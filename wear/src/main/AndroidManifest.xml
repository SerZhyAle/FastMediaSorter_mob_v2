<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />

    <!--
        S3178: what is left here is the whole permission surface of the Google Play variant.

        Every other permission this module used to declare - network, radios, media, microphone,
        foreground services, notifications - moved to wear/src/noLegal/AndroidManifest.xml, where
        the sideload artifact keeps it. The boundary is wear/config/store-boundary-policy.json and
        it names the category each one left under; assert-wear-store-boundary.ps1 reads the two
        MERGED manifests back, so a permission re-entering standard through a dependency is caught
        even though no file here declares it.

        Adding a permission to this file puts it in the store artifact. That is a policy decision,
        not a manifest edit: name it in standardAllowlist first, or the gate refuses the build.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />


   <application
        android:name=".FastMediaSorterWearApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <!-- S1721: the watch absorbs a rotation instead of being recreated by it. On a 480x480 screen a
             rotation changes no proportions, so a recreate reads as the screen resetting itself - the
             Compose tree and the navigation stack are rebuilt for nothing.
             Safe here and NOT a repeat of the S1549 defect: that rule is about layouts chosen by an
             orientation qualifier at inflate time, and this module has no res/layout* at all. Compose
             receives the new configuration through LocalConfiguration and recomposes. If a view layout ever
             appears in this module, this declaration stops being free. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.FastMediaSorterWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            S3178: MainActivity and the mini-programs tile are the only components the Google Play
            variant declares. The listen window, the Data Layer listener, both foreground services,
            the resource/stream/favourites/sections tiles, all three complications and the file
            provider moved to wear/src/noLegal/AndroidManifest.xml - each one is an entry point into
            a category wear/config/store-boundary-policy.json excludes, and an entry point survives
            hiding its screen. Their classes stay in this source set; what the store build loses is
            the platform's permission to start them.
        -->
        <!-- S2511: Wear OS Tile Service for the mini-programs shortcut grid -->
        <service
            android:name=".tile.WearProgramsTileService"
            android:exported="true"
            android:label="@string/wear_tile_programs_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_programs" />
        </service>

    </application>
</manifest>
