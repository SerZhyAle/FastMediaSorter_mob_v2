<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />

    <!--
        S3178 / S4029: this file is the whole permission surface of the Google Play variant.

        Only the health, body-sensor and automatic-listening permissions live in
        wear/src/noLegal/AndroidManifest.xml. The boundary is wear/config/store-boundary-policy.json;
        assert-wear-store-boundary.ps1 reads the two MERGED manifests back, so a sideload-only
        permission re-entering standard through a dependency is caught even though no file here
        declares it.

        Adding a permission to this file puts it in the store artifact. That is a policy decision,
        not a manifest edit: name it in standardAllowlist first, or the gate refuses the build.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        S3555: the running stopwatch is an ongoing activity (WO-V4), and on Wear OS 4+ its notification -
        the only thing the watch face indicator, the Recents chip and the tile hang off - is silently
        dropped without this grant. S1862 measured the same for a foreground-service notification, so
        no notification this module posts is exempt. Both flavors take it from here.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />

    <!--
      S4029: the permissions below came back from wear/src/noLegal/AndroidManifest.xml, where S3178
      had moved them for the first store publication. Both editions carry them now; only health,
      body-sensor and automatic-listening declarations stay in the sideload manifest.
    -->
    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        S1728: asks the platform for a wide-band transport while a stream plays, and gives it back when
        the stream ends. Only the request needs this; reading the current link needs nothing beyond
        ACCESS_NETWORK_STATE, which already reaches this app through the merged manifest.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
        S1710: the Network Monitor mini-program reads THIS watch's own radios. Only what the sampling
        actually calls is declared (Rule 13). READ_PHONE_STATE is deliberately absent (owner ruling
        2026-08-21): the operator name comes from TelephonyManager.networkOperatorName, which needs no
        permission, and the per-SIM detail that does need it is not carried to the watch at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        Wi-Fi section: the visible-network list on API 33+. `neverForLocation` is what lets the scan
        run without ACCESS_FINE_LOCATION, which S2013 removed - Play reviews location against the
        store description, and a radio monitor is not what this app is listed as.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        android:minSdkVersion="33" />

    <!--
        S3115: the Tourist dashboard is a GPS instrument - speed, altitude, coordinates, satellites,
        trip distance and sunrise/sunset all come from a location fix, and without these two the screen
        shows "Searching GPS.." for ever while the system closes the permission dialog in 0.1 s because
        nothing is declared to grant (measured on Galaxy Watch 7, 2026-09-17).

        S4029: both editions declare it again for the Network Monitor's satellite section, which reads
        the same GNSS fix; the Tourist dashboard itself stays sideload-only behind offersHealthFeatures
        (S3042). Play judges location against the store description (S2013), so the store listing names
        the satellite readout. There is no background location: both screens ask only while open.
        Coarse is declared beside fine because the system offers the approximate choice on API 31+ and
        the dashboard is usable on it; the repository reads whichever fix it is given.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Bluetooth section on API 30 and below; API 31+ routes through BLUETOOTH_CONNECT instead. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth section: adapter state on API 31+. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />

    <!-- Storage permissions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
        S1862: the voice recorder. The microphone session belongs to a foreground service rather than
        to the screen (ADR-4) - a watch screen goes dark when the wrist drops, and a screen-bound
        session would end exactly while the user is speaking. FOREGROUND_SERVICE_MICROPHONE is the
        API 34 split of FOREGROUND_SERVICE and is requested only there; below 34 the untyped
        permission alone is what the platform checks.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        android:minSdkVersion="34" />
    <!--
        S2166: background playback. FOREGROUND_SERVICE_MEDIA_PLAYBACK is the API 34 split of
        FOREGROUND_SERVICE and is requested only there; below 34 the untyped permission alone is
        what the platform checks.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        android:minSdkVersion="34" />


   <application
        android:name=".FastMediaSorterWearApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <!-- S1721: the watch absorbs a rotation instead of being recreated by it. On a 480x480 screen a
             rotation changes no proportions, so a recreate reads as the screen resetting itself - the
             Compose tree and the navigation stack are rebuilt for nothing.
             Safe here and NOT a repeat of the S1549 defect: that rule is about layouts chosen by an
             orientation qualifier at inflate time, and this module has no res/layout* at all. Compose
             receives the new configuration through LocalConfiguration and recomposes. If a view layout ever
             appears in this module, this declaration stops being free. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.FastMediaSorterWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            S4029: every component is declared for both editions again; S3178 had confined all but
            MainActivity, the mini-programs tile and the face-slot providers to the sideload build. An
            entry point survives hiding its screen, so a command whose capability an edition withholds
            is refused where it arrives (WatchWearListenerService, ResolveWearLaunchAddressUseCase).
        -->
        <!-- S2511: Wear OS Tile Service for the mini-programs shortcut grid -->
        <service
            android:name=".tile.WearProgramsTileService"
            android:exported="true"
            android:label="@string/wear_tile_programs_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_programs" />
        </service>

        <!-- S3558: one provider per watch-face slot (ADR-2); the face binds these class names, so they
             must not be renamed. SHORT_TEXT only (ADR-3). A 600 s period rather than 0: a slot may hold
             the battery, the date or the next alarm, which change without any event this app hears.
             S4023: declared for both editions. The store build has no Data Layer listener, so its
             slots always show the flavor's own default (WearRestrictedCapabilities.faceSlotDefaults),
             and a slot refuses app data wherever media access is withheld. -->
        <service
            android:name=".complication.WearFaceSlot1ComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_face_slot_1_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <service
            android:name=".complication.WearFaceSlot2ComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_face_slot_2_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <service
            android:name=".complication.WearFaceSlot3ComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_face_slot_3_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <service
            android:name=".complication.WearFaceSlot4ComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_face_slot_4_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <!-- S2550 ADR-6 / S2941: the window the listening-request notification opens, also
             automatically via setFullScreenIntent in the sideload build (S4029). Not exported - only this process may raise it, and
             only the notification (full-screen intent or tap) reaches it. Starting the microphone
             service from a window the user opened or that full-screen intent brought to the foreground
             is the one platform exemption that lifts both the API 31 and the API 34 background-start
             barriers (strategic §6.1). -->
        <activity
            android:name=".ui.listen.ListenRequestActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.FastMediaSorterWear" />

        <!-- Wearable Data Layer - receives resource push from the phone companion -->
        <service
            android:name=".data.wear.WatchWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <!-- S1697: the mirror of the phone-side filter. onMessageReceived handled the phone's
                     playback command and onDataChanged the settings push, but neither action nor path
                     was declared, so GMS delivered only the network-sources data item. -->
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <!-- S1861: without CHANNEL_EVENT and the /fms/transfer_file prefix GMS never starts
                     this service for an incoming file channel, so onChannelOpened was dead code. -->
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/network_sources"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/transfer_file"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/phone"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/wear"
                    android:scheme="wear" />
            </intent-filter>
            <!-- S1862: a filter of its own rather than one more action on the block above - an intent
                 filter matches the union of its actions against the union of its data, and the
                 capability path is not a /fms/ path. The name must equal PHONE_COMPANION_CAPABILITY
                 in WatchWearListenerService.kt and the capability the phone declares for itself. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/fms_phone_companion"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <!-- S1862: owner of the microphone session; started by the recorder screen, never bound to it. -->
        <service
            android:name=".service.VoiceRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- S2166: owner of the playback session; started by the player screen, never bound to it. -->
        <service
            android:name=".service.WearPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- S1955: Wear OS Tile Service for Network Resource tile -->
        <service
            android:name=".tile.WearResourceTileService"
            android:exported="true"
            android:label="@string/wear_tile_resource_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_resource" />
        </service>

        <!-- S1955: Wear OS Tile Service for Stream tile -->
        <service
            android:name=".tile.WearStreamTileService"
            android:exported="true"
            android:label="@string/wear_tile_stream_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_stream" />
        </service>

        <!-- S1955: Wear OS Tile Service for Favourites tile -->
        <service
            android:name=".tile.WearFavouritesTileService"
            android:exported="true"
            android:label="@string/wear_tile_favourites_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_favourites" />
        </service>

        <!-- S2511: Wear OS Tile Service for the home-sections shortcut grid -->
        <service
            android:name=".tile.WearSectionsTileService"
            android:exported="true"
            android:label="@string/wear_tile_sections_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_sections" />
        </service>

        <!-- S2047: Wear OS Complication Provider for Last Used Resource -->
        <service
            android:name=".complication.WearLastResourceComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_last_resource"
            android:label="@string/wear_complication_last_resource_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- S2047: Wear OS Complication Provider for Favourites Count -->
        <service
            android:name=".complication.WearFavouritesComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_favourites"
            android:label="@string/wear_complication_favourites_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- S2047: Wear OS Complication Provider for Now Playing -->
        <service
            android:name=".complication.WearNowPlayingComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_now_playing"
            android:label="@string/wear_complication_now_playing_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- S3557: the phone launcher clock style for this product's watch face. RANGED_VALUE only,
             because the face reads a number and a colour list from it (WearClockStyleFaceEncoder);
             no update period, the clock-style receiver asks for an update on every new style. -->
        <service
            android:name=".complication.WearClockStyleComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_clock_style_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- S3708: the delivered backdrop frame for this product's watch face, which binds one hidden
             full-screen PHOTO_IMAGE slot to it. No update period: every backdrop change refreshes it
             together with the clock style provider. -->
        <service
            android:name=".complication.WearFacePhotoComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_face_photo_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="PHOTO_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- S4018: the screen-off button the product face binds to its top-right slot. It answers the
             same data forever, so no update period. -->
        <service
            android:name=".complication.WearScreenOffComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_night_mode"
            android:label="@string/wear_screen_off"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!--
            S2142: hands one file to a «Send to..» receiver this watch serves itself.

            A receiver is another application, so it is given a content URI it can read rather than a
            path it cannot. The watch had no provider at all before this ticket - nothing here ever
            handed a file to a third party, only to the paired phone over the data layer.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/send_to_paths" />
        </provider>
    </application>
</manifest>
