<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- S2498: cleartext permitted app-wide so HTTP radio/stream sources play on Wear OS
         without CleartextNotPermittedException (matching app_v2 S0565). -->
    <base-config cleartextTrafficPermitted="true" />
    
    <!-- Allow cleartext (HTTP) traffic for local network only -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Private network ranges (RFC 1918) -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        
        <!-- Localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Debug overrides: trust user CAs globally for easier testing -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
