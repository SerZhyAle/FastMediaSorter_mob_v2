<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tile_preview_bg">#FF202124</color>
    <color name="tile_preview_accent">#FF0B82EB</color>

    <!-- S2007: the calculator's running value carries its own colour so it reads as a result rather
         than as one more key label. S2003 may later fold it into a watch palette - it is one entry
         here, so that decision re-points it in one line. -->
    <color name="wear_calc_display_value">#FFFFD54F</color>

    <!-- S2152 ADR-2: the calculator menu's two tinted groups. Memory is warm, which is the family
         the owner named, but it is NOT the theme's error colour: S2007 ADR-4 gave that colour to a
         destructive action and stated no other control is drawn that way, so borrowing it would
         leave one tone carrying two meanings on one screen. The warm brown sits far enough from the
         translucent red plate the clear and backspace keys wear to stay a different statement.
         Functions take a cool slate so the two tinted groups read apart from each other and from the
         plain surface chip that history and close keep. Reversible: the owner asking for literally
         the same red is one value here. -->
    <color name="wear_calc_memory_tint">#FF5D4037</color>
    <color name="wear_calc_function_tint">#FF26343F</color>

    <!-- S2003 ADR-3: the semantic tone of a content type, mirrored from the phone's icon-tinting
         scheme so one entity wears one colour across both apps. Names match the phone's on purpose -
         the lineage stays greppable from either module when S2046 folds its four schemes into one.

         S2003 ADR-6: these are the night members of the phone's day/night pairs, and there is no
         values-night here. Wear Compose ships a single palette - androidx.wear.compose.material
         .Colors declares no isLight and defaults background to black - so the watch has one surface
         and a split would resolve a choice that does not exist, at the risk of handing the watch the
         dark member of each pair against a black background.

         Owner ruling 2026-09-22: the muted members read as half-transparent glyphs on the dark glass,
         so the values moved to vivid mid tones (the Material 400/500 family, one tone per hue). The
         names keep matching the phone; the values are now tuned for the watch on purpose. -->
    <color name="color_media_music">#FF26A69A</color>
    <color name="color_media_video">#FFAB47BC</color>
    <color name="color_media_image">#FF42A5F5</color>
    <color name="color_media_docs">#FFFFB300</color>
    <color name="color_media_other">#FF90A4AE</color>

    <!-- S3433: source hues under the phone's names (ICON-RENDER 0.10 item D). The watch is always dark,
         so it carries the phone's night tones. -->
    <color name="color_source_local">#FF81C784</color>
    <color name="color_source_smb">#FF64B5F6</color>
    <color name="color_source_sftp">#FFFFB74D</color>
    <color name="color_source_ftp">#FFBA68C8</color>
    <color name="color_source_cloud">#FF4DD0E1</color>
    <!-- S2003 ADR-4: the only two tones in this set with no phone-side source - neither folder nor
         stream is a content type in any of the phone's four schemes. They are defined here, not
         inherited, and are marked so a later consolidation reads them as original rather than as
         drift. Green and red were chosen for being unoccupied and furthest from the five above;
         grey and teal were rejected because "other" and music already hold them. -->
    <color name="color_media_folder">#FF66BB6A</color>
    <color name="color_media_stream">#FFEF5350</color>

    <!-- S2510: per-mini-program accent palette, the watch half. The eight names repeat
         app_v2/src/main/res/values/colors.xml exactly - that name match is the whole contract, since
         the two modules share no source. The values do not: ADR-4 originally tuned them desaturated
         because a tone picked for a light phone surface either glares or disappears on the dark watch
         screen. Owner ruling 2026-09-22 cancelled that muting - the desaturated members read as
         half-transparent glyphs - so the values are now vivid mid tones (Material 400/500 family,
         one tone per hue), all 3:1 or better against black glass.
         No values-night, for the reason S2003 ADR-6 states above: Wear Compose ships one palette. -->
    <color name="color_program_accent_red">#FFEF5350</color>
    <color name="color_program_accent_orange">#FFFF9800</color>
    <color name="color_program_accent_amber">#FFFFC400</color>
    <color name="color_program_accent_green">#FF66BB6A</color>
    <color name="color_program_accent_teal">#FF26A69A</color>
    <color name="color_program_accent_blue">#FF42A5F5</color>
    <color name="color_program_accent_indigo">#FF5C6BC0</color>
    <color name="color_program_accent_purple">#FFAB47BC</color>
    <!-- S2509: the ninth name, and the first one the phone does not declare. The eight above are a
         name-for-name contract with app_v2 because each of those programs exists on both devices;
         the broadcast is a watch-only program (see the watch-only canonical-key baseline), so its
         tone has no phone counterpart to agree with. Vivid like its neighbours since the 2026-09-22
         un-muting, and distinct from the teal the Network Monitor holds - the accent test forbids a
         repeat because the whole list fits one watch screen at once. -->
    <color name="color_program_accent_cyan">#FF26C6DA</color>
    <!-- S2809: the tenth name, for blood pressure. Watch-only like the cyan above, and
         distinct from every other tone so no two adjacent rows on the Apps list look alike. -->
    <color name="color_program_accent_pink">#FFEC407A</color>
    <!-- S2825: the eleventh name, for the stopwatch. The phone gives that program orange because it
         sits beside the calculator there, but on the watch the calculator already holds orange and the
         accent test forbids a repeat - so this is the one tone whose value the two devices disagree on
         by necessity rather than by choice. Brown: the hue has no vivid member, so it takes the
         lightest one the family gives (Brown 300) and stays the quietest row of the list. -->
    <color name="color_program_accent_brown">#FFA1887F</color>
    <!-- S3007: the twelfth name, for Tourist dashboard. Emerald/lime green, distinct from game green. -->
    <color name="color_program_accent_emerald">#FF00C853</color>
    <!-- S3109: the thirteenth name, for the clipboard. Watch-only like the four above it, and slate
         rather than another blue - the Motion Monitor holds blue and the accent test forbids a repeat
         because the whole list fits one watch screen at once. -->
    <color name="color_program_accent_slate">#FF90A4AE</color>
    <!-- S3216: the fourteenth name, for the distress signal. The phone gives that program its plain
         red, but the red above is already the Voice Recorder's here and the accent test forbids a
         repeat - so this is the second tone whose value the two devices disagree on by necessity.
         Scarlet: hotter than the red beside it and pulled toward orange, which is the one row in this
         list that should read as an alarm at a glance. -->
    <color name="color_program_accent_scarlet">#FFFF5722</color>
</resources>
