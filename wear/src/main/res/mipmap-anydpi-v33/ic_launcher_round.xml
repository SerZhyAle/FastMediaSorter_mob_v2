<?xml version="1.0" encoding="utf-8"?>
<!--
    S4695: the watch launcher is the phone master on the same plate, cut by
    scripts/identity/build-identity.ps1 (PRODUCT-IDENTITY rule 5, surface app.wear), plus the themed-icon
    layer. Qualified -v33 like the phone copy (S1507), so older watches keep the v26 file unchanged.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_adaptive_back" />
    <foreground android:drawable="@mipmap/ic_launcher_adaptive_fore" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
