    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <path
        android:fillColor="@color/tile_preview_bg"
        android:pathData="M100,0 A100,100 0 1,1 99.9,0 Z" />
    <path
        android:fillColor="@color/tile_preview_accent"
        android:pathData="M58,64 h84 v20 h-84 Z" />
    <path
        android:fillColor="@color/tile_preview_accent"
        android:pathData="M58,92 h84 v20 h-84 Z" />
    <path
        android:fillColor="@color/tile_preview_accent"
        android:pathData="M58,120 h84 v20 h-84 Z" />
