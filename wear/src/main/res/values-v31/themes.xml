<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        S1706: the watch had no splash at all before this ticket. Deliberately not redefined under
        a newer qualifier - S0655 recorded that a later-qualifier redefinition silently drops these
        attributes.

        S2274: `windowSplashScreenAnimatedIcon` is deliberately ABSENT, and that absence is the fix.
        Left unset, the platform draws the launcher icon itself, which is what Wear App Quality
        requirement WO-V15 asks for - "the splash screen icon must match the app launcher icon".
        S1706 had pointed the attribute at the brand glyph `ic_splash_animated`, so the one mechanism
        that guaranteed the match by construction was traded for a mark that does not match, and Play
        rejected the watch on 2026-08-31 with `Missing app icon in splash screen`. Setting this
        attribute again re-opens that rejection; a brand mark belongs in `BrandFrameScreen`, which
        runs after the splash and is not what the requirement judges.
    -->
    <style name="Theme.FastMediaSorterWear" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
