<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        S1706: the watch had no splash at all before this ticket. Deliberately not redefined under
        a newer qualifier - S0655 recorded that a later-qualifier redefinition silently drops these
        attributes. Duration matches the phone so both surfaces move at the same pace.
    -->
    <style name="Theme.FastMediaSorterWear" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
    </style>
</resources>
