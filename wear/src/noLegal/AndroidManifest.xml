<?xml version="1.0" encoding="utf-8"?>
<!--
  The first AndroidManifest.xml in either wear flavor source set, created by S2458 and shared with S2457.

  S2090 ADR-5 created the flavor dimension so that a capability Play refuses on a watch had somewhere to
  go instead of being deleted, and predicted that "the first capability that needs a permission creates
  that file". Two tickets reached that point within the same hour, so this file serves both and will
  serve the next one: it is the whole module's noLegal permission surface, not any one ticket's.

  Why none of these permissions may live in wear/src/main/AndroidManifest.xml: each is reviewed by
  Google Play before an app may ship it, against a short list of admitted use cases that a media sorter
  matches none of, and a mismatch with the declared core functionality is denied. A declaration in
  src/main would merge into standard and put that denial on the store listing of a shipping product
  rather than on the feature. The two flavors share one applicationId (S1681), so the source set is the
  only isolation there is.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      S2457: heart rate. Two permissions for one capability, split at API 36. The granular health permission replaces the
      legacy sensor one there, so the legacy declaration is capped below it rather than removed - a watch
      on API 30..35 has no other way to ask. Background access is out of scope, which is why neither
      BODY_SENSORS_BACKGROUND nor READ_HEALTH_DATA_IN_BACKGROUND appears here: the measurement exists
      only while its screen is open.
    -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!--
      S2458: the step counter and step detector, which are activity-recognition sensors and NOT body
      sensors - a different permission family with a different reason for being confined here. The phone
      edition that declared this permission was rejected with HTTP 403 against the App content -> Health
      apps questionnaire on 2026-08-12, and S1614 is still BlockExternal waiting on that answer. Keeping
      it out of standard is what lets the Motion Monitor's other half - accelerometer, gyroscope and
      rotation vector, which need no permission at all - ship in every edition regardless.

      Availability is read back from the MERGED manifest at runtime (WearActivityRecognitionState), never
      from a flavor check, which Rule 14 bans in shared code.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
      androidx.health:health-services-client declares minSdk 30; this module's floor is 28 and is pinned
      there as a Wear OS 2.0 support commitment, so the merger is told to accept the gap instead of the
      floor being raised. What makes that safe is not this line but the runtime guard: the data source
      answers PLATFORM_TOO_OLD below API 30 and never touches a Health Services class, because Health
      Services is a mandatory component only from Wear OS 3.
    -->
    <uses-sdk tools:overrideLibrary="androidx.health.services.client" />


    <!--
      S3178: the whole sensitive permission surface of the Wear module, moved here out of
      wear/src/main/AndroidManifest.xml so that the Google Play variant declares none of it.

      Each block below kept its original ticket and its original reason; what changed is only which
      artifact carries it. The categories they belong to - media access, microphone and voice notes,
      remote sources, device diagnostics, nearby device state, foreground entry points - are named in
      wear/config/store-boundary-policy.json, and assert-wear-store-boundary.ps1 fails if any of them
      reappears in standard OR disappears from here. The owner's ruling of 2026-09-16 is that the
      first store publication carries none of them and that each returns later on its own ticket.
    -->

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        S1728: asks the platform for a wide-band transport while a stream plays, and gives it back when
        the stream ends. Only the request needs this; reading the current link needs nothing beyond
        ACCESS_NETWORK_STATE, which already reaches this app through the merged manifest.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
        S1710: the Network Monitor mini-program reads THIS watch's own radios. Only what the sampling
        actually calls is declared (Rule 13). READ_PHONE_STATE is deliberately absent (owner ruling
        2026-08-21): the operator name comes from TelephonyManager.networkOperatorName, which needs no
        permission, and the per-SIM detail that does need it is not carried to the watch at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        Wi-Fi section: the visible-network list on API 33+. `neverForLocation` is what lets the scan
        run without ACCESS_FINE_LOCATION, which S2013 removed - Play reviews location against the
        store description, and a radio monitor is not what this app is listed as.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        android:minSdkVersion="33" />

    <!--
        S3115: the Tourist dashboard is a GPS instrument - speed, altitude, coordinates, satellites,
        trip distance and sunrise/sunset all come from a location fix, and without these two the screen
        shows "Searching GPS.." for ever while the system closes the permission dialog in 0.1 s because
        nothing is declared to grant (measured on Galaxy Watch 7, 2026-09-17).

        S2013 removed location from wear/src/main because Play judges it against the store description,
        and that removal stands: the store variant still declares neither. What makes the declaration
        legitimate HERE is that the route it serves - tourist_info - is itself noLegal-only under the
        store-boundary policy, so the permission and the capability leave the Play artifact together.
        Coarse is declared beside fine because the system offers the approximate choice on API 31+ and
        the dashboard is usable on it; the repository reads whichever fix it is given.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Bluetooth section on API 30 and below; API 31+ routes through BLUETOOTH_CONNECT instead. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth section: adapter state on API 31+. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />

    <!-- Storage permissions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
        S1862: the voice recorder. The microphone session belongs to a foreground service rather than
        to the screen (ADR-4) - a watch screen goes dark when the wrist drops, and a screen-bound
        session would end exactly while the user is speaking. FOREGROUND_SERVICE_MICROPHONE is the
        API 34 split of FOREGROUND_SERVICE and is requested only there; below 34 the untyped
        permission alone is what the platform checks.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        android:minSdkVersion="34" />
    <!--
        S2166: background playback. FOREGROUND_SERVICE_MEDIA_PLAYBACK is the API 34 split of
        FOREGROUND_SERVICE and is requested only there; below 34 the untyped permission alone is
        what the platform checks.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        android:minSdkVersion="34" />
    <!-- S3555: POST_NOTIFICATIONS is declared once, in wear/src/main/AndroidManifest.xml. -->

    <!--
        S2941: lets the listen-request notification open ListenRequestActivity automatically via
        setFullScreenIntent, putting the app in the foreground so the microphone FGS can start without
        a tap. CATEGORY_CALL on the notification qualifies for this permission on Android 14+.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      S3178: every component that is an entry point into an excluded category, moved here out of
      wear/src/main/AndroidManifest.xml. Their classes remain in the shared source set - only the
      declarations moved, because a service declared in the merged manifest can be started by the
      platform, by GMS or by another application whatever the navigation graph offers.
    -->
    <application>
        <!-- S2550 ADR-6 / S2941: the window the listening-request notification opens, now also
             automatically via setFullScreenIntent. Not exported - only this process may raise it, and
             only the notification (full-screen intent or tap) reaches it. Starting the microphone
             service from a window the user opened or that full-screen intent brought to the foreground
             is the one platform exemption that lifts both the API 31 and the API 34 background-start
             barriers (strategic §6.1). -->
        <activity
            android:name=".ui.listen.ListenRequestActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.FastMediaSorterWear" />

        <!-- Wearable Data Layer - receives resource push from the phone companion -->
        <service
            android:name=".data.wear.WatchWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <!-- S1697: the mirror of the phone-side filter. onMessageReceived handled the phone's
                     playback command and onDataChanged the settings push, but neither action nor path
                     was declared, so GMS delivered only the network-sources data item. -->
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <!-- S1861: without CHANNEL_EVENT and the /fms/transfer_file prefix GMS never starts
                     this service for an incoming file channel, so onChannelOpened was dead code. -->
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/network_sources"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/transfer_file"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/phone"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/fms/wear"
                    android:scheme="wear" />
            </intent-filter>
            <!-- S1862: a filter of its own rather than one more action on the block above - an intent
                 filter matches the union of its actions against the union of its data, and the
                 capability path is not a /fms/ path. The name must equal PHONE_COMPANION_CAPABILITY
                 in WatchWearListenerService.kt and the capability the phone declares for itself. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/fms_phone_companion"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <!-- S1862: owner of the microphone session; started by the recorder screen, never bound to it. -->
        <service
            android:name=".service.VoiceRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- S2166: owner of the playback session; started by the player screen, never bound to it. -->
        <service
            android:name=".service.WearPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- S1955: Wear OS Tile Service for Network Resource tile -->
        <service
            android:name=".tile.WearResourceTileService"
            android:exported="true"
            android:label="@string/wear_tile_resource_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_resource" />
        </service>

        <!-- S1955: Wear OS Tile Service for Stream tile -->
        <service
            android:name=".tile.WearStreamTileService"
            android:exported="true"
            android:label="@string/wear_tile_stream_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_stream" />
        </service>

        <!-- S1955: Wear OS Tile Service for Favourites tile -->
        <service
            android:name=".tile.WearFavouritesTileService"
            android:exported="true"
            android:label="@string/wear_tile_favourites_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_favourites" />
        </service>

        <!-- S2511: Wear OS Tile Service for the home-sections shortcut grid -->
        <service
            android:name=".tile.WearSectionsTileService"
            android:exported="true"
            android:label="@string/wear_tile_sections_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_sections" />
        </service>

        <!-- S2047: Wear OS Complication Provider for Last Used Resource -->
        <service
            android:name=".complication.WearLastResourceComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_last_resource"
            android:label="@string/wear_complication_last_resource_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- S2047: Wear OS Complication Provider for Favourites Count -->
        <service
            android:name=".complication.WearFavouritesComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_favourites"
            android:label="@string/wear_complication_favourites_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- S2047: Wear OS Complication Provider for Now Playing -->
        <service
            android:name=".complication.WearNowPlayingComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_now_playing"
            android:label="@string/wear_complication_now_playing_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- S3557: the phone launcher clock style for this product's watch face. RANGED_VALUE only,
             because the face reads a number and a colour list from it (WearClockStyleFaceEncoder);
             no update period, the clock-style receiver asks for an update on every new style.
             Here and not in main for ADR-3: the Play build has no Data Layer listener to feed it. -->
        <service
            android:name=".complication.WearClockStyleComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/wear_complication_clock_style_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!--
            S2142: hands one file to a «Send to..» receiver this watch serves itself.

            A receiver is another application, so it is given a content URI it can read rather than a
            path it cannot. The watch had no provider at all before this ticket - nothing here ever
            handed a file to a third party, only to the paired phone over the data layer.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/send_to_paths" />
        </provider>
    </application>
</manifest>
