<?xml version="1.0" encoding="utf-8"?>
<!--
  S3178 / S4029: the Google Play variant's own manifest, and the second half of the store boundary.

  Keeping the sensitive declarations in wear/src/noLegal/ removes them from what THIS repository
  contributes to the standard artifact. It does not remove them from what a DEPENDENCY contributes:
  a library manifest merges into every flavor, so a future version of a Wear, health or GMS artifact
  could put a body-sensor permission back into the store build with no file here changing. That is
  the exact defect wear/config/store-boundary-policy.json exists to catch - but catching it in a gate
  means the bad artifact was built first, and a merger removal means it cannot be built.

  Each line below names a permission the policy keeps noLegal-only. S4029 returned media, microphone,
  network, radios, location and foreground services to both editions, so their removals are gone;
  returning another one is an edit of the policy file first, and only then a deletion of its line here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Category: automatic listening -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />

    <!-- Category: health body and motion data -->
    <uses-permission android:name="android.permission.BODY_SENSORS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" tools:node="remove" />

</manifest>
