{
  "$comment": "FastMediaSorter_mob_v2 project profile (S2402). Read by the canon-shipped harness through tools/harness/_profile.ps1; every value here overrides the harness default. Paths are project-relative with forward slashes.",
  "version": "1",
  "projectName": "FastMediaSorter_mob_v2",
  "envPrefix": "FMS",
  "paths": {
    "journal": "PLAN/spec-catalog.jsonl",
    "journalArchive": "PLAN/spec-catalog-archive.jsonl",
    "burnedIds": "PLAN/spec-catalog-burned-ids.jsonl",
    "specsDir": "PLAN",
    "specArchiveDir": "PLAN/archive",
    "releaseQueue": "PLAN/RELEASE_QUEUE.md",
    "releaseReady": "PLAN/RELEASE_READY.md",
    "releaseQueueDone": "PLAN/RELEASE_QUEUE_DONE.md",
    "tempDir": "temp",
    "locksDir": "temp",
    "leasesDir": "temp/SPEC-TICKET.LEASES",
    "leaseHandoffDir": "temp/LEASE-HANDOFF",
    "lockHandoffDir": "temp/LOCK-HANDOFF",
    "agentChatDir": "temp/AGENT-CHAT",
    "queueRunsDir": "temp/spec-queue",
    "queueStopFile": "temp/STOP-SPEC-QUEUE",
    "specAllQueueLock": "temp/spec-all-queue.lock",
    "skipCache": "temp/spec-next-skip-cache.json",
    "migrateDoneDir": "temp/done",
    "changelog": "dev/CHANGELOG.md",
    "documentRegistry": "docs/DOCUMENT_REGISTRY.jsonl",
    "docsMap": "docs/DOCS_MAP.md",
    "sitemap": "sitemap.xml",
    "allFeatures": "docs/ALL_FEATURES.jsonl",
    "allFeaturesPrivate": "docs/ALL_FEATURES_noLegal.jsonl",
    "allFeaturesSchema": "docs/ALL_FEATURES.schema.json",
    "allFeaturesFlavorsBaseline": "scripts/all_features/unexplained-flavors-baseline.txt",
    "featureMatrix": "docs/FLAVOR_MATRIX.md",
    "commandsDir": ".claude/commands",
    "probeBaseline": "scripts/quality/blockneedusertest-probe-baseline.txt"
  },
  "grammar": {
    "ticketIdPattern": "^S\\d{4}$",
    "specFilePattern": "^PLAN/(archive/)?S\\d{4}_(?!spec_)",
    "specFileTemplate": "PLAN/{0}_{1}.md",
    "statusVocabulary": ["Draft", "Approved", "Tactical", "In Progress", "Implemented", "Verified", "Partial", "Broken", "BlockByOtherTask", "BlockNeedUserTest", "BlockQuestions", "BlockExternal", "Archived"],
    "closedStatusesComment": "S3308. The statuses at which a ticket counts as CLOSED for intake: its defect is already fixed in the tree, so a fresh capture carrying the same symptom is a duplicate rather than a report. Five such duplicates were opened and archived the same day over 2026-09-17..19, all from an external quality dashboard still showing signatures of crashes fixed before that window. BlockNeedUserTest is in the list because the fix is already in the tree and only its verdict is outstanding; every state that still carries work is out. Read by scripts/utils/capture-draft.ps1.",
    "closedStatuses": ["Implemented", "Verified", "BlockNeedUserTest", "Archived"]
  },
  "modules": {
    "default": "app_v2",
    "names": ["app_v2", "wear"]
  },
  "locks": {
    "domains": [
      { "name": "Build.Phone", "type": "Build", "rank": 1 },
      { "name": "Build.Wear", "type": "Build", "rank": 2 },
      { "name": "Code.Phone", "type": "Code", "rank": 3 },
      { "name": "Code.Wear", "type": "Code", "rank": 4 },
      { "name": "Code.Scripts", "type": "Code", "rank": 5 },
      { "name": "Code.Fixture", "type": "Code", "rank": 6 }
    ],
    "pathRules": [
      { "pattern": "^config/detekt/baseline-app_v2", "domain": "Code.Phone" },
      { "pattern": "^config/detekt/baseline-wear", "domain": "Code.Wear" },
      { "pattern": "^(settings\\.gradle\\.kts|build\\.gradle\\.kts|gradle\\.properties|gradlew(\\.bat)?)$", "domain": "Code" },
      { "pattern": "^(gradle|config/detekt|lint-rules)/", "domain": "Code" },
      { "pattern": "^(app_v2|wear)/build\\.gradle\\.kts$", "domain": "Code" },
      { "pattern": "^app_v2/", "domain": "Code.Phone" },
      { "pattern": "^wear/", "domain": "Code.Wear" },
      { "pattern": "^PLAN/", "domain": null },
      { "pattern": "^temp/lock-fixture/", "domain": "Code.Fixture" },
      { "pattern": "^temp/", "domain": null },
      { "pattern": "^(scripts|dev|docs|\\.claude|\\.github)/", "domain": "Code.Scripts" },
      { "pattern": "^(CLAUDE|AGENTS|README)\\.md$", "domain": "Code.Scripts" },
      { "pattern": "^(\\.sza-profile\\.json|\\.sza-canon\\.json)$", "domain": "Code.Scripts" },
      { "pattern": "^a\\.ps1$", "domain": "Code.Scripts" },
      { "pattern": "^(play|fastlane|store_assets|delivery|maestro)/", "domain": "Code.Scripts" },
      { "pattern": "^(index|nolegal)[^/]*\\.html$", "domain": "Code.Scripts" },
      { "pattern": "^(styles\\.css|sitemap\\.xml|robots\\.txt|_config\\.yml|_typos\\.toml)$", "domain": "Code.Scripts" },
      { "pattern": "^(GEMINI\\.md|LICENSE|THIRD_PARTY_LICENSES\\.md)$", "domain": "Code.Scripts" },
      { "pattern": "^(favicon[^/]*|icon\\.png|apple-touch-icon\\.png)$", "domain": "Code.Scripts" }
    ],
    "agentProcessNames": ["claude.exe", "claude", "codex.exe", "codex"],
    "buildEngine": {
      "processNames": ["java.exe", "java"],
      "busyMatch": "GradleDaemon|gradle-launcher",
      "busyExclude": "-Xmx64m"
    }
  },
  "codexContext": {
    "maxInlineChars": 8000,
    "maxOutputTokens": 2000,
    "stageContextBudget": 120000,
    "evidenceDirTemplate": "temp/{Id}/evidence"
  },
  "probes": {
    "enabled": true,
    "scanRoots": ["app_v2", "wear"],
    "sourceRoots": ["app_v2/src", "wear/src"],
    "sourceExtensions": [".kt", ".java", ".py", ".xml"],
    "openerRegex": "Timber\\.(?<level>[iwed])\\(",
    "formRegex": "^Timber\\.d\\(\\s*\"S(?<num>\\d{4}):",
    "formRegexForId": "^Timber\\.d\\(\\s*\"{Id}:",
    "tagRegex": "Timber\\.d\\(\"S\\d{4}:",
    "templateRegex": "^Timber\\.d\\(\\s*\"(?<ticket>S\\d{4}):\\s*(?<message>(?:\\\\.|[^\"\\\\])*)\"",
    "ownLineRegex": "^(timber\\.log\\.)?Timber\\.d\\(.*\\)$",
    "callTemplate": "Timber.d(\"{Id}: {Message}\")",
    "callName": "Timber.d",
    "removeCommand": "pwsh -NoProfile -File scripts/quality/remove-ticket-probes.ps1 -Id {Id} -Force"
  },
  "hooks": {
    "postClose": [
      { "script": "dev/CATALOG/scripts/scan.ps1", "args": ["-Module", "{Module}"] },
      { "script": "dev/CATALOG/scripts/render.ps1", "args": ["-Module", "{Module}"] },
      { "script": "scripts/quality/assert-allfeatures-sync.ps1", "args": ["-Gate"] }
    ],
    "deviceReady": "scripts/devtest/device-ready.ps1",
    "deviceReadyArgs": ["-Package", "com.sza.fastmediasorter.debug", "-CheckMcp", "-Module", "app_v2"],
    "moduleCatalog": "dev/CATALOG/{Module}.jsonl",
    "moduleCatalogSync": "scripts/catalog_sync.ps1"
  },
  "runner": {
    "command": "claude",
    "promptTemplate": "/spec-all {Id}",
    "decisionStatuses": ["Draft", "Approved", "Tactical", "In Progress", "Partial", "Broken", "BlockQuestions"],
    "cheapStatuses": ["Implemented", "BlockNeedUserTest"],
    "cheapTierMax": 3,
    "alwaysStrongStatuses": ["BlockQuestions"],
    "strongTierMin": 4,
    "shapeCheapTierMax": 2,
    "instancesComment": "S2698. One record per -Instance name, each field optional and falling back to the shared value beside it: 'command' is what the child is launched as, 'argsTemplate' is its whole argument vector with the {prompt}, {permissionMode} and {model} substitutions, 'modelPolicy' is the S2696 rule the watchdog starts it with. Declared with no overrides on purpose: the map states which instances exist, and every one of them launches exactly what it launched before. Instance c runs the shape rule since 2026-09-13 (S2702): a one-week measurement against a and b, which stay on tiered as the control group; both the watchdog and a.ps1 r1-r3 read this field. Putting an instance on a second agent is \"command\" plus \"argsTemplate\" here, and nowhere else. S3151: all three instances append .claude/runner/silent-mode.md as a system prompt, so an unattended child writes no human-facing narration. S3158: instance mono is the MONO chain started by a.ps1 r0 through scripts/utils/run-mono-queue.ps1, whose children run /spec-all -m <id> and take no lease or lock.",
    "instances": {
      "a": { "argsTemplate": ["-p", "{prompt}", "--permission-mode", "{permissionMode}", "--model", "{model}", "--append-system-prompt-file", ".claude/runner/silent-mode.md"] },
      "b": { "argsTemplate": ["-p", "{prompt}", "--permission-mode", "{permissionMode}", "--model", "{model}", "--append-system-prompt-file", ".claude/runner/silent-mode.md"] },
      "c": { "modelPolicy": "shape", "argsTemplate": ["-p", "{prompt}", "--permission-mode", "{permissionMode}", "--model", "{model}", "--append-system-prompt-file", ".claude/runner/silent-mode.md"] },
      "mono": { "argsTemplate": ["-p", "{prompt}", "--permission-mode", "{permissionMode}", "--model", "{model}", "--append-system-prompt-file", ".claude/runner/silent-mode.md"] }
    },
    "idleRunThreshold": 2,
    "idleOutcomes": ["ok", "timeout"]
  },
  "concurrency": {
    "comment": "S3308. How much work may run at once, as one declared value bounded from two measured sides rather than as whatever number of sessions happened to be open. maxSessions is the owner's ruling of 2026-09-19, taken against a measured 11 simultaneous sessions. The two thresholds below it drop the allowance to one lane: idleRunSharePercentMax is the share of runner runs that moved no status, above which more lanes buy nothing, and fastCheckLagSecondsMax is how far past its documented duration the phone code fast check may run before added concurrency is being paid for in build time - 14.1 s of lag is the check taking twice the figure docs/BUILD_TEST_FAST_PATH.md documents for it. holdSecondsMax is the age at which a Rule 23 domain hold is reported as having outlived its edit window; every hold of the script domain measured on 2026-09-19 ran 4 to 418 s except the one that ran at least 41 minutes and cost a neighbouring session 747 s. Read by scripts/utils/measure-process-throughput.ps1 and by a.ps1's runner targets.",
    "maxSessions": 6,
    "activeAgentComment": "S3308, the owner's definition of 2026-09-19. An agent counts against maxSessions only while it is ACTIVE: it talked in the chat, wrote a file or ran a script no longer than activeAgentWindowMinutes ago. A hung one, an interrupted one, one out of usage limits, one that finished its task and sits idle, and one the owner has declared dead are all out of the count - the bound exists to measure load, and an open window is not load.",
    "activeAgentWindowMinutes": 2,
    "idleRunSharePercentMax": 20,
    "fastCheckLagSecondsMax": 14.1,
    "holdSecondsMax": 600
  },
  "trivial": {
    "comment": "S3151. The Trivial path's checklist as limits, judged at closure by scripts/quality/assert-trivial-scope.ps1 on the changed set outside PLAN/ and temp/: at most maxFiles paths, no path absent from HEAD, and no added line in a forbiddenPatternExtensions file matching forbiddenPatterns (a new Kotlin or Java type, a Room entity or database, a Hilt module or provider).",
    "maxFiles": 3,
    "forbidNewFiles": true,
    "forbiddenPatternExtensions": [".kt", ".java"],
    "forbiddenPatterns": [
      "^\\s*(?:(?:public|private|internal|protected|abstract|open|sealed|data|enum|inner|value|annotation|fun)\\s+)*(?:class|interface|object)\\s+\\w",
      "@Entity\\b",
      "@Database\\s*\\(",
      "@Module\\b",
      "@Provides\\b"
    ]
  },
  "commands": {
    "statusCommands": {
      "Draft": ["/spec-all {Id}"],
      "Approved": ["/spec-tech {Id}", "/spec-dev {Id}"],
      "Tactical": ["/spec-dev {Id}"],
      "In Progress": ["/spec-dev {Id}"],
      "Partial": ["/spec-fix {Id}", "/spec-check {Id}"],
      "Broken": ["/spec-fix {Id}", "/spec-check {Id}"],
      "BlockByOtherTask": ["/spec-tech {Id}", "/spec-dev {Id}"],
      "Implemented": ["/spec-test-device {Id}", "/spec-check {Id}"]
    },
    "aliases": [
      { "canonical": "spec-draft", "latin": "sd", "translit": "сд", "shadow": "ыв" },
      { "canonical": "spec-all", "latin": "sa" },
      { "canonical": "spec-next", "latin": "sn", "shadow": "ыт" },
      { "canonical": "spec-quiz", "latin": "sq", "shadow": "ый" },
      { "canonical": "spec-code", "latin": "sc" },
      { "canonical": "spec", "latin": "sx" },
      { "canonical": "spec-arc", "latin": "arc" }
    ]
  },
  "inventory": {
    "dimensionName": "flavors",
    "dimensions": ["standard", "noLegal", "lite", "photos", "legacy", "vr", "foss"],
    "secondary": { "name": "wearFlavors", "values": ["standard", "noLegal"] },
    "noChangePlaceholders": ["без изменений", "no changes"]
  },
  "site": {
    "baseUrl": "https://serzhyale.github.io/FastMediaSorter_mob_v2",
    "locales": ["ru", "uk", "en"],
    "defaultLocale": "en"
  },
  "harness": {
    "invokePrefix": "pwsh -NoProfile -File",
    "entryPoints": {
      "spec_catalog/*": "scripts/spec_catalog/*",
      "locks/ticket-lease.ps1": "scripts/spec_catalog/ticket-lease.ps1",
      "locks/*": "scripts/utils/*",
      "chat/*": "scripts/utils/*",
      "batch/*": "scripts/utils/*",
      "aliases/*": "scripts/utils/*",
      "devlog/*": "scripts/*",
      "document_registry/*": "scripts/document_registry/*",
      "all_features/*": "scripts/all_features/*"
    }
  }
}
