# Enforce LF line endings for all source files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Keep CRLF for Windows-specific scripts
*.bat text eol=crlf
*.PS1 text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
*.apk binary
*.aar binary
*.jar binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
