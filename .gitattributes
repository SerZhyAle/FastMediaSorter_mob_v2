# Enforce LF line endings for all source files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Keep CRLF for Windows-specific scripts
*.bat text eol=crlf
*.PS1 text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary

# Vendored contract vectors are hashed byte for byte in PROVENANCE.txt
app_v2/src/test/resources/user-playlist/*.m3u8 -text
*.jks binary
*.apk binary
*.aar binary
*.jar binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Provenance hashes cover the catalog bytes, including their line endings.
app_v2/src/test/resources/letterbox-fill/letterbox-fill-vectors.json binary

# S4554: the INBOX-PACKET conformance vector is hashed byte for byte; never normalize it
app_v2/src/test/resources/inbox-ticket-vector/** -text

# EXCHANGE-MARK rule 6: the vendored artwork XML is a byte copy of the catalog's files, so a line-ending conversion
# would break the hash. ic_exchange_guest.xml and ic_exchange_invitation.xml are the product's own drawings.
app_v2/src/main/res/drawable/ic_exchange_mark.xml binary
app_v2/src/main/res/drawable/ic_exchange_mark_small.xml binary
app_v2/src/main/res/drawable/ic_exchange_mono.xml binary
wear/src/main/res/drawable/ic_exchange_mark_small.xml binary
wear/src/main/res/drawable/ic_exchange_mono.xml binary
