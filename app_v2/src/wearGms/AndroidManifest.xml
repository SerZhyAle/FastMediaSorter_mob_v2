<?xml version="1.0" encoding="utf-8"?>
<!--
  Wear Data Layer service overlay (S0403).

  Mounted into every Wear-capable flavor (standard, noLegal) via build.gradle.kts
  addStaticManifestFile. Declares the GMS WearableListenerService that receives sync requests and
  acks from the watch companion. Flavors that mount wearStub (lite, photos, legacy, vr, and FOSS)
  never declare this, so no Google Play Services Wearable reference reaches their merged manifest.

  S1951: legacy left this list - its applicationIdSuffix makes the Data Layer route unreachable.

  addStaticManifestFile is used instead of a flavor sourceSet manifest.srcFile because noLegal
  already maps its manifest to src/vr/AndroidManifest.xml (a set, not merge); addStaticManifestFile
  injects an additional merger input without clobbering that override (mirrors castEnabled).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service android:name=".service.PhoneWearListenerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/fms/network_sources" android:scheme="wear" />
                <!-- S1697: every watch -> phone path lives under /fms/watch (sources export, playback
                     state, favorites delta, phone-resource browse and open). The service handled them
                     in code while the filter matched only /fms/network_sources, so GMS started it for
                     the sync request alone and silently dropped the rest. -->
                <data android:host="*" android:pathPrefix="/fms/watch" android:scheme="wear" />
                <!-- S1861: without CHANNEL_EVENT and the /fms/transfer_file prefix GMS never starts
                     this service for a watch -> phone file channel, so onChannelOpened is dead. The
                     same prefix also covers the announcing /fms/transfer_file_meta message. -->
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:host="*" android:pathPrefix="/fms/transfer_file" android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- S2142: the tap target of the «Send to..» notification posted for a file the watch sent
             here as an errand. Declared in this overlay rather than in the main manifest because the
             errand only exists where the watch companion does - the same flavors this service does. -->
        <activity android:name=".ui.share.WearSendToDispatcherActivity" android:excludeFromRecents="true" android:exported="false" android:theme="@style/Theme.FastMediaSorter.Transparent" />

    </application>

</manifest>
