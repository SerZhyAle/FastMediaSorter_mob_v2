<?xml version="1.0" encoding="utf-8"?>
<!--
    Standard flavor manifest overlay.
    ML Kit Translate/language-id live in the on-demand :translate_feature dynamic module, not in the
    base (S0386). The ML Kit AAR auto-merges MlKitInitProvider + MlKitComponentDiscoveryService into
    the base manifest, but their classes are absent from the base APK, so the base would crash on
    launch ("Unable to get provider MlKitInitProvider"). Remove them here; the feature module brings
    them back when it is installed on demand.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />

        <service
            android:name="com.google.mlkit.common.internal.MlKitComponentDiscoveryService"
            tools:node="remove" />

    </application>

</manifest>
