<?xml version="1.0" encoding="utf-8"?>
<!--
    Standard flavor manifest overlay.
    S0423: ML Kit Translate is bundled in the standard base, so its AAR-merged MlKitInitProvider +
    MlKitComponentDiscoveryService run normally (no on-demand DFM, nothing to strip).

    S0630: the edge-gesture screenshot overlay host (SYSTEM_ALERT_WINDOW + SPECIAL_USE FGS) and the
    shared MediaProjection capture engine (FOREGROUND_SERVICE_MEDIA_PROJECTION) are no longer declared
    unconditionally here. They are injected via addStaticManifestFile (build.gradle.kts) only when
    fms.screenCapture != off, so a Play-fast standard release can ship without the MEDIA_PROJECTION /
    SPECIAL_USE declarations. The relocated SPECIAL_USE block lives in
    src/standardScreenCapture/AndroidManifest.xml; the shared engine in src/screenCapture/AndroidManifest.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            S2551: where the owner's "allow the watch to see this camera" tap lands. Declared for the
            standard flavor only - noLegal answers the same question from a standing switch and ships
            no such surface. Shape copied from ScreenCaptureConsentActivity: the decision was already
            made on the notification, so this must not become a second screen.
        -->
        <activity
            android:name="com.sza.fastmediasorter.broadcast.CameraSessionConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FastMediaSorter.Transparent" />
    </application>

</manifest>
