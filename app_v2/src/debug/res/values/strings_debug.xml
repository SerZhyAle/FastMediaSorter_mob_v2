<?xml version="1.0" encoding="utf-8"?>
<!-- Developer debug menu, present only in the debug build type and never shipped. Every key is
     translatable="false" on purpose: without it both lint's MissingTranslation and
     scripts/check_strings_localized.ps1 report 27 phantom RU/UK gaps that nobody should ever fill
     (S1280). Adding a key here without the attribute re-opens that false report. -->
