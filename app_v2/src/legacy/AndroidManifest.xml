<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy flavor manifest overlay.
    Removes components that are not supported or not needed in the legacy build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S1454's closure, finished for legacy: the only seam onto ContactsContract is
         ContactSnapshotDataSource, reached solely from src/launcherEnabled, which legacy does not
         mount (SUPPORT_LAUNCHER=false, src/launcherDisabled instead). Declared in src/main and
         unreachable here, so it is dropped rather than left declared, per canon invariant 13. -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        tools:node="remove" />

    <!-- S2726: no manifest in this project and no library declares this - the manifest merger adds it
         implicitly (it carries no source in the legacy blame report) because an old dependency on the
         cloudSdk / playServicesEnabled classpath names no targetSdkVersion. The one consumer is
         S1415's SIM indicator in src/launcherEnabled, absent here, so the merged legacy manifest
         carried a dangerous telephony permission nothing could ever request. Removing a
         uses-permission cannot narrow device reach, and READ_PHONE_STATE implies no
         android.hardware.telephony (S1415). -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />

    <application>

        <!-- Remove Dropbox Auth Activity: legacy has no cloud support.
             Prevents multiple apps registering for db-<appKey>:// which triggers
             the Dropbox SDK security alert when two flavors are installed. -->
        <activity
            android:name="com.dropbox.core.android.AuthActivity"
            tools:node="remove" />

        <!-- S0423: ML Kit Translate is bundled in the legacy base, so its AAR-merged init components
             run normally (no on-demand DFM, nothing to strip). -->

        <!-- S1941: .core.AppLaunchPanelTileService is deliberately NOT removed here, though its base
             class TileService arrives in API 24 and this flavor's floor is 23. legacy installs on
             every API from 23 up, and the Quick Launch Panel it opens ships in src/main for all
             flavors, so removing the tile would take a working entry point away from every legacy
             user on API 24+ to guard a platform that cannot reach it anyway: nothing in the app
             references the class, and an API 23 system knows no QS_TILE action, so it never binds
             the service and never loads the class. Checked 2026-08-22 on the merged legacy manifest. -->

    </application>

</manifest>
