<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== 480x480 SCREEN STYLES ===== -->
    <!-- Style overrides for 480x480 compact screens -->
    
    <!-- Compact button style for 480x480 -->
    <style name="CompactButtonStyle">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    
    <!-- Compact list item style for 480x480 -->
    <style name="CompactListItemStyle">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    
    <!-- Compact toolbar style for 480x480 -->
    <style name="CompactToolbarStyle">
        <item name="android:minHeight">48dp</item>
        <item name="titleTextAppearance">@style/CompactToolbarTitle</item>
    </style>
    
    <style name="CompactToolbarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
    </style>
    
    <!-- Compact dialog style -->
    <style name="CompactDialogStyle" parent="AlertDialog.AppCompat.Light">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
