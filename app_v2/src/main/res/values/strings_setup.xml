    <string name="welcome_default_player_description">Set FastMediaSorter as your default media player</string>
    <string name="welcome_default_player_hint">Tap a button below - a dialog will appear. Select FastMediaSorter and tap <b>Always</b>.</string>
    <string name="welcome_default_player_title">Default Player</string>
    <string name="welcome_description_1">Your all-in-one media organizer.\nBrowse, sort, and manage files across local, network, and cloud storage - all with intuitive touch gestures.</string>
    <string name="welcome_description_1_details">FastMediaSorter brings every kind of media into one place. Open photos, videos, GIFs and music from your device, from a network share, or from cloud storage - and sort them with quick taps instead of long-press menus.\n\nEverything you set up here can be changed later in Settings, so there is no wrong choice on this screen - just tap Next to keep going.</string>
    <string name="welcome_description_3" formatted="false">Player uses 9 touch zones (3×3 grid) for quick actions. Tap zones to navigate, copy, move, delete files, or access the command panel. See the scheme above for details.</string>
    <string name="welcome_language_picker_hint">Select app language</string>
    <string name="welcome_profile_audio_player_desc">Best for audio-only devices or MP3 players. Hides photos and videos; optimizes background audio and now-playing screen.</string>
    <string name="welcome_profile_audio_player_title">Audio player</string>
    <string name="welcome_profile_car_head_unit_desc">Best for Android car stereos. Uses extra-large buttons, locks screen on, and prioritizes media playback over file operations.</string>
    <string name="welcome_profile_car_head_unit_title">Car head unit</string>
    <string name="welcome_profile_ebook_reader_desc">Best for e-readers or document tablets. Hides videos and music; optimizes PDF, EPUB, and text reading settings.</string>
    <string name="welcome_profile_ebook_reader_title">E-book reader</string>
    <string name="welcome_profile_home_tablet_desc">Best for tablets, Chromebooks, and Samsung DeX. Optimizes grid layout, enables large thumbnails, and allows multi-window browsing.</string>
    <string name="welcome_profile_home_tablet_title">Tablet &amp; desktop mode</string>
    <string name="welcome_profile_media_player_desc">Best for dedicated media boxes. Focuses entirely on photos, videos, and music with automatic slideshow and resume features.</string>
    <string name="welcome_profile_media_player_title">Media player</string>
    <string name="welcome_profile_other_desc">Keeps the default system settings unchanged. No batch presets will be applied automatically.</string>
    <string name="welcome_profile_other_title">Other / Custom</string>
    <string name="welcome_profile_personal_smartphone_desc">Best for personal phones. Optimizes touch layout, enables background synchronization, and keeps default security confirmations.</string>
    <string name="welcome_profile_personal_smartphone_title">Personal smartphone</string>
    <string name="welcome_profile_photo_frame_desc">Turns the device into a digital photo frame. Disables video, audio, and file operations; opens slideshow immediately on launch.</string>
    <string name="welcome_profile_photo_frame_title">Photo frame</string>
    <string name="welcome_profile_selector_title">Device profile</string>
    <string name="welcome_profile_tv_media_box_desc">Best for TV and media centers. Optimizes DPAD/remote navigation, uses large buttons, and hides tiny touch controls.</string>
    <string name="welcome_profile_tv_media_box_title">TV / media box</string>
    <string name="welcome_profile_video_player_desc">Best for video-only devices. Hides photos, music, and document viewers; prioritizes quick video playback and thumbnails.</string>
    <string name="welcome_profile_video_player_title">Video player</string>
    <string name="welcome_profile_vr_headset_desc">Best for virtual reality devices. Pre-enables 3D/360° layouts and immersive controls on supported headsets.</string>
    <string name="welcome_profile_vr_headset_title">VR headset</string>
    <string name="welcome_recommended_badge">(Recommended)</string>
