    <string name="welcome_networks_companion_note">Media on a Windows PC? Fast Media Sorter &amp; Sharing for Windows shares those folders here in a couple of clicks - no server setup needed.</string>
    <string name="welcome_networks_companion_button">Get the Windows app</string>
    <string name="welcome_networks_example_smb">For example: a shared folder on a Windows PC, a NAS such as Synology or QNAP, or a USB disk plugged into your router.</string>
    <string name="welcome_networks_example_ftp">For example: a hosting account over FTP, your own home server over SFTP, or a camera that uploads photos to an FTP folder.</string>
    <string name="welcome_networks_example_cloud">For example: sign in to Google Drive once and browse your photo backup like any other folder.</string>
    <string name="welcome_default_player_details">Being the default app means a file opened from somewhere else - a gallery, a messenger, a file manager - lands here instead of the system player.</string>
    <string name="welcome_default_player_revert_note">This is not permanent: Android keeps the choice in its own settings and it can be changed back at any time.</string>
