<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Grid column counts for default (phones in portrait) -->
    <integer name="grid_column_count">3</integer>
    <!-- Welcome feature list: one column, so the entries read as a list rather than a button grid.
         The only override is values-w600dp (2). Available width, not smallestWidth, is what decides:
         an sw* bucket would pin a phone to the same count in both orientations, and sw outranks
         orientation, so a values-land override would never win on a phone. -->
    <integer name="welcome_feature_grid_columns">1</integer>
    <integer name="grid_column_count_landscape">3</integer>
    <integer name="resource_grid_column_count">2</integer>
    <integer name="destinations_column_count">1</integer>
    <!-- S0999: column count for the Playback "Send file to.." toggle list. Narrow portrait = 1;
         values-land / values-sw600dp widen to 2. Extensible to 3+ via new width buckets, no Kotlin change. -->
    <integer name="settings_send_commands_columns">1</integer>
    <!-- S1161: settings group cards per row. Portrait stays 1 on every device - a sw600dp override
         here would silently give portrait tablets two columns, which the ticket rules out. -->
    <integer name="settings_group_columns">1</integer>

    <!-- Input field length limits -->
    <integer name="input_max_length_tiny">2</integer>
    <integer name="input_max_length_small">4</integer>
    <integer name="input_max_length_medium">5</integer>
    <integer name="input_max_length_filesize">7</integer>

    <!-- Grid layout dimensions -->
    <integer name="grid_columns_small">3</integer>
    <integer name="grid_rows_medium">3</integer>

    <!-- S0473: statistics summary-card grid span. Cards take 1 cell each; in portrait two fit
         per row, landscape (values-land) widens to four so all summary cards sit on one row. -->
    <integer name="statistics_card_span">2</integer>

    <!-- SeekBar/ProgressBar ranges -->
    <integer name="seekbar_max_percent">100</integer>
    <integer name="seekbar_max_extended">200</integer>
    <integer name="seekbar_default_center">100</integer>
    <integer name="seekbar_default_half">50</integer>

    <!-- Default values for missing resources (lint fix) -->
    <integer name="grid_columns_main">1</integer>
    <integer name="grid_columns_gallery">2</integer>
    <integer name="grid_columns_images">1</integer>
    <integer name="max_visible_items">4</integer>
    <integer name="animation_duration_short">100</integer>
    <integer name="animation_duration_normal">200</integer>
    <integer name="animation_duration_long">300</integer>
    <integer name="scroll_threshold_dp">10</integer>
    <integer name="default_player_quality">720</integer>
    <integer name="min_player_quality">480</integer>
</resources>
