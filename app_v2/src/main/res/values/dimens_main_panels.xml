<?xml version="1.0" encoding="utf-8"?>
<!-- S0755 / S0756: main-window programs & streams panels. -->
<resources>
    <dimen name="main_panel_row_height">48dp</dimen>
    <dimen name="main_panel_item_min_width">48dp</dimen>
    <!-- S1049: resource tabs carry a text label (not just an icon), so each tab is two item-modules
         wide - owner decision, strategic §6. -->
    <dimen name="main_panel_tab_min_width">96dp</dimen>
    <dimen name="main_panel_item_spacing">2dp</dimen>
    <!-- S1037: shared leading X for the first working button of each top panel (programs items /
         streams channels / resource tabs) in portrait. A leading service control (programs panel
         menu, streams entry) occupies this zone without pushing the working content past the other
         panels' start, so the three rows read as one aligned grid regardless of device width. -->
    <dimen name="main_top_panel_leading_anchor">56dp</dimen>
    <dimen name="main_panel_favicon_size">28dp</dimen>
    <!-- Streams entry button: about one channel chip wide (landscape label mode; S0756). Portrait width
         is pinned to main_top_panel_leading_anchor by MainStreamsPanelManager (S1037). -->
    <dimen name="main_streams_entry_min_width">56dp</dimen>
    <dimen name="main_panel_fading_edge">24dp</dimen>
</resources>
