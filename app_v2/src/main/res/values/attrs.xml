<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Layout reference resolved at PlayerView inflate time for `app:controller_layout_id`.
      Default = compact baseline; overlay Theme.FastMediaSorter.LargePlayerControls swaps to the large variant.
      Driven by AppSettings.useCompactElements (true → compact, false → large) - applied via
      theme.applyStyle(...) in PlayerActivity.onCreate before super.onCreate (app restart required to flip).
    -->
    <attr name="customPlayerControlsLayout" format="reference" />

    <!-- Unified dialog action-button sizing (S0538). Default theme binds the large dimens; the
         ThemeOverlay.FastMediaSorter.CompactDialogButtons overlay (applied in BaseActivity when
         "Compact elements (global)" is on) rebinds them to the 50% compact dimens. -->
    <attr name="dialogActionButtonMinHeight" format="dimension|reference" />
    <attr name="dialogActionButtonGap" format="dimension|reference" />

    <!-- Consumed by CollapsibleSectionHeader.kt. All public attrs use the csh_ prefix. -->
    <declare-styleable name="CollapsibleSectionHeader">
        <attr name="csh_title" format="string|reference" />
        <attr name="csh_summary" format="string|reference" />
        <attr name="csh_expanded" format="boolean" />
        <attr name="csh_showHelp" format="boolean" />
        <attr name="csh_helpTitle" format="string|reference" />
        <attr name="csh_helpMessage" format="string|reference" />
        <attr name="csh_virtual" format="boolean" />
        <attr name="csh_chevronTint" format="color|reference" />
        <attr name="csh_titleTextColor" format="color|reference" />
        <attr name="csh_prefixTextColor" format="color|reference" />
        <attr name="csh_titleTextSize" format="dimension" />
        <attr name="csh_titleBold" format="boolean" />
        <attr name="csh_headerBackground" format="reference|color" />
        <attr name="csh_headerPaddingHorizontal" format="dimension" />
        <attr name="csh_headerPaddingVertical" format="dimension" />
        <attr name="csh_prefixPaddingEnd" format="dimension" />
    </declare-styleable>

    <!-- Consumed by SettingsToggleRow.kt. All public attrs use the str_ prefix. -->
    <declare-styleable name="SettingsToggleRow">
        <attr name="str_title" format="string|reference" />
        <attr name="str_subtitle" format="string|reference" />
        <attr name="str_showHelp" format="boolean" />
        <attr name="str_helpTitle" format="string|reference" />
        <attr name="str_helpMessage" format="string|reference" />
        <attr name="str_checked" format="boolean" />
    </declare-styleable>

    <!-- Consumed by SettingsSelectionRow.kt. All public attrs use the ssr_ prefix. -->
    <declare-styleable name="SettingsSelectionRow">
        <attr name="ssr_title" format="string|reference" />
        <attr name="ssr_value" format="string|reference" />
        <attr name="ssr_subtitle" format="string|reference" />
        <attr name="ssr_icon" format="reference" />
        <attr name="ssr_showHelp" format="boolean" />
        <attr name="ssr_helpTitle" format="string|reference" />
        <attr name="ssr_helpMessage" format="string|reference" />
        <attr name="ssr_showChevron" format="boolean" />
        <!-- Packs the chevron right after the value (text group hugs content) and drops the tall touch-target band, for dense landscape rows. Default false. -->
        <attr name="ssr_inline" format="boolean" />
        <!-- Navigation mode: trailing glyph becomes a real forward arrow instead of the value chevron and the content collapses to hug the left (arrow right after the text). For rows that open another screen/activity/dialog. Default false. -->
        <attr name="ssr_navMode" format="boolean" />
    </declare-styleable>

    <!-- Consumed by SettingsDropdownRow.kt. All public attrs use the sdr_ prefix. -->
    <declare-styleable name="SettingsDropdownRow">
        <attr name="sdr_title" format="string|reference" />
        <attr name="sdr_showHelp" format="boolean" />
        <attr name="sdr_helpTitle" format="string|reference" />
        <attr name="sdr_helpMessage" format="string|reference" />
        <attr name="sdr_entries" format="reference" />
        <!-- Renders the label inline to the left of the field on one line (dense landscape, S0618). Default false = stacked. -->
        <attr name="sdr_inline" format="boolean" />
        <!-- Caps the dropdown field to a fixed width instead of filling the row, for short-value selectors. Default unset = match_parent (stacked) / weight (inline). -->
        <attr name="sdr_fieldWidth" format="dimension|reference" />
        <!-- Caps the dropdown field max width while it still shrinks with the row (weighted columns). Default unset = uncapped. -->
        <attr name="sdr_fieldMaxWidth" format="dimension|reference" />
    </declare-styleable>

    <!-- Consumed by SettingsInputRow.kt. All public attrs use the sir_ prefix. -->
    <declare-styleable name="SettingsInputRow">
        <attr name="sir_title" format="string|reference" />
        <attr name="sir_hint" format="string|reference" />
        <attr name="sir_inputType" format="integer" />
        <attr name="sir_showHelp" format="boolean" />
        <attr name="sir_helpTitle" format="string|reference" />
        <attr name="sir_helpMessage" format="string|reference" />
        <attr name="sir_endIconMode">
            <enum name="none" value="0" />
            <enum name="clear_text" value="1" />
            <enum name="password_toggle" value="2" />
        </attr>
        <!-- Caps the input field max width while it still shrinks with the row (weighted columns). Default unset = uncapped. -->
        <attr name="sir_fieldMaxWidth" format="dimension|reference" />
    </declare-styleable>

    <!-- Consumed by FormFieldPairLayout.kt. All public attrs use the ffp_ prefix. -->
    <declare-styleable name="FormFieldPairLayout">
        <attr name="ffp_ratio">
            <enum name="one_one" value="0" />
            <enum name="two_one" value="1" />
        </attr>
        <attr name="ffp_stackThreshold" format="dimension" />
    </declare-styleable>

    <!-- Consumed by FormCheckboxRow.kt. All public attrs use the fcr_ prefix. -->
    <declare-styleable name="FormCheckboxRow">
        <attr name="fcr_title" format="string|reference" />
        <attr name="fcr_subtitle" format="string|reference" />
        <attr name="fcr_checked" format="boolean" />
        <attr name="fcr_showHelp" format="boolean" />
        <attr name="fcr_helpTitle" format="string|reference" />
        <attr name="fcr_helpMessage" format="string|reference" />
    </declare-styleable>

    <!-- Consumed by ActionHelpRow.kt. All public attrs use the ahr_ prefix. -->
    <declare-styleable name="ActionHelpRow">
        <attr name="ahr_buttonText" format="string|reference" />
        <attr name="ahr_buttonStyle" format="reference" />
        <attr name="ahr_showHelp" format="boolean" />
        <attr name="ahr_helpTitle" format="string|reference" />
        <attr name="ahr_helpMessage" format="string|reference" />
    </declare-styleable>
</resources>
