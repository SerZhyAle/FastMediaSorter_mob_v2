    <color name="crop_frame_red">#FFFF1744</color>

    <!-- ============================================================ -->
    <!-- CAMERA-OCR TRANSLATE (S0501: intentional dark surface) -->
    <!-- Viewfinder/result overlay stays dark in both light and dark
         system themes (no -night override), so controls remain legible
         over the live preview. Do not convert to ?attr/ theme tokens. -->
    <!-- ============================================================ -->
    <color name="camera_ocr_bg">#121214</color>
    <color name="camera_ocr_scrim">#99121214</color>
    <color name="camera_ocr_card_bg">#1D1D21</color>
    <color name="camera_ocr_stroke">#2F2F37</color>
    <color name="camera_ocr_stroke_save">#2F4F37</color>
    <color name="camera_ocr_text_primary">#E1E1E6</color>
    <color name="camera_ocr_text_emphasis">#FFFFFF</color>
    <color name="camera_ocr_text_secondary">#A1A1AA</color>
    <color name="camera_ocr_text_original">#C4C4CC</color>
    <color name="camera_ocr_accent_save">#4CAF50</color>

    <!-- ============================================================ -->
    <!-- IN-APP CAMERA CAPTURE (S0545: intentional dark surface) -->
    <!-- Controls overlay the live viewfinder, so the surface stays dark
         in both light and dark system themes (no -night override) to
         keep controls legible. Do not convert to ?attr/ theme tokens. -->
    <!-- ============================================================ -->
    <color name="camera_capture_surface">#101114</color>
    <!-- S0753: ~30% opacity (70% transparent, owner-chosen); legibility comes from the stroke + elevation
         shadow + outlined text, not the fill, so the controls can be this see-through. -->
    <color name="camera_capture_control_bg">#4D15171C</color>
    <color name="camera_capture_control_stroke">#B3FFFFFF</color>
    <color name="camera_capture_shutter_icon">#111318</color>
    <color name="camera_capture_focus_ring">#FFFFFFFF</color>
    <!-- S0753: drop shadow behind overlay text/chips so they read on a bright (white) scene. -->
    <color name="camera_capture_text_shadow">#CC000000</color>
    <!-- S1173: shared contour colour for OutlinedTextView/OutlinedImageView. Theme-independent on
         purpose - the contour has to hold against an arbitrary photo, not against a theme surface. -->
    <color name="outline_text_stroke">#CC000000</color>
    <!-- S0753: zoom-slider inactive track, semi-transparent white. -->
    <color name="camera_capture_slider_inactive">#66FFFFFF</color>
    <!-- S1189: zoom preset pills. The native bounds (the device's own optical minimum and maximum,
         before any software zoom) are amber so the user can see where real optics end. -->
    <color name="camera_capture_zoom_step">#FFFFFFFF</color>
    <color name="camera_capture_zoom_native_bound">#FFFFC107</color>

    <!-- S0473: statistics type-distribution chart swatches. Fixed accent colors (not theme attrs)
         so the five media-type segments stay visually distinct; legend always shows value text,
         so color is decorative, never the only differentiator (strategic §3.2). -->
    <color name="stats_type_image">#FF42A5F5</color>
    <color name="stats_type_video">#FFAB47BC</color>
    <color name="stats_type_audio">#FF26A69A</color>
    <color name="stats_type_document">#FFFFA726</color>
    <color name="stats_type_other">#FF8D9499</color>

    <!-- Resource media type colors (light theme) -->
    <color name="color_media_music">#FF00796B</color>     <!-- Teal 700 -->
    <color name="color_media_video">#FF7B1FA2</color>     <!-- Purple 700 -->
    <color name="color_media_image">#FF1976D2</color>     <!-- Blue 700 -->
    <color name="color_media_docs">#FFE65100</color>      <!-- Orange 900 -->
    <color name="color_media_other">#FF616161</color>     <!-- Grey 700 -->

    <!-- S0593: streams per-row play-status bullet. Distinct icon shapes carry the meaning too (not colour alone). -->
    <color name="stream_status_ok">#FF2E7D32</color>      <!-- Green 800 - last play succeeded -->
    <color name="stream_status_failed">#FFC62828</color>  <!-- Red 800 - last play failed -->
    <color name="stream_status_unknown">#FFF9A825</color> <!-- Amber 800 - not yet played -->

    <!-- S1426: permission row state indicator. Mid tones (600/700 level) so a single value stays
         legible on both the light and the dark surface the row sits on; the icon shapes carry the
         meaning as well, so these are reinforcement, not the only signal. -->
    <color name="perm_state_granted">#FF43A047</color>    <!-- Green 600 - permission is granted -->
    <color name="perm_state_missing">#FFFFA000</color>    <!-- Amber 700 - not granted yet -->
    <color name="perm_state_blocked">#FFE53935</color>    <!-- Red 600 - blocked in system settings -->

    <!-- S0701: translucent dark disc behind grid-tile overlays (status dot + overflow) so they stay
         legible on top of an arbitrary captured video frame or favicon. -->
    <color name="stream_grid_overlay_scrim">#99000000</color>
    <!-- S1062: red pill behind the grid-tile "Pinned" badge (top-left indicator). Deliberately a full
         red so the pinned state reads at a glance; a separate element from the bottom-left play-status dot. -->
    <color name="stream_pin_badge_bg">#FFC62828</color>
    <!-- S0997: splash-screen center content (app logo + wordmark) - dark on the light splash background, light in night mode. -->
    <color name="splash_content">#FF37474F</color>
    <!-- S1706: splash logo gradient, sampled from the lit and shaded faces of the launcher icon's
         arrows in mipmap-xxxhdpi/ic_launcher_adaptive_fore.png, so the splash shows the same blue
         the user tapped rather than a flat silhouette. -->
    <color name="splash_logo_gradient_start">#FF98CFF1</color>
    <color name="splash_logo_gradient_end">#FF0B82EB</color>
    <!-- S1706: splash slogan - deeper than the logo blue to stay readable on the light splash background. -->
    <color name="splash_slogan">#FF1565C0</color>

    <!-- S0404 / S1768 / S1895: launcher taskbar and Start-panel foregrounds, day half. Blue for
         Start and slate-blue for All Apps keep the two apart; the four row groups keep the hue
         separation S1770 introduced, since after the lift to 7:1 lightness no longer tells them
         apart. Every value here clears 7:1 against the surface it lands on in every theme -
         measured by scripts/quality/assert-launcher-contrast.ps1. -->
    <color name="launcher_taskbar_start_text">#FF0B3D91</color>
    <color name="launcher_taskbar_all_apps_text">#FF2F3E46</color>
    <color name="launcher_start_row_group1">#FF0D47A1</color>
    <color name="launcher_start_row_group2">#FF00504F</color>
    <color name="launcher_start_row_group3">#FF633B48</color>
    <color name="launcher_start_row_group4">#FF8C1D18</color>

    <!-- S1549: portrait keeps the pressed/focused accent of the shared player selector; the landscape
         scroll buttons are flat white (see values-land/values-w600dp). An alias rather than a copied
         selector, so the portrait state list stays defined in exactly one place. -->
    <item name="browse_scroll_button_tint" type="color">@color/selector_player_button_tint</item>
</resources>

