        <!-- S0611: complete M3 tonal role set so dialogs/menus/cards tint with the theme. -->
        <item name="colorSurfaceContainerLowest">@color/theme_dark_green_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/theme_dark_green_surface_container_low</item>
