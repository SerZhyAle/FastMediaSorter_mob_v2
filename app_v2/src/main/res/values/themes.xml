    </style>

    <!-- S1433: Network Monitor summary tiles. Factored into styles because the portrait and landscape grids
         differ only in column count and focus chain - everything else has to stay identical between them, and
         a shared style is the only version of "identical" that survives an edit to one file. -->
    <style name="Widget.FastMediaSorter.NetworkMonitor.Tile" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:layout_margin">@dimen/margin_small</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/network_monitor_tile_min_height</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation_low</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.TileContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/margin_medium</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.TileTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Status line is deliberately multi-line: the availability phrases are sentences, not badges, and
         truncating "No such hardware on this device" would cost the honesty criterion 2 asks for. -->
    <style name="Widget.FastMediaSorter.NetworkMonitor.TileStatus" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margin_small</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- S1433 subscreen furniture. Shared so a portrait layout and its landscape twin differ only in the
         arrangement of the blocks, never in how a block looks - and so six subscreens cannot drift apart. -->
    <style name="Widget.FastMediaSorter.NetworkMonitor.SectionHeading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_small</item>
        <item name="android:layout_marginTop">@dimen/margin_small</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/margin_small</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation_low</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/margin_medium</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margin_small</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.RowLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Values are end-aligned against start-aligned labels: the pairs read as two columns without a table,
         which a ScrollView of cards cannot give and a landscape split would otherwise break. -->
    <style name="Widget.FastMediaSorter.NetworkMonitor.RowValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.Note" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margin_small</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.ToggleRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.ToggleLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.FastMediaSorter.NetworkMonitor.Chart" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/network_monitor_chart_height</item>
        <item name="android:layout_marginTop">@dimen/margin_small</item>
    </style>

    <!--
      Theme overlay applied via theme.applyStyle() in PlayerActivity.onCreate (before super.onCreate)
      when AppSettings.useCompactElements == false. Swaps the player controls layout reference to the
      large variant; bar_height/touch_target/scrubber sizes are read by DefaultTimeBar at inflate only,
      so toggling the setting requires an app restart (handled via existing restart-prompt flow).
    -->
    <style name="Theme.FastMediaSorter.LargePlayerControls">
        <item name="customPlayerControlsLayout">@layout/custom_player_controls_large</item>
    </style>

    <!-- S0566: fully-circular clip for the in-app camera gallery thumbnail (ShapeableImageView). -->
    <style name="ShapeAppearanceOverlay.FastMediaSorter.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- S0619: wide, finger-friendly slider for the playback control dialog. Opt-in via style= on each
         VerticalSeekBar - deliberately NOT the app-wide seekBarStyle, so other screens stay unchanged. -->
    <style name="Widget.FMS.PlaybackSlider" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_playback_track</item>
        <item name="android:thumb">@drawable/seekbar_playback_thumb</item>
        <item name="android:maxHeight">@dimen/playback_slider_track_height</item>
        <item name="android:minHeight">@dimen/playback_slider_min_height</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <!-- S0753: camera overlay icon buttons - ~70% dark fill, visible stroke and an elevation shadow
         so they separate from any background (white or black scene). -->
    <style name="Widget.FastMediaSorter.Camera.OverlayButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/camera_capture_control_bg</item>
        <item name="strokeColor">@color/camera_capture_control_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- S0753: camera overlay text (mode tabs, recording timer) with a drop shadow so white text
         stays legible on a bright viewfinder. -->
    <style name="Widget.FastMediaSorter.Camera.OverlayText" parent="">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">@color/camera_capture_text_shadow</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <!-- S0753: zoom preset chips - white text + shadow over a ~70% dark fill and a visible stroke,
         so the pills read on any background. -->
    <style name="Widget.FastMediaSorter.Camera.ZoomChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">@color/camera_capture_text_shadow</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
        <item name="chipBackgroundColor">@color/camera_capture_control_bg</item>
        <item name="chipStrokeColor">@color/camera_capture_control_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
</resources>
