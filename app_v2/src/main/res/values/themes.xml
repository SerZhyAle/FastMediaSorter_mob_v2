        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- S0623: transparent host for AppLaunchPanelActivity. Reuses the shared translucent theme so the
         panel dialog floats over the foreground app instead of showing an opaque activity window. -->
    <style name="Theme.FMS.TransparentPanelHost" parent="Theme.FastMediaSorter.Transparent" />

