<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FastMediaSorter.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors - Blue for better contrast -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary colors - Teal accent -->
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background colors for light theme -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">#FF655E6A</item>
        <item name="android:textColorSecondary">#FF655E6A</item>
        <item name="colorOutline">#FF6F6875</item>
        <item name="colorOutlineVariant">#FF8A8391</item>
        
        <!-- Window background - white for day mode -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Disable preview on app launch - no icon/splash shown until app fully loads -->
        <item name="android:windowDisablePreview">true</item>

        <!-- Default player controls layout = compact (matches AppSettings.useCompactElements default true).
             Overridden by Theme.FastMediaSorter.LargePlayerControls applyStyle() when compact is OFF. -->
        <item name="customPlayerControlsLayout">@layout/custom_player_controls</item>

        <!-- S0538: dialog action-button sizing defaults to large; the CompactDialogButtons overlay
             rebinds these to the 50% compact dimens when "Compact elements (global)" is on. -->
        <item name="dialogActionButtonMinHeight">@dimen/dialog_action_button_min_height</item>
        <item name="dialogActionButtonGap">@dimen/dialog_action_button_gap</item>

        <!-- S0538: builder dialogs inherit the unified confirm/cancel pair via this seam. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FastMediaSorter.MaterialAlertDialog</item>

        <!-- S0536: every MaterialSwitch left outside SettingsToggleRow inherits one canonical look. -->
        <item name="materialSwitchStyle">@style/Widget.FastMediaSorter.Switch</item>
    </style>

    <!-- S0538: applied via theme.applyStyle() in BaseActivity when compact mode is on. -->
    <style name="ThemeOverlay.FastMediaSorter.CompactDialogButtons" parent="">
        <item name="dialogActionButtonMinHeight">@dimen/dialog_action_button_min_height_compact</item>
        <item name="dialogActionButtonGap">@dimen/dialog_action_button_gap_compact</item>
    </style>

