    <!-- Unified Material3 button taxonomy: one named style per semantic role, so the same role looks identical everywhere.
         Pick by role, never reintroduce a plain <Button> or a one-off style. Role -> style mapping and exemptions:
         docs/ARCHITECTURE.md "Button Taxonomy (MANDATORY)". Filled=primary, Tonal=secondary emphasis, Outlined=secondary, Text=cancel/low-emphasis, Icon=icon-only. -->
    <style name="Widget.FastMediaSorter.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:letterSpacing">0</item>
