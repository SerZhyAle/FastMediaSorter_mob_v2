<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FastMediaSorter.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors - Blue for better contrast -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary colors - Teal accent -->
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background colors for light theme -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">#FF655E6A</item>
        <item name="android:textColorSecondary">#FF655E6A</item>
        <item name="colorOutline">#FF6F6875</item>
        <item name="colorOutlineVariant">#FF8A8391</item>
        
        <!-- Window background - white for day mode -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Disable preview on app launch - no icon/splash shown until app fully loads -->
        <item name="android:windowDisablePreview">true</item>

        <!-- Default player controls layout = compact (matches AppSettings.useCompactElements default true).
             Overridden by Theme.FastMediaSorter.LargePlayerControls applyStyle() when compact is OFF. -->
        <item name="customPlayerControlsLayout">@layout/custom_player_controls</item>
    </style>

    <!-- System bar transparency is applied programmatically via enableEdgeToEdge() in BaseActivity. -->
    <style name="Theme.FastMediaSorter.Base" parent="Theme.FastMediaSorter.App" />

    <style name="Theme.FastMediaSorter" parent="Theme.FastMediaSorter.Base" />

    <style name="Theme.FastMediaSorter.FullScreen" parent="Theme.FastMediaSorter">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.FastMediaSorter.NoActionBar" parent="Theme.FastMediaSorter">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Used by ReceiveShareActivity: renders only the dialog, not the activity window itself -->
    <style name="Theme.FastMediaSorter.Transparent" parent="Theme.FastMediaSorter">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Text Appearance for helper text: 2sp smaller than normal (14sp) -->
    <style name="TextAppearance.FastMediaSorter.HelperText" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.FastMediaSorter.SettingsTabConnected" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.OutlinedIcon" parent="Widget.MaterialComponents.Button.OutlinedButton.Icon">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.TextIcon" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.TextM3" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.SettingsButton.OutlinedM3" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/toggler_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/calculator_button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.DigitButton" parent="Widget.FastMediaSorter.Calculator.Button">
        <item name="backgroundTint">@color/item_alternate</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.OperatorButton" parent="Widget.FastMediaSorter.Calculator.Button">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.PlusButton" parent="Widget.FastMediaSorter.Calculator.Button">
        <item name="android:textColor">@color/calculator_plus_button_text</item>
        <item name="android:textSize">@dimen/calculator_plus_button_text_size</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.MemoryButton" parent="Widget.FastMediaSorter.Calculator.Button">
        <item name="android:textSize">@dimen/calculator_memory_button_text_size</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.ClearButton" parent="Widget.FastMediaSorter.Calculator.Button">
        <item name="backgroundTint">@color/calculator_clear_button_bg</item>
        <item name="strokeColor">@color/delete_button</item>
        <item name="android:textColor">@color/delete_button</item>
    </style>

    <style name="Widget.FastMediaSorter.Calculator.EqualsButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/calculator_button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <!--
      Theme overlay applied via theme.applyStyle() in PlayerActivity.onCreate (before super.onCreate)
      when AppSettings.useCompactElements == false. Swaps the player controls layout reference to the
      large variant; bar_height/touch_target/scrubber sizes are read by DefaultTimeBar at inflate only,
      so toggling the setting requires an app restart (handled via existing restart-prompt flow).
    -->
    <style name="Theme.FastMediaSorter.LargePlayerControls">
        <item name="customPlayerControlsLayout">@layout/custom_player_controls_large</item>
    </style>
</resources>
