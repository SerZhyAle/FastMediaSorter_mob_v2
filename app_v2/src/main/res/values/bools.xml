<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="debug_version_overlay_enabled">false</bool>
    <bool name="is_tab_inline">false</bool>
    <!-- S3538: a portrait phone card has no room for the five inline shortcuts beside the title, so
         below 600 dp in portrait (360 dp and 411 dp alike) Edit/Copy/Move/Delete are reached only
         through the always-present overflow (S2644). values-land, values-w600dp and values-sw600dp
         turn the shortcut row on; the S0160 setting hides it everywhere. A test that taps btnEdit
         must therefore go through "more_options:<resource>" on a portrait phone. -->
    <bool name="is_resource_actions_inline">false</bool>
    <!-- S0755: programs panel shows labels strictly by orientation (portrait = icons only). -->
    <bool name="main_programs_panel_show_labels">false</bool>
    <!-- S0756: streams panel shows channel labels by available window width (compact = thumbnail only). -->
    <bool name="main_streams_panel_show_labels">false</bool>
    <!-- S1049: portrait resource tabs use a fixed two-item-module width (main_panel_tab_min_width),
         left-aligned, instead of stretching to fill the row. -->
    <bool name="main_resource_tabs_fixed_grid">true</bool>
    <!-- S1549: the landscape control bar centres its children vertically; portrait leaves the
         LinearLayout default. MainActivity absorbs the rotation, so the row's gravity is set from
         this key instead of from android:gravity in the layout. -->
    <bool name="main_cmd_bar_center_vertical">false</bool>
</resources>
