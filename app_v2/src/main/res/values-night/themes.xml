<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FastMediaSorter.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors - same blue_500 as light theme; colorOnPrimary=white for contrast on #1976D2 -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors - Lighter teal accent -->
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background colors for dark theme -->
        <item name="android:colorBackground">@color/item_normal</item>
        <item name="colorSurface">@color/item_normal</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- S1895: defined by the app rather than inherited from the M3 baseline palette. -->
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorError">@color/m3_error</item>

        <!-- S1895: launcher foregrounds. Same order as the day block so the two read side by side. -->
        <item name="launcherTaskbarStartText">@color/launcher_taskbar_start_text</item>
        <item name="launcherTaskbarAllAppsText">@color/launcher_taskbar_all_apps_text</item>
        <item name="launcherStartRowGroup1">@color/launcher_start_row_group1</item>
        <item name="launcherStartRowGroup2">@color/launcher_start_row_group2</item>
        <item name="launcherStartRowGroup3">@color/launcher_start_row_group3</item>
        <item name="launcherStartRowGroup4">@color/launcher_start_row_group4</item>
        <!-- S2539: launcher desktop foregrounds for night mode. -->
        <item name="launcherDesktopText">@color/white</item>
        <item name="launcherDesktopTextSecondary">#FFCAC4D0</item>
        <item name="colorOnSurfaceVariant">#FFCAC4D0</item>
        <item name="android:textColorSecondary">@color/text_color_secondary</item>
        <item name="colorOutline">#FF938F99</item>
        <item name="colorOutlineVariant">@color/m3_surface_variant</item>

        <!-- Window background - dark for night mode -->
        <item name="android:windowBackground">@color/item_normal</item>
        <!-- Disable preview on app launch - no icon/splash shown until app fully loads -->
        <item name="android:windowDisablePreview">true</item>

        <!-- See values/themes.xml - overridden by Theme.FastMediaSorter.LargePlayerControls when compact is OFF. -->
        <item name="customPlayerControlsLayout">@layout/custom_player_controls</item>

        <!-- S2179: day theme (values/themes.xml) defines this seam item; the night variant is a
             separate resource, not a merge, so it was silently missing here. Without it every plain
             MaterialAlertDialogBuilder(context) call (no per-dialog override style) falls back to the
             stock M3 alert dialog in dark mode, losing the DialogConfirm/DialogCancel pair entirely. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FastMediaSorter.MaterialAlertDialog</item>
        <item name="materialSwitchStyle">@style/Widget.FastMediaSorter.Switch</item>
    </style>

    <!-- Pre-35 transparent bars. enableEdgeToEdge() sets these at runtime, but release R8 strips
         Window.setStatusBarColor/setNavigationBarColor (Play Android-15 deprecated-API check), so
         the theme must supply transparency. API 35 omits these (system-enforced) via values-night-v35. -->
    <style name="Theme.FastMediaSorter.Base" parent="Theme.FastMediaSorter.App">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FastMediaSorter" parent="Theme.FastMediaSorter.Base" />

    <style name="Theme.FastMediaSorter.FullScreen" parent="Theme.FastMediaSorter">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.FastMediaSorter.NoActionBar" parent="Theme.FastMediaSorter">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
