<?xml version="1.0" encoding="utf-8"?>
<!-- Preview layout for the Camera Photos widget shown in the Android widget picker.
     Shows a photo/image icon that communicates "camera roll" browsing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:gravity="center">

    <!-- Stack of two overlapping image icons to suggest a photo gallery -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_image"
            app:tint="#88FFFFFF"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|start"
            android:src="@drawable/ic_image"
            app:tint="@color/white"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_camera_photos_label"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
