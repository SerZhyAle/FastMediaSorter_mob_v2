<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UselessParent">

    <LinearLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/activity_player_unified_toolbar_background"
        android:orientation="vertical"
        android:padding="@dimen/player_controls_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_overlay_on_primary"
                android:textSize="@dimen/player_position_text_size"
                android:includeFontPadding="false" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="@dimen/player_progress_height"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/player_progress_margin_horizontal"
                app:played_color="@color/player_overlay_on_primary"
                app:scrubber_color="@color/player_overlay_on_primary"
                app:buffered_color="@color/player_overlay_on_primary_translucent"
                app:unplayed_color="@color/custom_player_controls_exo_bottom_bar_unplayed_color" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_overlay_on_primary"
                android:textSize="@dimen/player_position_text_size"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exoPlayerButtonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- S0819: transport buttons are D-pad focusable with the S0289 stroke selector; nextFocus
                 chain is a single-row wrap-around (btnPictureInPicture stays gone, excluded from it). -->
            <ImageButton
                android:id="@+id/exo_repeat"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_small_button_size"
                android:layout_height="@dimen/player_small_button_size"
                android:src="@drawable/ic_loop_list"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/playback_order_menu_title"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/btnPlaybackControl"
                android:nextFocusRight="@id/exo_prev_file"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/exo_prev_file"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_medium_button_size"
                android:layout_height="@dimen/player_medium_button_size"
                android:layout_marginStart="@dimen/player_group_separator_margin"
                android:src="@drawable/ic_back"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/previous_file"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/exo_repeat"
                android:nextFocusRight="@id/btnRewind10"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btnRewind10"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_small_button_size"
                android:layout_height="@dimen/player_small_button_size"
                android:layout_marginStart="@dimen/player_button_margin_start"
                android:src="@drawable/ic_fast_rewind"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/rewind_10_seconds"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/exo_prev_file"
                android:nextFocusRight="@id/exo_play_pause"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_large_button_size"
                android:layout_height="@dimen/player_large_button_size"
                android:layout_marginHorizontal="@dimen/player_play_button_margin_horizontal"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/play_pause"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/btnRewind10"
                android:nextFocusRight="@id/btnForward30"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btnForward30"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_small_button_size"
                android:layout_height="@dimen/player_small_button_size"
                android:src="@drawable/ic_fast_forward"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/forward_10_seconds"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/exo_play_pause"
                android:nextFocusRight="@id/exo_next_file"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/exo_next_file"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="96dp"
                android:layout_height="@dimen/player_medium_button_size"
                android:src="@drawable/ic_next_circle_selector"
                android:scaleType="centerInside"
                android:contentDescription="@string/next_file"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/btnForward30"
                android:nextFocusRight="@id/btnPlaybackControl"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btnPlaybackControl"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_small_button_size"
                android:layout_height="@dimen/player_small_button_size"
                android:layout_marginStart="@dimen/player_group_separator_margin"
                android:src="@drawable/ic_settings"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/control"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:nextFocusLeft="@id/exo_next_file"
                android:nextFocusRight="@id/exo_repeat"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btnPictureInPicture"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_small_button_size"
                android:layout_height="@dimen/player_small_button_size"
                android:layout_marginStart="@dimen/player_button_margin_start"
                android:src="@drawable/ic_picture_in_picture"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/picture_in_picture"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- S1114: VR entry in the transport row (reachable in fullscreen). Shown only when the
                 host reports VR entry available (XR device + 3D/VR master toggle + video). -->
            <ImageButton
                android:id="@+id/btnVrLaunch"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/player_small_button_size"
                android:layout_height="@dimen/player_small_button_size"
                android:layout_marginStart="@dimen/player_button_margin_start"
                android:src="@drawable/ic_vr_headset"
                app:tint="@color/selector_player_overlay_button_tint"
                android:contentDescription="@string/action_open_in_vr_cinema"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_button_background"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

