<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="@dimen/item_divider_height" app:cardCornerRadius="@dimen/margin_tiny" app:cardElevation="@dimen/card_elevation_low">

    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/padding_tiny">

        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

        <EditText android:id="@+id/etName" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_small" android:hint="@string/resource_name" android:inputType="text" android:importantForAutofill="no" android:textSize="@dimen/item_title_text_size" android:textStyle="bold" android:background="@null" android:singleLine="true" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/cbAdd" app:layout_constraintTop_toTopOf="parent" tools:text="Downloads" />

        <TextView android:id="@+id/tvPath" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="@dimen/item_detail_text_size" android:textColor="?attr/colorOnSurfaceVariant" android:maxLines="1" android:includeFontPadding="true" android:ellipsize="end" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@+id/etName" app:layout_constraintTop_toBottomOf="@+id/etName" tools:text="/storage/emulated/0/Download" />

        <TextView android:id="@+id/tvFileCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="@dimen/item_detail_text_size" android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintStart_toStartOf="@+id/etName" app:layout_constraintTop_toBottomOf="@+id/tvPath" tools:text="25 files" />

        <LinearLayout android:id="@+id/layoutMediaTypes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_large" android:orientation="horizontal" app:layout_constraintStart_toEndOf="@+id/tvFileCount" app:layout_constraintTop_toTopOf="@+id/tvFileCount" app:layout_constraintBottom_toBottomOf="@+id/tvFileCount">

            <TextView android:id="@+id/btnTypeImage" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypeImage_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/btnTypeVideo" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypeVideo_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnTypeAudio" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypeAudio_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnTypeGif" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypeGif_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnTypeText" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypeText_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnTypePdf" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypePdf_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnTypeOffice" android:layout_width="@dimen/item_status_badge_size" android:layout_height="@dimen/item_status_badge_size" android:gravity="center" android:text="@string/item_resource_to_add_btnTypeOffice_text" android:textSize="@dimen/item_detail_text_size" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutCheckboxRow1" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:baselineAligned="false" android:orientation="horizontal" app:layout_constraintStart_toStartOf="@+id/etName" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@+id/tvFileCount">

            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbDestination" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/register_as_destination" android:textSize="@dimen/item_detail_text_size" />

            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbReadOnly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="false" android:text="@string/read_only_mode" android:textSize="@dimen/item_detail_text_size" />

        </LinearLayout>

        <LinearLayout android:id="@+id/layoutCheckboxRow2" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:baselineAligned="false" android:orientation="horizontal" app:layout_constraintStart_toStartOf="@+id/etName" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@+id/layoutCheckboxRow1">

            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbScanSubdirectories" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="@string/scan_subdirectories" android:textSize="@dimen/item_detail_text_size" />

            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbAllFiles" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="false" android:text="@string/all_files" android:textSize="@dimen/item_detail_text_size" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
