<?xml version="1.0" encoding="utf-8"?>
<!-- S0774 rework: compact, non-modal recording indicator (screen video recording + voice capture) -
     replaces the previous full-screen modal AlertDialog card, which blocked the recorded content.
     Orientation-agnostic (fixed corner pill) - no layout-land counterpart needed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recordingIndicatorRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_camera_timer"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/recording_indicator_dot" />

    <TextView
        android:id="@+id/recordingIndicatorTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/recording_active_tint"
        android:textSize="14sp"
        tools:ignore="HardcodedText"
        tools:text="00:05" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recordingIndicatorPauseResume"
        style="@style/Widget.FastMediaSorter.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        app:icon="@drawable/ic_pause" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recordingIndicatorStop"
        style="@style/Widget.FastMediaSorter.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        app:icon="@drawable/ic_stop" />

    <!-- S0774 rework: discard-without-saving - only shown by callers that offer it (voice capture);
         gone by default (screen recording has no such action, matching its own strategic scope). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/recordingIndicatorCancel"
        style="@style/Widget.FastMediaSorter.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:visibility="gone"
        app:icon="@drawable/ic_delete"
        tools:visibility="visible" />

</LinearLayout>
