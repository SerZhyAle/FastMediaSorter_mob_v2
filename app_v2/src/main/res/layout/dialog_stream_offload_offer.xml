<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/offloadTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offload_dialog_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:id="@+id/offloadFileSizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offloadSpeedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offloadEtaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offloadFreeSpaceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offloadDestinationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="13sp"
        android:alpha="0.7" />

    <TextView
        android:id="@+id/offloadInsufficientStorageHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/offload_insufficient_storage"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/offloadDownloadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/offload_action_download" />

    <Button
        android:id="@+id/offloadTryAnywayButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/offload_action_try_anyway" />

    <Button
        android:id="@+id/offloadCancelButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offload_action_cancel" />

</LinearLayout>
