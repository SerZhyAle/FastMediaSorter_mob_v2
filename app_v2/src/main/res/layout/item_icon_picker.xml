<?xml version="1.0" encoding="utf-8"?>
<!-- item_icon_picker.xml — single icon cell in the picker grid (S0034 Phase 06).
     56dp square frame: centred icon ImageView + selection-ring overlay (gone by default). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/icon_picker_item_size"
    android:layout_height="@dimen/icon_picker_item_size"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:padding="@dimen/icon_picker_item_padding"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Selection highlight ring — visible only for the currently-selected icon -->
    <View
        android:id="@+id/vSelected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_icon_picker_selected"
        android:visibility="gone" />

</FrameLayout>
