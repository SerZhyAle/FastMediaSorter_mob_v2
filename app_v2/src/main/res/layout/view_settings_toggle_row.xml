<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for SettingsToggleRow compound view.
  Canonical pattern: switch (leftmost) + text group (title + helper inline, subtitle below) + optional trailing slot.
  See docs/ARCHITECTURE.md § "UI Patterns - Trigger Row" (Pattern A).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/str_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/settings_switch_margin_end"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/str_textGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title line: title + helper inline (helper sits next to the title, NOT at the right edge of the row). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/str_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/toggler_title_text_size" />

            <ImageButton
                android:id="@+id/str_iconHelp"
                android:layout_width="@dimen/settings_help_icon_size"
                android:layout_height="@dimen/settings_help_icon_size"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription=""
                android:focusable="true"
                android:src="@drawable/ic_help_outline_24"
                android:tint="@color/text_color_secondary"
                android:visibility="gone" />

            <!-- Spacer fills remaining width so the helper sits next to the title, not pushed right.
                 Identified so setHugsTextContent() can collapse it when the row must wrap its label. -->
            <View
                android:id="@+id/str_titleLineSpacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/str_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color_secondary"
            android:textSize="@dimen/toggler_desc_text_size"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Optional trailing action slot for the rare row that needs a secondary action. Hidden by default. -->
    <FrameLayout
        android:id="@+id/str_trailingSlot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:visibility="gone" />

</merge>
