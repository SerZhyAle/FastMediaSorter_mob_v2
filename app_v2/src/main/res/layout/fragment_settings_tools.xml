<?xml version="1.0" encoding="utf-8"?>
<!-- S4622: the Tools page - settings that used to be edited inside the translation overlay, the OCR camera,
     the calculator and the stopwatch (SETTINGS-NAVIGATION 2.1 item A). Every row commits at once; the hosts
     keep only a command that opens this page at their group. Same ids as layout-land/. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:descendantFocusability="afterDescendants">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="@dimen/margin_small" android:paddingBottom="@dimen/settings_fragment_padding" android:clipToPadding="false">

        <!-- GROUP: Translation. Hidden as a whole card when the build has no translation capability. -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardToolsTranslation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader android:id="@+id/headerToolsTranslation" android:layout_width="match_parent" android:layout_height="wrap_content" app:csh_icon="@drawable/ic_translate" app:csh_showHelp="false" app:csh_title="@string/settings_tools_group_translation" />

                <LinearLayout android:id="@+id/containerToolsTranslation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_small">

                    <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow android:id="@+id/rowTranslationSourceLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:ssr_showChevron="true" app:ssr_title="@string/translation_source_language_and_ocr" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow android:id="@+id/rowTranslationTargetLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_tiny" app:ssr_showChevron="true" app:ssr_title="@string/translation_target_language" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTranslationSwapLanguages" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:text="@string/swap_languages" app:icon="@drawable/ic_swap_horizontal" app:iconGravity="start" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow android:id="@+id/rowTranslationLensStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:str_title="@string/translation_lens_style" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow android:id="@+id/rowTranslationFontSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:sdr_fieldWidth="@dimen/settings_dropdown_compact_width" app:sdr_title="@string/translation_font_size" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow android:id="@+id/rowTranslationFontFamily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:sdr_fieldWidth="@dimen/settings_dropdown_compact_width" app:sdr_title="@string/translation_font_family" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow android:id="@+id/rowCameraOcrOnly" android:layout_width="match_parent" android:layout_height="wrap_content" app:str_subtitle="@string/setting_camera_ocr_only_desc" app:str_title="@string/setting_camera_ocr_only_title" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GROUP: Calculator. -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" android:layout_marginTop="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader android:id="@+id/headerToolsCalculator" android:layout_width="match_parent" android:layout_height="wrap_content" app:csh_icon="@drawable/ic_calculator" app:csh_showHelp="false" app:csh_title="@string/settings_tools_group_calculator" />

                <LinearLayout android:id="@+id/containerToolsCalculator" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_small">

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow android:id="@+id/rowCalculatorGroupThousands" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:str_subtitle="@string/calculator_settings_group_thousands_summary" app:str_title="@string/calculator_settings_group_thousands" />

                    <TextView android:id="@+id/labelCalculatorTextSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calculator_settings_text_size" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.slider.Slider android:id="@+id/sliderCalculatorTextSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:contentDescription="@string/calculator_settings_text_size" android:stepSize="2" android:valueFrom="16" android:valueTo="72" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow android:id="@+id/rowCalculatorKeypadMode" android:layout_width="match_parent" android:layout_height="wrap_content" app:sdr_fieldWidth="@dimen/settings_dropdown_compact_width" app:sdr_title="@string/calculator_settings_keypad_mode" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GROUP: Stopwatch. -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" android:layout_marginTop="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader android:id="@+id/headerToolsStopwatch" android:layout_width="match_parent" android:layout_height="wrap_content" app:csh_icon="@drawable/ic_stopwatch" app:csh_showHelp="false" app:csh_title="@string/settings_tools_group_stopwatch" />

                <LinearLayout android:id="@+id/containerToolsStopwatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_small">

                    <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow android:id="@+id/rowStopwatchParticipants" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:sdr_inline="true" app:sdr_title="@string/stopwatch_settings_participants" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow android:id="@+id/rowStopwatchMusic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:str_subtitle="@string/stopwatch_settings_music_summary" app:str_title="@string/stopwatch_settings_music" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow android:id="@+id/rowStopwatchTrack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" app:ssr_showChevron="true" app:ssr_title="@string/stopwatch_settings_track" app:ssr_value="@string/stopwatch_settings_track_none" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow android:id="@+id/rowStopwatchVolumeKeys" android:layout_width="match_parent" android:layout_height="wrap_content" app:str_subtitle="@string/stopwatch_settings_volume_keys_summary" app:str_title="@string/stopwatch_settings_volume_keys" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
