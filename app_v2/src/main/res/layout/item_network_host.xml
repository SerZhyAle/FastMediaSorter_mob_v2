<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    android:layout_marginHorizontal="@dimen/margin_tiny"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/item_padding_vertical"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/item_network_icon_size"
            android:layout_height="@dimen/item_network_icon_size"
            android:src="@drawable/ic_resource_smb"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="@dimen/dialog_button_spacing" />

        <LinearLayout
            android:layout_width="@dimen/match_constraint"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHostname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="DESKTOP-ABC1234"
                android:textStyle="bold"
                android:textSize="@dimen/item_title_text_size" />

            <TextView
                android:id="@+id/tvIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="192.168.1.105"
                android:textSize="@dimen/item_subtitle_text_size"
                android:textColor="?android:textColorSecondary" />

            <TextView
                android:id="@+id/tvServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="SMB, SFTP"
                android:textSize="@dimen/item_detail_text_size"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="@dimen/margin_tiny" />

        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/item_status_badge_size"
            android:layout_height="@dimen/item_status_badge_size"
            android:src="@drawable/ic_arrow_forward"
            app:tint="?android:textColorSecondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
