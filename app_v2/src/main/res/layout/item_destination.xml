<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    app:cardElevation="@dimen/card_elevation"
    app:cardCornerRadius="@dimen/card_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_small"
        android:minHeight="@dimen/button_height_small">

        <View
            android:id="@+id/viewColorIndicator"
            android:layout_width="@dimen/indicator_width"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            tools:background="#FF5722"/>

        <LinearLayout
            android:layout_width="@dimen/match_constraint"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDestinationNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_large"
                    android:layout_marginEnd="@dimen/margin_small"
                    tools:text="1"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDestinationName"
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Family Photos"/>

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvDestinationPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textSize="@dimen/item_detail_text_size"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/margin_minimal"
                tools:text="/storage/emulated/0/Pictures/Family"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveUp"
                android:layout_width="@dimen/item_icon_size_medium"
                android:layout_height="@dimen/item_icon_size_medium"
                android:layout_marginEnd="@dimen/margin_tiny"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@android:drawable/arrow_up_float"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                style="@style/Widget.Material3.Button.IconButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveDown"
                android:layout_width="@dimen/item_icon_size_medium"
                android:layout_height="@dimen/item_icon_size_medium"
                android:layout_marginEnd="@dimen/margin_tiny"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@android:drawable/arrow_down_float"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                style="@style/Widget.Material3.Button.IconButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="@dimen/item_icon_size_medium"
                android:layout_height="@dimen/item_icon_size_medium"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorError"
                style="@style/Widget.Material3.Button.IconButton"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
