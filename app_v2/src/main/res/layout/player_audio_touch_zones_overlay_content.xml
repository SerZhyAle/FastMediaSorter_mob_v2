<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/audioTouchZonesOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="@integer/grid_columns_small"
    android:rowCount="@integer/grid_rows_medium"
    android:visibility="gone">

    <TextView
        android:id="@+id/zoneBack"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_back"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background" />

    <TextView
        android:id="@+id/zoneCopy"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_copy"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background"
        android:layout_marginStart="@dimen/activity_player_unified_zoneMove_layout_marginStart"
        android:layout_marginEnd="@dimen/touch_zones_overlay_zoneDelete_layout_marginEnd" />

    <TextView
        android:id="@+id/zoneRename"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_rename"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background" />

    <TextView
        android:id="@+id/zonePrevious"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_previous"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background"
        android:layout_marginTop="@dimen/touch_zones_overlay_zoneNext_layout_marginTop"
        android:layout_marginBottom="@dimen/activity_player_unified_zonePrevious_layout_marginBottom" />

    <TextView
        android:id="@+id/zoneMove"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_move"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background"
        android:layout_marginStart="@dimen/activity_player_unified_zoneMove_layout_marginStart"
        android:layout_marginEnd="@dimen/touch_zones_overlay_zoneDelete_layout_marginEnd"
        android:layout_marginTop="@dimen/touch_zones_overlay_zoneNext_layout_marginTop"
        android:layout_marginBottom="@dimen/activity_player_unified_zonePrevious_layout_marginBottom" />

    <TextView
        android:id="@+id/zoneNext"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_next"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background"
        android:layout_marginTop="@dimen/touch_zones_overlay_zoneNext_layout_marginTop"
        android:layout_marginBottom="@dimen/activity_player_unified_zonePrevious_layout_marginBottom" />

    <TextView
        android:id="@+id/zoneCommandPanel"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_command_panel"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background" />

    <TextView
        android:id="@+id/zoneDelete"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_delete"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background"
        android:layout_marginStart="@dimen/activity_player_unified_zoneMove_layout_marginStart"
        android:layout_marginEnd="@dimen/touch_zones_overlay_zoneDelete_layout_marginEnd" />

    <TextView
        android:id="@+id/zoneSlideshow"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_queue"
        android:textColor="@color/activity_player_unified_zoneCommandPanel_textColor"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="@color/activity_player_unified_zoneBack_background" />
</GridLayout>


