<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding_large">

    <!-- Warning Title -->
    <TextView
        android:id="@+id/tvWarningTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_action_cannot_be_undone_title"
        android:textColor="?attr/colorError"
        android:textSize="@dimen/text_size_title_dialog"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_large" />

    <!-- Subtitle (Delete N files from network?) -->
    <TextView
        android:id="@+id/tvDeleteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_normal"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Files List -->
    <TextView
        android:id="@+id/tvFilesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="@dimen/margin_small" />

    <!-- +N more files -->
    <TextView
        android:id="@+id/tvMoreFilesCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Resource info wrapper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_large">

        <ImageView
            android:layout_width="@dimen/icon_size_button"
            android:layout_height="@dimen/icon_size_button"
            android:layout_marginEnd="@dimen/margin_normal"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_resource_smb"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvResourceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_small"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Warning Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorErrorContainer"
        android:padding="@dimen/padding_normal"
        android:layout_marginBottom="@dimen/margin_large">

        <ImageView
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_marginEnd="@dimen/margin_medium"
            android:src="@drawable/ic_cancel"
            app:tint="?attr/colorError" />

        <TextView
            android:id="@+id/tvWarningBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/network_delete_warning"
            android:textColor="?attr/colorOnErrorContainer"
            android:textSize="@dimen/text_size_small" />
    </LinearLayout>

    <!-- Don't show again checkbox -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDontShowAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small" />

</LinearLayout>
