<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_padding">

        <!-- Text + PDF Row Container -->
        <LinearLayout
            android:id="@+id/containerTextPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Support Text (vertical container for Text + line numbers) -->
            <LinearLayout
                android:id="@+id/layoutSupportText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/resource_field_margin_end"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Support Text switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height"
                    android:orientation="horizontal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSupportText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_text_description"
                            android:textSize="@dimen/toggler_title_text_size" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_support_text_desc"
                            android:textSize="@dimen/toggler_desc_text_size"
                            android:textColor="@color/text_color_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Show Text Line Numbers (nested under Support Text) -->
                <LinearLayout
                    android:id="@+id/layoutShowTextLineNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_nested_margin_start"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowTextLineNumbers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/show_text_line_numbers"
                            android:textSize="@dimen/toggler_title_text_size" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_show_text_line_numbers_desc"
                            android:textSize="@dimen/toggler_desc_text_size"
                            android:textColor="@color/text_color_secondary" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/iconHelpLineNumbers"
                        android:layout_width="@dimen/settings_help_icon_size"
                        android:layout_height="@dimen/settings_help_icon_size"
                        android:layout_marginStart="@dimen/settings_help_icon_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tooltip_line_numbers_title"
                        android:src="@drawable/ic_help_outline_24"
                        app:tint="@color/text_color_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Support PDF (vertical container for PDF + thumbnails) -->
            <LinearLayout
                android:id="@+id/layoutSupportPdf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Support PDF switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height"
                    android:orientation="horizontal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSupportPdf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_pdf_description"
                        android:textSize="@dimen/toggler_title_text_size" />
                </LinearLayout>

                <!-- Show PDF Thumbnails (nested under Support PDF) -->
                <LinearLayout
                    android:id="@+id/layoutShowPdfThumbnails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_nested_margin_start"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowPdfThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_pdf_thumbnails"
                        android:textSize="@dimen/toggler_title_text_size" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- EPUB Support Row -->
        <LinearLayout
            android:id="@+id/layoutSupportEpub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/button_height"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSupportEpub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/settings_switch_margin_end" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/support_epub_description"
                android:textSize="@dimen/toggler_title_text_size" />
        </LinearLayout>

    <Button
        android:id="@+id/btnSetDefaultDocsViewer"
        style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/settings_set_default_docs_viewer"
        android:textAllCaps="false" />

</LinearLayout>

