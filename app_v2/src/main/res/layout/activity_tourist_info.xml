<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/touristRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorControlNormal"
        app:title="@string/tourist_info_title" />

    <!-- Hero Focus Tile Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeroTile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_normal"
        android:layout_marginEnd="@dimen/margin_normal"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_medium"
        app:cardCornerRadius="@dimen/tourist_card_corner_radius"
        app:cardElevation="@dimen/tourist_card_elevation"
        app:strokeWidth="@dimen/tourist_card_stroke_width"
        app:strokeColor="?attr/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeroIcon"
                    android:layout_width="@dimen/tourist_hero_icon_size"
                    android:layout_height="@dimen/tourist_hero_icon_size"
                    android:contentDescription="@null"
                    app:tint="?attr/colorPrimary"
                    tools:src="@drawable/ic_speed" />

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    tools:text="Speed" />

                <ImageButton
                    android:id="@+id/btnHeroReset"
                    android:layout_width="@dimen/control_button_size_compact"
                    android:layout_height="@dimen/control_button_size_compact"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tourist_action_reset_tile"
                    android:src="@drawable/ic_refresh"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary"
                    tools:visibility="visible" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal"
                android:layout_marginBottom="@dimen/margin_medium">

                <LinearLayout
                    android:id="@+id/layoutHeroTextMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHeroPrimaryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tourist_primary_text_size"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="0.0" />

                    <TextView
                        android:id="@+id/tvHeroPrimaryUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_gravity="bottom"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="km/h" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHeroCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/tvHeroLat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/tourist_coords_text_size"
                        android:textStyle="bold"
                        tools:text="Lat: 55.7558°" />

                    <TextView
                        android:id="@+id/tvHeroLon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/tourist_coords_text_size"
                        android:textStyle="bold"
                        tools:text="Lon: 37.6173°" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivHeroCompassRose"
                    android:layout_width="@dimen/tourist_compass_rose_size"
                    android:layout_height="@dimen/tourist_compass_rose_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_compass" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHeroSecondaryDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Max: 0.0 km/h • Trip: 0.00 km" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Secondary Tiles Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSecondaryTiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margin_normal"
        android:paddingEnd="@dimen/margin_normal"
        android:paddingBottom="@dimen/margin_normal" />

    <!-- Action Bar -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/margin_normal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMap"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/margin_small"
            app:icon="@drawable/ic_map"
            android:text="@string/tourist_action_open_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareLocation"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            app:icon="@drawable/ic_share"
            android:text="@string/tourist_action_share_location" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetTrip"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_small"
            app:icon="@drawable/ic_refresh"
            android:text="@string/tourist_action_reset_trip" />
    </LinearLayout>
</LinearLayout>
