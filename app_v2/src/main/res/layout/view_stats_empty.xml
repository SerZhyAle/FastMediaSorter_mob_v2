<?xml version="1.0" encoding="utf-8"?>
<!-- S0473 Phase 04: friendly empty-state shown when collection was just enabled and no detailed
     activity exists yet. The always-on baseline rows still render below this in the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_large"
    android:paddingVertical="@dimen/margin_large">

    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_history"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:gravity="center_horizontal"
        android:text="@string/statistics_empty"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_normal" />

</LinearLayout>
