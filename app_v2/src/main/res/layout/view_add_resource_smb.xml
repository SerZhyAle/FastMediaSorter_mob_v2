<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/layoutSmbFolder" android:layout_width="@dimen/match_constraint" android:layout_height="0dp" android:visibility="gone" android:padding="@dimen/padding_large" app:layout_constraintTop_toBottomOf="@id/layoutResourceTypes" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Scan Network + Server IP in one row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="@dimen/resource_card_margin_bottom">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnScanNetwork" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/scan_network_button" android:layout_marginEnd="@dimen/margin_small" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbServer" android:layout_width="@dimen/resource_server_width" android:layout_height="wrap_content" android:minHeight="64dp" android:hint="@string/smb_server" app:helperText="@string/smb_server_hint" app:helperTextEnabled="true" app:helperTextTextAppearance="@style/TextAppearance.FastMediaSorter.HelperText">

                <com.sza.fastmediasorter.ui.addresource.widgets.IpAddressEditText android:id="@+id/etSmbServer" android:layout_width="match_parent" android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Username and Password in one row -->
        <com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_card_margin_bottom" app:ffp_ratio="one_one">

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbUsername" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/smb_username">

                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="flagNoExtractUi" android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbPassword" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/smb_password" app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:imeOptions="flagNoExtractUi" android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout>

        <!-- Test Connection + Scan Shares in one row to save vertical space -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginBottom="@dimen/resource_card_margin_bottom">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSmbTest" style="@style/Widget.FastMediaSorter.Button.Filled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/resource_field_margin_end" android:text="@string/smb_test_connection" app:icon="@drawable/ic_info" />

            <!-- Scan Shares: discovers available shares for the currently entered server + credentials -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnScanShares" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/resource_field_margin_start" android:text="@string/smb_scan_shares" app:icon="@drawable/ic_resource_smb" />

        </LinearLayout>

        <!-- Share Name and Resource Name in one row -->
        <com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_card_margin_bottom" app:ffp_ratio="one_one">

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbShareName" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/smb_share_name" app:helperText="@string/smb_share_name_hint" app:helperTextEnabled="true" app:helperTextTextAppearance="@style/TextAppearance.FastMediaSorter.HelperText">

                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbShareName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="flagNoExtractUi" android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbResourceName" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/resource_name" app:helperText="@string/resource_name_hint" app:helperTextEnabled="true" app:helperTextTextAppearance="@style/TextAppearance.FastMediaSorter.HelperText">

                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbResourceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="flagNoExtractUi" android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout>

        <!-- === GROUP B: CONDITIONS / SCANNING (collapsible) === -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardSmbConditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_card_margin_bottom" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage for SMB scanning settings if product wants inline help here later. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerSmbConditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/label_scanning_settings" />
                <LinearLayout android:id="@+id/contentSmbConditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small" android:visibility="gone">

                    <!-- Scan Subdirectories and All Files in one row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="@dimen/resource_margin_4dp">
                        <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbScanSubdirectories" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" app:fcr_checked="true" app:fcr_title="@string/scan_subdirectories" app:fcr_subtitle="@string/cb_smb_scan_subdirectories_desc" />
                        <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbAllFiles" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" app:fcr_title="@string/all_files" app:fcr_subtitle="@string/cb_smb_all_files_desc" />
                    </LinearLayout>

                    <!-- Show Subfolders Separately (option parity fix - was missing in create flow) -->
                    <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbShowSubfoldersAsItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_margin_4dp" app:fcr_title="@string/show_subfolders_as_items" app:fcr_subtitle="@string/show_subfolders_as_items_hint" />

                    <!-- Disable Thumbnails -->
                    <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbDisableThumbnails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_margin_4dp" app:fcr_title="@string/disable_thumbnails" app:fcr_subtitle="@string/cb_smb_disable_thumbnails_desc" />

                    <!-- Remember File List -->
                    <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbRememberFileList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_margin_4dp" app:fcr_title="@string/remember_file_list" app:fcr_subtitle="@string/cb_smb_remember_file_list_desc" app:fcr_showHelp="true" app:fcr_helpTitle="@string/remember_file_list_help_title" app:fcr_helpMessage="@string/remember_file_list_help_message" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- === GROUP C: MEDIA TYPES (collapsible) === -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardSmbMediaTypes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_card_margin_bottom" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage for SMB media types if product wants inline help here later. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerSmbMediaTypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/label_media_types" />
                <LinearLayout android:id="@+id/contentSmbMediaTypes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small" android:visibility="gone">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSmbProfilePreset" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/resource_margin_4dp" android:text="@string/label_profile_none" android:textAllCaps="false" app:icon="@drawable/ic_settings" app:iconGravity="textStart" />

                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardElevation="@dimen/resource_card_elevation_zero" app:cardBackgroundColor="?attr/colorSurfaceVariant" app:strokeWidth="@dimen/resource_stroke_width" app:strokeColor="?attr/colorOutlineVariant" android:layout_marginBottom="@dimen/resource_card_margin_bottom">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_small">
                            <!-- Row 1: I V A G -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportImage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/images_i" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportVideo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/videos_v" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportAudio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/audio_a" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportGif" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/gifs_g" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                            </LinearLayout>
                            <!-- Row 2: T P E -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/text_t" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportPdf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/pdf_p" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportEpub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/epub_e" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/resource_checkbox_min_height">
                                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSmbSupportOffice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/resource_checkbox_min_size_zero" android:minHeight="@dimen/resource_checkbox_min_size_zero" />
                                    <TextView android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/office_doc_d" android:textSize="@dimen/resource_text_13sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- === GROUP D: ADDITIONAL OPTIONS (collapsible) - destination, read-only, comment, pin, domain, port === -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardSmbAdditional" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_card_margin_bottom" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage for SMB additional options if product wants inline help here later. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerSmbAdditional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/label_additional_options" />
                <LinearLayout android:id="@+id/contentSmbAdditional" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small" android:visibility="gone">

                    <!-- Add to Destinations and Read-Only checkboxes -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/resource_card_margin_bottom">
                        <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbAddToDestinations" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" app:fcr_title="@string/register_as_destination" app:fcr_subtitle="@string/cb_smb_add_to_destinations_desc" />
                        <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow android:id="@+id/cbSmbReadOnlyMode" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:layout_weight="1" app:fcr_title="@string/read_only_mode" app:fcr_subtitle="@string/cb_smb_read_only_mode_desc" />
                    </LinearLayout>

                    <!-- Comment and PIN Code in one row -->
                    <com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_card_margin_bottom" app:ffp_ratio="two_one">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbComment" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/resource_comment">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="flagNoExtractUi" android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbPinCode" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/resource_pin_code" app:endIconMode="password_toggle">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbPinCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" android:imeOptions="flagNoExtractUi" android:maxLength="6" android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout>

                    <!-- Domain and Port in one row (optional, advanced) -->
                    <com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/resource_margin_16dp" app:ffp_ratio="two_one">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbDomain" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/smb_domain" app:helperText="@string/smb_domain_hint" app:helperTextEnabled="true" app:helperTextTextAppearance="@style/TextAppearance.FastMediaSorter.HelperText">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbDomain" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="flagNoExtractUi" android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSmbPort" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/smb_port" app:helperText="@string/smb_port_hint" app:helperTextEnabled="true" app:helperTextTextAppearance="@style/TextAppearance.FastMediaSorter.HelperText">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSmbPort" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:imeOptions="flagNoExtractUi" android:text="@string/default_smb_port" android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </com.sza.fastmediasorter.ui.common.widget.FormFieldPairLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Add Resource button on separate row -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSmbAddManually" style="@style/Widget.FastMediaSorter.Button.Filled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/smb_add_manual_resource" app:icon="@drawable/ic_add" android:layout_marginBottom="@dimen/resource_card_margin_bottom" />

        <TextView android:id="@+id/tvSmbResourcesToAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/resources_to_add" android:textSize="@dimen/resource_card_title_text_size" android:textStyle="@string/text_style_bold" android:layout_marginTop="@dimen/resource_section_margin_top" android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSmbResourcesToAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/resource_section_margin_top" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" android:visibility="gone" tools:listitem="@layout/item_resource_to_add" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnSmbAddToResources" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/add_to_resources_button" android:visibility="gone" android:layout_marginTop="@dimen/resource_section_margin_top" />



    </LinearLayout>

</ScrollView>
