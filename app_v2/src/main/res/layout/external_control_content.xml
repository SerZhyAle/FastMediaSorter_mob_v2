<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_large">

    <LinearLayout
        android:id="@+id/externalControlThis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerExternalControlThis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_title="@string/external_control_t1" />

    <LinearLayout
        android:id="@+id/externalControlThisBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowExternalControlListening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/headerExternalControlThis"
            app:str_icon="@drawable/ic_exchange_mono"
            app:str_subtitle="@string/external_control_switch_note"
            app:str_title="@string/external_control_switch" />

        <TextView
            android:id="@+id/textExternalControlState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExternalControlStateAction"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/rowExternalControlListening"
            android:nextFocusDown="@id/headerExternalControlControllers"
            android:text="@string/external_control_open_exchange" />

        <TextView
            android:id="@+id/textExternalControlWriteError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:text="@string/external_control_save_failed"
            android:visibility="gone" />

    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/externalControlWaiting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerExternalControlWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_title="@string/external_control_t2" />

    <LinearLayout
        android:id="@+id/externalControlWaitingBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textExternalControlPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

        <TextView
            android:id="@+id/textExternalControlDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/textExternalControlKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/textExternalControlCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExternalControlDecline"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusRight="@id/btnExternalControlAllow"
            android:text="@string/external_control_decline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExternalControlAllow"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/btnExternalControlDecline"
            android:text="@string/external_control_allow" />
        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/externalControlControllers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerExternalControlControllers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_title="@string/external_control_t3" />

    <LinearLayout
        android:id="@+id/externalControlControllersBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textExternalControlControllers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <LinearLayout
            android:id="@+id/externalControlDeviceRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/externalControlCommands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerExternalControlCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_title="@string/external_control_t4" />

        <LinearLayout
            android:id="@+id/externalControlCommandRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/externalControlLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerExternalControlLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_title="@string/external_control_t5" />

    <LinearLayout
        android:id="@+id/externalControlLogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/externalControlLogRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExternalControlFullLog"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/external_control_open_log" />

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
