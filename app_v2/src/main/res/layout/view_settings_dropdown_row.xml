<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for SettingsDropdownRow compound view.
  Title + inline helper, then a Material exposed dropdown (TextInputLayout + AutoCompleteTextView).
  Replaces raw <Spinner> usage in settings and dialog surfaces (S0567, ADR-1).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Title line: title + helper inline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sdr_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/toggler_title_text_size" />

        <ImageButton
            android:id="@+id/sdr_iconHelp"
            android:layout_width="@dimen/settings_help_icon_size"
            android:layout_height="@dimen/settings_help_icon_size"
            android:layout_marginStart="@dimen/settings_help_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription=""
            android:focusable="true"
            android:src="@drawable/ic_help_outline_24"
            app:tint="@color/text_color_secondary"
            android:visibility="gone" />

        <View
            android:id="@+id/sdr_titleLineSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sdr_inputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <AutoCompleteTextView
            android:id="@+id/sdr_autocomplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textSize="@dimen/toggler_title_text_size" />

    </com.google.android.material.textfield.TextInputLayout>

</merge>
