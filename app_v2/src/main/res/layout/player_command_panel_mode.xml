<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- Command Panel Top -->
    <LinearLayout
        android:id="@+id/topCommandPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/player_command_panel_mode_topCommandPanel_paddingTop"
        android:paddingBottom="@dimen/player_command_panel_mode_topCommandPanel_paddingBottom"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:background="@color/activity_player_unified_topCommandPanel_background">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnPreviousCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnNextCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:src="@android:drawable/ic_media_next"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnRenameCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rename"
            android:src="@drawable/ic_rename"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnShareCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnDeleteCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnUndoCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/undo"
            android:src="@android:drawable/ic_menu_revert"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnFullscreenCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:layout_marginEnd="@dimen/player_command_panel_mode_btnFullscreenCmd_layout_marginEnd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fullscreen_mode"
            android:src="@drawable/ic_fullscreen"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnSlideshowCmd"
            android:layout_width="@dimen/player_command_panel_mode_btnDeleteCmd_layout_width"
            android:layout_height="@dimen/player_command_panel_mode_btnDeleteCmd_layout_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/slideshow"
            android:src="@android:drawable/ic_media_play"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Media Content Area with touch zones -->
    <FrameLayout
        android:id="@+id/mediaContentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerViewPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:show_buffering="when_playing"
            app:resize_mode="fit" />

        <ImageView
            android:id="@+id/imageViewPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Touch zones overlay (left half - previous, right half - next) -->
        <LinearLayout
            android:id="@+id/touchZonesOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <View
                android:id="@+id/touchZonePrevious"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <View
                android:id="@+id/touchZoneNext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>

    <!-- Copy to... Panel -->
    <LinearLayout
        android:id="@+id/copyToPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/activity_player_unified_copyToPanel_background"
        android:padding="@dimen/padding_tiny">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_copy_to"
            android:textColor="@android:color/white"
            android:textSize="@dimen/activity_browse_btnSort_textSize"
            android:paddingBottom="@dimen/player_command_panel_mode_topCommandPanel_paddingBottom" />

        <GridLayout
            android:id="@+id/copyDestinationsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="2"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="false" />
    </LinearLayout>

    <!-- Move to... Panel -->
    <LinearLayout
        android:id="@+id/moveToPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/activity_player_unified_moveToPanel_background"
        android:padding="@dimen/padding_tiny">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_move_to"
            android:textColor="@android:color/white"
            android:textSize="@dimen/activity_browse_btnSort_textSize"
            android:paddingBottom="@dimen/player_command_panel_mode_topCommandPanel_paddingBottom" />

        <GridLayout
            android:id="@+id/moveDestinationsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="2"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="false" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/loading_indicator"
        android:visibility="gone" />
</LinearLayout>
