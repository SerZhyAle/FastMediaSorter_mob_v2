<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/item_padding_vertical"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:layout_width="@dimen/item_status_badge_size"
        android:layout_height="@dimen/item_status_badge_size"
        android:layout_marginEnd="@dimen/dialog_button_spacing"
        android:src="@drawable/ic_resource_local"
        android:contentDescription="@string/folder" />

    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/item_title_text_size"
        android:text="Folder Name" />

</LinearLayout>
