<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" tools:context=".ui.browse.BrowseActivity">

    <LinearLayout android:id="@+id/layoutControls" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:background="?attr/colorSurface" android:clickable="true" android:elevation="@dimen/dimension_zero" android:focusable="true" android:gravity="center_vertical" android:importantForAccessibility="no" android:orientation="horizontal" android:padding="@dimen/control_bar_padding" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/back" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@drawable/ic_arrow_back" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

        <!-- Breadcrumb path (visible during subfolder navigation) -->
        <com.sza.fastmediasorter.ui.common.BreadcrumbView android:id="@+id/breadcrumbView" android:layout_width="0dp" android:layout_height="@dimen/control_button_size" android:layout_weight="1" android:visibility="gone" />

        <!-- Small space after Back (only visible when breadcrumb is hidden) -->
        <Space android:id="@+id/spaceAfterBack" android:layout_width="@dimen/match_constraint" android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height" />

        <!-- Sort Button (shows current mode, popup menu on click) -->

        <!-- Filter (with badge) -->
        <TextView android:id="@+id/btnSort" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:ellipsize="end" android:gravity="center_horizontal|center_vertical" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:singleLine="true" android:textColor="?attr/colorControlNormal" android:textSize="@dimen/activity_browse_btnSort_textSize" app:drawableEndCompat="@drawable/ic_arrow_drop_down" app:drawableTint="?attr/colorControlNormal" tools:text="Date ↓" />

        <FrameLayout android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnFilter" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/filter" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@android:drawable/ic_menu_search" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

            <TextView android:id="@+id/tvFilterBadge" android:layout_width="@dimen/browse_filter_badge_size" android:layout_height="@dimen/browse_filter_badge_size" android:layout_gravity="top|end" android:layout_marginTop="@dimen/margin_tiny" android:layout_marginEnd="@dimen/margin_tiny" android:background="@drawable/badge_filter_background" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/browse_filter_badge_text_size" android:textStyle="bold" android:visibility="gone" />
        </FrameLayout>

        <!-- Refresh -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/refresh" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@android:drawable/ic_popup_sync" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

        <!-- Grid/List toggle -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleView" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/toggle_view" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@android:drawable/ic_menu_view" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

        <!-- Small space -->
        <Space android:layout_width="@dimen/match_constraint" android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height" />

        <!-- Select All -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectAll" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/select_all" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@drawable/ic_select_all" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

        <!-- Deselect All -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDeselectAll" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/deselect_all" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@drawable/ic_deselect_all" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

        <!-- Small space -->
        <Space android:layout_width="@dimen/match_constraint" android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height" />

        <!-- Play/Slideshow -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPlay" style="?attr/materialIconButtonStyle" android:layout_width="wrap_content" android:layout_height="@dimen/control_button_size" android:contentDescription="@string/play" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" android:maxWidth="@dimen/activity_browse_btnSort_maxWidth" android:maxHeight="@dimen/activity_browse_btnDeselectAll_maxHeight" android:minWidth="@dimen/activity_browse_btnBack_minWidth" android:minHeight="@dimen/activity_browse_btnDeselectAll_minHeight" android:padding="0dp" android:paddingStart="@dimen/activity_browse_btnDeselectAll_paddingStart" android:paddingTop="0dp" android:paddingEnd="@dimen/activity_player_unified_moveToPanelIndicator_paddingEnd" android:paddingBottom="0dp" android:textSize="@dimen/activity_browse_btnSort_textSize" app:icon="@android:drawable/ic_media_play" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_none" app:iconTint="?attr/colorControlNormal" />

    </LinearLayout>

    <LinearLayout android:id="@+id/layoutResourceInfo" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/padding_small" android:paddingEnd="@dimen/padding_small" app:layout_constraintTop_toBottomOf="@id/layoutControls" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnResourceAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="@dimen/activity_browse_btnResourceAction_layout_marginEnd" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/edit" android:padding="@dimen/activity_player_unified_btnExitPdfFullscreen_padding" android:scaleType="fitCenter" android:src="@drawable/ic_edit_20" android:visibility="gone" app:tint="?attr/colorControlNormal" tools:visibility="visible" />

        <TextView android:id="@+id/tvResourceInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingTop="@dimen/padding_small" android:paddingBottom="@dimen/padding_small" android:textSize="@dimen/text_size_small" android:textColor="@color/text_color_secondary" android:gravity="center_vertical" tools:text="Downloads • /storage/emulated/0/Download • 0 selected" />

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefreshLayout" android:layout_width="@dimen/match_constraint" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/layoutResourceInfo" app:layout_constraintBottom_toTopOf="@id/layoutOperations" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMediaFiles" android:scrollbars="vertical" android:scrollbarFadeDuration="0" android:fadeScrollbars="false" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" tools:listitem="@layout/item_media_file" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Scroll to Top button -->
    <ImageButton android:id="@+id/fabScrollToTop" android:layout_width="@dimen/browse_scroll_button_size" android:layout_height="@dimen/browse_scroll_button_size" android:layout_marginEnd="@dimen/browse_scroll_button_margin" android:layout_marginTop="@dimen/margin_small" android:background="@drawable/bg_scroll_button" android:contentDescription="@string/scroll_to_top" android:padding="@dimen/browse_scroll_button_padding" android:scaleType="centerInside" android:visibility="gone" android:src="@drawable/ic_arrow_upward" app:tint="@color/selector_player_button_tint" app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout" app:layout_constraintEnd_toEndOf="parent" />

    <!-- Page Up button -->
    <ImageButton android:id="@+id/fabPageUp" android:layout_width="@dimen/browse_scroll_button_size" android:layout_height="@dimen/browse_scroll_button_size" android:layout_marginEnd="@dimen/browse_scroll_button_margin" android:layout_marginTop="@dimen/margin_small" android:background="@drawable/bg_scroll_button" android:contentDescription="@string/scroll_page_up" android:padding="@dimen/browse_scroll_button_padding" android:scaleType="centerInside" android:visibility="gone" android:src="@drawable/ic_double_arrow_up" app:tint="@color/selector_player_button_tint" app:layout_constraintTop_toBottomOf="@id/fabScrollToTop" app:layout_constraintEnd_toEndOf="parent" />

    <!-- Page Down button -->
    <ImageButton android:id="@+id/fabPageDown" android:layout_width="@dimen/browse_scroll_button_size" android:layout_height="@dimen/browse_scroll_button_size" android:layout_marginEnd="@dimen/browse_scroll_button_margin" android:layout_marginBottom="@dimen/margin_small" android:background="@drawable/bg_scroll_button" android:contentDescription="@string/scroll_page_down" android:padding="@dimen/browse_scroll_button_padding" android:scaleType="centerInside" android:visibility="gone" android:src="@drawable/ic_double_arrow_down" app:tint="@color/selector_player_button_tint" app:layout_constraintBottom_toTopOf="@id/fabScrollToBottom" app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll to Bottom button -->
    <ImageButton android:id="@+id/fabScrollToBottom" android:layout_width="@dimen/browse_scroll_button_size" android:layout_height="@dimen/browse_scroll_button_size" android:layout_marginEnd="@dimen/browse_scroll_button_margin" android:layout_marginBottom="@dimen/margin_small" android:background="@drawable/bg_scroll_button" android:contentDescription="@string/scroll_to_bottom" android:padding="@dimen/browse_scroll_button_padding" android:scaleType="centerInside" android:visibility="gone" android:src="@drawable/ic_arrow_downward" app:tint="@color/selector_player_button_tint" app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout" app:layout_constraintEnd_toEndOf="parent" />

    <!-- Operations bar at bottom -->
    <LinearLayout android:id="@+id/layoutOperations" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/control_bar_padding" android:background="?attr/colorSurface" android:elevation="@dimen/elevation_operations_bar" android:visibility="visible" app:layout_constraintBottom_toTopOf="@id/tvFilterWarning" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <!-- Copy -->
        <ImageButton android:id="@+id/btnCopy" android:layout_width="@dimen/control_button_size" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/copy" android:src="@android:drawable/ic_menu_save" app:tint="?attr/colorControlNormal" android:visibility="gone" />

        <!-- Move -->
        <ImageButton android:id="@+id/btnMove" android:layout_width="@dimen/control_button_size" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/move" android:src="@android:drawable/ic_menu_revert" app:tint="?attr/colorControlNormal" android:visibility="gone" />

        <!-- Rename -->
        <ImageButton android:id="@+id/btnRename" android:layout_width="@dimen/control_button_size" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/rename" android:src="@android:drawable/ic_menu_edit" app:tint="?attr/colorControlNormal" android:visibility="gone" />

        <!-- Delete -->
        <ImageButton android:id="@+id/btnDelete" android:layout_width="@dimen/control_button_size" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/delete" android:src="@android:drawable/ic_menu_delete" app:tint="?attr/colorControlNormal" android:visibility="gone" />

        <!-- Undo -->
        <ImageButton android:id="@+id/btnUndo" android:layout_width="@dimen/control_button_size" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/undo" android:src="@android:drawable/ic_menu_revert" app:tint="?attr/colorControlNormal" android:visibility="gone" />

        <!-- Share -->
        <ImageButton android:id="@+id/btnShare" android:layout_width="@dimen/control_button_size" android:layout_height="@dimen/control_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/share" android:src="@drawable/ic_share" app:tint="?attr/colorControlNormal" android:visibility="gone" />

    </LinearLayout>

    <TextView android:id="@+id/tvFilterWarning" android:layout_width="@dimen/match_constraint" android:layout_height="wrap_content" android:background="@color/filter_warning_bg" android:padding="@dimen/padding_small" android:textSize="@dimen/text_size_small" android:textColor="@color/filter_warning_text" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" tools:text="⚠ Filter active: name contains 'photo', created after 01.01.2024" tools:visibility="visible" />

    <!-- Empty state (no files found) -->
    <LinearLayout android:id="@+id/emptyStateView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/empty_state_padding" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <ImageView android:layout_width="@dimen/empty_state_icon_size" android:layout_height="@dimen/empty_state_icon_size" android:src="@drawable/ic_folder_open_24" android:contentDescription="@string/empty_folder" app:tint="@color/text_color_secondary" />

        <TextView android:id="@+id/tvEmptyStateMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/empty_state_text_margin_top" android:text="@string/no_files_found" android:textSize="@dimen/empty_state_text_size" android:textAlignment="center" android:gravity="center" android:textColor="@color/text_color_secondary" />

        <TextView android:id="@+id/tvEmptyStateHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dialog_slideshow_settings_btnSelectMusic_layout_marginTop" android:text="@string/empty_folder_hint" android:textSize="@dimen/activity_player_unified_audioFileName_textSize" android:textAlignment="center" android:gravity="center" android:textColor="@color/text_color_secondary" android:visibility="gone" />
    </LinearLayout>

    <!-- Error state view for network errors -->
    <LinearLayout android:id="@+id/errorStateView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/empty_state_padding" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <ImageView android:layout_width="@dimen/empty_state_icon_size" android:layout_height="@dimen/empty_state_icon_size" android:src="@android:drawable/stat_notify_error" android:contentDescription="@string/error" app:tint="@color/error_color" />

        <TextView android:id="@+id/tvErrorMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/empty_state_text_margin_top" android:text="@string/connection_failed" android:textSize="@dimen/empty_state_text_size" android:textAlignment="center" android:gravity="center" android:textColor="@color/error_color" />

        <Button android:id="@+id/btnRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/button_margin_top_normal" android:text="@string/retry" style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

    <!-- Progress layout with STOP button -->
    <LinearLayout android:id="@+id/layoutProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar android:id="@+id/progressBar" android:layout_width="@dimen/browse_progress_bar_size" android:layout_height="@dimen/browse_progress_bar_size" android:contentDescription="@string/loading_indicator" />

        <TextView android:id="@+id/tvProgressMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/browse_progress_text_margin_start" android:textSize="@dimen/empty_state_text_size" android:textColor="@color/text_color_primary" android:maxLines="1" android:maxWidth="@dimen/browse_progress_max_width" tools:text="Loading (12345)" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnStopScan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/browse_stop_button_margin_start" android:text="@string/stop" android:visibility="gone" style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


