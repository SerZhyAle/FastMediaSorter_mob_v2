<?xml version="1.0" encoding="utf-8"?>
<!-- S0813: title on its own full-width line; Spinners -> SettingsDropdownRow,
     MaterialSwitch -> SettingsToggleRow; Cancel/Apply moved to a dedicated bottom row.
     S0924: setting rows live in a ColumnFlowLayout that switches to 2 columns in landscape (driven
     by CameraSettingsDialogRotationManager); title + action row stay full-width outside it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_normal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:text="@string/camera_settings_title"
            android:textSize="@dimen/text_size_title_dialog"
            android:textStyle="bold" />

        <com.sza.fastmediasorter.ui.common.widget.ColumnFlowLayout
            android:id="@+id/cameraSettingsFlow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
            android:id="@+id/rowCameraTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:sdr_title="@string/camera_setting_timer" />

        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowCameraGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:str_title="@string/camera_setting_grid" />

        <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
            android:id="@+id/rowCameraAspect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:sdr_title="@string/camera_setting_aspect" />

        <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
            android:id="@+id/rowCameraResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:sdr_title="@string/camera_setting_resolution" />

        <LinearLayout
            android:id="@+id/rowCameraExposure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/camera_setting_exposure"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraExposureValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCameraExposure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
            android:id="@+id/rowCameraWhiteBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:sdr_title="@string/camera_setting_white_balance" />

        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowCameraManualSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:str_title="@string/camera_setting_manual_sensor" />

        <LinearLayout
            android:id="@+id/layoutCameraIsoControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/camera_setting_iso"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraIsoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCameraIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCameraShutterControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/camera_setting_shutter"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraShutterValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCameraShutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowCameraHdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:str_title="@string/camera_setting_hdr" />

        </com.sza.fastmediasorter.ui.common.widget.ColumnFlowLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCameraSettingsCancel"
                style="@style/Widget.FastMediaSorter.Button.DialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCameraSettingsApply"
                style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_action_button_gap"
                android:text="@string/apply" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
