<?xml version="1.0" encoding="utf-8"?>
<!-- S3040: the pending cross-device packet queue (Settings -> Data / Cloud transfer).
     Every view id must mirror layout-land/dialog_cross_device_packets.xml (one ViewBinding). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:text="@string/cross_device_transfer_pending_title"
        android:textSize="@dimen/text_size_title_dialog"
        android:textStyle="bold" />

    <!-- Empty state carries the next action, not just the absence of items (COMMUNICATION_POLICY section 6). -->
    <TextView
        android:id="@+id/tvCrossDevicePacketsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:text="@string/cross_device_transfer_empty"
        android:textColor="@color/text_color_secondary"
        android:textSize="@dimen/text_size_small"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listCrossDevicePackets"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_list_max_height"
        android:layout_marginBottom="@dimen/margin_small"
        android:choiceMode="none"
        android:nextFocusDown="@+id/btnCrossDeviceSendSettings" />

    <!-- S3040: runs while the settings packet upload (or any queue call) is in flight. -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressCrossDeviceSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/margin_small"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="@dimen/settings_icon_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrossDeviceSendSettings"
            style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:nextFocusRight="@+id/btnCrossDeviceRemoveExpired"
            android:text="@string/cross_device_transfer_send_to_device" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrossDeviceRemoveExpired"
            style="@style/Widget.FastMediaSorter.Button.DialogDestructive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:nextFocusLeft="@+id/btnCrossDeviceSendSettings"
            android:nextFocusRight="@+id/btnCrossDevicePacketsClose"
            android:text="@string/cross_device_transfer_remove_expired" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrossDevicePacketsClose"
            style="@style/Widget.FastMediaSorter.Button.DialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusLeft="@+id/btnCrossDeviceRemoveExpired"
            android:text="@string/close" />

    </LinearLayout>

</LinearLayout>
