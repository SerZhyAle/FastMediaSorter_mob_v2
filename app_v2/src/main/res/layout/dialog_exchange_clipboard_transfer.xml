<?xml version="1.0" encoding="utf-8"?>
<!-- S4226: the body of the clipboard transfer dialog; the dialog's own buttons are "Hide" and "Cancel". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingTop="@dimen/margin_small"
    android:paddingEnd="?attr/dialogPreferredPadding">

    <TextView
        android:id="@+id/exchangeClipboardMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/margin_small"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/exchangeClipboardProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/operation_progress_indicator"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary" />
</LinearLayout>
