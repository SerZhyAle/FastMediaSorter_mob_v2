<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:keepScreenOn="true"
    tools:context=".ui.cameraocr.CameraOcrTranslateActivity">

    <!-- Primary Content Area (Visible when loaded) -->
    <LinearLayout
        android:id="@+id/layoutResultContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Title / Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_horizontal"
            android:text="@string/camera_ocr_result_header"
            android:textColor="#E1E1E6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Dual Scrollable Result Panes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Card 1: Translated Text (Top, Prominent) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTranslation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#1D1D21"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#2F2F37"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_ocr_pane_translation"
                        android:textColor="#A1A1AA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:layout_marginBottom="6dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvTranslation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:lineSpacingMultiplier="1.2"
                            android:textIsSelectable="true"
                            tools:text="This is a beautiful premium translation output displayed in large clean typography." />

                    </ScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Original OCR Text (Bottom, Secondary) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOriginalOcr"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                app:cardBackgroundColor="#1D1D21"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#2F2F37"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOriginalHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_ocr_pane_original"
                        android:textColor="#A1A1AA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:layout_marginBottom="6dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvOriginalText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#C4C4CC"
                            android:textSize="15sp"
                            android:lineSpacingMultiplier="1.2"
                            android:textIsSelectable="true"
                            tools:text="Original captured text from the image will be placed here." />

                    </ScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/settings"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tooltipText="@string/settings"
                android:textColor="#A1A1AA"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#A1A1AA"
                app:strokeColor="#2F2F37" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTxt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/camera_ocr_btn_save"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tooltipText="@string/camera_ocr_btn_save"
                android:textColor="#4CAF50"
                app:icon="@drawable/ic_text_save"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#4CAF50"
                app:strokeColor="#2F4F37" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextPhoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/camera_ocr_btn_next"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tooltipText="@string/camera_ocr_btn_next"
                android:textColor="#FFFFFF"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/ic_camera_ocr_translate"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/close"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tooltipText="@string/close"
                android:textColor="#E1E1E6"
                app:icon="@drawable/ic_cancel"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#E1E1E6"
                app:strokeColor="#2F2F37" />

        </LinearLayout>

    </LinearLayout>

    <!-- Empty State (No Text Found) -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_camera_ocr_translate"
            app:tint="#A1A1AA"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ocr_no_text_found"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_ocr_empty_desc"
            android:textColor="#A1A1AA"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyClose"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close"
                android:textColor="#E1E1E6"
                app:strokeColor="#2F2F37"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_ocr_btn_next"
                app:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Crop State (Select area before OCR) -->
    <LinearLayout
        android:id="@+id/layoutCropState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121214"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tvCropHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:gravity="center_horizontal"
            android:text="@string/camera_ocr_crop_hint"
            android:textColor="#E1E1E6"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivCropPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#121214"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <com.sza.fastmediasorter.ui.cameraocr.CropOverlayView
                android:id="@+id/cropOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Bottom Action Bar: Retry / OK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCropRetry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@+id/btnCropOcrLang"
                android:text="@string/camera_ocr_crop_retry"
                android:textColor="#E1E1E6"
                app:strokeColor="#2F2F37" />

            <!-- S0354: language cluster — OCR lang, direction arrow, translation lang.
                 Arrow + target button are shown only when translation is available. -->
            <LinearLayout
                android:id="@+id/layoutCropLangCluster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCropOcrLang"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/camera_ocr_crop_lang_ocr_desc"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:nextFocusLeft="@+id/btnCropRetry"
                    android:nextFocusRight="@+id/btnCropTargetLang"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#E1E1E6"
                    android:textSize="14sp"
                    app:strokeColor="#2F2F37"
                    tools:text="🌐 AUTO" />

                <ImageView
                    android:id="@+id/ivCropLangArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_forward"
                    android:tint="#A1A1AA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCropTargetLang"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/camera_ocr_crop_lang_target_desc"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:nextFocusLeft="@+id/btnCropOcrLang"
                    android:nextFocusRight="@+id/btnCropConfirm"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#E1E1E6"
                    android:textSize="14sp"
                    app:strokeColor="#2F2F37"
                    tools:text="🇷🇺 RU" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCropConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnCropTargetLang"
                android:text="@string/camera_ocr_crop_confirm"
                android:textColor="#FFFFFF"
                app:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Full-Screen Loading overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99121214"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorSize="64dp"
            app:trackThickness="6dp"
            app:indicatorColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/camera_ocr_loading_processing"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/camera_ocr_loading_saving"
            android:textColor="#A1A1AA"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
