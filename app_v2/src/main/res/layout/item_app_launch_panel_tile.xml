<?xml version="1.0" encoding="utf-8"?>
<!-- One large tile in the quick-launch panel: a centered app icon over a label. A filled tile shows
     the resolved icon + label; an empty slot shows the ghost "add" appearance, both driven at runtime
     by AppLaunchPanelTileAdapter. Touch target >= 88dp; clickable/focusable for touch, mouse, D-pad. -->
<com.sza.fastmediasorter.ui.common.widget.FocusMaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPanelTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:rippleColor="?attr/colorControlHighlight"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/ivPanelTileIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_add" />

        <TextView
            android:id="@+id/tvPanelTileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:text="Calculator" />

    </LinearLayout>

</com.sza.fastmediasorter.ui.common.widget.FocusMaterialCardView>
