<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">
        <!-- ========== IMAGES CATEGORY ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_category_images"
            android:textStyle="bold"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/settings_padding_vertical" />
        <!-- Images + GIF Row Container -->
        <LinearLayout
            android:id="@+id/containerImagesGif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Support static images -->
            <LinearLayout
                android:id="@+id/layoutSupportImages"
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/resource_field_margin_end">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSupportImages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end"
                    android:checked="true" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/support_images_description"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Support GIF animation -->
            <LinearLayout
                android:id="@+id/layoutSupportGifs"
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/settings_help_icon_margin">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSupportGifs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/support_gif_description"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

        </LinearLayout>

        <!-- Supported formats info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/supported_image_formats"
            android:textSize="@dimen/text_size_small"
            android:textColor="?android:textColorSecondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <!-- Load full size images -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/button_height"
            android:layout_marginStart="@dimen/fragment_settings_audio_etAudioSizeMax_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLoadFullSizeImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/settings_switch_margin_end"
                android:checked="false" />

            <TextView
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/load_full_size_images"
                android:textSize="@dimen/resource_card_desc_text_size" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_full_size_images_hint"
            android:textSize="@dimen/text_size_small"
            android:textColor="?android:textColorSecondary"
            android:layout_marginStart="@dimen/settings_margin_indent_level_3"
            android:layout_marginBottom="@dimen/margin_small" />

        <!-- Image size limit (for both static and GIF) -->
        <TextView
            android:id="@+id/tvImageSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_and_animation_size_limit"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small" />

        <LinearLayout
            android:id="@+id/layoutImageSizeInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginEnd="@dimen/fragment_settings_playback_iconHelpTouchZones_layout_marginEnd"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/fragment_settings_images_tilImageSizeMin_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginEnd="@dimen/margin_small">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImageSizeMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/fragment_settings_media_etVideoSizeMin_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImageSizeMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="@dimen/fragment_settings_media_etAudioSizeMax_layout_marginVertical" />

        <!-- ========== VIDEO CATEGORY ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_category_video"
            android:textStyle="bold"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/settings_padding_vertical" />

        <!-- Video Settings Container -->
        <LinearLayout
            android:id="@+id/containerVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Support video -->
            <LinearLayout
                android:id="@+id/layoutSupportVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSupportVideos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end"
                        android:checked="true" />

                    <TextView
                        android:layout_width="@dimen/match_constraint"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_video_description"
                        android:textSize="@dimen/resource_card_title_text_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supported_video_formats"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="?android:textColorSecondary"
                    android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" />

            </LinearLayout>

            <!-- Show video thumbnails -->
            <LinearLayout
                android:id="@+id/layoutShowVideoThumbnails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowVideoThumbnails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/show_video_thumbnails"
                    android:textSize="@dimen/resource_card_title_text_size" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvVideoSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_size_limit"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small" />

        <LinearLayout
            android:id="@+id/layoutVideoSizeInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginEnd="@dimen/fragment_settings_playback_iconHelpTouchZones_layout_marginEnd"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/fragment_settings_images_tilImageSizeMin_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginEnd="@dimen/margin_small">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVideoSizeMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/fragment_settings_media_etVideoSizeMin_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVideoSizeMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="@dimen/fragment_settings_media_etAudioSizeMax_layout_marginVertical" />

        <!-- ========== AUDIO CATEGORY ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_category_audio"
            android:textStyle="bold"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/settings_padding_vertical" />

        <!-- Audio Settings Container -->
        <LinearLayout
            android:id="@+id/containerAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Support audio -->
            <LinearLayout
                android:id="@+id/layoutSupportAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSupportAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end"
                        android:checked="true" />

                    <TextView
                        android:layout_width="@dimen/match_constraint"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_audio_description"
                        android:textSize="@dimen/resource_card_title_text_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supported_audio_formats"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="?android:textColorSecondary"
                    android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" />

            </LinearLayout>

            <!-- Search audio covers online -->
            <LinearLayout
                android:id="@+id/layoutSearchAudioCovers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSearchAudioCoversOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end"
                    android:checked="false" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_audio_covers_online"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Search covers only on WiFi -->
            <LinearLayout
                android:id="@+id/layoutSearchCoversOnlyWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_media_layoutSearchCoversOnlyWifi_layout_marginStart"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSearchCoversOnlyWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end"
                    android:checked="true" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_covers_only_on_wifi"
                    android:textSize="@dimen/resource_card_desc_text_size"
                    android:textColor="?android:textColorSecondary" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvAudioSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_size_limit"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small" />

        <LinearLayout
            android:id="@+id/layoutAudioSizeInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginEnd="@dimen/fragment_settings_playback_iconHelpTouchZones_layout_marginEnd"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/fragment_settings_audio_tilAudioSizeMin_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginEnd="@dimen/margin_small">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAudioSizeMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/fragment_settings_audio_tilAudioSizeMax_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAudioSizeMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>



        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="@dimen/fragment_settings_media_etAudioSizeMax_layout_marginVertical" />

        <!-- ========== DOCUMENTS CATEGORY ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_category_documents"
            android:textStyle="bold"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/settings_padding_vertical" />

        <!-- Text + PDF Container -->
        <!-- Text + PDF Row Container -->
        <LinearLayout
            android:id="@+id/containerTextPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Support Text -->
            <LinearLayout
                android:id="@+id/layoutSupportText"
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/resource_field_margin_end">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSupportText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/support_text_description"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Support PDF (vertical container for PDF + thumbnails) -->
            <LinearLayout
                android:id="@+id/layoutSupportPdf"
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/settings_help_icon_margin">

                <!-- Support PDF switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSupportPdf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <TextView
                        android:layout_width="@dimen/match_constraint"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_pdf_description"
                        android:textSize="@dimen/resource_card_desc_text_size" />

                </LinearLayout>

                <!-- Show PDF Thumbnails (nested under Support PDF) -->
                <LinearLayout
                    android:id="@+id/layoutShowPdfThumbnails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_height"
                    android:layout_marginStart="@dimen/settings_nested_margin_start"
                    android:visibility="gone">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowPdfThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <TextView
                        android:layout_width="@dimen/match_constraint"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_pdf_thumbnails"
                        android:textSize="@dimen/resource_card_desc_text_size" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="@dimen/fragment_settings_media_etAudioSizeMax_layout_marginVertical" />

        <!-- ========== OTHER SETTINGS (Translation, OCR) ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_category_other"
            android:textStyle="bold"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/settings_padding_vertical" />

        <!-- Translation Settings (visible when supportPdf or supportText enabled) -->
        <LinearLayout
            android:id="@+id/layoutTranslationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:visibility="gone">
            
            <!-- Enable Translation Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableTranslation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enable_translation"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>
            
            <!-- Source Language Spinner -->
            <LinearLayout
                android:id="@+id/layoutTranslationSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
                android:visibility="gone">

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_source_language"
                    android:textSize="@dimen/resource_card_desc_text_size"
                    android:layout_marginEnd="@dimen/margin_small" />

                <Spinner
                    android:id="@+id/spinnerSourceLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/settings_spinner_min_width" />

            </LinearLayout>
            
            <!-- Target Language Spinner -->
            <LinearLayout
                android:id="@+id/layoutTranslationTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
                android:visibility="gone">

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_target_language"
                    android:textSize="@dimen/resource_card_desc_text_size"
                    android:layout_marginEnd="@dimen/margin_small" />

                <Spinner
                    android:id="@+id/spinnerTargetLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/settings_spinner_min_width" />

            </LinearLayout>
            
            <!-- Google Lens Style Switch -->
            <LinearLayout
                android:id="@+id/layoutTranslationLensStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTranslationLensStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_lens_style"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Enable Google Lens Switch -->
            <LinearLayout
                android:id="@+id/layoutEnableGoogleLens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableGoogleLens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enable_google_lens"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Enable OCR Switch -->
            <LinearLayout
                android:id="@+id/layoutEnableOcr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEnableOcr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                    <TextView
                        android:layout_width="@dimen/match_constraint"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/enable_ocr"
                        android:textSize="@dimen/resource_card_desc_text_size" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fragment_settings_media_switchEnableOcr_layout_marginStart"
                    android:layout_marginTop="@dimen/margin_tiny"
                    android:text="@string/enable_ocr_summary"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
