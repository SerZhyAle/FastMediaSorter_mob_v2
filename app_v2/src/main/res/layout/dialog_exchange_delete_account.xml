<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dialog_padding_large"
        android:paddingTop="@dimen/margin_small">

        <TextView
            android:id="@+id/textExchangeDeleteMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exchange_delete_message"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExchangeDeleteHelp"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/etExchangeDeletePassword"
            android:text="@string/exchange_delete_help" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeDeletePassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:hint="@string/exchange_delete_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeDeletePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textPassword"
                android:nextFocusUp="@id/btnExchangeDeleteHelp" />
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/exchangeFailurePanel"
            layout="@layout/view_exchange_failure_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
