<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translation_settings"
        android:textSize="@dimen/text_size_title_dialog"
        android:textStyle="@string/text_style_bold"
        android:layout_marginBottom="@dimen/margin_small" />

    <!-- Source Language Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translation_source_language_and_ocr"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <Spinner
        android:id="@+id/spinnerSourceLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <!-- Swap Languages Button -->
    <ImageButton
        android:id="@+id/btnSwapLanguages"
        android:layout_width="@dimen/button_height_small"
        android:layout_height="@dimen/button_height_small"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_swap_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/swap_languages"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <!-- Target Language Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translation_target_language"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <Spinner
        android:id="@+id/spinnerTargetLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small" />

    <!-- Google Lens Style Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="@dimen/button_height"
        android:layout_marginBottom="@dimen/margin_small">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchLensStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dialog_field_spacing" />

        <TextView
            android:layout_width="@dimen/match_constraint"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/translation_lens_style"
            android:textSize="@dimen/resource_card_desc_text_size" />

    </LinearLayout>

    <!-- Font Size Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translation_font_size"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <Spinner
        android:id="@+id/spinnerFontSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small" />

    <!-- Font Family Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translation_font_family"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <Spinner
        android:id="@+id/spinnerFontFamily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_normal" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:layout_marginEnd="@dimen/dialog_field_spacing" />

        <Button
            android:id="@+id/btnOk"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/ok" />

    </LinearLayout>

</LinearLayout>

</ScrollView>
