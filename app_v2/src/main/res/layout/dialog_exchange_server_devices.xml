<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dialog_padding_large"
    android:paddingTop="@dimen/margin_small">

    <include
        android:id="@+id/exchangeFailurePanel"
        layout="@layout/view_exchange_failure_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExchangeDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:nextFocusDown="@id/btnExchangeDevicesPairing" />

    <TextView
        android:id="@+id/textExchangeDevicesPairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExchangeDevicesPairing"
        style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusUp="@id/rvExchangeDevices"
        android:text="@string/exchange_devices_pairing_issue" />
</LinearLayout>
