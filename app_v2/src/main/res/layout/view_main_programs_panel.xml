<?xml version="1.0" encoding="utf-8"?>
<!-- S0755: horizontal programs panel for the main window. Mirrors the three-dots programs menu;
     items that do not fit move under the trailing overflow button. Visibility owned by MainActivity.
     S0807: a leading three-dots button opens the panel-level menu (Configure / Collapse / Hide); the
     collapsed strip replaces the row when the panel is collapsed (mirror of the S0781 resource strip). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/programsPanelContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/main_panel_row_height"
        android:background="@color/main_programs_panel_accent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/main_panel_item_spacing">

        <!-- S0807: panel-level menu trigger; matches the top command bar three-dots for continuity.
             S1037: spans the shared leading anchor (gravity start keeps the icon at the row edge) so the
             first program item begins at the same X as the streams channels and resource tabs. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgramsPanelMenu"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/main_panel_row_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foreground="@drawable/focus_button_background"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/more_actions"
            android:gravity="start|center_vertical"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/main_top_panel_leading_anchor"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/main_panel_item_spacing"
            android:text=""
            app:icon="@drawable/ic_more_vert"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_size_normal"
            app:iconTint="@color/main_panel_accent_foreground" />

        <LinearLayout
            android:id="@+id/programsPanelItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgramsPanelOverflow"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/main_panel_row_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foreground="@drawable/focus_button_background"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/more_actions"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/main_panel_item_min_width"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/main_panel_item_spacing"
            android:text=""
            android:visibility="gone"
            app:icon="@drawable/ic_more_vert"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_size_normal"
            app:iconTint="@color/main_panel_accent_foreground" />

    </LinearLayout>

</LinearLayout>
