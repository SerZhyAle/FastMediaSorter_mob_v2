<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for FormCheckboxRow compound view.
  Checkbox + title + inline helper on one line, optional subtitle indented below.
  Replaces the repeated "checkbox + subtitle + optional help" structures in the
  resource-entry forms (S0567 survey item 5). Root orientation is VERTICAL (set by the view).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Title line: checkbox + title + helper inline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/fcr_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:duplicateParentState="true"
            android:focusable="false" />

        <TextView
            android:id="@+id/fcr_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/toggler_title_text_size" />

        <ImageButton
            android:id="@+id/fcr_iconHelp"
            android:layout_width="@dimen/settings_help_icon_size"
            android:layout_height="@dimen/settings_help_icon_size"
            android:layout_marginStart="@dimen/settings_help_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription=""
            android:focusable="true"
            android:src="@drawable/ic_help_outline_24"
            app:tint="@color/text_color_secondary"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/fcr_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/checkbox_subtitle_margin_start"
        android:textColor="@color/text_color_secondary"
        android:textSize="@dimen/toggler_desc_text_size"
        android:visibility="gone" />

</merge>
