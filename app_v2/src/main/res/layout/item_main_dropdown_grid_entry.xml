<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btnDropdownItem"
    style="@style/Widget.FastMediaSorter.Button.Text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="start|center_vertical"
    android:minHeight="@dimen/touch_target_min_height"
    android:paddingStart="@dimen/padding_small"
    android:paddingEnd="@dimen/padding_small"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurface"
    android:ellipsize="end"
    android:singleLine="true"
    android:focusable="true"
    android:clickable="true"
    app:iconGravity="start"
    app:iconPadding="@dimen/margin_small"
    app:iconSize="@dimen/icon_size_small"
    tools:icon="@drawable/ic_display"
    tools:text="Program Name" />
