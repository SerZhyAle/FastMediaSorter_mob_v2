<?xml version="1.0" encoding="utf-8"?>
<!--
  S0200 Phase 06: Google Account settings card.
  Focus traversal: every actionable child carries focusable+clickable+nextFocus.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardGoogleAccount"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivAccountIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/s0200_card_title"
            android:src="@drawable/ic_google_account"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAccountTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/s0200_card_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@+id/ivAccountAvatar"
            app:layout_constraintStart_toEndOf="@+id/ivAccountIcon"
            app:layout_constraintTop_toTopOf="@+id/ivAccountIcon"
            app:layout_constraintBottom_toBottomOf="@+id/ivAccountIcon" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAccountAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/s0200_card_title"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAccountSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAccountTitle"
            tools:text="Sign in once to use Google Drive backup and add Drive folders without re-entering your account."
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/tvAccountEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAccountSummary"
            tools:text="user@gmail.com"
            xmlns:tools="http://schemas.android.com/tools" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressAccountAuth"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorSize="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAccountEmail" />

        <!-- Diagnostics toggle sits on the left; the primary action button sits immediately to its right with a small gap. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnosticsToggle"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/s0200_card_diag_show"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressAccountAuth" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccountAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/s0200_card_state_unbound_cta"
            app:layout_constraintStart_toEndOf="@+id/btnDiagnosticsToggle"
            app:layout_constraintTop_toTopOf="@+id/btnDiagnosticsToggle"
            app:layout_constraintBottom_toBottomOf="@+id/btnDiagnosticsToggle" />

        <TextView
            android:id="@+id/tvDiagnosticsLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAccountAction"
            tools:text="Browser detected: Chrome."
            xmlns:tools="http://schemas.android.com/tools" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
