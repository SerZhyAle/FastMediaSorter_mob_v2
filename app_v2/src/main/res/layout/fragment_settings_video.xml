<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/settings_padding">

    <!-- Support video -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:gravity="center_vertical" android:minHeight="@dimen/button_height" android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchSupportVideos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_switch_margin_end" android:checked="true" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/support_video_description" android:textSize="@dimen/toggler_title_text_size" />

        <ImageButton android:id="@+id/iconHelpSupportVideos" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/supported_video_formats" android:src="@android:drawable/ic_menu_help" app:tint="@color/text_color_secondary" />
    </LinearLayout>

    <!-- Show video thumbnails -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_audio_etAudioSizeMax_layout_marginStart" android:layout_marginBottom="@dimen/margin_small" android:gravity="center_vertical" android:minHeight="@dimen/button_height" android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchShowVideoThumbnails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_switch_margin_end" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_video_thumbnails" android:textSize="@dimen/toggler_title_text_size" />

        <ImageButton android:id="@+id/iconHelpVideoThumbnails" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_video_thumbnails_title" android:src="@android:drawable/ic_menu_help" app:tint="@color/text_color_secondary" />
    </LinearLayout>

    <!-- Video size limit -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/margin_small" android:gravity="center_vertical" android:orientation="horizontal">

        <TextView android:id="@+id/tvVideoSizeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/video_size_limit" android:textSize="@dimen/resource_card_desc_text_size" />

        <ImageButton android:id="@+id/iconHelpVideoSizeLimits" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_video_size_limits_title" android:src="@android:drawable/ic_menu_help" app:tint="@color/text_color_secondary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/layoutVideoSizeInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/settings_margin_indent_level_2" android:layout_marginEnd="@dimen/settings_margin_standard" android:layout_marginBottom="@dimen/margin_small" android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilVideoSizeMin" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:hint="@string/fragment_settings_video_tilVideoSizeMin_hint" app:hintTextColor="@color/settings_textinput_hint">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etVideoSizeMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="@integer/input_max_length_filesize" android:textColor="@color/text_color_primary" android:textColorHint="@color/text_color_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilVideoSizeMax" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/fragment_settings_video_tilVideoSizeMax_hint" app:hintTextColor="@color/settings_textinput_hint">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etVideoSizeMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="@integer/input_max_length_filesize" android:textColor="@color/text_color_primary" android:textColorHint="@color/text_color_secondary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSetDefaultVideoPlayer"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/settings_set_default_video_player"
        android:textAllCaps="false" />

</LinearLayout>

