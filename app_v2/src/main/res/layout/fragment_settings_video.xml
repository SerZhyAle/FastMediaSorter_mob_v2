<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_padding">

    <!-- Support video -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/rowSupportVideos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        app:str_title="@string/support_video_description"
        app:str_subtitle="@string/setting_support_videos_desc"
        app:str_showHelp="true"
        app:str_helpTitle="@string/support_video_description"
        app:str_helpMessage="@string/supported_video_formats"
        app:str_checked="true" />

    <!-- Show video thumbnails -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/rowShowVideoThumbnails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fragment_settings_audio_etAudioSizeMax_layout_marginStart"
        android:layout_marginBottom="@dimen/margin_small"
        app:str_title="@string/show_video_thumbnails"
        app:str_subtitle="@string/setting_show_video_thumbnails_desc"
        app:str_showHelp="true"
        app:str_helpTitle="@string/tooltip_video_thumbnails_title"
        app:str_helpMessage="@string/tooltip_video_thumbnails_message" />

    <!-- Video size limit -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/margin_small" android:gravity="center_vertical" android:orientation="horizontal">

        <TextView android:id="@+id/tvVideoSizeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/video_size_limit" android:textSize="@dimen/resource_card_desc_text_size" />

        <ImageButton android:id="@+id/iconHelpVideoSizeLimits" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_video_size_limits_title" android:src="@drawable/ic_help_outline_24" app:tint="@color/text_color_secondary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/layoutVideoSizeInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/settings_margin_indent_level_2" android:layout_marginEnd="@dimen/settings_margin_standard" android:layout_marginBottom="@dimen/margin_small" android:baselineAligned="false" android:gravity="start" android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilVideoSizeMin" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="@dimen/settings_margin_standard" android:hint="@string/fragment_settings_video_tilVideoSizeMin_hint" app:hintTextColor="@color/settings_textinput_hint">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etVideoSizeMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="@integer/input_max_length_filesize" android:textColor="@color/text_color_primary" android:textColorHint="@color/text_color_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilVideoSizeMax" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/fragment_settings_video_tilVideoSizeMax_hint" app:hintTextColor="@color/settings_textinput_hint">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etVideoSizeMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="@integer/input_max_length_filesize" android:textColor="@color/text_color_primary" android:textColorHint="@color/text_color_secondary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSetDefaultVideoPlayer"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/settings_set_default_video_player"
        android:textAllCaps="false" />

    <!-- Video frame snapshot destination resource -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="vertical">

        <!-- Section header with help icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_snapshot_resource_label"
                android:textSize="@dimen/resource_card_desc_text_size" />

            <ImageButton
                android:id="@+id/iconHelpVideoSnapshot"
                android:layout_width="@dimen/settings_help_icon_size"
                android:layout_height="@dimen/settings_help_icon_size"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_video_snapshot_title"
                android:src="@drawable/ic_help_outline_24"
                app:tint="@color/text_color_secondary" />
        </LinearLayout>

        <!-- Current selection + picker button -->
        <LinearLayout
            android:id="@+id/layoutSnapshotResourceSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginStart="@dimen/settings_margin_indent_level_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSelectedSnapshotResource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/video_snapshot_resource_not_set"
                android:textSize="@dimen/toggler_desc_text_size"
                android:textColor="@color/text_color_secondary" />

            <Button
                android:id="@+id/btnSelectSnapshotResource"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:maxWidth="140dp"
                android:maxLines="2"
                android:breakStrategy="balanced"
                android:text="@string/select_snapshot_destination"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnClearSnapshotResource"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_selection"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Frame format: PNG (lossless) or JPG (85% quality, smaller file size) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginStart="@dimen/settings_margin_indent_level_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@string/snapshot_format_label"
                android:textSize="@dimen/toggler_title_text_size" />

            <RadioGroup
                android:id="@+id/rgSnapshotFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSnapshotPng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/snapshot_format_png"
                    android:textSize="@dimen/toggler_title_text_size"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbSnapshotJpg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/snapshot_format_jpg"
                    android:textSize="@dimen/toggler_title_text_size" />

            </RadioGroup>

        </LinearLayout>

        <!-- S0470: also place the extracted frame on the system clipboard -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowVideoFrameCopyToClipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            app:str_title="@string/setting_video_frame_copy_to_clipboard_title"
            app:str_subtitle="@string/setting_video_frame_copy_to_clipboard_summary" />
    </LinearLayout>

    <!-- S0021: Show FPS over flat (non-immersive) player -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/rowPlayerShowFps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        app:str_title="@string/settings_player_show_fps"
        app:str_subtitle="@string/settings_player_show_fps_desc" />

</LinearLayout>
