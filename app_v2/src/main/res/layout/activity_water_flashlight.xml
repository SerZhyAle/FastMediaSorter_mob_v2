<?xml version="1.0" encoding="utf-8"?>
<!--
  S2516: the whole window is the light. Unlike its neighbour the colour is fixed white and not a user
  choice, so it is declared here rather than set at runtime. One orientation-agnostic file on purpose -
  the content is a centred column, which reads the same in portrait and landscape, the same reason
  recorded in activity_front_flashlight.xml.

  No view declares a touch attribute: the screen must be deaf to a wet finger, and the activity consumes
  every touch before it could reach a listener that does not exist.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/waterFlashlightRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_medium">

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_large" />

        <TextView
            android:id="@+id/tvLockedHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:gravity="center"
            android:text="@string/water_flashlight_locked_hint"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>

</FrameLayout>
