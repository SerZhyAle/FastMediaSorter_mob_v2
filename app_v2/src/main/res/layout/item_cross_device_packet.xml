<?xml version="1.0" encoding="utf-8"?>
<!-- S4231: one packet of the Drive queue - who it is from or for, then size, age and state.
     A list row has no landscape variant: the dialogs in both orientations host the same row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_target_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_small"
    android:paddingTop="@dimen/padding_small"
    android:paddingEnd="@dimen/padding_small"
    android:paddingBottom="@dimen/padding_small">

    <TextView
        android:id="@+id/tvPacketTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FastMediaSorter.Item.Title" />

    <TextView
        android:id="@+id/tvPacketDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FastMediaSorter.Item.Detail" />

</LinearLayout>
