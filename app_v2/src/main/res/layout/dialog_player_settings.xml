<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <!-- Title and Buttons at top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_small">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/player_settings_title"
            android:textSize="@dimen/text_size_title_dialog"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginEnd="@dimen/dialog_field_spacing" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply" />

    </LinearLayout>

    <!-- Playback Speed Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_speed"
        android:textSize="@dimen/resource_card_title_text_size"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        app:singleSelection="true"
        app:selectionRequired="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed025"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed025_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed05"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed05_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed1"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed1_text"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed125"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed125_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed15"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed15_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed175"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed175_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed2"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_image_edit_seekSaturation_text" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Repeat Video -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="@dimen/resource_checkbox_min_height"
        android:layout_marginBottom="@dimen/margin_tiny">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbRepeatVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dialog_field_spacing"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/player_repeat_video"
            android:textSize="@dimen/resource_card_title_text_size" />

    </LinearLayout>

    <!-- Subtitles Section -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="@dimen/resource_checkbox_min_height"
        android:layout_marginBottom="@dimen/margin_tiny">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbShowSubtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dialog_field_spacing"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/player_show_subtitles"
            android:textSize="@dimen/resource_card_title_text_size" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtitleLanguageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_subtitle_language"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:layout_marginStart="@dimen/margin_xxlarge"
        android:layout_marginBottom="0dp" />

    <Spinner
        android:id="@+id/spinnerSubtitleLanguage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_color_item_size"
        android:layout_marginStart="@dimen/margin_xxlarge"
        android:layout_marginBottom="@dimen/margin_small"
        android:background="@drawable/spinner_background"
        android:padding="@dimen/padding_small" />

    <!-- Audio Track Section -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_audio_track"
        android:textSize="@dimen/resource_card_title_text_size"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <Spinner
        android:id="@+id/spinnerAudioLanguage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_color_item_size"
        android:layout_marginBottom="@dimen/margin_small"
        android:background="@drawable/spinner_background"
        android:padding="@dimen/padding_small" />

</LinearLayout>
</ScrollView>

