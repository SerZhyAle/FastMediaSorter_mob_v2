<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivResourceTypeIcon"
        android:layout_width="@dimen/toolbar_edit_resource_ivResourceTypeIcon_layout_width"
        android:layout_height="@dimen/toolbar_edit_resource_ivResourceTypeIcon_layout_height"
        android:layout_marginEnd="@dimen/margin_small"
        android:contentDescription="@string/resource_type" />

    <TextView
        android:id="@+id/tvToolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/activity_player_btnInfo_textSize"
        android:textStyle="@string/text_style_bold" />

</LinearLayout>
