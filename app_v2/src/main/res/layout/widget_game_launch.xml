<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_game_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/game_widget_label"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_tiny">

    <ImageView
        android:id="@+id/widget_game_icon"
        android:layout_width="@dimen/widget_icon_size_large"
        android:layout_height="@dimen/widget_icon_size_large"
        android:contentDescription="@string/game_widget_label"
        android:src="@drawable/ic_game_kryvavitsa"
        app:tint="@color/white" />

</LinearLayout>