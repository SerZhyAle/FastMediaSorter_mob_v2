<?xml version="1.0" encoding="utf-8"?>
<!-- S2818: broadcast entry confirmation - the one screen every entry surface opens (strategic ADR-1).
     Live-state views start gone; BroadcastEntryManager swaps them in when the session is running. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/broadcast_entry_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_huge">

    <TextView
        android:id="@+id/broadcast_entry_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/broadcast_entry_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:id="@+id/broadcast_entry_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:gravity="center"
        android:text="@string/broadcast_entry_description"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <TextView
        android:id="@+id/broadcast_entry_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large"
        android:text="@string/broadcast_entry_live"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/broadcast_entry_mode_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_normal"
        android:text="@string/broadcast_entry_mode_label"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <RadioGroup
        android:id="@+id/broadcast_entry_mode_radio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/broadcast_entry_mode_audio_only"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:focusable="true"
            android:clickable="true"
            android:minHeight="@dimen/touch_target_min_height"
            android:text="@string/broadcast_entry_mode_audio_only" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/broadcast_entry_mode_video_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:minHeight="@dimen/touch_target_min_height"
            android:text="@string/broadcast_entry_mode_video_audio" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/broadcast_entry_mode_video_only"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:minHeight="@dimen/touch_target_min_height"
            android:text="@string/broadcast_entry_mode_video_only" />
    </RadioGroup>

    <!-- S3038: lens choice for the camera modes; BroadcastLensChipsRenderer fills and shows it. -->
    <TextView
        android:id="@+id/broadcast_entry_lens_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_normal"
        android:text="@string/broadcast_entry_lens_label"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:visibility="gone" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/broadcast_entry_lens_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/broadcast_entry_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusUp="@id/broadcast_entry_mode_radio_group"
        android:minHeight="@dimen/touch_target_min_height"
        android:minWidth="@dimen/touch_target_min_height"
        android:text="@string/broadcast_entry_start" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/broadcast_entry_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:minHeight="@dimen/touch_target_min_height"
        android:minWidth="@dimen/touch_target_min_height"
        android:text="@string/broadcast_action_stop"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/broadcast_entry_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_normal"
        android:minHeight="@dimen/touch_target_min_height"
        android:minWidth="@dimen/touch_target_min_height"
        android:text="@string/cancel" />
</LinearLayout>
