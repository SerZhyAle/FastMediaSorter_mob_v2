<?xml version="1.0" encoding="utf-8"?>
<!-- S0756: horizontal streams panel for the main window. A wide "Streams" entry button leads, then the
     pinned channels scroll horizontally with fade edges. Visibility owned by MainActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/main_panel_row_height"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/main_panel_item_spacing"
    android:visibility="gone">

    <!-- Wider, offset entry button visually distinct from the pinned channel chips. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStreamsPanelEntry"
        style="@style/Widget.FastMediaSorter.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_panel_row_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:foreground="@drawable/focus_button_background"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/streams_title"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="@dimen/main_streams_entry_min_width"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/main_panel_item_spacing"
        android:text="@string/streams_title"
        android:textColor="?attr/colorControlNormal"
        app:icon="@drawable/ic_video"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/activity_main_btnFilter_iconPadding"
        app:iconSize="@dimen/icon_size_normal"
        app:iconTint="?attr/colorControlNormal" />

    <!-- S0770: per-item menu for the Streams entry (Open / Open in new window; no Remove). Always shown
         because the entry always carries a label. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStreamsEntryMenu"
        style="@style/Widget.FastMediaSorter.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_panel_row_height"
        android:layout_marginEnd="@dimen/main_streams_entry_margin_end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:foreground="@drawable/focus_button_background"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/more_actions"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="0dp"
        android:text=""
        app:icon="@drawable/ic_more_vert"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_size_normal"
        app:iconTint="?attr/colorControlNormal" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStreamChannels"
        android:layout_width="0dp"
        android:layout_height="@dimen/main_panel_row_height"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="@dimen/main_panel_fading_edge"
        android:requiresFadingEdge="horizontal"
        android:nextFocusUp="@id/btnStreamsPanelEntry"
        tools:listitem="@layout/item_main_stream_channel"
        xmlns:tools="http://schemas.android.com/tools" />

</LinearLayout>
