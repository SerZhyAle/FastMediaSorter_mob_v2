<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_capture_surface"
    android:keepScreenOn="true"
    tools:context=".ui.cameracapture.CameraCaptureActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fitCenter" />

    <!-- S1066: result frame - marks the saved-file bounds inside the full-frame preview (photo, 16:9). -->
    <com.sza.fastmediasorter.ui.cameracapture.ResultFrameOverlayView
        android:id="@+id/resultFrameOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewViewCamera"
        app:layout_constraintEnd_toEndOf="@id/previewViewCamera"
        app:layout_constraintStart_toStartOf="@id/previewViewCamera"
        app:layout_constraintTop_toTopOf="@id/previewViewCamera"
        tools:visibility="visible" />

    <com.sza.fastmediasorter.ui.cameracapture.FocusRingOverlayView
        android:id="@+id/focusRingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="@id/previewViewCamera"
        app:layout_constraintEnd_toEndOf="@id/previewViewCamera"
        app:layout_constraintStart_toStartOf="@id/previewViewCamera"
        app:layout_constraintTop_toTopOf="@id/previewViewCamera" />

    <com.sza.fastmediasorter.ui.cameracapture.GridOverlayView
        android:id="@+id/cameraGridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewViewCamera"
        app:layout_constraintEnd_toEndOf="@id/previewViewCamera"
        app:layout_constraintStart_toStartOf="@id/previewViewCamera"
        app:layout_constraintTop_toTopOf="@id/previewViewCamera"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/cameraTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCamera"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/close"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_cancel"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke" />

        <com.sza.fastmediasorter.ui.cameracapture.OutlinedTextView
            android:id="@+id/cameraSaveDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Saves to: Camera"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleCameraMicrophone"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/camera_capture_microphone"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_capture_microphone"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_microphone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraFlash"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/camera_control_flash"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_flash"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_camera_flash_off"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <!-- S0753: night-mode toggle; shown only when the active lens supports the NIGHT extension (photo). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraNight"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/camera_control_night"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_night"
            android:visibility="gone"
            app:icon="@drawable/ic_camera_night_off"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            tools:visibility="visible" />

        <!-- S0753: macro toggle; shown only on a lens that can focus close (photo). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraMacro"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/camera_control_macro"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_macro"
            android:visibility="gone"
            app:icon="@drawable/ic_camera_macro_off"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraSettings"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/camera_settings_title"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_settings_title"
            app:icon="@drawable/ic_camera_settings"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- S0566: recording timer overlay, centered in the top-bar row, shown only while recording. -->
    <LinearLayout
        android:id="@+id/cameraRecordingTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_camera_timer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cameraTopBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cameraTopBar"
        tools:visibility="visible">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/recording_indicator_dot" />

        <TextView
            android:id="@+id/txtRecordingTimer"
            style="@style/Widget.FastMediaSorter.Camera.OverlayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="00:05" />
    </LinearLayout>

    <TextView
        android:id="@+id/cameraCountdownOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_camera_timer"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="42sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3"
        tools:visibility="visible" />

    <!-- S0812: scenario context label (e.g. text recognition); sits above the zoom presets, hidden for generic capture. -->
    <com.sza.fastmediasorter.ui.cameracapture.OutlinedTextView
        android:id="@+id/cameraScenarioLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cameraZoomPresetGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Text recognition"
        tools:visibility="visible" />

    <!-- S0566/S0753: always-visible zoom presets (half-size, see-through); hidden when no zoom range. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cameraZoomPresetGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/camera_control_zoom"
        android:visibility="gone"
        app:chipSpacingHorizontal="6dp"
        app:layout_constraintBottom_toTopOf="@id/cameraZoomSlider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:singleLine="true"
        app:singleSelection="true"
        tools:visibility="visible" />

    <!-- S0753: continuous zoom slider directly under the preset chips; gone when the lens cannot zoom. -->
    <com.google.android.material.slider.Slider
        android:id="@+id/cameraZoomSlider"
        app:thumbColor="@android:color/white"
        app:trackColorActive="@color/camera_capture_control_stroke"
        app:trackColorInactive="@color/camera_capture_slider_inactive"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/camera_control_zoom"
        android:focusable="true"
        android:stepSize="0"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="1"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cameraModeSelector"
        app:layout_constraintEnd_toStartOf="@id/cameraZoomValue"
        app:layout_constraintStart_toStartOf="@id/cameraZoomPresetGroup"
        tools:visibility="visible" />

    <!-- S0753: live zoom readout to the right of the slider. -->
    <com.sza.fastmediasorter.ui.cameracapture.OutlinedTextView
        android:id="@+id/cameraZoomValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="end"
        android:minWidth="44dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cameraZoomSlider"
        app:layout_constraintEnd_toEndOf="@id/cameraZoomPresetGroup"
        app:layout_constraintStart_toEndOf="@id/cameraZoomSlider"
        app:layout_constraintTop_toTopOf="@id/cameraZoomSlider"
        tools:text="1.0×"
        tools:visibility="visible" />

    <!-- S0566: One UI text mode selector replacing the outlined toggle group; shown when switching is allowed. -->
    <HorizontalScrollView
        android:id="@+id/cameraModeSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cameraActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/cameraModeSelectorTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.sza.fastmediasorter.ui.cameracapture.OutlinedTextView
                android:id="@+id/tabModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/camera_mode_photo"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/camera_mode_photo"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <com.sza.fastmediasorter.ui.cameracapture.OutlinedTextView
                android:id="@+id/tabModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/camera_mode_video"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/camera_mode_video"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/cameraActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnGalleryThumbnail"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|start"
            android:clickable="true"
            android:contentDescription="@string/camera_gallery_preview"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FastMediaSorter.Circle"
            app:strokeColor="@color/camera_capture_control_stroke"
            app:strokeWidth="1dp"
            tools:src="@drawable/ic_camera_capture"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraPauseResume"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/camera_control_pause"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_pause"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapturePhoto"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cmd_camera_capture"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:tooltipText="@string/cmd_camera_capture"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_shutter_photo"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="44dp"
            app:iconTint="@color/camera_capture_shutter_icon" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraSendTo"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|center_horizontal"
            android:contentDescription="@string/camera_control_send_to"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_send_to"
            android:translationX="-88dp"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_camera_send_to"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraLensSwitch"
            style="@style/Widget.FastMediaSorter.Camera.OverlayButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/camera_control_switch_lens"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_switch_lens"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_camera_switch"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <!-- S0753: active-lens label (e.g. 0.6x / 1x / Front), sits just left of the switch button. -->
        <com.sza.fastmediasorter.ui.cameracapture.OutlinedTextView
            android:id="@+id/cameraLensLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="64dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="0.6×"
            tools:visibility="visible" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
