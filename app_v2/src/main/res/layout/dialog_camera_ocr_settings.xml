<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- S0361: OCR source-language picker. Changing it re-runs recognition over the retained
             (cropped) image with the new source language, then re-translates. -->

        <!-- OCR Source Language Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/translation_source_language"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/spinnerSourceLanguage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/item_focus_selector"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/colorOnSurface" />

        <!-- Target Language Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/translation_target_language"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/spinnerTargetLanguage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/item_focus_selector"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/colorOnSurface" />

        <!-- OCR Only -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/cbOcrOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:str_title="@string/setting_camera_ocr_only_title"
            app:str_subtitle="@string/setting_camera_ocr_only_desc" />

    </LinearLayout>

</ScrollView>
