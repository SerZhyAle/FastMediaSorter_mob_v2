<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced welcome page layout with feature highlight cards below description.
     All sizes reference @dimen so they automatically scale across:
       sw320dp  → tiny phones / watch-style 400×400 screens
       sw480dp  → mid-range phones
       sw600dp  → 7" tablets
       sw720dp  → Android TV / 10"+ tablets
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/welcome_page_padding">

        <!-- Centred content column capped at welcome_content_max_width so text
             doesn't stretch across a 55" TV screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/welcome_content_max_width">

            <!-- Hero Image -->
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/welcome_icon_size"
                android:layout_height="@dimen/welcome_icon_size"
                android:layout_marginTop="@dimen/welcome_icon_margin_top"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/welcome_title_margin_top"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/welcome_title_text_size"
                android:textStyle="bold"
                tools:text="Welcome to FastMediaSorter!" />

            <!-- Description / Subtitle -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/welcome_description_margin_top"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/welcome_description_text_size"
                android:lineSpacingMultiplier="1.3"
                android:alpha="0.85"
                tools:text="Your all-in-one media organizer" />

            <!-- Feature Cards Row -->
            <LinearLayout
                android:id="@+id/layoutFeatureCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/welcome_description_margin_top"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Feature Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeature1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/welcome_feature_card_margin"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="@android:color/transparent"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/welcome_feature_card_padding">

                        <ImageView
                            android:id="@+id/ivFeature1"
                            android:layout_width="@dimen/welcome_feature_card_icon_size"
                            android:layout_height="@dimen/welcome_feature_card_icon_size"
                            android:contentDescription="Feature 1"
                            app:tint="?attr/colorPrimary"
                            tools:src="@drawable/ic_image" />

                        <TextView
                            android:id="@+id/tvFeature1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textSize="@dimen/welcome_feature_card_text_size"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="Photos &amp; Videos" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Feature Card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeature2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/welcome_feature_card_margin"
                    android:layout_marginEnd="@dimen/welcome_feature_card_margin"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="@android:color/transparent"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/welcome_feature_card_padding">

                        <ImageView
                            android:id="@+id/ivFeature2"
                            android:layout_width="@dimen/welcome_feature_card_icon_size"
                            android:layout_height="@dimen/welcome_feature_card_icon_size"
                            android:contentDescription="Feature 2"
                            app:tint="?attr/colorPrimary"
                            tools:src="@drawable/ic_resource_cloud" />

                        <TextView
                            android:id="@+id/tvFeature2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textSize="@dimen/welcome_feature_card_text_size"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="Cloud Storage" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Feature Card 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeature3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/welcome_feature_card_margin"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="@android:color/transparent"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/welcome_feature_card_padding">

                        <ImageView
                            android:id="@+id/ivFeature3"
                            android:layout_width="@dimen/welcome_feature_card_icon_size"
                            android:layout_height="@dimen/welcome_feature_card_icon_size"
                            android:contentDescription="Feature 3"
                            app:tint="?attr/colorPrimary"
                            tools:src="@drawable/ic_sort" />

                        <TextView
                            android:id="@+id/tvFeature3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textSize="@dimen/welcome_feature_card_text_size"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="Smart Sorting" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
