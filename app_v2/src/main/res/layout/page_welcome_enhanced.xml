<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced welcome page: compact header (hero icon + title + short summary) pinned at the top,
     then a scrollable body holding the optional language picker, an adaptive grid of feature blocks
     (column count from @integer/welcome_feature_grid_columns), and the multi-paragraph details block.
     The page itself never scrolls - only the body ScrollView does. Content capped at
     welcome_content_max_width and centred for wide / TV screens.
     All ids must stay in sync with the landscape variant (layout-land/page_welcome_enhanced.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/welcome_page_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_max="@dimen/welcome_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Header: hero icon -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/welcome_icon_size"
            android:layout_height="@dimen/welcome_icon_size"
            android:layout_marginTop="@dimen/welcome_icon_margin_top"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header: title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_title_margin_top"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/welcome_title_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivIcon"
            tools:text="Powerful Extras" />

        <!-- Header: short summary -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/welcome_description_text_size"
            android:lineSpacingMultiplier="1.3"
            android:alpha="0.85"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="Go beyond simple media viewing." />

        <!-- Scrollable body: language picker (page 1 only) + feature grid + details.
             S1380: the body is longer than its viewport, so the line sitting on the bottom edge was
             cut through the middle of its glyphs. The fading edge makes that read as "more below"
             instead of as a rendering fault. Keep in sync with layout-land. -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="@dimen/welcome_body_fading_edge"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Language: visible only on the first Welcome page. S1190 replaced the three-position
                     switch - the interface language set is data now and no longer fits a fixed strip, so
                     this control shows the current language and opens the searchable picker. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWelcomeLanguage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone"
                    android:contentDescription="@string/welcome_language_picker_hint"
                    tools:text="English" />

                <!-- Theme picker: visible only on the first Welcome page. Mirrors the language picker
                     (styling, focusability) and recreates the activity immediately after a selection
                     so the current welcome page redraws in the chosen app theme. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/layoutThemePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:visibility="gone"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeAuto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/welcome_theme_auto"
                        android:contentDescription="@string/welcome_theme_picker_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLight"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/welcome_theme_light"
                        android:contentDescription="@string/welcome_theme_picker_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeDark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/welcome_theme_dark"
                        android:contentDescription="@string/welcome_theme_picker_hint" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Caption: selection applies immediately to the current welcome flow. -->
                <TextView
                    android:id="@+id/tvThemeAppliesHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:visibility="gone"
                    android:text="@string/welcome_theme_applies_after_setup" />

                <!-- S0404 / S1104: launcher-mode toggle - gone by default; shown only on the first page in
                     builds that ship the launcher surface (WelcomePage.showLauncherModeToggle). Canonical
                     SettingsToggleRow (switch-left "Trigger Row") so it matches every other app toggle, incl.
                     the capability rows on the functionality page. -->
                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                    android:id="@+id/rowWelcomeLauncherMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:visibility="gone"
                    app:str_icon="@drawable/ic_launcher_mode"
                    app:str_title="@string/launcher_welcome_toggle_title" />

                <!-- Adaptive feature-block grid (populated programmatically; columnCount set at runtime) -->
                <GridLayout
                    android:id="@+id/gridFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:columnCount="2"
                    android:useDefaultMargins="false" />

                <!-- Multi-paragraph details -->
                <TextView
                    android:id="@+id/tvDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:gravity="center|top"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_description_text_size"
                    android:lineSpacingMultiplier="1.3"
                    tools:text="A longer, multi-paragraph explanation of the extra capabilities." />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
