<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding_large">

        <!-- Title and Close button at top -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_large">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gif_edit_title"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.FastMediaSorter.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvGifPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:ellipsize="middle"
            android:singleLine="true"
            android:layout_marginBottom="@dimen/margin_xlarge" />

        <!-- Extract Frames Section -->
        <com.sza.fastmediasorter.ui.common.widget.ActionHelpRow
            android:id="@+id/rowExtractFrames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            app:ahr_buttonText="@string/gif_edit_extract_frames"
            app:ahr_showHelp="true"
            app:ahr_helpTitle="@string/help"
            app:ahr_helpMessage="@string/gif_edit_extract_help" />

        <!-- Speed Control Section -->
        <TextView
            android:id="@+id/tvSpeedSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gif_edit_speed"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small" />

        <TextView
            android:id="@+id/tvSpeedValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gif_edit_speed_normal"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_small" />

        <LinearLayout
            android:id="@+id/layoutSpeedSeekRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_small">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gif_edit_speed_slower"
                android:textSize="@dimen/text_size_small"
                android:layout_marginEnd="@dimen/dialog_field_spacing" />

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="@integer/seekbar_max_percent"
                android:progress="@integer/seekbar_default_half" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gif_edit_speed_faster"
                android:textSize="@dimen/text_size_small"
                android:layout_marginStart="@dimen/dialog_field_spacing" />

        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.ActionHelpRow
            android:id="@+id/layoutSpeedApplyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            app:ahr_buttonText="@string/gif_edit_apply_speed"
            app:ahr_showHelp="true"
            app:ahr_helpTitle="@string/help"
            app:ahr_helpMessage="@string/gif_edit_speed_help" />

        <!-- First Frame to Image Section -->
        <TextView
            android:id="@+id/tvFirstFrameSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gif_edit_first_frame"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small" />

        <com.sza.fastmediasorter.ui.common.widget.ActionHelpRow
            android:id="@+id/layoutFirstFrameRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ahr_buttonText="@string/gif_edit_save_first_frame"
            app:ahr_showHelp="true"
            app:ahr_helpTitle="@string/help"
            app:ahr_helpMessage="@string/gif_edit_first_frame_help" />

    </LinearLayout>

</ScrollView>


