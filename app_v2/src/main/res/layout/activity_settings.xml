<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar container: back, title and page actions (portrait) -->
    <LinearLayout android:id="@+id/toolbarContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?attr/colorPrimary" android:elevation="@dimen/dimension_zero" app:layout_constraintTop_toTopOf="parent">

        <!-- Title row with back button and settings text -->
        <LinearLayout android:id="@+id/titleRow" android:layout_width="match_parent" android:layout_height="@dimen/settings_title_row_height" android:background="?attr/colorPrimary" android:elevation="@dimen/dimension_zero" android:orientation="horizontal" android:gravity="center_vertical">

            <!-- UI-SIZING rule 4: match_parent height so compact mode's 24 dp row shrinks the target with the row -->
            <ImageButton android:id="@+id/backButton" android:layout_width="@dimen/touch_target_min_height" android:layout_height="match_parent" android:src="@drawable/ic_arrow_back" android:background="?attr/colorPrimary" android:elevation="@dimen/dimension_zero" android:contentDescription="@string/back" app:tint="?attr/colorOnPrimary" />

            <!-- Settings title -->
            <TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings" android:drawableStart="@drawable/ic_settings" android:drawableTint="?attr/colorOnPrimary" android:drawablePadding="@dimen/toolbar_title_icon_gap" android:textColor="?attr/colorOnPrimary" android:textSize="@dimen/activity_player_btnInfo_textSize" android:textStyle="bold" tools:ignore="SpUsage" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- S4394: collapse-all for the current page; triangle up = drop-down glyph rotated, gone until a group is expanded -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCollapseAllGroups"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_collapse_all"
                android:rotation="180"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconTint="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingsHelp"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/help"
                app:icon="@drawable/ic_help_outline"
                app:iconTint="?attr/colorOnPrimary" />

            <ImageButton android:id="@+id/searchButton" android:layout_width="@dimen/touch_target_min_height" android:layout_height="match_parent" android:background="?attr/colorPrimary" android:contentDescription="@string/settings_search_open" android:src="@drawable/ic_search" app:tint="?attr/colorOnPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- S4621: the page menu at reading start and the content pane at reading end (SETTINGS-NAVIGATION 2.1 section 2).
         SettingsNavigationRailManager decides the presentation at runtime from isWideLayout(): this activity absorbs
         rotation, so every layout variant carries the same panes and none of them encodes the breakpoint. -->
    <LinearLayout android:id="@+id/settingsPanes" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/toolbarContainer" app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/settingsRail" android:layout_width="@dimen/settings_rail_width" android:layout_height="match_parent" android:background="?attr/colorSurface" android:clipToPadding="false" android:paddingTop="@dimen/margin_small" android:paddingBottom="@dimen/margin_small" android:contentDescription="@string/settings" android:scrollbars="vertical" />

        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPager" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout android:id="@+id/searchOverlay" android:layout_width="match_parent" android:layout_height="0dp" android:background="?attr/colorSurface" android:elevation="@dimen/elevation_player_overlay" android:orientation="vertical" android:padding="@dimen/settings_padding" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/toolbarContainer" app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

            <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/settings_search_hint" android:imeOptions="actionSearch|flagNoExtractUi" android:inputType="text" android:maxLines="1" />

            <ImageButton android:id="@+id/searchCloseButton" android:layout_width="@dimen/button_height" android:layout_height="@dimen/button_height" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/settings_search_close" android:src="@drawable/ic_clear" app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView android:id="@+id/searchEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_medium" android:text="@string/settings_search_no_results" android:textColor="?attr/colorOnSurface" android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchResultsRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/margin_small" android:layout_weight="1" tools:listitem="@layout/item_settings_search_result" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
