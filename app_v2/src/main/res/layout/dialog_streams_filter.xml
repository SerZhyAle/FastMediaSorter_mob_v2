<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <LinearLayout
        android:id="@+id/rowCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_height"
        android:orientation="horizontal"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streams_filter_category"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/resource_card_desc_text_size" />

        <TextView
            android:id="@+id/tvCategoryValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dialog_field_spacing"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/resource_card_desc_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_height"
        android:orientation="horizontal"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streams_filter_language"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/resource_card_desc_text_size" />

        <TextView
            android:id="@+id/tvLanguageValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dialog_field_spacing"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/resource_card_desc_text_size" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/streams_filter_media_kind"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/toggler_desc_text_size" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleMediaKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMediaAll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streams_filter_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMediaAudio"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streams_filter_media_audio" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMediaVideo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streams_filter_media_video" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- S0696: quick facet limiting the list to the channels the user pinned themselves. -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkPinnedOnly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_normal"
        android:minHeight="@dimen/list_item_height"
        android:text="@string/streams_filter_pinned_only"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/resource_card_desc_text_size" />

</LinearLayout>
