<?xml version="1.0" encoding="utf-8"?>
<!-- S4405: one dialog for the share panel and the broadcast settings row; a dialog, so no landscape variant. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dialog_padding_large"
        android:paddingTop="@dimen/margin_small">

        <RadioGroup
            android:id="@+id/groupLinkPasswordMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioLinkPasswordAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min_height"
                android:nextFocusDown="@+id/radioLinkPasswordNone"
                android:text="@string/broadcast_link_password_mode_auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkPasswordGenerate"
                style="@style/Widget.FastMediaSorter.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_large"
                android:minHeight="@dimen/touch_target_min_height"
                android:contentDescription="@string/broadcast_link_password_generate_cd"
                android:text="@string/broadcast_link_password_generate"
                android:visibility="gone" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioLinkPasswordNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min_height"
                android:nextFocusDown="@+id/radioLinkPasswordCustom"
                android:text="@string/broadcast_link_password_mode_none" />

            <TextView
                android:id="@+id/textLinkPasswordNoneNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_large"
                android:text="@string/broadcast_link_password_none_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioLinkPasswordCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min_height"
                android:nextFocusDown="@+id/etLinkPassword"
                android:text="@string/broadcast_link_password_mode_custom" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLinkPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/broadcast_link_password_field_hint"
            android:visibility="gone"
            app:endIconContentDescription="@string/broadcast_link_password_show_cd"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLinkPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone|flagNoExtractUi|flagNoPersonalizedLearning"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:nextFocusUp="@id/radioLinkPasswordCustom"
                android:nextFocusDown="@+id/btnLinkPasswordApply"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkPasswordCancel"
                style="@style/Widget.FastMediaSorter.Button.DialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_small"
                android:minHeight="@dimen/touch_target_min_height"
                android:nextFocusRight="@+id/btnLinkPasswordApply"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkPasswordApply"
                style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min_height"
                android:nextFocusLeft="@id/btnLinkPasswordCancel"
                android:text="@string/apply" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
