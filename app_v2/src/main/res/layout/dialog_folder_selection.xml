<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/padding_large">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Special Virtual Folders Section -->
        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader android:id="@+id/headerSpecialFolders" android:layout_width="match_parent" android:layout_height="wrap_content" app:csh_title="@string/special_virtual_folders" app:csh_expanded="true" />

        <LinearLayout android:id="@+id/containerSpecialFolders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Flow chip group: text-sized buttons wrap to new lines -->
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_tiny">

            <androidx.constraintlayout.helper.widget.Flow android:id="@+id/flowVirtualFolders" android:layout_width="0dp" android:layout_height="wrap_content" app:flow_wrapMode="chain" app:flow_horizontalStyle="packed" app:flow_horizontalBias="0" app:flow_verticalBias="0" app:flow_horizontalGap="@dimen/margin_small" app:flow_verticalGap="@dimen/margin_tiny" app:constraint_referenced_ids="btnVirtualRecent,btnVirtualAllMusic,btnVirtualAllVideo,btnVirtualCameraPhotos,btnVirtualAllImages,btnVirtualAllDocs" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVirtualRecent" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recent_media" android:textSize="@dimen/text_size_small" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVirtualAllMusic" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/virtual_all_music" android:textSize="@dimen/text_size_small" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVirtualAllVideo" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/virtual_all_video" android:textSize="@dimen/text_size_small" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVirtualCameraPhotos" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/virtual_camera_photos" android:textSize="@dimen/text_size_small" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVirtualAllImages" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/virtual_all_images" android:textSize="@dimen/text_size_small" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVirtualAllDocs" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/virtual_all_docs" android:textSize="@dimen/text_size_small" app:iconSize="@dimen/icon_size_menu" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="@dimen/item_divider_height" android:background="?android:attr/listDivider" android:layout_marginVertical="@dimen/margin_small" />

        <!-- Quick Select Section -->
        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader android:id="@+id/headerQuickFolders" android:layout_width="match_parent" android:layout_height="wrap_content" app:csh_title="@string/quick_select_common_folders" app:csh_expanded="true" />

        <LinearLayout android:id="@+id/containerQuickFolders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Root Folder -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRoot" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginBottom="@dimen/margin_small" android:text="@string/folder_root" android:textSize="@dimen/resource_text_13sp" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_button" />

        <!-- Flow chip group: text-sized buttons wrap to new lines -->
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_tiny">

            <androidx.constraintlayout.helper.widget.Flow android:id="@+id/flowQuickFolders" android:layout_width="0dp" android:layout_height="wrap_content" app:flow_wrapMode="chain" app:flow_horizontalStyle="packed" app:flow_horizontalBias="0" app:flow_verticalBias="0" app:flow_horizontalGap="@dimen/margin_small" app:flow_verticalGap="@dimen/margin_tiny" app:constraint_referenced_ids="btnDCIM,btnPictures,btnDownload,btnDocuments,btnWhatsApp,btnTelegram" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnDCIM" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/folder_dcim" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnPictures" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/folder_pictures" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnDownload" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/folder_download" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnDocuments" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/folder_documents" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnWhatsApp" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/folder_whatsapp" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnTelegram" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/folder_telegram" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Instagram -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnInstagram" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginBottom="@dimen/margin_medium" android:text="@string/folder_instagram" android:textSize="@dimen/text_size_small" app:icon="@drawable/ic_resource_local" app:iconSize="@dimen/icon_size_menu" />

        </LinearLayout>

        <!-- Removable media - filled at runtime, hidden while nothing is connected -->
        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader android:id="@+id/headerRemovableVolumes" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:csh_title="@string/removable_volumes_section" app:csh_expanded="true" />

        <LinearLayout android:id="@+id/containerRemovableVolumes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="@dimen/item_divider_height" android:background="?android:attr/listDivider" android:layout_marginVertical="@dimen/margin_small" />

        <!-- Manual Path Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/or_enter_path_manually" android:textStyle="bold" android:textSize="@dimen/resource_card_title_text_size" android:layout_marginBottom="@dimen/margin_small" />

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilManualPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/folder_path" app:helperText="@string/folder_path_hint" app:helperTextEnabled="true" app:helperTextTextAppearance="@style/TextAppearance.FastMediaSorter.HelperText">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etManualPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:imeOptions="flagNoExtractUi" android:text="@string/dialog_folder_selection_etManualPath_text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnValidatePath" style="@style/Widget.FastMediaSorter.Button.Filled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/validate_and_select" android:layout_marginTop="@dimen/margin_tiny" android:layout_marginBottom="@dimen/margin_medium" app:icon="@drawable/ic_search" />

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="@dimen/item_divider_height" android:background="?android:attr/listDivider" android:layout_marginVertical="@dimen/margin_small" />

        <!-- SAF Picker Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/or_use_system_picker" android:textStyle="bold" android:textSize="@dimen/resource_card_title_text_size" android:layout_marginBottom="@dimen/margin_small" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnBrowseWithSAF" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/browse_with_system_picker" app:icon="@drawable/ic_search" />

    </LinearLayout>

</ScrollView>

