<?xml version="1.0" encoding="utf-8"?>
<!-- S1433: one stored measurement. The outcome is a word rather than a coloured dot, so the row still
     reads correctly in a grayscale screenshot and to a screen reader. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_small"
    android:paddingTop="@dimen/margin_small"
    android:paddingEnd="@dimen/margin_small"
    android:paddingBottom="@dimen/margin_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/measurementTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_small"
            tools:text="9 Aug, 14:21" />

        <TextView
            android:id="@+id/measurementOutcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_small"
            tools:text="@string/network_monitor_history_outcome_ok" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/measurementKind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            tools:text="@string/network_monitor_history_kind_speed_test" />

        <TextView
            android:id="@+id/measurementNetwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_small"
            tools:text="Home-5G" />
    </LinearLayout>

    <TextView
        android:id="@+id/measurementResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_small"
        tools:text="Internet: measured" />
</LinearLayout>
