<?xml version="1.0" encoding="utf-8"?>
<!-- S4184: the optional larger steps; one file so the portrait and landscape screens cannot drift apart. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus3"
            style="@style/Widget.FastMediaSorter.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            tools:text="+3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus5"
            style="@style/Widget.FastMediaSorter.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_normal"
            android:layout_weight="1"
            android:focusable="true"
            tools:text="+5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus10"
            style="@style/Widget.FastMediaSorter.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_normal"
            android:layout_weight="1"
            android:focusable="true"
            tools:text="+10" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus50"
            style="@style/Widget.FastMediaSorter.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            tools:text="+50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus100"
            style="@style/Widget.FastMediaSorter.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_normal"
            android:layout_weight="1"
            android:focusable="true"
            tools:text="+100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus1000"
            style="@style/Widget.FastMediaSorter.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_normal"
            android:layout_weight="1"
            android:focusable="true"
            tools:text="+1000" />
    </LinearLayout>
</LinearLayout>
