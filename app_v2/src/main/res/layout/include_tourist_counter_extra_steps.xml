<?xml version="1.0" encoding="utf-8"?>
<!-- S4184: the optional larger steps; one file so the portrait and landscape screens cannot drift apart. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flowExtraSteps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btnPlus3,btnPlus5,btnPlus10,btnPlus50,btnPlus100,btnPlus1000"
        app:flow_wrapMode="chain"
        app:flow_horizontalStyle="packed"
        app:flow_horizontalBias="0"
        app:flow_verticalAlign="top"
        app:flow_horizontalGap="@dimen/token_spacing_8"
        app:flow_verticalGap="@dimen/token_spacing_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlus3"
        style="@style/Widget.FastMediaSorter.Button.Command.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        tools:text="+3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlus5"
        style="@style/Widget.FastMediaSorter.Button.Command.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        tools:text="+5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlus10"
        style="@style/Widget.FastMediaSorter.Button.Command.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        tools:text="+10" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlus50"
        style="@style/Widget.FastMediaSorter.Button.Command.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        tools:text="+50" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlus100"
        style="@style/Widget.FastMediaSorter.Button.Command.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        tools:text="+100" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlus1000"
        style="@style/Widget.FastMediaSorter.Button.Command.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        tools:text="+1000" />
</androidx.constraintlayout.widget.ConstraintLayout>
