<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowSystemInfoField"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/focus_button_background"
    android:minHeight="@dimen/touch_target_min_height">

    <!-- S4283: the faint band of every second row lives on a child surface, so the row root keeps its
         focus state; the adapter only toggles this view. -->
    <View
        android:id="@+id/viewRowShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_system_info_row_shaded"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_normal"
        android:paddingVertical="@dimen/margin_tiny">

        <TextView
            android:id="@+id/tvFieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FastMediaSorter.Item.Subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="bold"
            tools:text="Manufacturer:" />

        <TextView
            android:id="@+id/tvFieldValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.FastMediaSorter.Item.Title"
            android:textColor="?attr/colorOnSurface"
            tools:text="Google" />

    </LinearLayout>

</FrameLayout>
