<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdfControlsLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/player_pdf_controls_padding_vertical"
    android:paddingHorizontal="@dimen/player_pdf_controls_padding_horizontal"
    android:elevation="@dimen/elevation_player_controls"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/btnPdfPrevPage"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_skip_previous"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/activity_player_unified_btnEpubNextChapter_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:contentDescription="@string/previous_page" />

    <ImageButton
        android:id="@+id/btnPdfHome"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_fast_rewind"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/activity_player_unified_btnPdfHome_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginStart="@dimen/player_pdf_button_margin"
        android:contentDescription="@string/to_begin" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btnPdfZoomOut"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_zoom_out"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:contentDescription="@string/zoom_out" />

    <TextView
        android:id="@+id/tvPdfPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_dark"
        android:paddingHorizontal="@dimen/player_indicator_padding"
        android:paddingVertical="@dimen/player_indicator_padding_vertical"
        android:textColor="@color/white"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:text="@string/activity_player_unified_tvPdfPageIndicator_text"
        android:layout_marginHorizontal="@dimen/player_indicator_margin" />

    <ImageButton
        android:id="@+id/btnPdfZoomIn"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_zoom_in"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:contentDescription="@string/zoom_in" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btnTranslatePdf"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_translate"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginStart="@dimen/player_pdf_button_margin"
        android:visibility="gone"
        android:contentDescription="@string/translate_page" />

    <ImageButton
        android:id="@+id/btnTranslationFontDecrease"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:src="@drawable/ic_zoom_out"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_button_padding_small"
        android:layout_marginStart="@dimen/player_button_margin_small"
        android:visibility="gone"
        android:contentDescription="@string/decrease_translation_font" />

    <ImageButton
        android:id="@+id/btnTranslationFontIncrease"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:src="@drawable/ic_zoom_in"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_button_padding_small"
        android:layout_marginStart="@dimen/player_button_margin_small"
        android:visibility="gone"
        android:contentDescription="@string/increase_translation_font" />

    <ImageButton
        android:id="@+id/btnGoogleLensPdf"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_google_lens"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginStart="@dimen/player_button_margin_small"
        android:visibility="gone"
        android:contentDescription="@string/google_lens" />

    <TextView
        android:id="@+id/btnSelectTextPdf"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/player_pdf_button_size"
        android:background="@drawable/bg_circle_dark"
        android:text="TXT"
        android:textColor="@color/selector_player_button_tint"
        android:textSize="@dimen/player_audio_info_text_size"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingHorizontal="@dimen/player_ocr_padding_horizontal"
        android:layout_marginStart="@dimen/player_button_margin_small"
        android:visibility="gone"
        android:contentDescription="@string/pdf_text_mode_enter" />

    <ImageButton
        android:id="@+id/btnSearchPdf"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_search"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/selector_player_button_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginStart="@dimen/player_button_margin_small"
        android:visibility="gone"
        android:contentDescription="@string/search_in_pdf" />

    <ImageButton
        android:id="@+id/btnPdfNextPage"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_skip_next"
        android:background="@drawable/bg_circle_dark"
        app:tint="@color/activity_player_unified_btnEpubNextChapter_tint"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginStart="@dimen/player_pdf_button_margin"
        android:contentDescription="@string/next_page" />

    <ImageButton
        android:id="@+id/btnPdfEnd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@string/to_end" />
</LinearLayout>



