<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for SettingsInputRow compound view.
  Title + inline helper, then a Material outlined text field. Replaces manual
  TextInputLayout + standalone help ImageButton pairs in settings (S0567).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Title line: title + helper inline. -->
    <LinearLayout
        android:id="@+id/sir_titleLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sir_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/toggler_title_text_size" />

        <ImageButton
            android:id="@+id/sir_iconHelp"
            android:layout_width="@dimen/settings_help_icon_size"
            android:layout_height="@dimen/settings_help_icon_size"
            android:layout_marginStart="@dimen/settings_help_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription=""
            android:focusable="true"
            android:src="@drawable/ic_help_outline_24"
            app:tint="@color/text_color_secondary"
            android:visibility="gone" />

        <View
            android:id="@+id/sir_titleLineSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sir_inputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sir_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            android:textSize="@dimen/toggler_title_text_size" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--
      S2786: takes the slack at the END of an inline row, so the value never drifts away from its caption.
      S3229: the height is 0dp, never wrap_content - a bare View answers an AT_MOST spec with the whole
      available size (View.getDefaultSize), which inflated the row to the full height of its card.
    -->
    <View
        android:id="@+id/sir_inlineTailSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</merge>
