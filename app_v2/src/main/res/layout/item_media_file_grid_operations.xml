<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llOperations"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:elevation="@dimen/card_elevation_high"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <ImageButton
        android:id="@+id/btnCopyItem"
        android:layout_width="@dimen/item_status_badge_size"
        android:layout_height="@dimen/item_status_badge_size"
        android:layout_margin="0dp"
        android:padding="0dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/copy"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_save"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnMoveItem"
        android:layout_width="@dimen/item_status_badge_size"
        android:layout_height="@dimen/item_status_badge_size"
        android:layout_margin="0dp"
        android:padding="0dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/move"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_revert"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnRenameItem"
        android:layout_width="@dimen/item_status_badge_size"
        android:layout_height="@dimen/item_status_badge_size"
        android:layout_margin="0dp"
        android:padding="0dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rename"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_edit"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnDeleteItem"
        android:layout_width="@dimen/item_status_badge_size"
        android:layout_height="@dimen/item_status_badge_size"
        android:layout_margin="0dp"
        android:padding="0dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_delete"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>

