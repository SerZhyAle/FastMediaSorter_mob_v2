<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llOperations"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:elevation="@dimen/card_elevation_high"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <ImageButton
        android:id="@+id/btnCopyItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="0dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/copy"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_copy"
        app:tint="@color/selector_themed_button_tint"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnMoveItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="0dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/move"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_move"
        app:tint="@color/selector_themed_button_tint"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnRenameItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="0dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rename"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_edit_20"
        app:tint="@color/selector_themed_button_tint"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnDeleteItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="0dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        app:tint="@color/selector_themed_button_tint"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>

