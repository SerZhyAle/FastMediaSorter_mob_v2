<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/welcome_page_1_background">

    <!-- S1234: brand waves-and-particles backdrop, the same view the audio player and the launcher
         desktop use. First child so it sits behind the pager; never focusable or announced. -->
    <com.sza.fastmediasorter.ui.player.helpers.AudioWaveParticleView android:id="@+id/brandAnimation" android:layout_width="@dimen/match_constraint" android:layout_height="0dp" android:clickable="false" android:focusable="false" android:contentDescription="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <!-- ViewPager2 for Welcome Pages -->
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPager" android:layout_width="@dimen/match_constraint" android:layout_height="0dp" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_small" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/layoutBottomNav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <!-- Single bottom navigation bar: Back | indicator | Skip | Next/Finish -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layoutBottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/welcome_top_nav_padding" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <!-- Previous Button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPrevious" style="@style/Widget.FastMediaSorter.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/previous" android:textColor="?attr/colorOnSurface" android:textSize="@dimen/welcome_button_text_size" android:alpha="0.7" android:visibility="invisible" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusRight="@id/btnNext" android:nextFocusUp="@id/viewPager" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Page Indicator -->
        <LinearLayout android:id="@+id/layoutIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" app:layout_constraintStart_toEndOf="@id/btnPrevious" app:layout_constraintEnd_toStartOf="@id/btnEnableAll" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Enable-all Button (page 0 only; toggled by the Activity). Secondary/outlined so Next stays primary. -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEnableAll" style="@style/Widget.FastMediaSorter.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/margin_small" android:text="@string/welcome_enable_all" android:contentDescription="@string/welcome_enable_all_content_description" android:textSize="@dimen/welcome_button_text_size" android:textColor="?attr/colorPrimary" android:visibility="gone" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnPrevious" android:nextFocusRight="@id/btnNext" android:nextFocusUp="@id/viewPager" app:layout_constraintEnd_toStartOf="@id/btnNext" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Next Button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnNext" style="@style/Widget.FastMediaSorter.Button.Filled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/next" android:textSize="@dimen/welcome_button_text_size" android:textColor="?attr/colorOnPrimary" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnEnableAll" android:nextFocusUp="@id/viewPager" app:backgroundTint="?attr/colorPrimary" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Finish Button (same position as Next) -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnFinish" style="@style/Widget.FastMediaSorter.Button.Filled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/finish" android:textSize="@dimen/welcome_button_text_size" android:textColor="?attr/colorOnPrimary" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnPrevious" android:nextFocusUp="@id/viewPager" app:backgroundTint="?attr/colorPrimary" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
