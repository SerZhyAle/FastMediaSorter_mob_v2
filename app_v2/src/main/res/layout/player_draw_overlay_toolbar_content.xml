<?xml version="1.0" encoding="utf-8"?>
<!--
    S0191/S0192 - Draw overlay toolbar (portrait).

    Single horizontal strip: tool + colour controls on the left, then
    Save / Save & close / overflow / Cancel on the right. "Save & send" and
    "Share" live in the overflow menu (alongside "Save as.." and "Send to
    Google Keep") to keep the strip narrow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawOverlayToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC000000"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/btn_draw_tool_selector"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/draw_tool_selector_cd"
        android:padding="8dp"
        android:src="@drawable/ic_draw_overlay"
        android:tint="#FFFFFFFF" />

    <View
        android:id="@+id/color_black"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FF000000"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true" />

    <View
        android:id="@+id/color_white"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FFFFFFFF"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true" />

    <View
        android:id="@+id/color_red"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FFE53935"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true" />

    <View
        android:id="@+id/color_custom"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FFE53935"
        android:clickable="true"
        android:contentDescription="@string/draw_color_custom_cd"
        android:focusable="true" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btn_draw_save"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_editor_action_save"
        android:padding="8dp"
        android:src="@drawable/ic_text_save"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/btn_draw_save_close"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_editor_action_save_close"
        android:padding="8dp"
        android:src="@drawable/ic_text_save_close"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/btn_draw_overflow"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/draw_overflow_settings"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_more"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/btn_draw_close"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_editor_action_cancel"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFFFF" />

</LinearLayout>
