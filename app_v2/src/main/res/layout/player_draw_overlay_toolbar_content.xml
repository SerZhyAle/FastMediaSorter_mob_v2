<?xml version="1.0" encoding="utf-8"?>
<!--
    S0192 Phase 06 — Draw overlay toolbar v2 (portrait), single row.

    Layout (left → right):
      [tool selector] [B][W][R][C] ......(weighted spacer)...... [⋮] [X]

    The bottom Save button was removed in Phase 06; both save modes (in-place
    overwrite + save-as-new) live inside the overflow popup (⋮).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawOverlayToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC000000"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/btn_draw_tool_selector"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/draw_tool_selector_cd"
        android:padding="8dp"
        android:src="@drawable/ic_draw_overlay"
        android:tint="#FFFFFFFF" />

    <View
        android:id="@+id/color_black"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FF000000"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true" />

    <View
        android:id="@+id/color_white"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FFFFFFFF"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true" />

    <View
        android:id="@+id/color_red"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FFE53935"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true" />

    <View
        android:id="@+id/color_custom"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/draw_color_swatch_selected"
        android:backgroundTint="#FFE53935"
        android:clickable="true"
        android:contentDescription="@string/draw_color_custom_cd"
        android:focusable="true" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btn_draw_overflow"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/draw_overflow_settings"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_more"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/btn_draw_close"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cancel"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFFFF" />

</LinearLayout>
