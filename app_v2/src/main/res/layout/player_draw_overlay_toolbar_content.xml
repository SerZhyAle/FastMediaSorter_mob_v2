<?xml version="1.0" encoding="utf-8"?>
<!--
    S0192 Phase 05 — Draw overlay toolbar v2 (portrait).

    Layout:
      Row 1: tool selector (1×) + 4 colour swatches (Black / White / Red / Custom)
      Row 2: vertical 8dp spacer
      Row 3: action row [X] [⋮] [Save]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawOverlayToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC000000"
    android:orientation="vertical"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Row 1: Tool selector + colour swatches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_draw_tool_selector"
            android:layout_width="@dimen/player_cmd_button_size"
            android:layout_height="@dimen/player_cmd_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/draw_tool_selector_cd"
            android:padding="8dp"
            android:src="@drawable/ic_draw_overlay"
            android:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/color_black"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="#FF000000"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true" />

            <View
                android:id="@+id/color_white"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="#FFFFFFFF"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true" />

            <View
                android:id="@+id/color_red"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="#FFE53935"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true" />

            <View
                android:id="@+id/color_custom"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="#FFE53935"
                android:clickable="true"
                android:contentDescription="@string/draw_color_custom_cd"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Row 3: Action buttons [X] [⋮] [Save] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_draw_close"
            android:layout_width="@dimen/player_cmd_button_size"
            android:layout_height="@dimen/player_cmd_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btn_draw_overflow"
            android:layout_width="@dimen/player_cmd_button_size"
            android:layout_height="@dimen/player_cmd_button_size"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/draw_overflow_settings"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFFFFFFF" />

        <Button
            android:id="@+id/btn_draw_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/draw_overlay_save_button" />

    </LinearLayout>

</LinearLayout>
