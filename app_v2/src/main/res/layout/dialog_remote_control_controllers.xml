<?xml version="1.0" encoding="utf-8"?>
<!-- S4701: "Who can control this phone" - the account's devices with their grants per risk class. Rows are added
     by RemoteControlControllersDialogManager. A scrolling list, so no landscape variant is needed. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/padding_large">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remote_control_controllers_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textAlignment="center" />

            <include layout="@layout/view_dialog_help_button" />

        </LinearLayout>

        <TextView
            android:id="@+id/textRemoteControlControllersIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_control_controllers_intro"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/textRemoteControlControllersState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/remote_control_controllers_loading"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <LinearLayout
            android:id="@+id/layoutRemoteControlControllers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoteControlControllersDone"
            style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/close" />

    </LinearLayout>
</ScrollView>
