<?xml version="1.0" encoding="utf-8"?>
<!-- S3382: credential entry for the FileDO .fd-sec container. The repeat field is shown only when
     packing, where a typo would lock the data behind a credential the owner never meant, and the
     empty-credential warning is visible whenever the field is empty because the format's contract
     requires that statement at the point of entry, every time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_medium">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFdSecPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/filedo_password_hint"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFdSecPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFdSecPasswordRepeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:hint="@string/filedo_password_repeat_hint"
        android:visibility="gone"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFdSecPasswordRepeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- S3397: offered only when a container is opened for viewing; the credential is kept only
         after it has opened the file, so a typo is never remembered. The subtitle states the
         source's leak where it is offered, as the FDSEC-BEHAVIOUR contract section 8 asks. -->
    <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
        android:id="@+id/cbFdSecRemember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:visibility="gone"
        app:fcr_subtitle="@string/filedo_password_remember_leak"
        app:fcr_title="@string/filedo_password_remember" />

    <TextView
        android:id="@+id/tvFdSecEmptyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/filedo_password_empty_warning"
        android:textColor="@color/text_color_secondary"
        android:textAppearance="@style/TextAppearance.FastMediaSorter.HelperText" />

    <TextView
        android:id="@+id/tvFdSecNoRecovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_tiny"
        android:text="@string/filedo_no_recovery_warning"
        android:textColor="@color/text_color_secondary"
        android:textAppearance="@style/TextAppearance.FastMediaSorter.HelperText" />

    <include
        android:id="@+id/fdSecActions"
        layout="@layout/dialog_action_pair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium" />

</LinearLayout>
