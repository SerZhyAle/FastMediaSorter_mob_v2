<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_capture_ocr_panel_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_capture_ocr_panel_label"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/padding_small">

    <LinearLayout
        android:id="@+id/widget_capture_camera_photos_action"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_camera_photos_label"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_capture_camera_photos_icon"
            android:layout_width="@dimen/widget_icon_size_large"
            android:layout_height="@dimen/widget_icon_size_large"
            android:contentDescription="@string/widget_camera_photos_label"
            android:src="@drawable/ic_image"
            app:tint="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_capture_camera_ocr_action"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_camera_ocr_translate_label"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_capture_camera_ocr_icon"
            android:layout_width="@dimen/widget_icon_size_large"
            android:layout_height="@dimen/widget_icon_size_large"
            android:contentDescription="@string/widget_camera_ocr_translate_label"
            android:src="@drawable/ic_camera_ocr_translate"
            app:tint="@color/white" />

    </LinearLayout>

</LinearLayout>
