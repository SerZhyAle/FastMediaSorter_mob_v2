<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    android:padding="@dimen/padding_large">

    <TextView
        android:id="@+id/tvQrTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/resource_margin_16dp"
        android:gravity="center"
        android:text="@string/companion_qr_share_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tvQrResourceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/resource_margin_12dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgQr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/resource_margin_16dp"
        android:layout_marginBottom="@dimen/resource_margin_16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/companion_qr_share_title"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvQrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/companion_qr_share_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/tvQrNoPasswordNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/resource_margin_12dp"
        android:gravity="center"
        android:text="@string/companion_qr_share_no_password_note"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQrClose"
        style="@style/Widget.FastMediaSorter.Button.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/resource_margin_16dp"
        android:focusable="true"
        android:text="@android:string/ok" />

</LinearLayout>
