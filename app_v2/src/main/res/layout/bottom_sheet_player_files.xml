<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/token_spacing_16">
    <TextView android:id="@+id/title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:accessibilityHeading="true"
        android:textAppearance="?attr/textAppearanceHeadline6" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/files"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/close"
        style="@style/Widget.FastMediaSorter.Button.DialogCancel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:text="@string/close"
        android:focusable="true" android:clickable="true" />
</LinearLayout>
