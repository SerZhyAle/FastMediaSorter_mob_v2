<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvPlaybackControlTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/control"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- S0019: «Apply and 3D» combo button — visible only on VR-flavor builds.
             One click closes the dialog AND launches immersive playback with current settings. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyAnd3D"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:text="@string/dialog_playback_apply_and_3d"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePlaybackControl"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:text="@string/playback_control_done" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/radioGroupPlaybackSections"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_control_tab_volume" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_control_tab_audio" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_control_tab_subtitles" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionStereo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_settings_3d_tab" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionHue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_control_tab_hue" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_control_tab_brightness" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSectionSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:text="@string/playback_control_tab_speed" />
        </RadioGroup>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/colorOnSurfaceVariant" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sectionVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVolumeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekVolume"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMuteToggle"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:layout_weight="1"
                            android:minHeight="56dp"
                            android:text="@string/playback_control_mute"
                            app:strokeColor="@color/btn_mute_toggle_state"
                            app:strokeWidth="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVolumeHalf"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:layout_weight="1"
                            android:text="@string/volume_50_percent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVolumeMax"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:layout_weight="1"
                            android:text="@string/volume_max" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAudioEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/playback_control_no_audio_tracks"
                        android:visibility="gone" />

                    <RadioGroup
                        android:id="@+id/groupAudioTracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionSubtitles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSubtitleEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/playback_control_no_subtitles"
                        android:visibility="gone" />

                    <RadioGroup
                        android:id="@+id/groupSubtitleTracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionStereo3d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvStereoDetected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- B2: canonical switch+label row — switch left (wrap_content), label right (weight=1).
                         Previous `match_parent` on the switch caused a wide text-to-thumb gap. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchVrOverrideFormatType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/playback_settings_3d_override_format_type" />

                    </LinearLayout>

                    <!-- Two columns: Flat (left) | Spherical (right) — same structure as landscape for consistency -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Flat format column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/tvStereoFlatLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/playback_settings_3d_flat_format"
                                android:textStyle="bold" />

                            <RadioGroup
                                android:id="@+id/radioGroup3D"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DAuto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_auto" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DSbs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_sbs" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DOU"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_ou" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DMono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_mono" />
                            </RadioGroup>
                        </LinearLayout>

                        <!-- Thin vertical divider between columns -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Spherical format column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:id="@+id/tvStereoSphericalLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/playback_settings_3d_spherical_format"
                                android:textStyle="bold" />

                            <RadioGroup
                                android:id="@+id/radioGroupSpherical3D"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Auto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_auto" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Mono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_360_mono" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Sbs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_360_sbs" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Ou"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_360_ou" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radioVr180"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_vr180" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radioCylinder180"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:text="@string/playback_settings_3d_cylinder_180" />
                            </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStereoHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/playback_settings_3d_hint"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- VR-only controls (visible when SUPPORT_VR_PLAYER) -->

                    <!-- Content type label (read-only) -->
                    <TextView
                        android:id="@+id/tvVrContentType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- VR Rendering mode chips -->
                    <TextView
                        android:id="@+id/tvVrRenderingModeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/playback_vr_rendering_mode"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupVrRenderingMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:visibility="gone">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRenderCinema"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/playback_vr_render_cinema"
                            android:checked="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRenderFullStereo"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/playback_vr_render_full_stereo" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- IPD (inter-pupillary distance) slider -->
                    <TextView
                        android:id="@+id/tvVrIpdLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <SeekBar
                        android:id="@+id/seekVrIpd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="100"
                        android:progress="50"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionHue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHueValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekHue"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="360" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetHue"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="@string/reset" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvBrightnessValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="100" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetBrightness"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="@string/reset" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="7" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetSpeed"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="@string/reset" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>