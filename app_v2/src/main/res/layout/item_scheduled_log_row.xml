<?xml version="1.0" encoding="utf-8"?>
<!-- S4493: one line of the Scheduled operations Run log. A failed or skipped line shows a sentence in the
     interface language, with the English log text behind the Details button, which is shown only then. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/margin_tiny">

    <TextView
        android:id="@+id/tvLogHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FastMediaSorter.Item.Subtitle" />

    <TextView
        android:id="@+id/tvLogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogDetails"
        style="@style/Widget.FastMediaSorter.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:text="@string/scheduled_op_history_details"
        android:visibility="gone" />

</LinearLayout>
