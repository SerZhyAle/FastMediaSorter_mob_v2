<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">

        <!-- Enable Copy + Overwrite on Copy (One Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Enable Copying -->
            <LinearLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/resource_field_margin_end">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableCopying"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enable_copying"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Overwrite on Copy -->
            <LinearLayout
                android:id="@+id/layoutOverwriteCopyWrapper"
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/settings_help_icon_margin">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchOverwriteOnCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/overwrite_on_copy"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

        </LinearLayout>

        <!-- Copy Options (Remaining) -->
        <LinearLayout
            android:id="@+id/layoutCopyOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_padding_horizontal_start"
            android:paddingEnd="@dimen/padding_none"
            android:layout_marginBottom="@dimen/margin_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginBottom="@dimen/margin_tiny">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGoToNextAfterCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/go_to_next_after_copy"
                    android:textSize="@dimen/resource_card_title_text_size" />

                <ImageButton
                    android:id="@+id/iconHelpGoToNextAfterCopy"
                    android:layout_width="@dimen/settings_help_icon_size"
                    android:layout_height="@dimen/settings_help_icon_size"
                    android:layout_marginStart="@dimen/settings_help_icon_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tooltip_go_to_next_after_copy_title"
                    android:src="@android:drawable/ic_menu_help"
                    android:tint="?android:attr/textColorSecondary" />

            </LinearLayout>
        </LinearLayout>

        <!-- Enable Move + Overwrite on Move (One Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Enable Moving -->
            <LinearLayout
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/resource_field_margin_end">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableMoving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enable_moving"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Overwrite on Move -->
            <LinearLayout
                android:id="@+id/layoutOverwriteMoveWrapper"
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/settings_help_icon_margin">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchOverwriteOnMove"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="@dimen/match_constraint"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/overwrite_on_move"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

        </LinearLayout>
        
        <!-- Header: Destinations List + Max Recipients (One Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_small"
            android:paddingTop="@dimen/settings_padding_vertical_top_small">
            
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="@dimen/match_constraint"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/destinations_list_header"
                android:textSize="@dimen/resource_card_title_text_size"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />
            
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMaxRecipients"
                android:layout_width="@dimen/settings_width_input_medium"
                android:layout_height="wrap_content"
                android:hint="@string/max_recipients"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginStart="@dimen/margin_small">

                <AutoCompleteTextView
                    android:id="@+id/etMaxRecipients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2" />

            </com.google.android.material.textfield.TextInputLayout>
            
            <ImageButton
                android:id="@+id/iconHelpDestinations"
                android:layout_width="@dimen/settings_help_icon_size"
                android:layout_height="@dimen/settings_help_icon_size"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_destinations_title"
                android:src="@android:drawable/ic_menu_help"
                android:tint="?android:attr/textColorSecondary" />
        
        </LinearLayout>

        <!-- Add Destination Button (before list) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_destination"
            android:textSize="@dimen/resource_card_title_text_size"
            android:paddingHorizontal="@dimen/settings_padding_horizontal_large"
            android:paddingVertical="@dimen/settings_padding_vertical"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="@dimen/margin_small"
            android:visibility="gone"/>

        <!-- Message when no resources available -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvNoResourcesMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_resources_first_message"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:padding="@dimen/bottom_sheet_binary_file_unknown_padding"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_small"
            android:visibility="gone"/>

        <!-- Destinations List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_height_container_min"
            android:layout_marginBottom="@dimen/settings_padding_vertical"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
