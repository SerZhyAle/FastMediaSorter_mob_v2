<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:show_buffering="when_playing"
        app:use_artwork="true"
        app:default_artwork="@drawable/ic_music_note"
        app:resize_mode="fit"
        app:controller_layout_id="@layout/custom_player_controls" />

    <!-- Audio file info overlay (visible only for audio files) -->
    <LinearLayout
        android:id="@+id/audioInfoOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/activity_player_audioInfoOverlay_padding"
        android:layout_marginBottom="@dimen/activity_player_audioInfoOverlay_layout_marginBottom"
        android:background="@color/activity_player_unified_topCommandPanel_background"
        android:elevation="@dimen/activity_edit_resource_layoutProgress_elevation"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/audioMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/activity_player_unified_audioMetadata_textSize"
            android:textStyle="@string/text_style_bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/activity_player_unified_audioMetadata_layout_marginBottom"
            android:visibility="gone"
            android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier" />

        <TextView
            android:id="@+id/audioFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/activity_player_unified_audioFileName_textColor"
            android:textSize="@dimen/activity_player_unified_audioFileName_textSize"
            android:gravity="center"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/audioFileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/activity_player_unified_audioFileName_textColor"
            android:textSize="@dimen/activity_player_unified_audioFileName_textSize"
            android:gravity="center"
            android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/activity_player_unified_toolbar_background"
        android:visibility="visible">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:elevation="@dimen/toolbar_elevation"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextColor="@android:color/white" />

        <!-- Slideshow countdown timer (top-right corner) -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/dialog_slideshow_settings_btnSelectMusic_layout_marginTop"
            android:layout_marginEnd="@dimen/fragment_settings_playback_iconHelpTouchZones_layout_marginEnd"
            android:textColor="@color/activity_player_tvCountdown_textColor"
            android:textSize="@dimen/activity_player_unified_audioFileName_textSize"
            android:visibility="gone"
            android:elevation="@dimen/activity_player_unified_tvCountdown_elevation" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/activity_player_tvCountdown_paddingVertical"
            android:paddingHorizontal="@dimen/activity_player_btnSlideShow_paddingHorizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeDown"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_unified_btnVolumeDown_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_unified_btnVolumeDown_text"
                android:textSize="@dimen/activity_player_btnVolumeUp_textSize"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:backgroundTint="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevious"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_unified_btnPrevious_text"
                android:textSize="@dimen/activity_player_btnVolumeUp_textSize"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_btnPlayPause_text"
                android:textSize="@dimen/activity_player_unified_btnPlayPause_textSize"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_btnPlayPause_text"
                android:textSize="@dimen/activity_player_btnVolumeUp_textSize"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeUp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_unified_btnVolumeDown_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_unified_btnVolumeUp_text"
                android:textSize="@dimen/activity_player_btnVolumeUp_textSize"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:backgroundTint="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/activity_player_btnSlideShow_paddingHorizontal"
            android:paddingBottom="@dimen/activity_player_unified_btnVolumeUp_paddingBottom"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlideShow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="@dimen/activity_player_btnSlideShow_paddingHorizontal"
                android:text="@string/activity_player_btnSlideShow_text"
                android:textColor="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorite"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_btnFavorite_text"
                android:textSize="@dimen/activity_player_btnVolumeUp_textSize"
                android:textColor="@android:color/white"
                android:contentDescription="Favorite"
                app:backgroundTint="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInfo"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/activity_player_btnInfo_text"
                android:textSize="@dimen/activity_player_btnInfo_textSize"
                android:textColor="@android:color/white"
                android:contentDescription="@string/file_information"
                app:backgroundTint="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/activity_player_btnFavorite_minWidth"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="@dimen/activity_player_btnSlideShow_paddingHorizontal"
                android:text="@string/activity_player_btnDelete_text"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/touch_zones_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/loading_indicator"
        android:visibility="gone" />

</FrameLayout>
