<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:background="?attr/colorPrimary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnPrimary"
            app:menu="@menu/menu_streams"
            app:title="@string/streams_title"
            app:titleTextColor="?attr/colorOnPrimary">

            <!-- S0940: in-landscape host for the relocated search/filter/sort control group.
                 Empty and gone in portrait; StreamsControlsPlacementManager reparents the
                 streamControls group into here in landscape to free vertical space. -->
            <FrameLayout
                android:id="@+id/headerControlsHost"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:focusable="false"
                android:visibility="gone" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/streamControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="?attr/colorControlNormal"
                app:endIconMode="clear_text"
                app:endIconTint="?attr/colorControlNormal"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/streams_search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:focusable="true"
                    android:nextFocusUp="@id/toolbar"
                    android:nextFocusRight="@id/btnMediaKindVideo"
                    android:nextFocusDown="@id/rvStreams" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- S1473: one-tap media-kind facet. Three states on two icons - the lit one is the
                 active facet, both neutral means no filter; tapping the lit one clears it. -->
            <ImageButton
                android:id="@+id/btnMediaKindVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_video"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/etSearch"
                android:nextFocusRight="@id/btnMediaKindAudio"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_media_filter_video" />

            <ImageButton
                android:id="@+id/btnMediaKindAudio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_audio"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnMediaKindVideo"
                android:nextFocusRight="@id/btnFilter"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_media_filter_audio" />

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_tune"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnMediaKindAudio"
                android:nextFocusRight="@id/btnSort"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_filter">

                <!-- First touch-mode focus parks on Filter, not etSearch, so the soft keyboard
                     does not auto-open on launch and cover short landscape screens. -->
                <requestFocus />
            </ImageButton>

            <ImageButton
                android:id="@+id/btnSort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_sort"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnFilter"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_sort" />
        </LinearLayout>

        <!-- S1141: pinned-channels section - shown by StreamsSectionsManager only when >=1 pinned. -->
        <LinearLayout
            android:id="@+id/streamsPinnedSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/streamsPinnedHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/streams_section_header_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/streams_section_header_padding"
                android:paddingEnd="@dimen/streams_section_header_padding"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/btnFilter"
                android:nextFocusDown="@id/rvStreamsPinned">

                <TextView
                    android:id="@+id/tvPinnedHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/streams_section_pinned" />

                <ImageView
                    android:id="@+id/ivPinnedChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand_less"
                    app:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/streams_section_collapse" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeStreamsPinned"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStreamsPinned"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/streams_list_side_padding"
                        android:paddingEnd="@dimen/streams_list_side_padding"
                        android:paddingBottom="8dp"
                        android:scrollbars="vertical" />

                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- S1141: main (unpinned) section - keeps the existing list/grid, empty-state and scroll buttons. -->
        <LinearLayout
            android:id="@+id/streamsMainSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/streamsMainHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/streams_section_header_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/streams_section_header_padding"
                android:paddingEnd="@dimen/streams_section_header_padding"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/streamsPinnedHeader"
                android:nextFocusDown="@id/rvStreams">

                <TextView
                    android:id="@+id/tvMainHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/streams_section_main" />

                <ImageView
                    android:id="@+id/ivMainChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand_less"
                    app:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/streams_section_collapse" />
            </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- S0675: rvStreams wrapped in SwipeRefreshLayout for grid-mode pull-to-refresh; the manager
                 enables the swipe gesture only in GRID (disabled in LIST so list scroll is unaffected). -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeStreams"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStreams"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/streams_list_side_padding"
                    android:paddingEnd="@dimen/streams_list_side_padding"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- S0673: empty state pairs the message with an icon + primary "add" and secondary
                 "import" actions so the recovery path is one tap, not a hunt for unlabeled toolbar
                 glyphs. Buttons reuse the toolbar handlers (showSourceDialog / showImportChooser). -->
            <LinearLayout
                android:id="@+id/emptyStateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/empty_state_padding"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/empty_state_icon_size"
                    android:layout_height="@dimen/empty_state_icon_size"
                    android:src="@drawable/ic_cast"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/empty_state_text_margin_top"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/streams_empty" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAddUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/empty_state_text_margin_top"
                    android:text="@string/streams_add"
                    android:focusable="true"
                    android:nextFocusUp="@id/etSearch"
                    android:nextFocusDown="@id/btnEmptyImport" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyImport"
                    style="@style/Widget.FastMediaSorter.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/streams_import"
                    android:focusable="true"
                    android:nextFocusUp="@id/btnEmptyAddUrl" />
            </LinearLayout>

            <!-- S0587: scroll-navigation buttons split into top + bottom groups to mirror the file
                 browser (activity_browse.xml) - top/page-up anchor to the list top, page-down/bottom
                 to the list bottom, instead of one stack that overlaps the rows. -->
            <LinearLayout
                android:id="@+id/streamScrollButtonsTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/browse_scroll_button_margin"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/fabStreamsScrollToTop"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_to_top"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_upward"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />

                <ImageButton
                    android:id="@+id/fabStreamsPageUp"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_page_up"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_double_arrow_up"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/streamScrollButtonsBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginEnd="@dimen/browse_scroll_button_margin"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/fabStreamsPageDown"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_page_down"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_double_arrow_down"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />

                <ImageButton
                    android:id="@+id/fabStreamsScrollToBottom"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_to_bottom"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_downward"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/streamMiniControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/streams_mini_control_min_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnMiniPlayStop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_stop"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:nextFocusUp="@id/rvStreams"
                android:contentDescription="@string/streams_stop" />

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="@integer/streams_mini_title_max_lines"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- S0933: window-attached but off-screen host for the transient grid frame-capture TextureView.
         Kept in the hierarchy (drawn, so the SurfaceTexture receives frames) but translated far off the
         viewport; holds no persistent child and never intercepts touches or focus. -->
    <FrameLayout
        android:id="@+id/streamCaptureHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="-10000dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

    <!-- S1141: dedicated off-screen capture host for the pinned section's grid snapshot engine -
         two engines must not share one TextureView host. -->
    <FrameLayout
        android:id="@+id/streamCaptureHostPinned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="-10000dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
