<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.sza.fastmediasorter.ui.common.widget.StandardToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.FastMediaSorter.Toolbar.Primary"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:theme="@style/ThemeOverlay.FastMediaSorter.Toolbar.Primary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:menu="@menu/menu_streams"
            app:stbTitleIcon="@drawable/ic_stream"
            app:title="@string/streams_title">


            <!-- S0940: in-landscape host for the relocated search/filter/sort control group.
                 Empty and gone in portrait; StreamsControlsPlacementManager reparents the
                 streamControls group into here in landscape to free vertical space. -->
            <FrameLayout
                android:id="@+id/headerControlsHost"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:focusable="false"
                android:visibility="gone" />

        </com.sza.fastmediasorter.ui.common.widget.StandardToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- S1823: the ON_OPEN catalog offer, inflated only when the policy actually raises it
             (CLAUDE.md Rule 18). It sits above the controls so an empty list and its remedy are on
             screen together - the Snackbar it replaced faded before it could be acted on. -->
        <ViewStub
            android:id="@+id/stubCatalogBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout="@layout/view_streams_catalog_banner"
            android:inflatedId="@+id/streamsCatalogBanner" />

        <LinearLayout
            android:id="@+id/streamControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="?attr/colorControlNormal"
                app:endIconMode="clear_text"
                app:endIconTint="?attr/colorControlNormal"
                app:hintEnabled="false">

                <com.sza.fastmediasorter.ui.common.widget.SafeSelectionTextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/streams_search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:focusable="true"
                    android:nextFocusUp="@id/toolbar"
                    android:nextFocusRight="@id/btnMediaKindVideo"
                    android:nextFocusDown="@id/rvStreams" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- S1473: one-tap media-kind facet. The lit icon is the active facet, all neutral
                 means no filter; tapping the lit one clears it.
                 S3249: every control of this bar is a MaterialButton on the icon-button token, so the
                 six share one ripple shape and disabled tint. Insets and padding are zeroed because the
                 fixed edge, not the style's 48dp floor, is the size here, and the glyph must stay centred. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaKindVideo"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="@dimen/streams_media_filter_button_size"
                android:layout_height="@dimen/streams_media_filter_button_size"
                android:layout_marginStart="4dp"
                android:insetLeft="@dimen/dimension_zero"
                android:insetTop="@dimen/dimension_zero"
                android:insetRight="@dimen/dimension_zero"
                android:insetBottom="@dimen/dimension_zero"
                android:padding="@dimen/dimension_zero"
                app:icon="@drawable/ic_video"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorControlNormal"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/etSearch"
                android:nextFocusRight="@id/btnMediaKindAudio"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_media_filter_video" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaKindAudio"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="@dimen/streams_media_filter_button_size"
                android:layout_height="@dimen/streams_media_filter_button_size"
                android:insetLeft="@dimen/dimension_zero"
                android:insetTop="@dimen/dimension_zero"
                android:insetRight="@dimen/dimension_zero"
                android:insetBottom="@dimen/dimension_zero"
                android:padding="@dimen/dimension_zero"
                app:icon="@drawable/ic_audio"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorControlNormal"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnMediaKindVideo"
                android:nextFocusRight="@id/btnMediaKindOwn"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_media_filter_audio" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaKindOwn"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="@dimen/streams_media_filter_button_size"
                android:layout_height="@dimen/streams_media_filter_button_size"
                android:insetLeft="@dimen/dimension_zero"
                android:insetTop="@dimen/dimension_zero"
                android:insetRight="@dimen/dimension_zero"
                android:insetBottom="@dimen/dimension_zero"
                android:padding="@dimen/dimension_zero"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorControlNormal"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnMediaKindAudio"
                android:nextFocusRight="@id/btnMediaKindRecent"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_media_filter_own" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaKindRecent"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="@dimen/touch_target_min_height"
                android:layout_height="@dimen/touch_target_min_height"
                android:insetLeft="@dimen/dimension_zero"
                android:insetTop="@dimen/dimension_zero"
                android:insetRight="@dimen/dimension_zero"
                android:insetBottom="@dimen/dimension_zero"
                android:padding="@dimen/dimension_zero"
                app:icon="@drawable/ic_history"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorControlNormal"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnMediaKindOwn"
                android:nextFocusRight="@id/btnFilter"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_media_filter_recent" />

            <!-- S4752 over S3249: Filter keeps the quiet background in place of the token's own. A
                 MaterialButton ripple paints its highlight for state_focused, so the parked launch focus
                 would bring the grey disc back; backgroundTint is nulled so the inherited tint cannot
                 recolour the custom drawable. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilter"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="@dimen/touch_target_min_height"
                android:layout_height="@dimen/touch_target_min_height"
                android:layout_marginStart="4dp"
                android:padding="@dimen/dimension_zero"
                android:background="@drawable/bg_icon_button_focus_quiet"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_filter"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorControlNormal"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnMediaKindRecent"
                android:nextFocusRight="@id/btnSort"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_filter">

                <!-- First touch-mode focus parks on Filter, not etSearch, so the soft keyboard
                     does not auto-open on launch and cover short landscape screens. S4752: the quiet
                     background keeps that parked focus from leaving a grey ripple circle behind.
                     S4756: StreamsActivity clears the touch-focusable flag after the first layout, because
                     a touch-focusable button that lost focus spends its next tap on regaining it. -->
                <requestFocus />
            </com.google.android.material.button.MaterialButton>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSort"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="@dimen/touch_target_min_height"
                android:layout_height="@dimen/touch_target_min_height"
                android:insetLeft="@dimen/dimension_zero"
                android:insetTop="@dimen/dimension_zero"
                android:insetRight="@dimen/dimension_zero"
                android:insetBottom="@dimen/dimension_zero"
                android:padding="@dimen/dimension_zero"
                app:icon="@drawable/ic_sort"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_none"
                app:iconTint="?attr/colorControlNormal"
                android:focusable="true"
                android:nextFocusUp="@id/toolbar"
                android:nextFocusLeft="@id/btnFilter"
                android:nextFocusDown="@id/rvStreams"
                android:contentDescription="@string/streams_sort" />
        </LinearLayout>

        <!-- S4116: broadcasts of the user's other devices - shown only while an exchange server is held;
             collapsed by default, because an open section keeps a server stream per entry. -->
        <LinearLayout
            android:id="@+id/streamsDevicesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- S4626: the three streams section headers are the shared collapsible header. The widget
                 tag is a valid next-focus target that hands focus to its row, and its own next-focus ids
                 are forwarded to that row. -->
            <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                android:id="@+id/streamsDevicesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:nextFocusUp="@id/btnFilter"
                app:csh_title="@string/streams_section_device_broadcasts" />

            <LinearLayout
                android:id="@+id/streamsDevicesBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDevicesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/streams_section_header_padding"
                    android:paddingEnd="@dimen/streams_section_header_padding"
                    android:paddingBottom="@dimen/margin_small"
                    android:textAppearance="@style/TextAppearance.FastMediaSorter.Item.Subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/streamsDevicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/streams_list_side_padding"
                    android:paddingEnd="@dimen/streams_list_side_padding"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDevicesPortal"
                    style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/streams_section_header_padding"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/exchange_portal_link_broadcast"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

        <!-- S1141: pinned-channels section - shown by StreamsSectionsManager only when >=1 pinned. -->
        <!-- S4751: wraps to its rows under a cap that StreamsSectionsManager sets, so one pinned row leaves
             no empty block; the manager re-shapes it to a fill section when the main section is closed. -->
        <com.sza.fastmediasorter.ui.common.widget.MaxHeightLinearLayout
            android:id="@+id/streamsPinnedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                android:id="@+id/streamsPinnedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:nextFocusUp="@id/btnFilter"
                android:nextFocusDown="@id/rvStreamsPinned"
                app:csh_expanded="true"
                app:csh_title="@string/streams_section_pinned" />

            <!-- wrap_content with weight 1 on purpose: under the section's cap the body shrinks to its rows, and
                 in the fill section it stretches over it; a 0dp body would never wrap. -->
            <FrameLayout
                android:id="@+id/streamsPinnedBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:ignore="InefficientWeight">

                <com.sza.fastmediasorter.ui.common.widget.WrapContentSwipeRefreshLayout
                    android:id="@+id/swipeStreamsPinned"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStreamsPinned"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/streams_list_side_padding"
                        android:paddingEnd="@dimen/streams_list_side_padding"
                        android:paddingBottom="8dp"
                        android:scrollbars="vertical" />

                </com.sza.fastmediasorter.ui.common.widget.WrapContentSwipeRefreshLayout>
            </FrameLayout>
        </com.sza.fastmediasorter.ui.common.widget.MaxHeightLinearLayout>

        <!-- S1141: main (unpinned) section - keeps the existing list/grid, empty-state and scroll buttons. -->
        <LinearLayout
            android:id="@+id/streamsMainSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                android:id="@+id/streamsMainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:nextFocusUp="@id/streamsPinnedHeader"
                android:nextFocusDown="@id/rvStreams"
                app:csh_expanded="true"
                app:csh_title="@string/streams_section_main" />

        <FrameLayout
            android:id="@+id/streamsMainBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- S0675: rvStreams wrapped in SwipeRefreshLayout for grid-mode pull-to-refresh; the manager
                 enables the swipe gesture only in GRID (disabled in LIST so list scroll is unaffected). -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeStreams"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStreams"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/streams_list_side_padding"
                    android:paddingEnd="@dimen/streams_list_side_padding"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- S0673: empty state pairs the message with an icon + primary "add" and secondary
                 "import" actions so the recovery path is one tap, not a hunt for unlabeled toolbar
                 glyphs. Buttons reuse the toolbar handlers (showSourceDialog / showImportChooser). -->
            <LinearLayout
                android:id="@+id/emptyStateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/empty_state_padding"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/empty_state_icon_size"
                    android:layout_height="@dimen/empty_state_icon_size"
                    android:src="@drawable/ic_stream"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/empty_state_text_margin_top"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/streams_empty" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAddUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/empty_state_text_margin_top"
                    android:text="@string/streams_add"
                    android:focusable="true"
                    android:nextFocusUp="@id/etSearch"
                    android:nextFocusDown="@id/btnEmptyImport" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyImport"
                    style="@style/Widget.FastMediaSorter.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/streams_import"
                    android:focusable="true"
                    android:nextFocusUp="@id/btnEmptyAddUrl" />
            </LinearLayout>

            <!-- S0587: scroll-navigation buttons split into top + bottom groups to mirror the file
                 browser (activity_browse.xml) - top/page-up anchor to the list top, page-down/bottom
                 to the list bottom, instead of one stack that overlaps the rows. -->
            <LinearLayout
                android:id="@+id/streamScrollButtonsTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/browse_scroll_button_margin"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/fabStreamsScrollToTop"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_to_top"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vertical_align_top"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />

                <ImageButton
                    android:id="@+id/fabStreamsPageUp"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_page_up"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_double_arrow_up"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/streamScrollButtonsBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginEnd="@dimen/browse_scroll_button_margin"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/fabStreamsPageDown"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_page_down"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_double_arrow_down"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />

                <ImageButton
                    android:id="@+id/fabStreamsScrollToBottom"
                    android:layout_width="@dimen/browse_scroll_button_size"
                    android:layout_height="@dimen/browse_scroll_button_size"
                    android:background="@drawable/bg_scroll_button"
                    android:contentDescription="@string/scroll_to_bottom"
                    android:focusable="true"
                    android:padding="@dimen/browse_scroll_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vertical_align_bottom"
                    android:visibility="gone"
                    app:tint="@color/selector_player_button_tint" />
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/streamMiniControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/streams_mini_control_min_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnMiniPlayStop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_pause"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:nextFocusUp="@id/rvStreams"
                android:nextFocusRight="@id/btnMiniStop"
                android:contentDescription="@string/streams_pause" />

            <ImageButton
                android:id="@+id/btnMiniStop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_stop"
                app:tint="?attr/colorControlNormal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:nextFocusUp="@id/rvStreams"
                android:nextFocusLeft="@id/btnMiniPlayStop"
                android:contentDescription="@string/streams_stop" />

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="@integer/streams_mini_title_max_lines"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- S0933: window-attached but off-screen host for the transient grid frame-capture TextureView.
         Kept in the hierarchy (drawn, so the SurfaceTexture receives frames) but translated far off the
         viewport; holds no persistent child and never intercepts touches or focus. -->
    <FrameLayout
        android:id="@+id/streamCaptureHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="-10000dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

    <!-- S1141: dedicated off-screen capture host for the pinned section's grid snapshot engine -
         two engines must not share one TextureView host. -->
    <FrameLayout
        android:id="@+id/streamCaptureHostPinned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="-10000dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
