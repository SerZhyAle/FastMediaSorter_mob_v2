<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">

        <!-- Sort Mode Dropdown -->
        <!-- Sort Mode and Slideshow Interval (one row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/margin_small"
                android:hint="@string/default_sort_mode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerSortMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSlideshowInterval"
                android:layout_width="@dimen/settings_width_input_small"
                android:layout_height="wrap_content"
                android:hint="@string/slideshow_interval"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/etSlideshowInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:text="5"/>

            </com.google.android.material.textfield.TextInputLayout>
            
            <ImageButton
                android:id="@+id/iconHelpSlideshow"
                android:layout_width="@dimen/settings_help_icon_size"
                android:layout_height="@dimen/settings_help_icon_size"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_slideshow_title"
                android:src="@android:drawable/ic_menu_help"
                app:tint="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- Rename + PlayToEnd Row Container -->
        <LinearLayout
            android:id="@+id/containerRenamePlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <LinearLayout
                android:id="@+id/layoutPlayToEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/resource_field_margin_end">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPlayToEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/play_video_to_end"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAllowRename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/settings_help_icon_margin">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAllowRename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/allow_rename"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

        </LinearLayout>

        <!-- Delete + ConfirmDelete Row Container -->
        <LinearLayout
            android:id="@+id/containerDeleteConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <LinearLayout
                android:id="@+id/layoutAllowDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/resource_field_margin_end">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAllowDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/allow_delete"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutConfirmDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/settings_help_icon_margin">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchConfirmDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/confirm_delete"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

        </LinearLayout>

        <!-- Icon Size for Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_small">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilIconSize"
                android:layout_width="@dimen/fragment_settings_playback_tilIconSize_layout_width"
                android:layout_height="wrap_content"
                android:hint="@string/default_icon_size"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginStart="@dimen/margin_small">

                <AutoCompleteTextView
                    android:id="@+id/etIconSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="4"
                    android:text="96"/>

            </com.google.android.material.textfield.TextInputLayout>
            
            <ImageButton
                android:id="@+id/iconHelpGridSize"
                android:layout_width="@dimen/settings_help_icon_size"
                android:layout_height="@dimen/settings_help_icon_size"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_grid_size_title"
                android:src="@android:drawable/ic_menu_help"
                app:tint="?android:attr/textColorSecondary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGridMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_switch_margin_end"
                android:layout_marginEnd="@dimen/settings_switch_margin_end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grid_mode"
                android:textSize="@dimen/resource_card_title_text_size" />

        </LinearLayout>

        <!-- Hide Grid Action Buttons + Hide System UI (One Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="@dimen/settings_margin_end_large"
            android:paddingEnd="@dimen/padding_none"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Hide Grid Action Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="@dimen/margin_small">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHideGridActionButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hide_grid_action_buttons"
                    android:textSize="@dimen/resource_card_desc_text_size" />
            </LinearLayout>

            <!-- Hide System UI in Fullscreen -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_small">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHideSystemUiInFullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hide_system_ui_in_fullscreen"
                    android:textSize="@dimen/resource_card_desc_text_size" />
            </LinearLayout>
        </LinearLayout>

        <!-- Command Panel + Detailed Errors (One Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Show Command Panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/margin_small">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowCommandPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_command_panel_by_default"
                    android:textSize="@dimen/resource_card_desc_text_size" 
                    android:layout_marginEnd="@dimen/margin_small" />

                <ImageButton
                    android:id="@+id/iconHelpCommandPanel"
                    android:layout_width="@dimen/settings_help_icon_size"
                    android:layout_height="@dimen/settings_help_icon_size"
                    android:layout_marginStart="@dimen/settings_help_icon_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tooltip_command_panel_title"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="?android:attr/textColorSecondary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Show Detailed Errors -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/margin_small">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDetailedErrors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/show_detailed_errors"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

        </LinearLayout>

        <!-- Player Hint + Touch Zones (One Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <!-- Show Player Hint -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginEnd="@dimen/margin_small">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowPlayerHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/show_player_hint"
                    android:textSize="@dimen/resource_card_desc_text_size" />

            </LinearLayout>

            <!-- Always Show Touch Zones -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:layout_marginStart="@dimen/margin_small">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAlwaysShowTouchZones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/settings_switch_margin_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/always_show_touch_zones_overlay"
                    android:textSize="@dimen/resource_card_desc_text_size" 
                    android:layout_marginEnd="@dimen/margin_small" />
                
                <ImageButton
                    android:id="@+id/iconHelpTouchZones"
                    android:layout_width="@dimen/settings_help_icon_size"
                    android:layout_height="@dimen/settings_help_icon_size"
                    android:layout_marginStart="@dimen/settings_help_icon_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tooltip_touch_zones_title"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="?android:attr/textColorSecondary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/always_show_touch_zones_overlay_description"
            android:textSize="@dimen/text_size_small"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginEnd="@dimen/fragment_settings_playback_iconHelpTouchZones_layout_marginEnd"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom"/>

        <!-- Touch Zones Scheme Header and Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/touch_zones_scheme"
                android:textSize="@dimen/resource_card_title_text_size"
                android:textStyle="@string/text_style_bold"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowHintNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_hint_now"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

        <!-- Horizontal layout: Map (50%) + Legend (50%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/margin_small">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/fragment_settings_playback_btnShowHintNow_layout_height"
                android:layout_weight="1"
                android:contentDescription="@string/touch_zones_scheme"
                android:scaleType="fitCenter"
                android:src="@drawable/touch_zones_scheme"
                android:layout_marginEnd="@dimen/margin_small"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zones_legend_title"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="@string/text_style_bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="@dimen/margin_tiny"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_1_back"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_2_copy"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_3_rename"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_4_previous"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_5_move"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_6_next"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_7_command"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_8_delete"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_zone_9_slideshow"
                    android:textSize="@dimen/activity_browse_btnSort_textSize"
                    android:lineSpacingMultiplier="@string/dialog_file_info_tvExifExposure_lineSpacingMultiplier"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
