<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:descendantFocusability="afterDescendants" tools:ignore="NestedWeights">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/settings_fragment_padding" android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" android:layout_marginTop="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- GROUP: Sorting & Slideshow -->
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage when playback header help copy is ready. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerSortingSlideshow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/settings_category_sorting_slideshow" />

                <LinearLayout android:id="@+id/containerSortingSlideshow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small">

                    <!-- Sort Mode and Slideshow Interval (one row) -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_small" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/margin_small" android:layout_weight="1" android:hint="@string/default_sort_mode">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerSortMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSlideshowInterval" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="@dimen/settings_width_input_small" android:layout_height="wrap_content" android:hint="@string/slideshow_interval">

                            <AutoCompleteTextView android:id="@+id/etSlideshowInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/slideshow_interval" android:inputType="number" android:maxLength="@integer/input_max_length_medium" android:text="@string/default_slideshow_interval" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton android:id="@+id/iconHelpSlideshow" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_slideshow_title" android:src="@drawable/ic_help_outline_24" app:tint="@color/text_color_secondary" />

                    </LinearLayout>

                    <!-- Play Video to End -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowPlayToEnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/play_video_to_end"
                        app:str_subtitle="@string/setting_play_to_end_desc" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- GROUP: File Operations -->
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage when playback header help copy is ready. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerFileOperations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/settings_category_file_operations" />

                <LinearLayout android:id="@+id/containerFileOperations" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small">

                    <!-- Allow Rename -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowAllowRename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        app:str_title="@string/allow_rename"
                        app:str_subtitle="@string/setting_allow_rename_desc" />

                    <!-- Delete + ConfirmDelete Row Container -->
                    <LinearLayout android:id="@+id/containerDeleteConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginBottom="@dimen/margin_small">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowAllowDelete"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/resource_field_margin_end"
                            app:str_title="@string/allow_delete"
                            app:str_subtitle="@string/setting_allow_delete_desc" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowConfirmDelete"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/settings_help_icon_margin"
                            app:str_title="@string/confirm_delete"
                            app:str_subtitle="@string/setting_confirm_delete_player_desc" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- GROUP: Player UI -->
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage when playback header help copy is ready. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerPlayerUI"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/settings_category_player_ui" />

                <LinearLayout android:id="@+id/containerPlayerUI" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small">

                    <!-- Hide System UI in Fullscreen -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowHideSystemUiInFullscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/hide_system_ui_in_fullscreen"
                        app:str_subtitle="@string/setting_hide_system_ui_desc" />

                    <!-- S0162: Follow OS auto-rotate (visibility gated by accelerometer presence) -->
                    <LinearLayout android:id="@+id/layoutFollowSystemRotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowFollowSystemRotation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_small"
                            app:str_title="@string/setting_follow_system_rotation_title"
                            app:str_subtitle="@string/setting_follow_system_rotation_summary" />

                    </LinearLayout>

                    <!-- Command Panel + Detailed Errors (One Row) -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowShowCommandPanel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/margin_small"
                            app:str_title="@string/show_command_panel_by_default"
                            app:str_subtitle="@string/setting_show_command_panel_desc"
                            app:str_showHelp="true"
                            app:str_helpTitle="@string/tooltip_command_panel_title"
                            app:str_helpMessage="@string/tooltip_command_panel_message" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowDetailedErrors"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            app:str_title="@string/show_detailed_errors"
                            app:str_subtitle="@string/setting_detailed_errors_desc" />

                    </LinearLayout>

                    <!-- Picture-in-Picture (API 31+; outer wrapper preserved for runtime visibility gate) -->
                    <LinearLayout android:id="@+id/layoutPip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowEnablePip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_small"
                            app:str_title="@string/setting_enable_pip"
                            app:str_subtitle="@string/setting_enable_pip_desc" />

                    </LinearLayout>

                    <!-- Panel Stereo Single-Eye View (spec_panel-stereo-single-eye) -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowPanelStereoSingleEye"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/pref_panel_stereo_single_eye_title"
                        app:str_subtitle="@string/pref_panel_stereo_single_eye_summary" />

                    <!-- S0158: Big Buttons Mode -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowBigButtonsMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/big_buttons_mode_title"
                        app:str_subtitle="@string/big_buttons_mode_summary"
                        app:str_showHelp="true"
                        app:str_helpTitle="@string/tooltip_big_buttons_mode_title"
                        app:str_helpMessage="@string/tooltip_big_buttons_mode_message" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- GROUP: Touch Zones -->
                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage when playback header help copy is ready. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerTouchZones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/settings_category_touch_zones" />

                <LinearLayout android:id="@+id/containerTouchZones" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingBottom="@dimen/margin_small">

                    <!-- Player Hint + Touch Zones (One Row) -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_small" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowShowPlayerHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/margin_small"
                            app:str_title="@string/show_player_hint"
                            app:str_subtitle="@string/show_player_hint_description" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowAlwaysShowTouchZones"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            app:str_title="@string/always_show_touch_zones_overlay"
                            app:str_subtitle="@string/always_show_touch_zones_overlay_description"
                            app:str_showHelp="true"
                            app:str_helpTitle="@string/tooltip_touch_zones_title"
                            app:str_helpMessage="@string/tooltip_touch_zones_message" />

                    </LinearLayout>



                    <!-- Touch Zones Scheme Header and Button -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_small" android:gravity="center_vertical" android:orientation="horizontal">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/touch_zones_scheme" android:textColor="?attr/colorPrimary" android:textSize="@dimen/toggler_title_text_size" android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnShowHintNow" style="@style/Widget.FastMediaSorter.SettingsButton.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_hint_now" />

                    </LinearLayout>

                    <!-- Horizontal layout: Map (50%) + Legend (50%) -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginBottom="@dimen/margin_small">

                        <ImageView android:layout_width="0dp" android:layout_height="@dimen/fragment_settings_playback_btnShowHintNow_layout_height" android:layout_weight="1" android:contentDescription="@string/touch_zones_scheme" android:scaleType="fitCenter" android:src="@drawable/touch_zones_scheme" android:layout_marginEnd="@dimen/margin_small"/>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">

                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zones_legend_title" android:textSize="@dimen/text_size_small" android:textStyle="bold" android:textColor="?attr/colorPrimary" android:layout_marginBottom="@dimen/margin_tiny"/>

                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_1_back" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_2_copy" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_3_rename" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_4_previous" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_5_move" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_6_next" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_7_command" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_8_delete" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_zone_9_slideshow" android:textSize="@dimen/activity_browse_btnSort_textSize" android:lineSpacingMultiplier="1.2"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GROUP: Behaviour (collapsible) - primary player, shared files, resume on next launch -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardBehaviour" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage when playback header help copy is ready. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerBehaviour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/settings_category_behaviour" />

                <LinearLayout android:id="@+id/containerBehaviour" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingTop="@dimen/margin_small" android:paddingBottom="@dimen/margin_small">

                    <!-- Prevent Sleep (moved from General > Network & Cache) -->
                    <LinearLayout android:id="@+id/layoutPreventSleep" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:orientation="vertical">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowPreventSleep"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_title="@string/prevent_sleep"
                            app:str_subtitle="@string/setting_prevent_sleep_desc"
                            app:str_showHelp="true"
                            app:str_helpTitle="@string/tooltip_prevent_sleep_title"
                            app:str_helpMessage="@string/tooltip_prevent_sleep_message" />

                    </LinearLayout>

                    <!-- Primary Media Player + Accept Shared Files (One Row, visible only when SUPPORTS_DEFAULT_PLAYER) -->
                    <LinearLayout android:id="@+id/layoutDefaultPlayerToggles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowPrimaryMediaPlayer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/margin_small"
                            app:str_title="@string/settings_primary_media_player"
                            app:str_subtitle="@string/setting_primary_media_player_desc" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowAcceptSharedFiles"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            app:str_title="@string/settings_accept_shared_files"
                            app:str_subtitle="@string/setting_accept_shared_files_desc" />

                    </LinearLayout>

                    <!-- Toggle: Resume on next launch (moved up to follow primary player + shared files row, no divider) -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowResumeOnNextLaunch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/setting_resume_on_next_launch"
                        app:str_subtitle="@string/setting_resume_on_next_launch_desc" />

                    <!-- S0142: sub-section "Incoming links" - divider + caps header -->
                    <View android:layout_width="match_parent" android:layout_height="@dimen/settings_divider_height" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_small" android:background="?attr/colorOutlineVariant" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:text="@string/settings_subcategory_incoming_links" android:textAllCaps="true" android:textColor="?attr/colorPrimary" android:textSize="@dimen/text_size_small" android:textStyle="bold" />

                    <!-- S0003: Link auto-download - master toggle -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowLinkAutodownloadEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/link_autodownload_master_label"
                        app:str_subtitle="@string/link_autodownload_master_summary" />

                    <!-- S0003: Link auto-download - destination resource (label-only stub; picker wired in Phase 05) -->
                    <LinearLayout android:id="@+id/row_link_autodownload_resource" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="vertical" android:clickable="true" android:focusable="true">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/link_autodownload_resource_label" android:textSize="@dimen/toggler_title_text_size" />
                        <TextView android:id="@+id/tv_link_autodownload_resource_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/link_autodownload_resource_not_set" android:textSize="@dimen/toggler_desc_text_size" android:textColor="@color/text_color_secondary" />

                    </LinearLayout>

                    <!-- S0003: Link auto-download - open in player toggle -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowLinkAutodownloadOpenInPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/link_autodownload_open_in_player_label"
                        app:str_subtitle="@string/link_autodownload_open_in_player_summary" />

                    <!-- Default for new resources: remember last viewed file -->
                    <LinearLayout android:id="@+id/layoutDefaultRememberFileList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_tiny" android:orientation="vertical">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowDefaultRememberFileList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_title="@string/default_remember_file_list"
                            app:str_subtitle="@string/setting_default_remember_file_list_desc"
                            app:str_showHelp="true"
                            app:str_helpTitle="@string/remember_file_list_help_title"
                            app:str_helpMessage="@string/remember_file_list_help_message" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GROUP: Other features (S0318) - camera capture + black screen, moved from Behaviour -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="2dp" app:contentPadding="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerOtherFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/settings_category_other_features" />

                <LinearLayout android:id="@+id/containerOtherFeatures" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingTop="@dimen/margin_small" android:paddingBottom="@dimen/margin_small">

                    <!-- Camera OCR Translation sub-section (S0320) -->
                    <TextView android:id="@+id/tvSubcategoryCameraOcr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:text="@string/settings_subcategory_camera_ocr" android:textAllCaps="true" android:textColor="?attr/colorPrimary" android:textSize="@dimen/text_size_small" android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowCameraOcrTranslationEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/setting_camera_ocr_translation_title"
                        app:str_subtitle="@string/setting_camera_ocr_translation_desc" />

                    <LinearLayout android:id="@+id/layoutCameraOcrOnly" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowCameraOcrOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_small"
                            app:str_title="@string/setting_camera_ocr_only_title"
                            app:str_subtitle="@string/setting_camera_ocr_only_desc" />
                    </LinearLayout>

                    <!-- Camera capture sub-section (moved from Behaviour, S0318) -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:text="@string/settings_subcategory_camera_capture" android:textAllCaps="true" android:textColor="?attr/colorPrimary" android:textSize="@dimen/text_size_small" android:textStyle="bold" />

                    <!-- Camera Capture: disable (row 1) + skip-filename (row 2) -->
                    <LinearLayout android:id="@+id/layoutCameraCapture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_small" android:orientation="vertical">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowDisableCameraCapture"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_title="@string/setting_disable_camera_capture"
                            app:str_subtitle="@string/setting_disable_camera_capture_summary"
                            app:str_showHelp="true"
                            app:str_helpTitle="@string/tooltip_camera_capture_title"
                            app:str_helpMessage="@string/tooltip_camera_capture_message" />

                        <!-- Skip filename dialog (dependent row gated by disableCameraCapture) -->
                        <LinearLayout android:id="@+id/layoutSkipCameraFilename" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                android:id="@+id/rowSkipCameraFilenameDialog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:str_title="@string/setting_skip_camera_filename_dialog" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- S0050: Show Black Screen button toggle (moved from Behaviour, S0318) -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowShowBlackScreenButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:str_title="@string/settings_black_screen_button_title"
                        app:str_subtitle="@string/settings_black_screen_button_desc" />

                    <!-- Calculator + Embedded game (moved here from the General tab "Other functionality" group) -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowEnableCalculator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:str_title="@string/calculator_title"
                        app:str_subtitle="@string/setting_calculator_desc"
                        app:str_showHelp="true"
                        app:str_helpTitle="@string/tooltip_calculator_title"
                        app:str_helpMessage="@string/tooltip_calculator_message" />

                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/rowEmbeddedGame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:str_title="@string/game_settings_toggle_title"
                        app:str_subtitle="@string/game_settings_toggle_subtitle"
                        app:str_showHelp="true"
                        app:str_helpTitle="@string/game_settings_help_title"
                        app:str_helpMessage="@string/game_settings_help_message" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnResetPlaybackSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginEnd="@dimen/margin_small" android:layout_marginTop="@dimen/margin_small" android:text="@string/reset_playback_section" style="@style/Widget.FastMediaSorter.SettingsButton.Outlined" />

        <!-- Controls & Keybindings entry -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:contentPadding="0dp">

            <LinearLayout
                android:id="@+id/rowControlsKeybindings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_controls_keybindings_title"
                        android:textSize="@dimen/toggler_title_text_size" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_controls_keybindings_desc"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="@dimen/toggler_desc_text_size" />

                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
