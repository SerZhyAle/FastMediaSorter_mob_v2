<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_padding">

        <!-- Extensions Manager Entrance (S0645: navigation-row etalon - title + hint + real arrow, no-stretch). -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow
            android:id="@+id/layoutExtensionsManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom"
            app:ssr_navMode="true"
            app:ssr_title="@string/ext_shortcut_packs_title"
            app:ssr_subtitle="@string/ext_shortcut_packs_desc" />

        <!-- Translation Section - help payload folded into the row -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:str_title="@string/enable_translation"
            app:str_subtitle="@string/setting_enable_translation_desc"
            app:str_showHelp="true"
            app:str_helpTitle="@string/tooltip_translation_title"
            app:str_helpMessage="@string/tooltip_translation_message" />

        <!-- Translation Languages Container (portrait: vertical, landscape: horizontal) -->
        <LinearLayout
            android:id="@+id/layoutTranslationLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom">

            <!-- Source Language -->
            <LinearLayout
                android:id="@+id/layoutTranslationSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_item_min_height"
                android:layout_marginBottom="@dimen/margin_small">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_source_language"
                    android:textSize="@dimen/toggler_title_text_size" />

                <TextView
                    android:id="@+id/spinnerTranslationSourceLanguage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/item_focus_selector"
                    android:contentDescription="@string/translation_source_language"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:minWidth="@dimen/settings_spinner_min_width"
                    android:paddingStart="@dimen/padding_normal"
                    android:paddingEnd="@dimen/padding_normal"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Swap Button -->
            <ImageButton android:id="@+id/btnSwapLanguages" android:layout_width="@dimen/settings_width_icon" android:layout_height="@dimen/settings_height_icon" android:layout_gravity="center_horizontal" android:layout_marginBottom="@dimen/margin_small" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/swap_languages" android:src="@drawable/ic_swap_horizontal" />

            <!-- Target Language -->
            <LinearLayout
                android:id="@+id/layoutTranslationTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_item_min_height">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_target_language"
                    android:textSize="@dimen/toggler_title_text_size" />

                <TextView
                    android:id="@+id/spinnerTranslationTargetLanguage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/item_focus_selector"
                    android:contentDescription="@string/translation_target_language"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:minWidth="@dimen/settings_spinner_min_width"
                    android:paddingStart="@dimen/padding_normal"
                    android:paddingEnd="@dimen/padding_normal"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutTranslationPrewarmStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><TextView android:id="@+id/tvTranslationPrewarmStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_desc_text_size" /><com.google.android.material.button.MaterialButton android:id="@+id/btnTranslationPrewarmRetry" style="@style/Widget.FastMediaSorter.SettingsButton.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="@string/translation_model_prewarm_retry" android:visibility="gone" /></LinearLayout>
        </LinearLayout>

        <!-- Translation Lens Style - help payload folded into the row -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowTranslationLensStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom"
            android:visibility="gone"
            app:str_title="@string/translation_lens_style"
            app:str_subtitle="@string/setting_translation_lens_style_desc"
            app:str_showHelp="true"
            app:str_helpTitle="@string/tooltip_translation_blocks_title"
            app:str_helpMessage="@string/tooltip_translation_blocks_message" />

        <!-- OCR (Text Recognition) - no subtitle in original layout; tvOcrSummary below shows unsupported reason -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:str_title="@string/enable_ocr" />

        <TextView
            android:id="@+id/tvOcrSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_ocr_summary"
            android:textSize="@dimen/toggler_desc_text_size"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small" />

        <!-- OCR Engine Type (S0288) - trigger row opens SimpleValueChoiceDialog (S0646). -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow
            android:id="@+id/rowOcrEngineType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            app:ssr_title="@string/ocr_engine_type" />

        <!-- PaddleOCR Model Selection (S0288) - trigger row opens SimpleValueChoiceDialog (S0646). -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow
            android:id="@+id/rowPaddleOcrModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            app:ssr_title="@string/paddle_ocr_model" />

        <!-- OCR Font Size - trigger row opens SimpleValueChoiceDialog (S0646). -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow
            android:id="@+id/rowOcrFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            app:ssr_title="@string/ocr_font_size" />

        <!-- OCR Font Family - trigger row opens SimpleValueChoiceDialog (S0646). -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsSelectionRow
            android:id="@+id/rowOcrFontFamily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            app:ssr_title="@string/ocr_font_family" />


</LinearLayout>
