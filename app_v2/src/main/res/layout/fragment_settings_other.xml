<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_padding">

        <!-- Translation Section - help payload folded into the row -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:str_title="@string/enable_translation"
            app:str_subtitle="@string/setting_enable_translation_desc"
            app:str_showHelp="true"
            app:str_helpTitle="@string/tooltip_translation_title"
            app:str_helpMessage="@string/tooltip_translation_message" />

        <!-- Translation Languages Container (portrait: vertical, landscape: horizontal) -->
        <LinearLayout
            android:id="@+id/layoutTranslationLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom">

            <!-- Source Language -->
            <LinearLayout
                android:id="@+id/layoutTranslationSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_item_min_height"
                android:layout_marginBottom="@dimen/margin_small">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_source_language"
                    android:textSize="@dimen/toggler_title_text_size" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinnerTranslationSourceLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/settings_spinner_min_width" />
            </LinearLayout>

            <!-- Swap Button -->
            <ImageButton
                android:id="@+id/btnSwapLanguages"
                android:layout_width="@dimen/settings_width_icon"
                android:layout_height="@dimen/settings_height_icon"
                android:layout_gravity="center_horizontal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_swap_horizontal"
                android:contentDescription="@string/swap_languages"
                android:layout_marginBottom="@dimen/margin_small" />

            <!-- Target Language -->
            <LinearLayout
                android:id="@+id/layoutTranslationTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_item_min_height">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/translation_target_language"
                    android:textSize="@dimen/toggler_title_text_size" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinnerTranslationTargetLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/settings_spinner_min_width" />
            </LinearLayout>
        </LinearLayout>

        <!-- Translation Lens Style - help payload folded into the row -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowTranslationLensStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom"
            android:visibility="gone"
            app:str_title="@string/translation_lens_style"
            app:str_subtitle="@string/setting_translation_lens_style_desc"
            app:str_showHelp="true"
            app:str_helpTitle="@string/tooltip_translation_blocks_title"
            app:str_helpMessage="@string/tooltip_translation_blocks_message" />

        <!-- Google Lens -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableGoogleLens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom"
            app:str_title="@string/enable_google_lens"
            app:str_subtitle="@string/setting_enable_google_lens_desc" />

        <!-- OCR (Text Recognition) - no subtitle in original layout; tvOcrSummary below shows unsupported reason -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:str_title="@string/enable_ocr" />

        <TextView
            android:id="@+id/tvOcrSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_ocr_summary"
            android:textSize="@dimen/toggler_desc_text_size"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small" />

        <!-- OCR Font Size -->
        <LinearLayout
            android:id="@+id/layoutOcrFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/settings_item_min_height"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/margin_small">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ocr_font_size"
                android:textSize="@dimen/toggler_title_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerOcrFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/settings_spinner_min_width" />
        </LinearLayout>

        <!-- OCR Font Family -->
        <LinearLayout
            android:id="@+id/layoutOcrFontFamily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/settings_item_min_height"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ocr_font_family"
                android:textSize="@dimen/toggler_title_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerOcrFontFamily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/settings_spinner_min_width" />
        </LinearLayout>

</LinearLayout>
