<?xml version="1.0" encoding="utf-8"?>
<!-- S0400 functionality onboarding page (portrait). Same ids, centred header, and inline
     title+description toggle rows as the landscape variant, while keeping the capability toggles in
     TWO columns so tall phones/tablets do not waste vertical space. OCR / translation / streams keep
     their inline progress rows directly below the owning toggle, and the centred
     "All downloadable (optional) elements" button stays below both columns.
     Rows are hidden by WelcomeFunctionalityController per the S0396 availability contract; hidden rows
     collapse their column slot. All ids must stay in sync with the landscape variant
     (layout-land/page_welcome_functionality.xml). Keep the generated binding name
     PageWelcomeFunctionalityBinding stable. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/welcome_page_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_max="@dimen/welcome_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Header: icon -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/welcome_icon_size"
            android:layout_height="@dimen/welcome_icon_size"
            android:layout_marginTop="@dimen/welcome_icon_margin_top"
            android:contentDescription="@string/welcome_functionality_title"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header: title -->
        <TextView
            android:id="@+id/tvFunctionalityTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_title_margin_top"
            android:gravity="center"
            android:text="@string/welcome_functionality_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/welcome_title_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivIcon" />

        <!-- Header: subtitle -->
        <TextView
            android:id="@+id/tvFunctionalitySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:alpha="0.85"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/welcome_functionality_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/welcome_description_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFunctionalityTitle" />

        <!-- Scrollable body so the two columns never clip on short screens -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFunctionalitySubtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="@dimen/welcome_func_column_gap">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowFileManager"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_folder"
                            app:str_subtitle="@string/welcome_func_file_manager_desc"
                            app:str_title="@string/welcome_func_file_manager" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowAudio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_audio"
                            app:str_subtitle="@string/welcome_func_audio_desc"
                            app:str_title="@string/welcome_func_audio" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowVideo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_video"
                            app:str_subtitle="@string/welcome_func_video_desc"
                            app:str_title="@string/welcome_func_video" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowStreams"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_cast"
                            app:str_subtitle="@string/welcome_func_streams_desc"
                            app:str_title="@string/welcome_func_streams" />

                        <!-- S0575: inline stream-catalog download progress; optional, hidden until a download starts -->
                        <LinearLayout
                            android:id="@+id/groupStreamsProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="0dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progressStreams"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100" />

                            <TextView
                                android:id="@+id/tvStreamsStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:accessibilityLiveRegion="polite"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowStatistics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_history"
                            app:str_subtitle="@string/settings_statistics_collection_summary"
                            app:str_title="@string/settings_statistics_collection_title" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/welcome_func_column_gap">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowDocuments"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_book"
                            app:str_subtitle="@string/welcome_func_documents_desc"
                            app:str_title="@string/welcome_func_documents" />

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowOcr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_ocr"
                            app:str_subtitle="@string/welcome_func_ocr_desc"
                            app:str_title="@string/welcome_func_ocr" />

                        <!-- Inline OCR download progress; hidden until a download starts -->
                        <LinearLayout
                            android:id="@+id/groupOcrProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="0dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progressOcr"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100" />

                            <TextView
                                android:id="@+id/tvOcrStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:accessibilityLiveRegion="polite"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowTranslation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_translate"
                            app:str_subtitle="@string/welcome_func_translation_desc"
                            app:str_title="@string/welcome_func_translation" />

                        <!-- Inline translation download progress; hidden until a download starts -->
                        <LinearLayout
                            android:id="@+id/groupTranslationProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="0dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progressTranslation"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100" />

                            <TextView
                                android:id="@+id/tvTranslationStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:accessibilityLiveRegion="polite"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowGestures"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_icon="@drawable/ic_gesture"
                            app:str_subtitle="@string/welcome_func_gestures_summary"
                            app:str_title="@string/welcome_func_gestures" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnElements"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:text="@string/welcome_func_elements_button" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
