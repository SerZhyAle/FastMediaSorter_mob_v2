<?xml version="1.0" encoding="utf-8"?>
<!-- S0473 Phase 04: summary card (big value + label + icon). Width is driven by the grid span
     set in the adapter; colors come from the theme (no hardcoded hex, Rule 19). -->
<com.sza.fastmediasorter.ui.common.widget.FocusMaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_small"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/margin_medium">

        <ImageView
            android:id="@+id/ivCardIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_move"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvCardValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_normal"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_huge"
            android:textStyle="bold"
            tools:text="1 248" />

        <TextView
            android:id="@+id/tvCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>

</com.sza.fastmediasorter.ui.common.widget.FocusMaterialCardView>
