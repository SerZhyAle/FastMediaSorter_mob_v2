<?xml version="1.0" encoding="utf-8"?>
<!-- S0675: stream grid tile. Column width is owned by the GridLayoutManager span; height derives from
     the 16:9 ratio. ivFrame shows the cached frame or the favicon/placeholder fallback.
     S0700: frame capture is fully offscreen (StreamFrameSnapshotManager renders into its own ImageReader,
     not a cell view), so the tile no longer hosts a capture TextureView - the captured bitmap is painted
     into ivFrame from the frame cache once the offscreen decode completes. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="?attr/colorSurfaceVariant"
    android:foreground="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/ivFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="H,16:9" />

    <!-- S0701: the title starts after the bottom-left status dot so the dot never overlaps the first
         characters of the channel name; it still fills the rest of the tile width. -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_stream_grid_title_scrim"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toEndOf="@id/ivGridStatus"
        app:layout_constraintEnd_toEndOf="@id/ivFrame"
        app:layout_constraintBottom_toBottomOf="@id/ivFrame" />

    <!-- S0701: play-status dot mirrored from the list row (ivPlayStatus); icon shape + tint carry the
         state. Pinned to the bottom-left of the frame, on a dark disc for contrast over any frame. -->
    <ImageView
        android:id="@+id/ivGridStatus"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="6dp"
        android:padding="3dp"
        android:background="@drawable/bg_stream_grid_overlay_circle"
        android:src="@drawable/ic_stream_status_unknown"
        android:contentDescription="@string/stream_status_unknown"
        app:layout_constraintStart_toStartOf="@id/ivFrame"
        app:layout_constraintBottom_toBottomOf="@id/ivFrame" />

    <!-- S1062: pinned-state indicator badge, top-left over the frame. Pure indicator (not clickable/
         focusable) - pin/unpin is driven only through the overflow menu. Shown at bind time when pinned. -->
    <TextView
        android:id="@+id/tvPinBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_stream_pin_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:maxLines="1"
        android:text="@string/streams_pinned_badge"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/ivFrame"
        app:layout_constraintStart_toStartOf="@id/ivFrame" />

    <!-- S0701: per-tile overflow (три точки) mirroring the list row's btnOverflow, anchored top-right of
         the frame so the same secondary commands (shortcut/edit/share/remove) are reachable in grid mode. -->
    <ImageButton
        android:id="@+id/btnGridOverflow"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="2dp"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:background="@drawable/bg_stream_grid_overlay_circle"
        android:src="@drawable/ic_more_vert"
        app:tint="@android:color/white"
        android:focusable="true"
        android:contentDescription="@string/streams_more_actions"
        app:layout_constraintTop_toTopOf="@id/ivFrame"
        app:layout_constraintEnd_toEndOf="@id/ivFrame" />

</androidx.constraintlayout.widget.ConstraintLayout>
