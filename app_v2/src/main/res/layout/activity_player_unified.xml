        <TextView android:id="@+id/audioSlideshowSongLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="@dimen/activity_player_unified_audioSlideshowSongLabel_layout_margin" android:paddingStart="@dimen/activity_player_unified_audioSlideshowSongLabel_paddingStart" android:paddingEnd="@dimen/activity_player_unified_audioSlideshowSongLabel_paddingEnd" android:paddingTop="@dimen/activity_player_unified_audioSlideshowSongLabel_paddingTop" android:paddingBottom="@dimen/activity_player_unified_audioSlideshowSongLabel_paddingBottom" android:background="@color/activity_player_unified_audioSlideshowSongLabel_background" android:textColor="@color/white" android:textSize="@dimen/activity_browse_btnSort_textSize" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:elevation="@dimen/activity_player_unified_audioSlideshowSongLabel_elevation" />

        <!-- Dual-surface container for static image rendering (A=current, B=next) -->
        <FrameLayout android:id="@+id/photoDualSurfaceContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">

            <!-- Surface B (prepared/next), kept below A by z-order -->
            <com.github.chrisbanes.photoview.PhotoView android:id="@+id/photoViewSurfaceB" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:contentDescription="@null" />

            <!-- Surface A (current/top). Keep legacy id for compatibility -->
            <com.github.chrisbanes.photoview.PhotoView android:id="@+id/photoView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:contentDescription="@null" />

        </FrameLayout>

        <!-- PDF Vertical Scroll Mode RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/pdfScrollRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/activity_player_unified_topCommandPanel_background" android:clipToPadding="false" android:scrollbars="vertical" />

        <!-- Google Lens Style Translation Overlay (drawn on top of PDF/images) -->
        <com.sza.fastmediasorter.ui.player.views.TranslationOverlayView android:id="@+id/translationLensOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:elevation="@dimen/elevation_player_overlay" android:clickable="true" android:focusable="true" />

        <include layout="@layout/player_search_panel_content" />

        <include layout="@layout/player_text_viewer_container_content" />

        <ViewStub android:id="@+id/lyricsViewerStub" android:inflatedId="@+id/lyricsViewerContainer" android:layout="@layout/player_lyrics_viewer_container" android:layout_width="match_parent" android:layout_height="match_parent" />

        <include layout="@layout/player_pdf_controls_overlay_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

        <include layout="@layout/player_deprecated_translate_image_button_content" />

        <!-- EPUB WebView Container: FrameLayout keeps the id so all .isVisible calls in managers work.
             The actual WebView is created programmatically in EpubViewerManager.getOrCreateWebView()
             only when an EPUB is opened, avoiding Chromium native heap load at layout inflation time. -->
        <FrameLayout android:id="@+id/epubWebView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/white" />

        <!-- S0301: neutral host slot for the embedded Office viewer. Stays GONE until a
             flavor with an internal Office engine populates it; engine-specific widgets are
             added programmatically by the flavor viewer manager, never declared here. -->
        <FrameLayout android:id="@+id/officeDocumentViewerContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/white" />

        <ImageButton android:id="@+id/btnExitEpubFullscreen" android:layout_width="@dimen/player_cmd_button_size" android:layout_height="@dimen/player_cmd_button_size" android:layout_gravity="top|end" android:layout_marginTop="@dimen/player_epub_button_margin_top" android:layout_marginEnd="@dimen/player_epub_button_margin_end" android:src="@drawable/ic_fullscreen_exit" android:background="@drawable/bg_circle_dark" app:tint="@color/white" android:scaleType="fitCenter" android:padding="@dimen/player_epub_button_padding" android:visibility="gone" android:contentDescription="@string/exit_fullscreen" />

        <include layout="@layout/player_epub_controls_overlay_content" />


        <include layout="@layout/player_deprecated_google_lens_image_button_content" />

        <include layout="@layout/player_deprecated_ocr_image_button_content" />

        <include layout="@layout/player_translation_overlay_content" />

        <include layout="@layout/player_touch_zones_legacy_content" />

        <!-- Fullscreen controls overlay (visible only in fullscreen mode when showControls=true) -->
        <LinearLayout android:id="@+id/controlsOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@android:color/transparent" android:visibility="gone">

            <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="?attr/colorPrimary" android:elevation="@dimen/toolbar_elevation" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="?attr/colorOnPrimary" app:titleTextColor="?attr/colorOnPrimary" />

            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout android:id="@+id/playbackButtonRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/player_text_viewer_padding" android:background="@color/activity_player_unified_toolbar_background" android:gravity="center">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnVolumeDown" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/activity_player_unified_btnVolumeDown_minWidth" android:text="@string/activity_player_unified_btnVolumeDown_text" android:textSize="@dimen/activity_player_btnVolumeUp_textSize" android:textColor="@color/white" android:visibility="gone" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusRight="@id/btnPrevious" android:nextFocusDown="@id/btnSlideShow" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrevious" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_player_unified_btnPrevious_text" android:textSize="@dimen/activity_player_btnVolumeUp_textSize" android:textColor="@color/white" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnVolumeDown" android:nextFocusRight="@id/btnPlayPause" android:nextFocusDown="@id/btnSlideShow" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnPlayPause" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/play_pause" android:text="@string/activity_player_btnPlayPause_text" android:textSize="@dimen/activity_player_unified_btnPlayPause_textSize" android:textColor="@color/white" android:layout_marginHorizontal="@dimen/activity_player_unified_btnPlayPause_layout_marginHorizontal" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnPrevious" android:nextFocusRight="@id/btnNext" android:nextFocusDown="@id/btnSlideShow" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnNext" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/next_file" android:text="@string/activity_player_btnPlayPause_text" android:textSize="@dimen/activity_player_btnVolumeUp_textSize" android:textColor="@color/white" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnPlayPause" android:nextFocusRight="@id/btnVolumeUp" android:nextFocusDown="@id/btnDelete" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnVolumeUp" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/activity_player_unified_btnVolumeDown_minWidth" android:text="@string/activity_player_unified_btnVolumeUp_text" android:textSize="@dimen/activity_player_btnVolumeUp_textSize" android:textColor="@color/white" android:visibility="gone" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnNext" android:nextFocusDown="@id/btnDelete" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/activity_player_unified_btnVolumeUp_paddingHorizontal" android:paddingBottom="@dimen/activity_player_unified_btnVolumeUp_paddingBottom" android:background="@color/activity_player_unified_toolbar_background" android:gravity="center">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnSlideShow" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_player_btnSlideShow_text" android:textColor="@color/white" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusUp="@id/btnPlayPause" android:nextFocusRight="@id/btnDelete" />

                <View android:layout_width="0dp" android:layout_height="@dimen/fragment_settings_media_etImageSizeMax_layout_height" android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_player_btnDelete_text" android:textColor="@color/white" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusUp="@id/btnPlayPause" android:nextFocusLeft="@id/btnSlideShow" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:contentDescription="@string/loading_indicator" android:visibility="gone" />

        <!-- S0685: stream wait-phase caption under the centered spinner (buffering vs reconnecting). -->
        <TextView android:id="@+id/streamWaitLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="@dimen/stream_wait_label_margin_top" android:textColor="@color/white" android:textSize="@dimen/stream_wait_label_text_size" android:textAlignment="center" android:visibility="gone" />

        <include layout="@layout/player_tv_countdown_content" />

        <include layout="@layout/player_audio_touch_zones_overlay_content" />

        <include layout="@layout/player_first_run_hint_overlay_content" />

        <!-- File name overlay (visible only in command panel mode) - positioned last for z-order -->
        <TextView android:id="@+id/tvFileNameOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="@dimen/activity_player_unified_tvFileNameOverlay_layout_marginStart" android:layout_marginTop="@dimen/activity_player_unified_tvFileNameOverlay_layout_marginTop" android:maxLines="1" android:ellipsize="end" android:textColor="@color/activity_player_unified_tvFileNameOverlay_textColor" android:textSize="@dimen/activity_browse_btnSort_textSize" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2" android:background="@drawable/bg_rounded_badge" android:visibility="gone" />

        <TextView android:id="@+id/tvAnimatedBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="@dimen/activity_player_unified_tvFileNameOverlay_layout_marginTop" android:layout_marginEnd="@dimen/player_epub_button_margin_end" android:background="@drawable/bg_circle_dark" android:paddingHorizontal="@dimen/player_button_padding" android:paddingVertical="@dimen/player_button_padding" android:text="@string/animated_badge_gif" android:textColor="@color/white" android:textSize="@dimen/player_audio_info_text_size" android:textStyle="bold" android:visibility="gone" />

        <TextView android:id="@+id/tvVideoGestureIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/bg_circle_dark" android:paddingHorizontal="@dimen/player_ocr_padding_horizontal" android:paddingVertical="@dimen/player_button_padding" android:textColor="@color/white" android:textSize="@dimen/activity_player_unified_audioSlideshowSongLabel_textSize" android:textStyle="bold" android:visibility="gone" />

        <include layout="@layout/player_document_fullscreen_exit_button_content" />

        <include layout="@layout/player_touch_zones_overlay_new_content" />

        <include layout="@layout/player_background_music_track_overlay_content" />

        <include layout="@layout/player_pdf_fullscreen_overlay_content" />

        <!-- Touch Zones Help button (?) - visible in fullscreen touch zone mode for IMAGE/GIF.
             Positioned top-end to avoid conflict with toolbar back button. -->
        <ImageButton
            android:id="@+id/btnTouchZonesHelp"
            android:layout_width="@dimen/player_cmd_button_size"
            android:layout_height="@dimen/player_cmd_button_size"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/player_epub_button_margin_top"
            android:layout_marginEnd="@dimen/player_epub_button_margin_end"
            android:background="@drawable/bg_circle_dark"
            android:src="@drawable/ic_help_outline_24"
            android:contentDescription="@string/touch_zones_help"
            android:scaleType="fitCenter"
            android:padding="@dimen/player_epub_button_padding"
            android:elevation="@dimen/elevation_player_overlay"
            android:visibility="gone" />

        <include layout="@layout/player_vr_launch_overlay_content" />

        <!-- S0021: Diagnostic FPS overlay over the flat player. Visibility driven by
             AppSettings.playerShowFps + active-video gate; see PlayerActivity. -->
        <TextView
            android:id="@+id/tvPlayerFpsOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_small"
            android:background="@drawable/bg_fps_overlay"
            android:paddingHorizontal="@dimen/margin_small"
            android:paddingVertical="2dp"
            android:textColor="@color/white"
            android:textSize="@dimen/toggler_desc_text_size"
            android:elevation="@dimen/elevation_player_overlay"
            android:focusable="false"
            android:clickable="false"
            android:visibility="gone"
            tools:text="60 fps" />

    </FrameLayout>

    <!-- Mini Now Playing bar - shown only while AudioPlaybackService.isRunning == true.
         Tap anywhere to open NowPlayingBottomSheetFragment. -->
    <include
        android:id="@+id/miniNowPlayingBar"
        layout="@layout/view_mini_now_playing"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_now_playing_height"
        android:visibility="gone" />

    <!-- S0107: Draw overlay toolbar (visibility managed by ImageDrawOverlayManager).
         S0368: ordered ABOVE bottom_panels_container so the draw band sits nearest the
         image, with Copy/Move below it; Copy/Move already consume systemBars.bottom and
         stay the bottom-most band above the system navigation bar. -->
    <include
        android:id="@+id/draw_overlay_toolbar_stub"
        layout="@layout/player_draw_overlay_toolbar_content" />

    <include layout="@layout/player_bottom_panels_container_content" />

</LinearLayout>

