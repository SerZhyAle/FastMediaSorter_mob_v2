<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdfFullscreenOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_player_unified_pdfFullscreenOverlay_background"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/pdfFullscreenPhotoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/pdf_fullscreen" />

    <include layout="@layout/player_pdf_exit_fullscreen_button_content" />
</FrameLayout>
