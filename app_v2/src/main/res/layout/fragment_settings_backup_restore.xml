<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:descendantFocusability="afterDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/settings_fragment_padding"
        android:clipToPadding="false">

        <!-- Backup to Google Drive -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackup"
                        style="@style/Widget.FastMediaSorter.SettingsButton.OutlinedM3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/backup_to_google_drive"
                        app:icon="@drawable/ic_cloud_upload"
                        app:iconGravity="start" />

                    <ImageButton
                        android:layout_width="@dimen/settings_help_icon_size"
                        android:layout_height="@dimen/settings_help_icon_size"
                        android:layout_marginStart="@dimen/settings_help_icon_margin"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:clickable="false"
                        android:importantForAccessibility="no"
                        android:visibility="invisible" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:id="@+id/layoutBackupInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvLastBackupDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="@dimen/toggler_title_text_size" />

                        <TextView
                            android:id="@+id/tvBackupAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="@dimen/toggler_title_text_size" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressBackup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="36dp" />

                </FrameLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Restore from Google Drive -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestore"
                        style="@style/Widget.FastMediaSorter.SettingsButton.OutlinedM3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/restore_from_google_drive"
                        app:icon="@drawable/ic_cloud_download"
                        app:iconGravity="start" />

                    <ImageButton
                        android:id="@+id/iconHelpBackupInfo"
                        android:layout_width="@dimen/settings_help_icon_size"
                        android:layout_height="@dimen/settings_help_icon_size"
                        android:layout_marginStart="@dimen/settings_help_icon_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tooltip_backup_info_title"
                        android:src="@drawable/ic_help_outline_24"
                        app:tint="@color/text_color_secondary" />

                </LinearLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="36dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Export Favorites -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportFavorites"
                    style="@style/Widget.FastMediaSorter.SettingsButton.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_export_favorites"
                    app:icon="@drawable/ic_favorite"
                    app:iconGravity="start" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressExportFav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="32dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Import Favorites -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportFavorites"
                    style="@style/Widget.FastMediaSorter.SettingsButton.OutlinedM3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_import_favorites"
                    app:icon="@drawable/ic_favorite"
                    app:iconGravity="start" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressImportFav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="32dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Export resources to file (S0422) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportResources"
                    style="@style/Widget.FastMediaSorter.SettingsButton.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/resource_share_export_title"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="start" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressExportResources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="32dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Import resources from file (S0422) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportResources"
                    style="@style/Widget.FastMediaSorter.SettingsButton.OutlinedM3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/resource_share_import_title"
                    app:icon="@drawable/ic_open_in_browse"
                    app:iconGravity="start" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressImportResources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="32dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
