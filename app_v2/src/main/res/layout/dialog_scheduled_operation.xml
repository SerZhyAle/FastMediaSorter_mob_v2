<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/scheduled_ops_btn_add"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <!-- Source resource -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scheduled_ops_source"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.7" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/actvSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Read-only source hint -->
        <TextView
            android:id="@+id/tvReadOnlySourceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/scheduled_ops_readonly_source"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <!-- Operation type (no label - value is self-explanatory) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/settings_dropdown_compact_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/actvOperation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target resource (hidden for DELETE) -->
        <TextView
            android:id="@+id/tvTargetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/scheduled_ops_target"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.7" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/actvTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONDITIONS GROUP (collapsible, collapsed by default) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- S0256 TODO: add csh_helpTitle/csh_helpMessage for ScheduledOperation conditions if inline help is approved later. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerConditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_showHelp="false"
                    app:csh_title="@string/scheduled_ops_col_condition" />

                <!-- Collapsible content - hidden by default -->
                <LinearLayout
                    android:id="@+id/containerConditionsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <!-- File type checkboxes - compact, 2-column grid -->
                    <GridLayout
                        android:id="@+id/containerFileTypeMask"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbFileTypeAllFiles"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:minHeight="0dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/scheduled_ops_filter_all_files" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbFileTypeImages"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:minHeight="0dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/scheduled_ops_filter_images" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbFileTypeAudio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:minHeight="0dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/scheduled_ops_filter_audio" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbFileTypeVideo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:minHeight="0dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/scheduled_ops_filter_video" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbFileTypeDocs"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:minHeight="0dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/scheduled_ops_filter_documents" />

                    </GridLayout>

                    <!-- Time filter -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                        <AutoCompleteTextView
                            android:id="@+id/actvTimeFilter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Overwrite existing files (hidden for DELETE) - grouped with conditions.
                         Wrapper keeps id containerOverwrite as the op-type visibility target;
                         the canonical row carries id switchOverwrite for the checked-state seam. -->
                    <LinearLayout
                        android:id="@+id/containerOverwrite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/switchOverwrite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:str_title="@string/scheduled_ops_overwrite" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Start time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/scheduled_ops_starting_from"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="HH"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartHour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:maxLength="2" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text=":"
                android:textAppearance="?attr/textAppearanceBody1" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="MM"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartMinute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:maxLength="2" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickTime"
                style="@style/Widget.FastMediaSorter.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:contentDescription="@string/scheduled_ops_starting_from"
                app:icon="@drawable/ic_schedule"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

        <!-- Interval -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/scheduled_ops_col_schedule"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/scheduled_ops_every_hours"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIntervalHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:maxLength="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_tiny"
                android:hint="@string/scheduled_ops_every_minutes"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIntervalMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:maxLength="2" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickInterval"
                style="@style/Widget.FastMediaSorter.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:contentDescription="@string/scheduled_ops_col_schedule"
                app:icon="@drawable/ic_schedule"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvIntervalHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/scheduled_ops_schedule_accuracy_hint"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.6" />

        <!-- Next run preview -->
        <TextView
            android:id="@+id/tvNextRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone" />

        <!-- Silent mode -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/switchSilentMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:str_title="@string/scheduled_ops_silent_mode" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.FastMediaSorter.Button.DialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_action_button_gap"
                android:text="@string/scheduled_ops_save" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
