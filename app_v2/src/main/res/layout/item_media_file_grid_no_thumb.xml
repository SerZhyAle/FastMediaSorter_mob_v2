<?xml version="1.0" encoding="utf-8"?>
<!-- No-thumbnail grid cell: horizontal "plank" - square extension tile on the left,
     file name filling the rest on the right. The tile is sized to the cell height by the
     adapter so it stays square and never stretches across the (doubled) cell width. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_focus_selector"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/item_media_file_grid_unknown_padding">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:padding="0dp"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingTop="@dimen/margin_tiny"
            android:paddingEnd="@dimen/padding_small"
            android:paddingBottom="@dimen/margin_tiny">

            <FrameLayout
                android:id="@+id/flThumbnailContainer"
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/ivThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:selectableItemBackground"
                    android:contentDescription="@string/thumbnail"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_image" />

                <CheckBox
                    android:id="@+id/cbSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/padding_small"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textSize="@dimen/item_detail_text_size"
                tools:text="39.Кот в крапинку.Неаполитанский ужин" />

            <ViewStub
                android:id="@+id/stubOperations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/item_media_file_grid_operations"
                android:inflatedId="@+id/llOperations" />

            <ImageButton
                android:id="@+id/btnOverflowMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overflow_menu"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                android:visibility="gone"
                app:tint="@color/selector_themed_button_tint"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
