<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_large"
    android:background="?attr/colorSurface">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Integration Tests"
        android:textSize="@dimen/text_size_huge"
        android:textStyle="@string/text_style_bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="@dimen/margin_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automated testing of file operations across all resource types"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="@dimen/margin_small" />

    <!-- Test Group Buttons - Row 1 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="@dimen/margin_tiny">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipAll_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFailedOnly"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipFailedOnly_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLocal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipLocal_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNetwork"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipNetwork_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipImage"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipImage_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGif"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipGif_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Test Group Buttons - Row 2 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="@dimen/margin_normal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMatrixCopy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipMatrixCopy_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMatrixMove"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipMatrixMove_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMatrixOther"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipMatrixOther_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSettings"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipSettings_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavorites"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipFavorites_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMetadata"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipMetadata_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Test Group Buttons - Row 3 (New Features) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="@dimen/margin_normal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAudio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipAudio_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNetworkUtils"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipNetworkUtils_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCache"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipCache_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipScanning"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipScanning_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCloudProviders"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_integration_test_chipCloudProviders_text"
                android:layout_marginEnd="@dimen/margin_tiny" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Progress Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_normal"
        android:background="?attr/colorSurfaceVariant"
        android:layout_marginBottom="@dimen/margin_large">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_tvProgress_text"
            android:textSize="@dimen/resource_card_title_text_size"
            android:textStyle="@string/text_style_bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/margin_tiny" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_tvStatus_text"
            android:textSize="@dimen/resource_card_desc_text_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="@dimen/margin_small" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <!-- Log Output -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_integration_test_progressBar_text"
        android:textSize="@dimen/resource_card_desc_text_size"
        android:textStyle="@string/text_style_bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="@dimen/margin_small" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black"
        android:padding="@dimen/padding_small">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_tvLog_text"
            android:textSize="@dimen/text_size_small"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_large"
        android:gravity="end">

        <Button
            android:id="@+id/btnImportLog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_btnImportLog_text"
            android:layout_marginEnd="@dimen/dialog_field_spacing" />

        <Button
            android:id="@+id/btnCopyLog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_btnCopyLog_text"
            android:layout_marginEnd="@dimen/dialog_field_spacing" />

        <Button
            android:id="@+id/btnSaveLog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_btnSaveLog_text"
            android:layout_marginEnd="@dimen/dialog_field_spacing" />

        <Button
            android:id="@+id/btnClose"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_integration_test_btnClose_text" />
    </LinearLayout>

</LinearLayout>
