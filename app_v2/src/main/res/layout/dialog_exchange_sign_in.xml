<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dialog_padding_large"
        android:paddingTop="@dimen/margin_small">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeSignInIntake"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exchange_signin_intake_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeSignInIntake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:nextFocusDown="@+id/btnExchangeSignInPaste" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExchangeSignInPaste"
                style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/etExchangeSignInIntake"
                android:nextFocusRight="@+id/btnExchangeSignInScan"
                android:nextFocusDown="@+id/etExchangeSignInAddress"
                android:text="@string/exchange_signin_paste" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExchangeSignInScan"
                style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/etExchangeSignInIntake"
                android:nextFocusLeft="@id/btnExchangeSignInPaste"
                android:nextFocusRight="@+id/btnExchangeSignInFile"
                android:nextFocusDown="@+id/etExchangeSignInAddress"
                android:text="@string/exchange_signin_scan_qr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExchangeSignInFile"
                style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/etExchangeSignInIntake"
                android:nextFocusLeft="@id/btnExchangeSignInScan"
                android:nextFocusDown="@+id/etExchangeSignInAddress"
                android:text="@string/exchange_signin_choose_file" />
        </LinearLayout>

        <TextView
            android:id="@+id/textExchangeSignInServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textExchangeSignInPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textExchangeSignInInvitation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:accessibilityLiveRegion="polite"
            android:drawablePadding="@dimen/margin_small"
            android:drawableStart="@drawable/ic_exchange_invitation"
            android:drawableTint="?attr/colorControlNormal"
            android:gravity="center_vertical"
            android:text="@string/exchange_signin_invitation_present"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeSignInAddress"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exchange_devices_signin_address">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeSignInAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textUri|textNoSuggestions"
                android:nextFocusUp="@id/btnExchangeSignInPaste"
                android:nextFocusDown="@id/etExchangeSignInLogin" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeSignInLogin"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:hint="@string/exchange_devices_signin_login">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeSignInLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="text|textNoSuggestions"
                android:nextFocusUp="@id/etExchangeSignInAddress"
                android:nextFocusDown="@id/etExchangeSignInSecret" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeSignInSecret"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:hint="@string/exchange_devices_signin_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeSignInSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textPassword"
                android:nextFocusUp="@id/etExchangeSignInLogin"
                android:nextFocusDown="@+id/etExchangeSignInPasswordRepeat" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeSignInPasswordRepeat"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:hint="@string/exchange_signin_password_repeat"
            android:visibility="gone"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeSignInPasswordRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textPassword"
                android:nextFocusUp="@id/etExchangeSignInSecret"
                android:nextFocusDown="@+id/checkExchangeSignInUseCode" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
            android:id="@+id/checkExchangeSignInUseCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:nextFocusUp="@id/etExchangeSignInSecret"
            android:nextFocusDown="@+id/checkExchangeSignInUseInvitationPassword"
            app:fcr_title="@string/exchange_devices_signin_use_code" />

        <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
            android:id="@+id/checkExchangeSignInUseInvitationPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:nextFocusUp="@id/checkExchangeSignInUseCode"
            android:nextFocusDown="@+id/etExchangeSignInInvitationPassword"
            app:fcr_title="@string/exchange_signin_use_invitation_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExchangeSignInInvitationPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:hint="@string/exchange_signin_invitation_password"
            android:visibility="gone"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExchangeSignInInvitationPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textPassword"
                android:nextFocusUp="@id/checkExchangeSignInUseInvitationPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExchangePortalSignIn"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/checkExchangeSignInUseInvitationPassword"
            android:text="@string/exchange_portal_link_my_devices" />

        <include
            android:id="@+id/exchangeFailurePanel"
            layout="@layout/view_exchange_failure_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
