<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sza.fastmediasorter.ui.common.widget.StandardToolbar
        android:id="@+id/system_info_toolbar"
        style="@style/Widget.FastMediaSorter.Toolbar.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/settings_system_info_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/menu_system_info" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/system_info_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
