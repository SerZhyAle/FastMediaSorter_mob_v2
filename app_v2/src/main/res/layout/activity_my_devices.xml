<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.sza.fastmediasorter.ui.common.widget.StandardToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.FastMediaSorter.Toolbar.Primary"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:nextFocusDown="@id/rvExchangeServers"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/exchange_devices_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/textExchangeServersEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_medium"
            android:text="@string/exchange_devices_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExchangeServers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="true"
            android:nextFocusUp="@id/toolbar"
            android:nextFocusDown="@id/btnExchangeAddServer"
            android:paddingVertical="@dimen/margin_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExchangeAddServer"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/rvExchangeServers"
            android:nextFocusDown="@+id/btnExchangePortalServer"
            android:text="@string/exchange_devices_add_server"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExchangePortalServer"
            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/btnExchangeAddServer"
            android:text="@string/exchange_portal_link_server" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
