<?xml version="1.0" encoding="utf-8"?>
<!-- S2730: one wallpaper mode offered by the wallpaper screen - the choice plus the sentence that says
     what it does. The description is part of the row rather than a hint elsewhere because the owner asked
     for every mode to explain itself where it is chosen. Inflated per mode by LauncherWallpaperScreenManager,
     which is also what filters the camera modes out on a device with no camera. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingTop="@dimen/margin_small"
    android:paddingBottom="@dimen/margin_small">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/radioWallpaperMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_small"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWallpaperModeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/tvWallpaperModeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</LinearLayout>
