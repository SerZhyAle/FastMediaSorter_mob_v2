<?xml version="1.0" encoding="utf-8"?>
<!-- S4621: About, the last top-level settings page (SETTINGS-NAVIGATION 2.1 section 3 rule 3). Plain section titles,
     no collapsible wrapper: the page is the resource index, so every row stays in view. Rows are bound and
     flavor-gated by AboutResourceLaunchManager from AboutResourceCatalog. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:descendantFocusability="afterDescendants">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/margin_small" android:paddingEnd="@dimen/margin_small" android:paddingTop="@dimen/margin_small" android:paddingBottom="@dimen/settings_fragment_padding" android:clipToPadding="false">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/ivAboutLogo" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_logo" android:contentDescription="@null" android:layout_marginEnd="@dimen/margin_small" />
            <TextView android:id="@+id/tvAboutProductName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView android:id="@+id/tvAboutDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:text="@string/settings_about_description" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />

        <TextView android:id="@+id/tvVersionInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:text="" android:textSize="@dimen/text_size_small" android:textColor="?android:attr/textColorLink" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground" android:padding="@dimen/item_resource_btnCopy_padding" />

        <LinearLayout android:id="@+id/containerAboutResources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:id="@+id/tvAboutGroupHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_large" android:accessibilityHeading="true" android:text="@string/settings_about_group_help" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnUserGuide" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/user_guide" app:icon="@drawable/ic_help_outline" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnHowToGuides" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/how_to_guides" app:icon="@drawable/ic_book" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenWelcome" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/open_welcome_tutorial" app:icon="@drawable/ic_image" app:iconGravity="start" />

            <TextView android:id="@+id/tvAboutGroupLegal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_large" android:accessibilityHeading="true" android:text="@string/settings_about_group_legal" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPrivacyPolicy" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/privacy_policy" app:icon="@drawable/ic_lock" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenSourceLicenses" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/open_source_licenses_title" app:icon="@drawable/ic_info" app:iconGravity="start" />

            <TextView android:id="@+id/tvAboutGroupSupport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_large" android:accessibilityHeading="true" android:text="@string/settings_about_group_support" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAboutSupport" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_about_support" app:icon="@drawable/ic_send_email" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAboutExportDiagnostics" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_about_export_diagnostics" app:icon="@drawable/ic_share" app:iconGravity="start" />

            <TextView android:id="@+id/tvAboutGroupGetApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_large" android:accessibilityHeading="true" android:text="@string/settings_about_group_get_app" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAboutSite" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_about_site" app:icon="@drawable/ic_language" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAboutDownloads" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_about_downloads" app:icon="@drawable/ic_cloud_download" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAboutRepository" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_about_repository" app:icon="@drawable/ic_open_in_browse" app:iconGravity="start" />

            <TextView android:id="@+id/tvAboutGroupRelated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_large" android:accessibilityHeading="true" android:text="@string/settings_about_group_related" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMediaExchangePortal" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/media_exchange_portal_link" app:icon="@drawable/ic_swap_horizontal" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAboutCompanionHome" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_about_companion_home" app:icon="@drawable/ic_open_in_browse" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCompanionPublishGuide" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/companion_publish_folders_guide" app:icon="@drawable/ic_open_in_browse" app:iconGravity="start" />

            <TextView android:id="@+id/tvAboutGroupDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_large" android:accessibilityHeading="true" android:text="@string/settings_about_group_device" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPermissionsManagement" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_category_permissions" app:icon="@drawable/ic_lock" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSystemInfo" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/settings_system_info_button" app:icon="@drawable/ic_info" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDownloadableExtensions" style="@style/Widget.FastMediaSorter.SettingsButton.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_tiny" android:text="@string/ext_manager_title" app:icon="@drawable/ic_cloud_download" app:iconGravity="start" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
