<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_continue_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:contentDescription="@string/continue_reading"
    android:padding="@dimen/padding_tiny"
    android:gravity="center">

    <ImageView
        android:layout_width="@dimen/widget_icon_size_large"
        android:layout_height="@dimen/widget_icon_size_large"
        android:src="@drawable/ic_widget_continue_reading_accent"
        android:contentDescription="@string/continue_reading" />

    <TextView
        android:id="@+id/widget_continue_reading_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:shadowColor="@color/black"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/widget_continue_reading_label"
        android:textColor="@color/white"
        android:textSize="11sp" />

</LinearLayout>

