    <string name="welcome_func_file_manager_desc">सभी फ़ाइलें मोड की अनुमति देता है। इसे हर स्रोत के लिए अलग से चालू करना होगा।</string>
    <string name="welcome_func_audio_desc">संगीत और ऑडियो चलाएँ, ट्रैक फ़ोल्डरों में छाँटें।</string>
    <string name="welcome_func_video_desc">वीडियो चलाएँ और अंतर्निहित प्लेयर से क्लिप छाँटें।</string>
    <string name="welcome_func_documents_desc">PDF, टेक्स्ट, ई-बुक और ऑफ़िस फ़ाइलें खोलें।</string>
    <string name="welcome_func_ocr_desc">छवियों और स्कैन से पाठ पहचानें और कॉपी करें।</string>
    <string name="welcome_func_translation_desc">पहचाने गए और चुने गए पाठ का ऑफ़लाइन अनुवाद करें।</string>
    <string name="welcome_func_streams_desc">इंटरनेट स्ट्रीम चलाएँ और अंतर्निहित सूची आयात करें।</string>
