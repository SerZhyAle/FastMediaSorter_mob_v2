<?xml version="1.0" encoding="utf-8"?>
<!--
  S2898: Focus-state selector for toolbar action menu items and navigation icons.
  Displays a 2dp stroke in colorOnPrimary with a subtle semi-transparent background fill when focused or hovered.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="?attr/colorOnPrimary" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="?attr/colorOnPrimary" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
