<?xml version="1.0" encoding="utf-8"?>
<!-- S1907: a sun on the horizon with a drop beside it - the two halves the gadget shows. Flat single
     fill like ic_world_clock, so LauncherGadget.iconTintable can recolour it for the picker surface. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- S3433 fit: moves the ink into the 20-unit live area of the 24 grid (ICON-RENDER 0.10
         item A); the path data is the original drawing, untouched. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:translateY="1">
        <!-- Sun disc sitting on the horizon line, with rays. -->
        <path
            android:fillColor="@color/white"
            android:pathData="M8,10.5c-2.21,0 -4,1.79 -4,4h8c0,-2.21 -1.79,-4 -4,-4z" />
        <path
            android:fillColor="@color/white"
            android:pathData="M7.25,4h1.5v2.5h-1.5z" />
        <path
            android:fillColor="@color/white"
            android:pathData="M2.4,6.55l1.06,-1.06 1.77,1.77 -1.06,1.06z" />
        <path
            android:fillColor="@color/white"
            android:pathData="M11.77,7.26l1.77,-1.77 1.06,1.06 -1.77,1.77z" />

        <!-- The horizon: what makes the disc read as rising or setting rather than as a plain sun. -->
        <path
            android:fillColor="@color/white"
            android:pathData="M2,16.25h12v1.5h-12z" />

        <!-- Dew drop. -->
        <path
            android:fillColor="@color/white"
            android:pathData="M18.5,9c-1.9,2.4 -3,4 -3,5.4 0,1.66 1.34,3 3,3s3,-1.34 3,-3c0,-1.4 -1.1,-3 -3,-5.4z" />
    </group>
</vector>
