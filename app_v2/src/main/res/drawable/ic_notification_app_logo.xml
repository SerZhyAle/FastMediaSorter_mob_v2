<!--
    S1399: the one status-bar icon every notification this app posts uses.

    A fork of ic_app_logo.xml rather than a reference to it, for the same reason
    ic_notification_screen_capture.xml is a fork: the original
    carries android:tint="?attr/colorControlNormal", a theme attribute cannot resolve outside the app
    theme, and startForeground then throws CannotPostForegroundServiceNotificationException (S0405,
    S0416). Do not add a tint here - the system tints a status-bar icon itself, and it renders this as
    an alpha silhouette, so the white fill is the shape rather than the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/white"
        android:pathData="M10,9h4L14,6h3l-5,-5 -5,5h3v3zM9,10L6,10L6,7l-5,5 5,5v-3h3v-4zM23,12l-5,-5v3h-3v4h3v3l5,-5zM14,15h-4v3L7,18l5,5 5,-5h-3v-3z" />
</vector>
