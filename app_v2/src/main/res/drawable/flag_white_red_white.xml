  A semi-transparent outline keeps the white bands visible on both light and dark backgrounds.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="16dp"
    android:viewportWidth="24"
    android:viewportHeight="16">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0h24v16h-24z" />

    <path
        android:fillColor="#FFCD1F2D"
        android:pathData="M0,5.333h24v5.334h-24z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#80808080"
        android:strokeWidth="1"
        android:pathData="M0.5,0.5h23v15h-23z" />
</vector>
