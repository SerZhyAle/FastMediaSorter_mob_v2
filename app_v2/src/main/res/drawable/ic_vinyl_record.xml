<?xml version="1.0" encoding="utf-8"?>
<!-- Vinyl record drawable for audio playback indicator.
     Rotating animation applied via ObjectAnimator in code. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="64dp" android:height="64dp" android:viewportWidth="48" android:viewportHeight="48">

    <!-- Outer disc body -->
    <path android:fillColor="#1A1A1A" android:pathData="M24,24m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0" />

    <!-- Outer rim highlight - visible chrome edge, makes rotation clear -->
    <path android:fillColor="#00000000" android:strokeColor="#585858" android:strokeWidth="1.2" android:pathData="M24,24m-21,0a21,21 0,1 1,42 0a21,21 0,1 1,-42 0" />

    <!-- Groove ring 1 -->
    <path android:fillColor="#2E2E2E" android:strokeColor="#3A3A3A" android:strokeWidth="0.5" android:pathData="M24,24m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0" />

    <!-- Groove ring 2 -->
    <path android:fillColor="#1C1C1C" android:strokeColor="#303030" android:strokeWidth="0.5" android:pathData="M24,24m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0" />

    <!-- Groove ring 3 -->
    <path android:fillColor="#282828" android:strokeColor="#383838" android:strokeWidth="0.5" android:pathData="M24,24m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0" />

    <!-- Label area (center circle) -->
    <path android:fillColor="#D32F2F" android:pathData="M24,24m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />

    <!-- Inner ring on label -->
    <path android:fillColor="#B71C1C" android:pathData="M24,24m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />

    <!-- Center hole -->
    <path android:fillColor="#111111" android:pathData="M24,24m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />

    <!-- Main glare arc (top-left) - was 6%, now 22% - makes rotation clearly visible -->
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.22" android:pathData="M24,2C11.85,2 2,11.85 2,24C2,24 24,24 24,2Z" />

    <!-- Secondary glare spot (bottom-right) - asymmetry is what shows rotation -->
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.07" android:pathData="M24,46C36.15,46 46,36.15 46,24C46,24 24,24 24,46Z" />
</vector>
