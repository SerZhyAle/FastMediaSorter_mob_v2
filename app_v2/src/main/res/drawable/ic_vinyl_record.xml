    <path
        android:fillColor="#B71C1C"
        android:pathData="M24,24m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />

    <!-- Center hole -->
    <path
        android:fillColor="#111111"
        android:pathData="M24,24m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />

    <!-- Light reflection highlight -->
