    android:height="64dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer disc -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M24,24m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0" />

    <!-- Grooves (concentric rings) -->
    <path
        android:fillColor="#2A2A2A"
        android:pathData="M24,24m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0"
        android:strokeColor="#1F1F1F"
        android:strokeWidth="0.3" />

    <path
        android:fillColor="#222222"
        android:pathData="M24,24m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="0.3" />

    <path
        android:fillColor="#252525"
        android:pathData="M24,24m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0"
        android:strokeColor="#1F1F1F"
        android:strokeWidth="0.3" />

    <!-- Label area (center circle) -->
    <path
        android:fillColor="#D32F2F"
        android:pathData="M24,24m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />

