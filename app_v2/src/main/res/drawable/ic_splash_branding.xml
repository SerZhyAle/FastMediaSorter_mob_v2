<?xml version="1.0" encoding="utf-8"?>
<!--
    S0997: author logo, small, in the platform branding slot (windowSplashScreenBrandingImage,
    bottom-center, API 31+) - the owner-ratified home for the personal logo that used to fill
    the splash center. @drawable/ic_logo resolves to its drawable-night variant in dark mode.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="44dp"
        android:height="44dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_logo"
            android:gravity="center"
            android:tileMode="disabled"
            android:antialias="true" />
    </item>
</layer-list>
