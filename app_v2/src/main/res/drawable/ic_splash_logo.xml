<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen icon wrapper - 108dp × 108dp matches the adaptive-icon foreground
    area required by Android 12+ (API 31+) windowSplashScreenAnimatedIcon.
    @drawable/ic_logo resolves automatically to drawable-night variant in dark mode.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_logo"
            android:gravity="center"
            android:tileMode="disabled"
            android:antialias="true" />
    </item>
</layer-list>
