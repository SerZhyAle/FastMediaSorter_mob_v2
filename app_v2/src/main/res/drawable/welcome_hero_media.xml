<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome hero: media files organized concept -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Background circle -->
    <path
        android:fillColor="#E3F2FD"
        android:pathData="M100,100m-90,0a90,90 0,1 1,180 0a90,90 0,1 1,-180 0" />

    <!-- Photo frame 1 (tilted left) -->
    <group
        android:pivotX="65"
        android:pivotY="85"
        android:rotation="-12">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M35,55 L95,55 L95,115 L35,115 Z"
            android:strokeColor="#90CAF9"
            android:strokeWidth="2" />
