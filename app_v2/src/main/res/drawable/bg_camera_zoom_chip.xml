<?xml version="1.0" encoding="utf-8"?>
<!-- S0753: zoom preset pill background - fully transparent fill (shows the viewfinder through it),
     with a faint fill only when selected. Legibility comes from the stroke + the outlined label. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/camera_capture_slider_inactive" />
            <stroke
                android:width="1dp"
                android:color="@android:color/white" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/camera_capture_control_stroke" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
