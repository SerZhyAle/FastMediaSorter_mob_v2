<?xml version="1.0" encoding="utf-8"?>
<!-- S2322: schematic "press Back to come back here" guide picture. Letter-free (spec ADR-3); the
     back affordance is drawn as a chevron rather than a specific navigation bar, because gesture
     navigation and three-button navigation both exist on supported devices. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Phone outline. -->
    <path
        android:pathData="M14,5h20v38h-20z"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="1.6" />

    <!-- Content line, so the screen reads as a screen. -->
    <path
        android:pathData="M19,13h10"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="1.6" />

    <!-- Back chevron. -->
    <path
        android:pathData="M27,20l-6,6l6,6"
        android:strokeColor="?attr/colorPrimary"
        android:strokeWidth="2.4" />

    <!-- Tap ring around the chevron. -->
    <path
        android:pathData="M16,26a8,8 0 1,0 16,0a8,8 0 1,0 -16,0"
        android:strokeColor="?attr/colorPrimary"
        android:strokeWidth="1.6" />
</vector>
