<?xml version="1.0" encoding="utf-8"?>
<!-- action.rename - a text field holding a line of typed text and an I-beam caret after it. It is deliberately
     not a pencil: ic_edit is the pencil, and the two sit side by side in the player command panel, where a pencil
     with an underline read as the same picture. The caret is an I-beam at the end of the text, never a lone bar in
     the middle: a frame split by a centred bar is media.stereo-3d (ic_stereo_3d) at 16 px.
     The inner box is wound against the outer one so the fill leaves the frame hollow. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3,5h18v14H3zM5,7v10h14V7zM7,11h5v2H7zM13,9h4v1h-1v4h1v1h-4v-1h1v-4h-1z" />
</vector>
