<?xml version="1.0" encoding="utf-8"?>
<!--
  S1924: background of one zoom preset in the mirror's bottom-start row.

  The selected state differs by a filled body AND a thick outline, not by colour alone - strategic 3.2
  requires the active preset to stay distinguishable for a reader who cannot separate the two colours.
  The host additionally puts the selected label in bold, so the cue survives a greyscale display.

  Focus is a separate cue from selection and must not collapse into it (Rule 16): the row is reachable
  by D-pad and keyboard, where "which preset is active" and "which preset am I about to press" are two
  different questions. The focus ring is @color/focus_indicator at 3dp - the project-wide focus colour,
  one dp thicker than the selected outline so the two states stay apart when they coincide. It is a
  fixed colour rather than a theme attribute on purpose: these controls sit on the white glow field,
  where a theme-derived colour resolves to white under values-night and disappears - the same failure
  this ticket's audit already fixed once for the control tint.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_indicator" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_indicator" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutline" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>

</selector>
