<?xml version="1.0" encoding="utf-8"?>
<!-- Activity shell for mid/large screens (sw >= 480dp). Single bottom navigation bar:
     Back | page indicator | Skip | Next/Finish. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- S1234: brand waves-and-particles backdrop, behind the pager. -->
    <com.sza.fastmediasorter.ui.player.helpers.AudioWaveParticleView
        android:id="@+id/brandAnimation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ViewPager2 for Welcome Pages -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Single bottom navigation bar: Back | indicator | Skip | Next/Finish -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/welcome_top_nav_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- S1234: the bottom bar sits on the brand animation, which paints black in BOTH themes, so
             ?attr/colorOnSurface rendered the label black-on-black in the light theme. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            style="@style/Widget.FastMediaSorter.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:text="@string/previous"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            android:textSize="@dimen/welcome_button_text_size"
            android:minHeight="36dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/layoutIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/btnPrevious"
            app:layout_constraintEnd_toStartOf="@id/btnEnableAll"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Enable-all Button (page 0 only; toggled by the Activity). Secondary/outlined so Next stays primary. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnableAll"
            style="@style/Widget.FastMediaSorter.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:text="@string/welcome_enable_all"
            android:contentDescription="@string/welcome_enable_all_content_description"
            android:textSize="@dimen/welcome_button_text_size"
            android:textColor="?attr/colorPrimary"
            app:strokeColor="?attr/colorPrimary"
            android:minHeight="36dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btnNext"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.FastMediaSorter.Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:text="@string/next"
            android:textSize="@dimen/welcome_button_text_size"
            android:textColor="?attr/colorOnPrimary"
            android:minHeight="36dp"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            style="@style/Widget.FastMediaSorter.Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:text="@string/finish"
            android:textSize="@dimen/welcome_button_text_size"
            android:textColor="?attr/colorOnPrimary"
            android:minHeight="36dp"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
