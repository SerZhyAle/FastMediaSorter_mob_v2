<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration file for predefined resources ("one-click" addition).
    Each <resource> element corresponds to a MediaResource object.
    
    Attributes mapping to MediaResource fields:
    - name: Display name of the resource (String)
    - path: File path or URI (String). For network resources, use the full URI (e.g., smb://server/share).
    - type: ResourceType enum (LOCAL, SMB, SFTP, FTP, CLOUD)
    - supportedMediaTypes: Comma-separated list of MediaType enum values (IMAGE, VIDEO, AUDIO, etc.)
    - sortMode: SortMode enum (NAME_ASC, DATE_DESC, etc.)
    - displayMode: DisplayMode enum (LIST, GRID)
    - scanSubdirectories: Boolean (true/false)
    - showHiddenFiles: Boolean (true/false)
    - allFiles: Boolean (true/false)
    - disableThumbnails: Boolean (true/false)
    
    Note: ID is auto-generated upon creation. Credentials for network resources will need to be handled separately or prompted.

    === INTEGRATION TEST INSTRUCTIONS ===
    To run integration tests, please add the following CLOUD resources to this file (or create them manually with these exact names):

    1. Google Drive: name="google_drive_test" path="cloud://google_drive/{FOLDER_ID}" (e.g. cloud://google_drive/1A2B3C...) type="CLOUD" supportedMediaTypes="VIDEO,AUDIO,IMAGE,DOCUMENT"

    2. OneDrive: name="onedrive_test" path="cloud://onedrive/{FOLDER_ID}" (e.g. cloud://onedrive/123456...) type="CLOUD" supportedMediaTypes="VIDEO,AUDIO,IMAGE,DOCUMENT"

    3. Dropbox: name="dropbox_test" path="cloud://dropbox/{PATH}" (e.g. cloud://dropbox/Tests) type="CLOUD" supportedMediaTypes="VIDEO,AUDIO,IMAGE,DOCUMENT"

    The tests will also use the following existing resources from this file:
    - SMB: "test_media"
    - SFTP: "SFTP"
    - FTP: "FTP"
    -->
<media-resources>

    <resource name="Downloads" path="/storage/emulated/0/Download" type="LOCAL" allFiles="true" supportedMediaTypes="IMAGE,VIDEO,AUDIO,PDF" sortMode="DATE_DESC" displayMode="LIST" scanSubdirectories="true" showHiddenFiles="true" disableThumbnails="false" rememberTheFileList="true" />

