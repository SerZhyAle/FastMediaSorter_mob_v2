<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup Rules for FastMediaSorter
    
    Security Note:
    - fastmediasorter_v2.db is excluded because its network_credentials table contains encrypted credentials
      that are tied to Android Keystore (hardware-backed). The encryption key 
      cannot be restored to a different device, making those credentials unusable.
      Backup rules exclude files, not tables: resources, favorites, playback positions
      and other state in this shared database are also omitted from system backup.
    - datastore/* is excluded because it may contain device-specific settings
      and encrypted default password (also tied to Android Keystore).
      
    For future implementation: Consider password-based encryption (PBE) with
    master password if cloud backup of credentials is desired.
-->
<full-backup-content>
    <!-- Exclude the shared database containing credentials whose Keystore key cannot be restored -->
    <exclude domain="database" path="fastmediasorter_v2.db" />
    <exclude domain="database" path="fastmediasorter_v2.db-shm" />
    <exclude domain="database" path="fastmediasorter_v2.db-wal" />
    
    <!-- Exclude DataStore preferences (contains encrypted default password) -->
    <exclude domain="file" path="datastore/" />

    <!-- S2101: EncryptedSharedPreferences credential stores - same Keystore reason as above -->
    <exclude domain="sharedpref" path="primary_google_account_v1.xml" />
    <exclude domain="sharedpref" path="google_drive_credentials.xml" />
    <exclude domain="sharedpref" path="dropbox_credentials.xml" />
    <exclude domain="sharedpref" path="link_download_cookies.xml" />
    <!-- S3450: the remembered FileDO credential never leaves the device, whatever the restore target -->
    <exclude domain="sharedpref" path="fdsec_remembered_credential.xml" />
</full-backup-content>
