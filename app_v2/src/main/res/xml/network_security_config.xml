<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- S0565: cleartext permitted app-wide so the Трансляции feature can play arbitrary
         public http:// radio/stream hosts (most internet radio is plain HTTP and the source
         list is user-supplied, so a static allowlist cannot cover it). Owner-approved
         security trade-off. SMB (445)/FTP (21)/SFTP (22) use their own ports, unaffected. -->
    <base-config cleartextTrafficPermitted="true" />
    
    <!-- Allow cleartext (HTTP) traffic for local network only -->
    <!-- This is needed for potential local HTTP APIs (if any) -->
    <!-- External APIs (iTunes, Lyrics) already use HTTPS and are not affected -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Private network ranges (RFC 1918) -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        
        <!-- Localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Trust user-installed CAs for Dropbox/OneDrive cloud domains -->
    <!-- Fixes CertPathValidatorException on devices with MITM-intercepting -->
    <!-- proxies (AdGuard, corporate MDM, antivirus) that use user CAs -->
    <domain-config>
        <domain includeSubdomains="true">dropbox.com</domain>
        <domain includeSubdomains="true">dropboxapi.com</domain>
        <domain includeSubdomains="true">graph.microsoft.com</domain>
        <domain includeSubdomains="true">login.microsoftonline.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- Debug builds: trust user CAs globally for easier testing -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
