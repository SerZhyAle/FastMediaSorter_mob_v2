<?xml version="1.0" encoding="utf-8"?>
<!-- S2818: broadcast entry widget - one static button, never wakes to poll (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="48dp"
    android:minHeight="48dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_broadcast_entry"
    android:description="@string/widget_broadcast_label"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:theme="@style/Widget.FastMediaSorter"
    android:previewImage="@drawable/ic_live_broadcast" />
