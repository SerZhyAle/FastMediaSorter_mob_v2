<?xml version="1.0" encoding="utf-8"?>
<!-- S0568: config-less 1x1 camera launch widget (no android:configure - tap opens the camera). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="48dp"
    android:minHeight="110dp"
    android:targetCellWidth="1"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_camera_launch"
    android:description="@string/widget_camera_launch_description"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:theme="@style/Widget.FastMediaSorter"
    android:previewImage="@drawable/ic_widget_camera_launch_accent" />
