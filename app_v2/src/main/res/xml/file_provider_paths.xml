<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External storage files directory -->
    <external-files-path
        name="external_files"
        path="." />
    
    <!-- External cache directory for temporary files -->
    <external-cache-path
        name="external_cache"
        path="." />
    
    <!-- External storage root (for local resources) -->
    <external-path
        name="external_storage"
        path="." />
    
    <!-- Internal cache directory (for share_temp and other temporary files) -->
    <cache-path
        name="cache"
        path="." />

    <!-- S1433: the GNSS track sessions only. Scoped to that one directory rather than to filesDir as a
         whole, because filesDir also holds the DataStore preference files - a share of the track must not
         make the settings store addressable through the provider. -->
    <files-path
        name="gnss_tracks"
        path="gnss-tracks/" />
</paths>
