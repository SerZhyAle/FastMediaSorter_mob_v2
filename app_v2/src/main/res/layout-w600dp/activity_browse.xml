        <TextView android:id="@+id/tvErrorMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/empty_state_text_margin_top" android:text="@string/connection_failed" android:textSize="@dimen/empty_state_text_size" android:textAlignment="center" android:gravity="center" android:textColor="@color/error_color" />

