<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15 (API 35) enforces edge-to-edge at the system level. Runtime system-bar
        color setters are deprecated/no-op here, so this overlay avoids them.

        Material 1.14.0 handles bottom-sheet edge-to-edge natively on API 35, so no
        enableEdgeToEdge attribute is needed here. Only the system-window padding is retained
        so sheet content stays clear of the navigation bar.
    -->
    <style name="Theme.FastMediaSorter.Base" parent="Theme.FastMediaSorter.App">
        <item name="bottomSheetDialogTheme">@style/Theme.App.BottomSheetDialog.EdgeToEdgeCompat</item>
    </style>

    <style name="Theme.App.BottomSheetDialog.EdgeToEdgeCompat" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <!-- Keep system-window padding so sheet content clears the navigation bar; edge-to-edge itself is native in Material 1.14.0. -->
        <item name="paddingBottomSystemWindowInsets">true</item>
        <item name="paddingLeftSystemWindowInsets">true</item>
        <item name="paddingRightSystemWindowInsets">true</item>
    </style>

    <!--
        S0655: do NOT redefine Theme.FastMediaSorter here. An empty redefinition shadows the values-v31
        definition on API 35 (resource resolution picks one best-match bucket per style name, no merge),
        silently dropping the Android-12 splash items (windowSplashScreenBackground / windowSplashScreenAnimatedIcon
        / windowSplashScreenAnimationDuration). Falling back to values-v31 restores the curated splash; the parent
        chain still resolves Base->App per device config, so the v35 bottomSheet/edge-to-edge override above is
        preserved. Edge-to-edge itself is handled programmatically via enableEdgeToEdge() in BaseActivity.
    -->

    <!--
        S0653: do NOT redefine Theme.FastMediaSorter.FullScreen here. An empty redefinition shadows the
        values/ definition on API 35 (resource resolution picks one best-match bucket per style name, no
        merge), silently dropping windowActionBar/windowNoTitle/android:windowFullscreen. Falling back to
        values/ keeps those window items; the parent chain still resolves Base->App per device config, so
        the v35 bottomSheet/edge-to-edge override above is preserved.
    -->
</resources>
