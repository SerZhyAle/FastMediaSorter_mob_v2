<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15 (API 35) enforces edge-to-edge at system level.
        Window.setStatusBarColor() / setNavigationBarColor() are deprecated on API 35+ and
        no longer need to be called - the OS manages system bar transparency automatically.

        Material 1.13.0+ rewrote BottomSheetDialog edge-to-edge handling to use
        WindowInsetsControllerCompat instead of the deprecated setStatusBarColor /
        setNavigationBarColor APIs. Setting enableEdgeToEdge=true here instructs the
        Material library to use the correct non-deprecated path.

        AppCompat 1.7.0+ fixed onStart() applying night-mode colours via deprecated APIs.
    -->
    <style name="Theme.FastMediaSorter.Base" parent="Theme.FastMediaSorter.App">
        <item name="bottomSheetDialogTheme">@style/Theme.App.BottomSheetDialog.EdgeToEdgeCompat</item>
    </style>

    <style name="Theme.App.BottomSheetDialog.EdgeToEdgeCompat" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <!-- Material edge-to-edge path requires both enableEdgeToEdge and a transparent nav bar. -->
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
        <item name="paddingLeftSystemWindowInsets">true</item>
        <item name="paddingRightSystemWindowInsets">true</item>
    </style>

    <!-- Edge-to-edge is handled programmatically via enableEdgeToEdge() in BaseActivity. -->
    <style name="Theme.FastMediaSorter" parent="Theme.FastMediaSorter.Base" />

    <style name="Theme.FastMediaSorter.FullScreen" parent="Theme.FastMediaSorter" />
</resources>
