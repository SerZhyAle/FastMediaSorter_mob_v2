    <string name="welcome_default_player_description">将 FastMediaSorter 设为默认媒体播放器</string>
    <string name="welcome_default_player_hint">点按下面的按钮，会弹出一个对话框。选择 FastMediaSorter，然后点按<b>始终</b>。</string>
    <string name="welcome_default_player_title">默认播放器</string>
    <string name="welcome_description_1">一体化的媒体管理工具。\n浏览、整理和管理本地、网络与云端存储中的文件，全部通过直观的触摸手势完成。</string>
    <string name="welcome_description_1_details">FastMediaSorter 把各类媒体汇集到一处。可以打开设备、网络共享或云存储中的照片、视频、GIF 和音乐，用轻点代替长按菜单来整理它们。\n\n这里设置的一切之后都能在“设置”中修改，所以本页面没有错误选项 - 点“下一步”继续即可。</string>
    <string name="welcome_description_3" formatted="false">播放器使用 9 个触摸区域（3×3 网格）执行快捷操作。点按区域可以翻页、复制、移动、删除文件或打开命令面板。详见上方示意图。</string>
    <string name="welcome_language_picker_hint">选择应用语言</string>
    <string name="welcome_profile_audio_player_desc">适合纯音频设备或 MP3 播放器。隐藏照片和视频；优化后台播放与正在播放界面。</string>
    <string name="welcome_profile_audio_player_title">音频播放器</string>
    <string name="welcome_profile_car_head_unit_desc">适合 Android 车机。使用超大按钮，保持屏幕常亮，并让媒体播放优先于文件操作。</string>
    <string name="welcome_profile_car_head_unit_title">车载主机</string>
    <string name="welcome_profile_ebook_reader_desc">适合电子阅读器或文档平板。隐藏视频和音乐；优化 PDF、EPUB 和文本的阅读设置。</string>
    <string name="welcome_profile_ebook_reader_title">电子书阅读器</string>
    <string name="welcome_profile_home_tablet_desc">适合平板电脑、Chromebook 和三星 DeX。优化网格布局，启用大缩略图，并允许多窗口浏览。</string>
    <string name="welcome_profile_home_tablet_title">平板与桌面模式</string>
    <string name="welcome_profile_media_player_desc">适合专用媒体盒子。完全专注于照片、视频和音乐，带自动幻灯片和续播功能。</string>
    <string name="welcome_profile_media_player_title">媒体播放器</string>
    <string name="welcome_profile_other_desc">保持系统默认设置不变。不会自动应用任何预设。</string>
    <string name="welcome_profile_other_title">其他 / 自定义</string>
    <string name="welcome_profile_personal_smartphone_desc">适合个人手机。优化触摸布局，启用后台同步，并保留默认的安全确认。</string>
    <string name="welcome_profile_personal_smartphone_title">个人手机</string>
    <string name="welcome_profile_photo_frame_desc">把设备变成数码相框。停用视频、音频和文件操作；启动后立即打开幻灯片。</string>
    <string name="welcome_profile_photo_frame_title">数码相框</string>
    <string name="welcome_profile_selector_title">设备使用场景</string>
    <string name="welcome_profile_tv_media_box_desc">适合电视和媒体中心。优化方向键与遥控器导航，使用大按钮，并隐藏细小的触摸控件。</string>
    <string name="welcome_profile_tv_media_box_title">电视 / 媒体盒子</string>
    <string name="welcome_profile_video_player_desc">适合纯视频设备。隐藏照片、音乐和文档查看器；优先快速播放视频和显示缩略图。</string>
    <string name="welcome_profile_video_player_title">视频播放器</string>
    <string name="welcome_profile_vr_headset_desc">适合虚拟现实设备。在受支持的硬件版本上预先启用 3D/360° 布局和沉浸式控件。</string>
    <string name="welcome_profile_vr_headset_title">VR 头显</string>
