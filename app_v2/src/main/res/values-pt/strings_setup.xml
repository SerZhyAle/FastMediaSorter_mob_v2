    <string name="welcome_default_player_description">Definir o FastMediaSorter como leitor de mídia padrão</string>
    <string name="welcome_default_player_hint">Toque num botão abaixo: aparecerá uma caixa de diálogo. Selecione o FastMediaSorter e toque em <b>Sempre</b>.</string>
    <string name="welcome_default_player_title">Leitor padrão</string>
    <string name="welcome_description_1">O seu organizador de mídia completo.\nNavegue, ordene e gerencie arquivos no armazenamento local, de rede e na nuvem, tudo com gestos de toque intuitivos.</string>
    <string name="welcome_description_1_details">O FastMediaSorter reúne todo tipo de mídia num só lugar. Abra fotos, vídeos, GIFs e músicas do seu aparelho, de uma pasta compartilhada na rede ou da nuvem, e ordene-os com toques rápidos em vez de menus de toque longo.\n\nTudo o que você configurar aqui pode ser alterado depois nas Configurações, então não há escolha errada nesta tela: toque em Avançar para continuar.</string>
    <string name="welcome_description_3" formatted="false">O leitor usa 9 zonas de toque (grelha 3×3) para ações rápidas. Toque nas zonas para navegar, copiar, mover, eliminar ficheiros ou aceder ao painel de comandos. Consulte o esquema acima para mais detalhes.</string>
    <string name="welcome_language_picker_hint">Escolher o idioma do aplicativo</string>
    <string name="welcome_profile_audio_player_desc">Ideal para aparelhos só de áudio ou tocadores de MP3. Oculta fotos e vídeos; otimiza o áudio em segundo plano e a tela de reprodução.</string>
    <string name="welcome_profile_audio_player_title">Tocador de áudio</string>
    <string name="welcome_profile_car_head_unit_desc">Ideal para centrais Android de carro. Usa botões extragrandes, mantém a tela ligada e prioriza a reprodução sobre as operações com arquivos.</string>
    <string name="welcome_profile_car_head_unit_title">Central do carro</string>
    <string name="welcome_profile_ebook_reader_desc">Ideal para leitores digitais ou tablets de leitura. Oculta vídeos e músicas; otimiza as configurações de leitura de PDF, EPUB e texto.</string>
    <string name="welcome_profile_ebook_reader_title">Leitor de e-books</string>
    <string name="welcome_profile_home_tablet_desc">Ideal para tablets, Chromebooks e Samsung DeX. Otimiza a grade, ativa miniaturas grandes e permite navegação em várias janelas.</string>
    <string name="welcome_profile_home_tablet_title">Modo tablet e desktop</string>
    <string name="welcome_profile_media_player_desc">Ideal para caixas de mídia dedicadas. Concentra-se inteiramente em fotos, vídeos e músicas, com apresentação automática e retomada.</string>
    <string name="welcome_profile_media_player_title">Leitor de mídia</string>
    <string name="welcome_profile_other_desc">Mantém as configurações do sistema inalteradas. Nenhuma predefinição será aplicada automaticamente.</string>
    <string name="welcome_profile_other_title">Outro / Personalizado</string>
    <string name="welcome_profile_personal_smartphone_desc">Ideal para celulares pessoais. Otimiza o layout de toque, ativa a sincronização em segundo plano e mantém as confirmações de segurança.</string>
    <string name="welcome_profile_personal_smartphone_title">Celular pessoal</string>
    <string name="welcome_profile_photo_frame_desc">Transforma o aparelho num porta-retratos digital. Desativa vídeo, áudio e operações com arquivos; abre a apresentação ao iniciar.</string>
    <string name="welcome_profile_photo_frame_title">Porta-retratos</string>
    <string name="welcome_profile_selector_title">Perfil do dispositivo</string>
    <string name="welcome_profile_tv_media_box_desc">Ideal para TVs e centrais de mídia. Otimiza a navegação por controle remoto, usa botões grandes e oculta os controles de toque miúdos.</string>
    <string name="welcome_profile_tv_media_box_title">TV / caixa de mídia</string>
    <string name="welcome_profile_video_player_desc">Ideal para aparelhos só de vídeo. Oculta fotos, músicas e visualizadores de documentos; prioriza a reprodução rápida e as miniaturas.</string>
    <string name="welcome_profile_video_player_title">Leitor de vídeo</string>
    <string name="welcome_profile_vr_headset_desc">Ideal para dispositivos de realidade virtual. Ativa previamente layouts 3D/360° e controles imersivos em headsets compatíveis.</string>
    <string name="welcome_profile_vr_headset_title">Óculos de RV</string>
    <string name="welcome_recommended_badge">(Recomendado)</string>
