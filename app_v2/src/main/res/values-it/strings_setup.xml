    <string name="welcome_default_player_description">Imposta FastMediaSorter come lettore multimediale predefinito</string>
    <string name="welcome_default_player_hint">Tocca un pulsante qui sotto: comparirà una finestra. Seleziona FastMediaSorter e tocca <b>Sempre</b>.</string>
    <string name="welcome_default_player_title">Lettore predefinito</string>
    <string name="welcome_description_1">Il tuo organizzatore multimediale tutto in uno.\nSfoglia, ordina e gestisci i file su memoria locale, di rete e nel cloud, tutto con gesti tattili intuitivi.</string>
    <string name="welcome_description_1_details">FastMediaSorter riunisce ogni tipo di contenuto in un unico posto. Apri foto, video, GIF e musica dal dispositivo, da una cartella condivisa in rete o dal cloud, e ordinali con tocchi rapidi invece che con i menu a pressione prolungata.\n\nTutto ciò che imposti qui si può cambiare più tardi nelle Impostazioni, quindi su questa schermata non esiste una scelta sbagliata: tocca Avanti per continuare.</string>
    <string name="welcome_description_3" formatted="false">Il lettore usa 9 zone tattili (griglia 3×3) per azioni rapide. Tocca le zone per navigare, copiare, spostare, eliminare file o accedere al pannello dei comandi. Vedi lo schema sopra per i dettagli.</string>
    <string name="welcome_language_picker_hint">Scegli la lingua dell\'app</string>
    <string name="welcome_profile_audio_player_desc">Ideale per dispositivi solo audio o lettori MP3. Nasconde foto e video; ottimizza l\'audio in background e la schermata di riproduzione.</string>
    <string name="welcome_profile_audio_player_title">Lettore audio</string>
    <string name="welcome_profile_car_head_unit_desc">Ideale per autoradio Android. Usa pulsanti molto grandi, tiene acceso lo schermo e dà priorità alla riproduzione rispetto alle operazioni sui file.</string>
    <string name="welcome_profile_car_head_unit_title">Autoradio</string>
    <string name="welcome_profile_ebook_reader_desc">Ideale per lettori di e-book o tablet da lettura. Nasconde video e musica; ottimizza le impostazioni di lettura di PDF, EPUB e testo.</string>
    <string name="welcome_profile_ebook_reader_title">Lettore di e-book</string>
    <string name="welcome_profile_home_tablet_desc">Ideale per tablet, Chromebook e Samsung DeX. Ottimizza la griglia, attiva le miniature grandi e consente la navigazione a più finestre.</string>
    <string name="welcome_profile_home_tablet_title">Modalità tablet e desktop</string>
    <string name="welcome_profile_media_player_desc">Ideale per box multimediali dedicati. Si concentra interamente su foto, video e musica, con presentazione automatica e ripresa della riproduzione.</string>
    <string name="welcome_profile_media_player_title">Lettore multimediale</string>
    <string name="welcome_profile_other_desc">Mantiene invariate le impostazioni di sistema. Non verrà applicato automaticamente alcun preset.</string>
    <string name="welcome_profile_other_title">Altro / Personalizzato</string>
    <string name="welcome_profile_personal_smartphone_desc">Ideale per telefoni personali. Ottimizza la disposizione tattile, attiva la sincronizzazione in background e mantiene le conferme di sicurezza.</string>
    <string name="welcome_profile_personal_smartphone_title">Smartphone personale</string>
    <string name="welcome_profile_photo_frame_desc">Trasforma il dispositivo in una cornice digitale. Disattiva video, audio e operazioni sui file; apre la presentazione all\'avvio.</string>
    <string name="welcome_profile_photo_frame_title">Cornice digitale</string>
    <string name="welcome_profile_selector_title">Profilo dispositivo</string>
    <string name="welcome_profile_tv_media_box_desc">Ideale per TV e media center. Ottimizza la navigazione con telecomando e crocera, usa pulsanti grandi e nasconde i comandi tattili minuti.</string>
    <string name="welcome_profile_tv_media_box_title">TV / box multimediale</string>
    <string name="welcome_profile_video_player_desc">Ideale per dispositivi solo video. Nasconde foto, musica e visualizzatori di documenti; privilegia la riproduzione rapida e le miniature.</string>
    <string name="welcome_profile_video_player_title">Lettore video</string>
    <string name="welcome_profile_vr_headset_desc">Ideale per i dispositivi di realtà virtuale. Attiva in anticipo layout 3D/360° e controlli immersivi sui visori supportati.</string>
    <string name="welcome_profile_vr_headset_title">Visore VR</string>
    <string name="welcome_recommended_badge">(Consigliato)</string>
