<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="is_tab_inline">true</bool>
    <bool name="is_resource_actions_inline">true</bool>
    <!-- S0755: landscape shows programs panel labels next to icons. -->
    <bool name="main_programs_panel_show_labels">true</bool>
    <!-- S0779: streams panel shows the entry label + channel labels in landscape only (portrait = icons,
         to fit more pinned channels horizontally). -->
    <bool name="main_streams_panel_show_labels">true</bool>
    <!-- S1049: landscape resource tabs keep the pre-existing width-aware fixed/fill or scrollable
         behaviour - the portrait fixed-grid does not apply here. -->
    <bool name="main_resource_tabs_fixed_grid">false</bool>
    <!-- S1549: layout-land/activity_main.xml sets android:gravity="center_vertical" on the row. -->
    <bool name="main_cmd_bar_center_vertical">true</bool>
</resources>
