    <string name="welcome_default_player_description">Establecer FastMediaSorter como reproductor multimedia predeterminado</string>
    <string name="welcome_default_player_hint">Toque un botón de abajo y aparecerá un diálogo. Seleccione FastMediaSorter y toque <b>Siempre</b>.</string>
    <string name="welcome_default_player_title">Reproductor predeterminado</string>
    <string name="welcome_description_1">Su organizador multimedia todo en uno.\nExplore, ordene y gestione archivos en almacenamiento local, de red y en la nube, todo con gestos táctiles intuitivos.</string>
    <string name="welcome_description_1_details">FastMediaSorter reúne todo tipo de contenido en un solo lugar. Abra fotos, vídeos, GIF y música desde su dispositivo, desde un recurso compartido de red o desde la nube, y ordénelos con toques rápidos en lugar de menús de pulsación larga.\n\nTodo lo que configure aquí se puede cambiar después en Ajustes, así que en esta pantalla no hay elección equivocada: toque Siguiente para continuar.</string>
    <string name="welcome_description_3" formatted="false">El reproductor usa 9 zonas táctiles (cuadrícula 3×3) para acciones rápidas. Toca las zonas para navegar, copiar, mover, eliminar archivos o acceder al panel de comandos. Consulta el esquema anterior para más detalles.</string>
    <string name="welcome_language_picker_hint">Seleccionar idioma de la aplicación</string>
    <string name="welcome_profile_audio_player_desc">Ideal para dispositivos solo de audio o reproductores MP3. Oculta fotos y vídeos; optimiza el audio en segundo plano y la pantalla de reproducción.</string>
    <string name="welcome_profile_audio_player_title">Reproductor de audio</string>
    <string name="welcome_profile_car_head_unit_desc">Ideal para radios Android de coche. Usa botones muy grandes, mantiene la pantalla encendida y prioriza la reproducción sobre las operaciones con archivos.</string>
    <string name="welcome_profile_car_head_unit_title">Radio del coche</string>
    <string name="welcome_profile_ebook_reader_desc">Ideal para lectores electrónicos o tabletas de documentos. Oculta vídeos y música; optimiza los ajustes de lectura de PDF, EPUB y texto.</string>
    <string name="welcome_profile_ebook_reader_title">Lector de libros electrónicos</string>
    <string name="welcome_profile_home_tablet_desc">Ideal para tabletas, Chromebooks y Samsung DeX. Optimiza la cuadrícula, activa miniaturas grandes y permite navegar en varias ventanas.</string>
    <string name="welcome_profile_home_tablet_title">Modo tableta y escritorio</string>
    <string name="welcome_profile_media_player_desc">Ideal para reproductores multimedia dedicados. Se centra por completo en fotos, vídeos y música, con presentación automática y reanudación.</string>
    <string name="welcome_profile_media_player_title">Reproductor multimedia</string>
    <string name="welcome_profile_other_desc">Mantiene sin cambios los ajustes del sistema. No se aplicará ningún preajuste automáticamente.</string>
    <string name="welcome_profile_other_title">Otro / Personalizado</string>
    <string name="welcome_profile_personal_smartphone_desc">Ideal para teléfonos personales. Optimiza la disposición táctil, activa la sincronización en segundo plano y mantiene las confirmaciones de seguridad.</string>
    <string name="welcome_profile_personal_smartphone_title">Teléfono personal</string>
    <string name="welcome_profile_photo_frame_desc">Convierte el dispositivo en un marco de fotos digital. Desactiva vídeo, audio y operaciones con archivos; abre la presentación al iniciarse.</string>
    <string name="welcome_profile_photo_frame_title">Marco de fotos</string>
    <string name="welcome_profile_selector_title">Perfil de uso del dispositivo</string>
    <string name="welcome_profile_tv_media_box_desc">Ideal para televisores y centros multimedia. Optimiza la navegación con mando y cruceta, usa botones grandes y oculta los controles táctiles pequeños.</string>
    <string name="welcome_profile_tv_media_box_title">TV / caja multimedia</string>
    <string name="welcome_profile_video_player_desc">Ideal para dispositivos solo de vídeo. Oculta fotos, música y visores de documentos; prioriza la reproducción rápida y las miniaturas.</string>
    <string name="welcome_profile_video_player_title">Reproductor de vídeo</string>
    <string name="welcome_profile_vr_headset_desc">Ideal para dispositivos de realidad virtual. Habilita de antemano los diseños 3D/360° y los controles inmersivos en las variantes de hardware compatibles.</string>
    <string name="welcome_profile_vr_headset_title">Visor de RV</string>
    <string name="welcome_recommended_badge">(Recomendado)</string>
