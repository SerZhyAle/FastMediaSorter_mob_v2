        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:elevation="@dimen/toolbar_elevation" android:background="?attr/colorPrimary" app:navigationIcon="@drawable/ic_back" app:titleTextColor="@color/white" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout android:id="@+id/playbackButtonRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/player_text_viewer_padding" android:background="#80000000" android:gravity="center">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVolumeDown" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="40dp" android:text="@string/player_volume_down_symbol" android:textSize="24sp" android:textColor="@color/white" android:visibility="gone" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusRight="@id/btnPrevious" android:nextFocusDown="@id/btnSlideShow" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnPrevious" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_previous_symbol" android:textSize="24sp" android:textColor="@color/white" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnVolumeDown" android:nextFocusRight="@id/btnPlayPause" android:nextFocusDown="@id/btnSlideShow" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnPlayPause" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/play_pause" android:text="@string/player_play_symbol" android:textSize="32sp" android:textColor="@color/white" android:layout_marginHorizontal="32dp" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnPrevious" android:nextFocusRight="@id/btnNext" android:nextFocusDown="@id/btnSlideShow" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnNext" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/next_file" android:text="@string/player_next_symbol" android:textSize="24sp" android:textColor="@color/white" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnPlayPause" android:nextFocusRight="@id/btnVolumeUp" android:nextFocusDown="@id/btnDelete" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVolumeUp" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="40dp" android:text="@string/player_volume_up_symbol" android:textSize="24sp" android:textColor="@color/white" android:visibility="gone" app:backgroundTint="@android:color/transparent" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusLeft="@id/btnNext" android:nextFocusDown="@id/btnDelete" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingBottom="16dp" android:background="#80000000" android:gravity="center">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSlideShow" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/slideshow" android:textColor="@color/white" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusUp="@id/btnPlayPause" android:nextFocusRight="@id/btnDelete" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/delete" android:textColor="@color/white" android:focusable="true" android:clickable="true" android:foreground="@drawable/focus_button_background" android:nextFocusUp="@id/btnPlayPause" android:nextFocusLeft="@id/btnSlideShow" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/player_audio_touch_zones_overlay_content" />

    <include layout="@layout/player_document_fullscreen_exit_button_content" />

