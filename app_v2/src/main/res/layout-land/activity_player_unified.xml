    <!-- Media Content Area (Below Command Panel) -->
    <!-- bottom is constrained to top of bottomPanelsContainer so that ExoPlayer controls
         are not hidden behind the Copy/Move panels in landscape mode.
         When both panels are gone (0 height), bottomPanelsContainer sits at parent bottom,
         so mediaContentArea naturally extends to the full remaining height. -->
    <FrameLayout android:id="@+id/mediaContentArea" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toTopOf="@id/bottomPanelsContainer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/topCommandPanel">

        <!-- Dynamic Background Extension layer (behind all other views) -->
        <ImageView android:id="@+id/ivDynamicBackground" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scaleType="fitXY" android:contentDescription="@null" />

        <!-- Audio layers: BEFORE TextureView PlayerView so controls are always on top. -->
        <ImageView android:id="@+id/audioCoverArtView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scaleType="fitCenter" android:background="#000000" android:contentDescription="@string/audio_cover_art" />

        <com.sza.fastmediasorter.ui.player.helpers.AudioBreathingBarsView android:id="@+id/audioBarsView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="false" android:focusable="false" android:background="@color/black" android:contentDescription="@null" />

        <com.sza.fastmediasorter.ui.player.helpers.AudioWaveParticleView android:id="@+id/audioWaveParticleView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="false" android:focusable="false" android:contentDescription="@null" />

        <TextureView android:id="@+id/audioVideoView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="false" android:focusable="false" />

           <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" app:surface_type="texture_view" app:show_buffering="when_playing" app:resize_mode="fit" app:use_artwork="true" app:default_artwork="@drawable/ic_music_note" app:show_timeout="2147483647" app:hide_on_touch="false" app:controller_layout_id="?attr/customPlayerControlsLayout" />

        <!-- Vinyl record playback indicator (rotating during audio playback) -->
        <ImageView android:id="@+id/vinylIndicator" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="16dp" android:elevation="8dp" android:src="@drawable/ic_vinyl_record" android:visibility="gone" android:contentDescription="@string/vinyl_indicator_description" />

        <!-- Sleep timer remaining time badge -->
        <TextView android:id="@+id/sleepTimerBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="68dp" android:layout_marginEnd="12dp" android:elevation="8dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:background="@drawable/bg_rounded_badge" android:textColor="@color/white" android:textSize="11sp" android:visibility="gone" />

        <!-- Audio file info overlay -->
        <LinearLayout android:id="@+id/audioInfoOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="@dimen/player_audio_overlay_padding" android:layout_marginBottom="@dimen/player_audio_overlay_margin_bottom" android:background="@color/activity_player_unified_audioInfoOverlay_background" android:elevation="@dimen/elevation_player_overlay" android:clickable="true" android:focusable="true" android:visibility="gone">
            <include layout="@layout/player_audio_info_overlay_content" />
        </LinearLayout>

        <!-- Standard ImageView -->
        <ImageView android:id="@+id/imageView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scaleType="fitCenter" android:contentDescription="@null" />

        <!-- Photo path overlay for audio slideshow photo mode -->
        <TextView android:id="@+id/audioSlideshowSongLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="12dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="#88000000" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:elevation="4dp" />

        <!-- Dual-surface container for static image rendering (A=current, B=next) - mirrors portrait layout -->
        <FrameLayout android:id="@+id/photoDualSurfaceContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">

            <!-- Surface B (prepared/next), kept below A by z-order -->
            <com.github.chrisbanes.photoview.PhotoView android:id="@+id/photoViewSurfaceB" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:contentDescription="@null" />

            <!-- Surface A (current/top). Keep legacy id for compatibility -->
            <com.github.chrisbanes.photoview.PhotoView android:id="@+id/photoView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:contentDescription="@null" />

        </FrameLayout>

        <!-- PDF Vertical Scroll Mode RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/pdfScrollRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/activity_player_unified_topCommandPanel_background" android:clipToPadding="false" android:scrollbars="vertical" />

        <!-- Translation Overlay -->
        <com.sza.fastmediasorter.ui.player.views.TranslationOverlayView android:id="@+id/translationLensOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:elevation="@dimen/elevation_player_overlay" android:clickable="true" android:focusable="true" />

