        <TextView android:id="@+id/tvAnimatedBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="@dimen/activity_player_unified_tvFileNameOverlay_layout_marginTop" android:layout_marginEnd="@dimen/player_epub_button_margin_end" android:background="@drawable/bg_circle_dark" android:paddingHorizontal="@dimen/player_button_padding" android:paddingVertical="@dimen/player_button_padding" android:text="@string/animated_badge_gif" android:textColor="@color/white" android:textSize="@dimen/player_audio_info_text_size" android:textStyle="bold" android:visibility="gone" />

