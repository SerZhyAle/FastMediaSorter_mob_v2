<?xml version="1.0" encoding="utf-8"?>
<!-- S1088: landscape counterpart of layout/dialog_launcher_settings.xml. The row set is short and
     scrolls in one column, so the layout is identical to portrait; kept as a separate file only to
     satisfy the one-ViewBinding-per-orientation contract (Rule 11).
     S1422: same four collapsible groups as portrait, same ids, same order - the binding is shared, so a
     header or container present in only one orientation would generate a nullable field. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_normal">

        <!-- Header: title + close (DialogCancel taxonomy, S0538). Every control applies immediately, so Close is the only action. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/launcher_settings_dialog_title"
                android:textSize="@dimen/text_size_title_dialog"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetLauncher"
                style="@style/Widget.FastMediaSorter.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/launcher_settings_reset_button_description"
                android:focusable="true"
                app:icon="@drawable/ic_restore_defaults" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.FastMediaSorter.Button.DialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:text="@string/close" />

        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerLauncherTaskbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_icon="@drawable/ic_apps"
            app:csh_title="@string/launcher_settings_group_taskbar" />

        <LinearLayout
            android:id="@+id/containerLauncherTaskbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <!-- S1643: which edge the whole bar is anchored to. First in the section because the
                 placement is the precondition for the composition switches below it. Mirrors
                 layout/dialog_launcher_settings.xml (one ViewBinding, Rule 11). -->
            <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
                android:id="@+id/rowLauncherTaskbarPlacement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:layout_marginBottom="@dimen/margin_small"
                app:sdr_inline="true"
                app:sdr_fieldMaxWidth="@dimen/settings_dropdown_compact_width"
                app:sdr_title="@string/launcher_settings_taskbar_placement_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherShowRecents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_show_recents_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherShowPinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_show_pinned_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherShowTray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_show_tray_title" />

            <!-- S1415: same run of tray-composition rows as portrait, in the same order - one ViewBinding, so
                 every id must exist in both files. -->
            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTrayClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_tray_clock_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTrayBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_subtitle="@string/launcher_settings_tray_bluetooth_subtitle"
                app:str_title="@string/launcher_settings_tray_bluetooth_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTraySim1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_subtitle="@string/launcher_settings_tray_sim_subtitle"
                app:str_title="@string/launcher_settings_tray_sim1_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTraySim2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_subtitle="@string/launcher_settings_tray_sim_subtitle"
                app:str_title="@string/launcher_settings_tray_sim2_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTrayNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_tray_network_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTrayBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_tray_battery_title" />

        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerLauncherTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_icon="@drawable/ic_display"
            app:csh_title="@string/launcher_settings_group_top_bar" />

        <LinearLayout
            android:id="@+id/containerLauncherTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <!-- S1087: same placement as portrait - one ViewBinding, so the id must exist in both files. -->
            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherReplaceStatusArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_replace_status_area_title" />

            <!-- S1431: same placement as portrait, for the same ViewBinding reason as the row above. -->
            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherTopStatusStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_subtitle="@string/launcher_settings_top_status_strip_summary"
                app:str_title="@string/launcher_settings_top_status_strip_title" />

        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerLauncherDesktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_icon="@drawable/ic_view_grid"
            app:csh_title="@string/launcher_settings_group_desktop" />

        <LinearLayout
            android:id="@+id/containerLauncherDesktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
                android:id="@+id/rowLauncherDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:layout_marginBottom="@dimen/margin_small"
                app:sdr_inline="true"
                app:sdr_fieldMaxWidth="@dimen/settings_dropdown_compact_width"
                app:sdr_title="@string/launcher_settings_density_title" />

            <!-- S1090: blocks the long-press entry into desktop edit mode; the Start-menu entry is a
                 deliberate action and stays reachable while locked. -->
            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowLauncherLockDesktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:str_title="@string/launcher_settings_lock_desktop_title" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
                android:id="@+id/rowLauncherWallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:layout_marginBottom="@dimen/margin_small"
                app:sdr_inline="true"
                app:sdr_fieldMaxWidth="@dimen/settings_dropdown_compact_width"
                app:sdr_title="@string/launcher_settings_wallpaper_title" />

        </LinearLayout>

        <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
            android:id="@+id/headerLauncherSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:csh_icon="@drawable/ic_android"
            app:csh_title="@string/launcher_settings_group_system" />

        <LinearLayout
            android:id="@+id/containerLauncherSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rowLauncherOpenHomeSettings"
                style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/launcher_settings_open_home_chooser_title"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
