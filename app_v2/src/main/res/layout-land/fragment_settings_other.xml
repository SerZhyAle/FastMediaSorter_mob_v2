<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" tools:ignore="NestedWeights">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/settings_padding">

        <!-- Translation Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchEnableTranslation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_switch_margin_end" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enable_translation" android:textSize="@dimen/toggler_title_text_size" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_enable_translation_desc" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_desc_text_size" />
            </LinearLayout>

            <ImageButton android:id="@+id/iconHelpTranslation" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_translation_title" android:src="@drawable/ic_help_outline_24" app:tint="@color/text_color_secondary" />
        </LinearLayout>

        <!-- Translation Languages Container (landscape: horizontal) -->
        <LinearLayout android:id="@+id/layoutTranslationLanguages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">

            <LinearLayout android:id="@+id/layoutTranslationSource" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/translation_source_language" android:textSize="@dimen/resource_card_desc_text_size" />

                <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerTranslationSourceLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" />
            </LinearLayout>

            <ImageButton android:id="@+id/btnSwapLanguages" android:layout_width="@dimen/settings_width_icon" android:layout_height="@dimen/settings_height_icon" android:layout_marginHorizontal="@dimen/settings_margin_standard" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/swap_languages" android:src="@drawable/ic_swap_horizontal" />

            <LinearLayout android:id="@+id/layoutTranslationTarget" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/translation_target_language" android:textSize="@dimen/resource_card_desc_text_size" />

                <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerTranslationTargetLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" />
            </LinearLayout>
        </LinearLayout>

        <!-- Translation Lens Style -->
        <LinearLayout android:id="@+id/layoutTranslationLensStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchTranslationLensStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_switch_margin_end" android:checked="false" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/translation_lens_style" android:textSize="@dimen/toggler_title_text_size" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_translation_lens_style_desc" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_desc_text_size" />
            </LinearLayout>

            <ImageButton android:id="@+id/iconHelpTranslationBlocks" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_translation_blocks_title" android:src="@drawable/ic_help_outline_24" app:tint="@color/text_color_secondary" />
        </LinearLayout>

        <!-- Google Lens -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchEnableGoogleLens" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_switch_margin_end" android:checked="false" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enable_google_lens" android:textSize="@dimen/toggler_title_text_size" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_enable_google_lens_desc" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_desc_text_size" />
            </LinearLayout>
        </LinearLayout>

        <!-- OCR (Text Recognition) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchEnableOcr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_switch_margin_end" android:checked="false" />

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/enable_ocr" android:textSize="@dimen/toggler_title_text_size" />
        </LinearLayout>

        <TextView android:id="@+id/tvOcrSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:text="@string/enable_ocr_summary" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_desc_text_size" />

        <!-- OCR Font Size -->
        <LinearLayout android:id="@+id/layoutOcrFontSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ocr_font_size" android:textSize="@dimen/resource_card_desc_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerOcrFontSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" />
        </LinearLayout>

        <!-- OCR Font Family -->
        <LinearLayout android:id="@+id/layoutOcrFontFamily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ocr_font_family" android:textSize="@dimen/resource_card_desc_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerOcrFontFamily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
