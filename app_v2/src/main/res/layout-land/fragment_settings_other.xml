<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:descendantFocusability="afterDescendants" tools:ignore="NestedWeights">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/settings_padding">

        <!-- Extensions Manager Entrance (landscape counterpart of layout/fragment_settings_other.xml) -->
        <LinearLayout
            android:id="@+id/layoutExtensionsManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/item_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/settings_item_min_height"
            android:padding="8dp"
            android:layout_marginBottom="@dimen/bottom_sheet_binary_file_tvFileName_layout_marginBottom">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_shortcut_packs_title"
                    android:textSize="@dimen/toggler_title_text_size"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_shortcut_packs_desc"
                    android:textSize="@dimen/toggler_desc_text_size"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.6"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- Translation toggle + lens style on the same row (landscape) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/settings_margin_standard"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowEnableTranslation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:str_title="@string/enable_translation"
                app:str_subtitle="@string/setting_enable_translation_desc"
                app:str_showHelp="true"
                app:str_helpTitle="@string/tooltip_translation_title"
                app:str_helpMessage="@string/tooltip_translation_message" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                android:id="@+id/rowTranslationLensStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/settings_margin_standard"
                android:visibility="gone"
                app:str_title="@string/translation_lens_style"
                app:str_subtitle="@string/setting_translation_lens_style_desc"
                app:str_showHelp="true"
                app:str_helpTitle="@string/tooltip_translation_blocks_title"
                app:str_helpMessage="@string/tooltip_translation_blocks_message" />
        </LinearLayout>

        <!-- Translation Languages Container (landscape: horizontal) -->
        <LinearLayout android:id="@+id/layoutTranslationLanguages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">

            <LinearLayout android:id="@+id/layoutTranslationSource" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:text="@string/translation_source_language" android:textSize="@dimen/toggler_title_text_size" />

                <TextView android:id="@+id/spinnerTranslationSourceLanguage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/item_focus_selector" android:clickable="true" android:ellipsize="end" android:focusable="true" android:gravity="end|center_vertical" android:maxLines="1" android:minWidth="@dimen/settings_spinner_min_width" android:paddingStart="@dimen/padding_normal" android:paddingEnd="@dimen/padding_normal" android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <ImageButton android:id="@+id/btnSwapLanguages" android:layout_width="@dimen/settings_width_icon" android:layout_height="@dimen/settings_height_icon" android:layout_marginHorizontal="@dimen/settings_margin_standard" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/swap_languages" android:src="@drawable/ic_swap_horizontal" />

            <LinearLayout android:id="@+id/layoutTranslationTarget" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:text="@string/translation_target_language" android:textSize="@dimen/toggler_title_text_size" />

                <TextView android:id="@+id/spinnerTranslationTargetLanguage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/item_focus_selector" android:clickable="true" android:ellipsize="end" android:focusable="true" android:gravity="end|center_vertical" android:maxLines="1" android:minWidth="@dimen/settings_spinner_min_width" android:paddingStart="@dimen/padding_normal" android:paddingEnd="@dimen/padding_normal" android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTranslationPrewarmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/settings_margin_standard"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTranslationPrewarmStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_color_secondary"
                android:textSize="@dimen/toggler_desc_text_size" />

            <Button
                android:id="@+id/btnTranslationPrewarmRetry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/translation_model_prewarm_retry"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Google Lens -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableGoogleLens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/settings_margin_standard"
            app:str_title="@string/enable_google_lens"
            app:str_subtitle="@string/setting_enable_google_lens_desc" />

        <!-- OCR (Text Recognition) - no subtitle in original layout; tvOcrSummary below shows unsupported reason -->
        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowEnableOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:str_title="@string/enable_ocr" />

        <TextView android:id="@+id/tvOcrSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:text="@string/enable_ocr_summary" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_desc_text_size" />

        <!-- OCR Engine Type (S0288) -->
        <LinearLayout android:id="@+id/layoutOcrEngineType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:text="@string/ocr_engine_type" android:textSize="@dimen/toggler_title_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerOcrEngineType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" android:contentDescription="@string/ocr_engine_type" />
        </LinearLayout>

        <!-- PaddleOCR Model Selection (S0288) -->
        <LinearLayout android:id="@+id/layoutPaddleOcrModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:text="@string/paddle_ocr_model" android:textSize="@dimen/toggler_title_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerPaddleOcrModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" android:contentDescription="@string/paddle_ocr_model" />
        </LinearLayout>

        <!-- OCR Font Size -->
        <LinearLayout android:id="@+id/layoutOcrFontSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:text="@string/ocr_font_size" android:textSize="@dimen/toggler_title_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerOcrFontSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" />
        </LinearLayout>

        <!-- OCR Font Family -->
        <LinearLayout android:id="@+id/layoutOcrFontFamily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:minHeight="@dimen/settings_item_min_height" android:orientation="horizontal" android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:text="@string/ocr_font_family" android:textSize="@dimen/toggler_title_text_size" />

            <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/spinnerOcrFontFamily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/settings_spinner_min_width" />
        </LinearLayout>

        <!-- OCR Best Models Section -->
        <LinearLayout
            android:id="@+id/layoutOcrBestModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart"
            android:layout_marginBottom="@dimen/settings_margin_standard">

            <!-- Title of section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ocr_best_models_title"
                android:textSize="@dimen/toggler_title_text_size"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small" />

            <!-- Russian Model Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ocr_best_rus_title"
                            android:textSize="@dimen/toggler_title_text_size"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvOcrBestRusStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ocr_best_model_size_mb"
                            android:textSize="@dimen/toggler_desc_text_size"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOcrBestRusDownload"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_best_model_download" />

                    <Button
                        android:id="@+id/btnOcrBestRusDelete"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_best_model_delete"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbOcrBestRusDownload"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Ukrainian Model Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ocr_best_ukr_title"
                            android:textSize="@dimen/toggler_title_text_size"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvOcrBestUkrStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ocr_best_model_size_mb"
                            android:textSize="@dimen/toggler_desc_text_size"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOcrBestUkrDownload"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_best_model_download" />

                    <Button
                        android:id="@+id/btnOcrBestUkrDelete"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_best_model_delete"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbOcrBestUkrDownload"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
