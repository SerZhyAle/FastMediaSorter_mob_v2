<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:descendantFocusability="afterDescendants"
    tools:ignore="NestedWeights">

    <!-- Full-width content to match other Settings pages (Playback, General); 600dp M3 cap removed per user UX preference -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/settings_fragment_padding">

            <!-- SAFETY & CONFIRMATION SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_margin_standard"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                        android:id="@+id/headerSafety"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:csh_title="@string/settings_category_safety" />

                    <LinearLayout
                        android:id="@+id/containerSafety"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/settings_margin_standard"
                        android:paddingEnd="@dimen/settings_margin_standard"
                        android:paddingBottom="@dimen/settings_margin_standard">

                        <LinearLayout
                            android:id="@+id/layoutEnableSafeMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_tiny"
                            android:orientation="vertical">

                            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                android:id="@+id/rowEnableSafeMode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:str_title="@string/enable_safe_mode"
                                app:str_subtitle="@string/setting_safe_mode_desc" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/containerConfirm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/settings_nested_margin_start"
                            android:layout_marginBottom="@dimen/margin_tiny"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/layoutConfirmDelete"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/margin_tiny"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                    android:id="@+id/rowConfirmDelete"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:str_title="@string/confirm_delete_safe_mode"
                                    app:str_subtitle="@string/setting_confirm_delete_desc"
                                    app:str_showHelp="true"
                                    app:str_helpTitle="@string/tooltip_safe_mode_title"
                                    app:str_helpMessage="@string/tooltip_safe_mode_message" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutConfirmMove"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/margin_tiny"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                    android:id="@+id/rowConfirmMove"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:str_title="@string/confirm_move_safe_mode"
                                    app:str_subtitle="@string/setting_confirm_move_desc" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutUseTrash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_tiny"
                            android:orientation="vertical">

                            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                android:id="@+id/rowUseTrash"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:str_title="@string/use_trash"
                                app:str_subtitle="@string/use_trash_summary"
                                app:str_showHelp="true"
                                app:str_helpTitle="@string/tooltip_use_trash_title"
                                app:str_helpMessage="@string/tooltip_use_trash_message" />

                            <ImageButton
                                android:id="@+id/btnClearTrash"
                                android:layout_width="@dimen/settings_help_icon_size"
                                android:layout_height="@dimen/settings_help_icon_size"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/clear_trash"
                                android:src="@drawable/ic_delete"
                                android:visibility="gone"
                                app:tint="@color/text_color_secondary" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- COPY & MOVE SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_margin_standard"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                        android:id="@+id/headerCopyMove"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:csh_title="@string/settings_category_copy_move" />

                    <LinearLayout
                        android:id="@+id/containerFileOperations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/settings_margin_standard"
                        android:paddingEnd="@dimen/settings_margin_standard"
                        android:paddingBottom="@dimen/settings_margin_standard">

                        <!-- Enable Copy + Overwrite on Copy -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/resource_field_margin_end"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                    android:id="@+id/rowEnableCopying"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:str_title="@string/enable_copying"
                                    app:str_subtitle="@string/setting_enable_copying_desc" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutOverwriteCopyWrapper"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/settings_help_icon_margin"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                    android:id="@+id/rowOverwriteOnCopy"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:str_title="@string/overwrite_on_copy"
                                    app:str_subtitle="@string/setting_overwrite_on_copy_desc" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Copy Options (go to next after copy) -->
                        <LinearLayout
                            android:id="@+id/layoutCopyOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_tiny"
                            android:orientation="vertical">

                            <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                android:id="@+id/rowGoToNextAfterCopy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:str_title="@string/go_to_next_after_copy"
                                app:str_subtitle="@string/setting_go_to_next_after_copy_desc"
                                app:str_showHelp="true"
                                app:str_helpTitle="@string/tooltip_go_to_next_after_copy_title"
                                app:str_helpMessage="@string/tooltip_go_to_next_after_copy_message" />

                        </LinearLayout>

                        <!-- Enable Move + Overwrite on Move -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/resource_field_margin_end"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                    android:id="@+id/rowEnableMoving"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:str_title="@string/enable_moving"
                                    app:str_subtitle="@string/setting_enable_moving_desc" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutOverwriteMoveWrapper"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/settings_help_icon_margin"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                                    android:id="@+id/rowOverwriteOnMove"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:str_title="@string/overwrite_on_move"
                                    app:str_subtitle="@string/setting_overwrite_on_move_desc" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DESTINATIONS SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_margin_standard"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                        android:id="@+id/headerDestinations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:csh_title="@string/destinations_list_header" />

                    <LinearLayout
                        android:id="@+id/containerDestinations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/settings_margin_standard"
                        android:paddingEnd="@dimen/settings_margin_standard"
                        android:paddingBottom="@dimen/settings_margin_standard">

                        <!-- Add destination button + max recipients + help icon -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/settings_padding_vertical_top_small">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddDestination"
                                style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/settings_help_icon_margin"
                                android:paddingHorizontal="@dimen/settings_padding_horizontal_large"
                                android:paddingVertical="@dimen/settings_padding_vertical"
                                android:text="@string/add_destination"
                                android:textSize="@dimen/toggler_title_text_size"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMaxRecipients"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="@dimen/settings_width_input_medium"
                                android:layout_height="wrap_content"
                                android:hint="@string/max_recipients">

                                <AutoCompleteTextView
                                    android:id="@+id/etMaxRecipients"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/max_recipients"
                                    android:inputType="number"
                                    android:maxLength="@integer/input_max_length_tiny" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <ImageButton
                                android:id="@+id/iconHelpDestinations"
                                android:layout_width="@dimen/settings_help_icon_size"
                                android:layout_height="@dimen/settings_help_icon_size"
                                android:layout_marginStart="@dimen/settings_help_icon_margin"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/tooltip_destinations_title"
                                android:src="@drawable/ic_help_outline_24"
                                app:tint="@color/text_color_secondary" />

                        </LinearLayout>

                        <!-- Message when no resources available -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvNoResourcesMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:padding="@dimen/bottom_sheet_binary_file_unknown_padding"
                            android:text="@string/add_resources_first_message"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/toggler_title_text_size"
                            android:visibility="gone" />

                        <!-- Destinations List -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDestinations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:descendantFocusability="afterDescendants"
                            android:layout_marginBottom="@dimen/settings_padding_vertical"
                            android:minHeight="@dimen/settings_height_container_min" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEDULED OPERATIONS SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_margin_standard"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                        android:id="@+id/headerScheduled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:csh_title="@string/scheduled_ops_section_title" />

                    <LinearLayout
                        android:id="@+id/containerScheduled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/settings_margin_standard"
                        android:paddingEnd="@dimen/settings_margin_standard"
                        android:paddingBottom="@dimen/settings_margin_standard"
                        android:visibility="gone">

                        <!-- Master toggle -->
                        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                            android:id="@+id/rowEnableScheduledOps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_tiny"
                            app:str_title="@string/scheduled_ops_toggle"
                            app:str_subtitle="@string/scheduled_ops_toggle_hint" />

                        <!-- Notification permission button (Android 13+) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScheduledNotificationPermission"
                            style="@style/Widget.FastMediaSorter.SettingsButton.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_tiny"
                            android:text="@string/grant_notifications_permission"
                            android:textSize="@dimen/toggler_title_text_size"
                            android:visibility="gone" />

                        <!-- Operations list and toolbar -->
                        <LinearLayout
                            android:id="@+id/containerScheduledContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Toolbar: Add + Log + Clear buttons -->
                            <LinearLayout
                                android:id="@+id/layoutScheduledActions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAddScheduledOp"
                                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/scheduled_ops_btn_add"
                                    app:icon="@drawable/ic_add"
                                    app:iconTint="?attr/colorOnSurface" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnScheduledLog"
                                    style="@style/Widget.Material3.Button.IconButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/scheduled_ops_btn_log"
                                    app:icon="@drawable/ic_history"
                                    app:iconTint="?attr/colorOnSurface" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClearAllScheduled"
                                    style="@style/Widget.Material3.Button.IconButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/scheduled_ops_btn_clear_all"
                                    app:icon="@drawable/ic_delete_sweep"
                                    app:iconTint="?attr/colorError" />

                            </LinearLayout>

                            <!-- Empty state -->
                            <TextView
                                android:id="@+id/tvNoScheduledOps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="@dimen/bottom_sheet_binary_file_unknown_padding"
                                android:text="@string/scheduled_ops_no_destinations"
                                android:textColor="?attr/colorError"
                                android:textSize="@dimen/toggler_title_text_size"
                                android:visibility="gone" />

                            <!-- Scheduled operations list -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvScheduledOps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:descendantFocusability="afterDescendants"
                                android:nestedScrollingEnabled="false" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
