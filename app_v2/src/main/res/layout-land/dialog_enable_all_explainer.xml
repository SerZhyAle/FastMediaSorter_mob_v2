<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape variant of res/layout/dialog_enable_all_explainer.xml (S2322 content, S3254 added this
  counterpart): same structure and ids, so no orientation-specific code is needed. Carries the
  portrait D-pad focus chain - nextFocusForward from the cancel button reaches the confirm button -
  because a chain that exists in portrait and not rotated is a regression the user meets by turning
  the phone (docs/ui/PHONE_UI_COMPONENT_PATTERNS.md 3.2/5.3).
  Root is a ScrollView: the three illustrated rows are taller than a landscape dialog window.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/layout_spacing_xlarge"
    android:paddingEnd="@dimen/layout_spacing_xlarge"
    android:paddingTop="@dimen/layout_spacing_medium_small"
    android:paddingBottom="@dimen/layout_spacing_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExplainerIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Android will ask a few questions of its own." />

        <LinearLayout
            android:id="@+id/rowStepPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/enable_all_explainer_step_gap"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStepPermissions"
                android:layout_width="@dimen/enable_all_explainer_guide_size"
                android:layout_height="@dimen/enable_all_explainer_guide_size"
                android:contentDescription="@string/welcome_enable_all_guide_allow_content_description"
                android:src="@drawable/ic_guide_tap_allow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_spacing_large"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStepPermissionsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_enable_all_explainer_step_permissions_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvStepPermissionsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_spacing_small"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/welcome_enable_all_explainer_step_permissions_body"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowStepDefaultApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/enable_all_explainer_step_gap"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStepDefaultApp"
                android:layout_width="@dimen/enable_all_explainer_guide_size"
                android:layout_height="@dimen/enable_all_explainer_guide_size"
                android:contentDescription="@string/welcome_enable_all_guide_always_content_description"
                android:src="@drawable/ic_guide_tap_always" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_spacing_large"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStepDefaultAppTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_enable_all_explainer_step_default_app_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvStepDefaultAppBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_spacing_small"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/welcome_enable_all_explainer_step_default_app_body"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowStepBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/enable_all_explainer_step_gap"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStepBack"
                android:layout_width="@dimen/enable_all_explainer_guide_size"
                android:layout_height="@dimen/enable_all_explainer_guide_size"
                android:contentDescription="@string/welcome_enable_all_guide_back_content_description"
                android:src="@drawable/ic_guide_press_back" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_spacing_large"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStepBackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_enable_all_explainer_step_back_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvStepBackBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_spacing_small"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/welcome_enable_all_explainer_step_back_body"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_spacing_xlarge"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExplainerCancel"
                style="@style/Widget.FastMediaSorter.Button.DialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusForward="@id/btnExplainerConfirm"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExplainerConfirm"
                style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_action_button_gap"
                android:focusable="true"
                android:text="@string/welcome_enable_all_explainer_continue" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
