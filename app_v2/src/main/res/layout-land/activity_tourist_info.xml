<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/touristRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorControlNormal"
        app:title="@string/tourist_info_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Side: Hero Focus Tile Card + Action Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeroTile"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivHeroIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            tools:src="@drawable/ic_speed" />

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            tools:text="Speed" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/layoutHeroTextMetrics"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeroPrimaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="64sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="0.0" />

                            <TextView
                                android:id="@+id/tvHeroPrimaryUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="12dp"
                                android:layout_gravity="bottom"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="km/h" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivHeroCompassRose"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:visibility="gone"
                            tools:src="@drawable/ic_compass" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvHeroSecondaryDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Max: 0.0 km/h • Trip: 0.00 km" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Bar -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenMap"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_map"
                    android:text="@string/tourist_action_open_map" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareLocation"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_share"
                    android:text="@string/tourist_action_share_location" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetTrip"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_refresh"
                    android:text="@string/tourist_action_reset_trip" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side: Secondary Tiles Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSecondaryTiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</LinearLayout>
