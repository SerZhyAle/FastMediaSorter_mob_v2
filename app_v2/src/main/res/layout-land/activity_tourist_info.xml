<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/touristRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sza.fastmediasorter.ui.common.widget.StandardToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FastMediaSorter.Toolbar.Flat"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/tourist_info_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Side: Hero Focus Tile Card + Action Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_normal"
            android:paddingEnd="@dimen/padding_small"
            android:paddingBottom="@dimen/margin_normal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeroTile"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/tourist_card_corner_radius"
                app:cardElevation="@dimen/tourist_card_elevation"
                app:strokeWidth="@dimen/tourist_card_stroke_width"
                app:strokeColor="?attr/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivHeroIcon"
                            android:layout_width="@dimen/tourist_hero_icon_size_land"
                            android:layout_height="@dimen/tourist_hero_icon_size_land"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            tools:src="@drawable/ic_speed" />

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_normal"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            tools:text="Speed" />

                        <ImageButton
                            android:id="@+id/btnHeroReset"
                            android:layout_width="@dimen/control_button_size_compact"
                            android:layout_height="@dimen/control_button_size_compact"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/tourist_action_reset_tile"
                            android:src="@drawable/ic_refresh"
                            android:visibility="gone"
                            app:tint="?attr/colorPrimary"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/layoutHeroTextMetrics"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeroPrimaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/tourist_primary_text_size_land"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="0.0" />

                            <TextView
                                android:id="@+id/tvHeroPrimaryUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_normal"
                                android:layout_marginBottom="@dimen/margin_medium"
                                android:layout_gravity="bottom"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="km/h" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutHeroCoords"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="gone">

                            <TextView
                                android:id="@+id/tvHeroLat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/tourist_coords_text_size_land"
                                android:textStyle="bold"
                                tools:text="Lat: 55.7558°" />

                            <TextView
                                android:id="@+id/tvHeroLon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/tourist_coords_text_size_land"
                                android:textStyle="bold"
                                tools:text="Lon: 37.6173°" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivHeroCompassRose"
                            android:layout_width="@dimen/tourist_compass_rose_size_land"
                            android:layout_height="@dimen/tourist_compass_rose_size_land"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:visibility="gone"
                            tools:src="@drawable/ic_compass" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvHeroSecondaryDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Max: 0.0 km/h • Trip: 0.00 km" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/padding_small">

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flowActionButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="btnOpenMap,btnShareLocation,btnResetTrip,btnSos"
                    app:flow_wrapMode="chain"
                    app:flow_horizontalStyle="packed"
                    app:flow_horizontalBias="0.5"
                    app:flow_horizontalGap="@dimen/margin_small"
                    app:flow_verticalGap="@dimen/margin_small"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenMap"
                    style="@style/Widget.FastMediaSorter.Button.Tonal.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_map"
                    android:text="@string/tourist_action_open_map" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareLocation"
                    style="@style/Widget.FastMediaSorter.Button.Tonal.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_share"
                    android:text="@string/tourist_action_share_location" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetTrip"
                    style="@style/Widget.FastMediaSorter.Button.Outlined.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_refresh"
                    android:text="@string/tourist_action_reset_trip" />

                <!-- S3216: last in the row and the only filled button among the four - the other three
                     act on a location and this one calls for help, so it must not read as one more of
                     them. Its accent is the red the programs list already gives the program. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSos"
                    style="@style/Widget.FastMediaSorter.Button.Filled.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/color_program_accent_red"
                    android:text="@string/tourist_action_sos"
                    app:icon="@drawable/ic_sos" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- Right Side: Secondary Tiles Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSecondaryTiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_normal"
            android:paddingBottom="@dimen/margin_normal" />
    </LinearLayout>
</LinearLayout>
