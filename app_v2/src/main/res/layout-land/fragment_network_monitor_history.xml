<?xml version="1.0" encoding="utf-8"?>
<!-- S1433 History subscreen, landscape. Same blocks and the same ids as portrait; the actions move into
     their own column so the short landscape height stays with the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/margin_small">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.FastMediaSorter.NetworkMonitor.SectionHeading"
            android:drawableStart="@drawable/ic_history"
            android:text="@string/network_monitor_section_history" />

        <TextView
            android:id="@+id/historyEmpty"
            style="@style/Widget.FastMediaSorter.NetworkMonitor.Note"
            android:text="@string/network_monitor_history_empty"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="true"
            tools:itemCount="4"
            tools:listitem="@layout/item_network_measurement" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/margin_small"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyNote"
            style="@style/Widget.FastMediaSorter.NetworkMonitor.Note"
            android:visibility="gone"
            tools:text="@string/network_monitor_history_export_failed"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryExport"
            style="@style/Widget.FastMediaSorter.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/btnHistoryClear"
            android:text="@string/network_monitor_history_export"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryClear"
            style="@style/Widget.FastMediaSorter.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@+id/btnHistoryExport"
            android:text="@string/network_monitor_history_clear"
            app:icon="@drawable/ic_delete_sweep" />
    </LinearLayout>
</LinearLayout>
