<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdfControlsLayout"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/player_pdf_controls_padding_vertical"
    android:paddingHorizontal="@dimen/player_pdf_controls_padding_horizontal"
    android:elevation="@dimen/elevation_player_controls"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/btnPdfPrevPage"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@android:drawable/ic_media_previous"
        android:background="@drawable/bg_circle_dark"
        app:tint="#4CAF50"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:contentDescription="Previous Page" />

    <ImageButton
        android:id="@+id/btnPdfHome"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@android:drawable/ic_media_rew"
        android:background="@drawable/bg_circle_dark"
        app:tint="#2196F3"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginStart="@dimen/player_pdf_button_margin"
        android:contentDescription="To begin" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btnPdfZoomOut"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_zoom_out"
        android:background="@drawable/bg_circle_dark"
        app:tint="@android:color/white"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginEnd="@dimen/player_pdf_button_margin"
        android:contentDescription="Zoom Out" />

    <ImageButton
        android:id="@+id/btnPdfZoomIn"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_zoom_in"
        android:background="@drawable/bg_circle_dark"
        app:tint="@android:color/white"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:contentDescription="Zoom In" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btnPdfEnd"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@drawable/ic_arrow_forward"
        android:background="@drawable/bg_circle_dark"
        app:tint="#2196F3"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:layout_marginEnd="@dimen/player_pdf_button_margin"
        android:contentDescription="To end" />

    <ImageButton
        android:id="@+id/btnPdfNextPage"
        android:layout_width="@dimen/player_pdf_button_size"
        android:layout_height="@dimen/player_pdf_button_size"
        android:src="@android:drawable/ic_media_next"
        android:background="@drawable/bg_circle_dark"
        app:tint="#4CAF50"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_search_panel_padding"
        android:contentDescription="Next Page" />
</LinearLayout>
