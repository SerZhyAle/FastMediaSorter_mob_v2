<?xml version="1.0" encoding="utf-8"?>
<!-- S1433: landscape keeps the same single-pane grid as portrait and only widens it to three tiles per row.
     Strategic 3.1.2 rules out a master-detail split so navigation stays identical on every device. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/networkMonitorSummaryScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="@dimen/margin_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/networkMonitorActiveCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/network_monitor_active_title"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/networkMonitorActiveHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/network_monitor_active_none"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold" />

                <!-- S2025: the same two rows as portrait, side by side - landscape has the width for it,
                     and the ids stay identical so one fragment binds both orientations. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/networkMonitorLocalIpRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:baselineAligned="false"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/network_monitor_local_ip_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_small" />

                        <TextView
                            android:id="@+id/networkMonitorLocalIpValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_normal"
                            android:layout_weight="1"
                            android:text="@string/network_monitor_value_unknown"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_size_small" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/networkMonitorExternalIpRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_normal"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:baselineAligned="false"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/network_monitor_external_ip_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_small" />

                        <TextView
                            android:id="@+id/networkMonitorExternalIpValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_normal"
                            android:layout_weight="1"
                            android:text="@string/network_monitor_external_ip_reveal"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_size_small" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/networkMonitorSpeedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/network_monitor_speed_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:id="@+id/networkMonitorSpeedValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_normal"
                        android:layout_weight="1"
                        android:text="@string/network_monitor_value_unknown"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_small" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileWifi"
                app:cardBackgroundColor="@color/tourist_tile_bg_weather"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusDown="@+id/tileGnss"
                android:nextFocusRight="@+id/tileMobile">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_wifi" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_wifi" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileWifiFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileWifiStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileMobile"
                app:cardBackgroundColor="@color/tourist_tile_bg_compass"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusDown="@+id/tileInternet"
                android:nextFocusLeft="@+id/tileWifi"
                android:nextFocusRight="@+id/tileBluetooth">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_mobile_network" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_mobile" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileMobileFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileMobileStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileBluetooth"
                app:cardBackgroundColor="@color/tourist_tile_bg_trip_distance"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusDown="@+id/tileHistory"
                android:nextFocusLeft="@+id/tileMobile">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_bluetooth" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_bluetooth" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileBluetoothFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileBluetoothStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileGnss"
                app:cardBackgroundColor="@color/tourist_tile_bg_satellites"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusUp="@+id/tileWifi"
                android:nextFocusRight="@+id/tileInternet"
                android:nextFocusDown="@+id/tileTools">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_location" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_gnss" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileGnssFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileGnssStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileInternet"
                app:cardBackgroundColor="@color/tourist_tile_bg_altitude"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusUp="@+id/tileMobile"
                android:nextFocusLeft="@+id/tileGnss"
                android:nextFocusRight="@+id/tileHistory"
                android:nextFocusDown="@+id/tileSpeed">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_internet" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_internet" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileInternetFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileInternetStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHistory"
                app:cardBackgroundColor="@color/tourist_tile_bg_coordinates"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusUp="@+id/tileBluetooth"
                android:nextFocusLeft="@+id/tileInternet"
                android:nextFocusDown="@+id/tileSpeed">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_history" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_history" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileHistoryFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileHistoryStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileTools"
                app:cardBackgroundColor="@color/tourist_tile_bg_dew_point"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusUp="@+id/tileGnss"
                android:nextFocusRight="@+id/tileSpeed">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_settings" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_tools" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileToolsFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileToolsStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileSpeed"
                app:cardBackgroundColor="@color/tourist_tile_bg_speed"
                style="@style/Widget.FastMediaSorter.NetworkMonitor.Tile"
                android:nextFocusUp="@+id/tileInternet"
                android:nextFocusLeft="@+id/tileTools">

                <LinearLayout
                    style="@style/Widget.FastMediaSorter.NetworkMonitor.TileContent"
                    android:padding="@dimen/margin_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            app:tint="?attr/colorOnSurface"
                            app:srcCompat="@drawable/ic_speed" />

                        <TextView
                            style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_small"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="@dimen/text_size_tiny"
                            app:autoSizeMaxTextSize="@dimen/text_size_small"
                            android:text="@string/network_monitor_section_resource_speed" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tileSpeedFact"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.SummaryTileFact"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tileSpeedStatus"
                        style="@style/Widget.FastMediaSorter.NetworkMonitor.TileStatus"
                        android:text="@string/network_monitor_status_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
</ScrollView>
