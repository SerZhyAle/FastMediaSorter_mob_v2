<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/audioTouchZonesOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="3"
    android:rowCount="3"
    android:visibility="gone">

    <TextView
        android:id="@+id/zoneBack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_back"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF" />

    <TextView
        android:id="@+id/zoneCopy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_copy"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp" />

    <TextView
        android:id="@+id/zoneRename"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_rename"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF" />

    <TextView
        android:id="@+id/zonePrevious"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_previous"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp" />

    <TextView
        android:id="@+id/zoneMove"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_move"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp" />

    <TextView
        android:id="@+id/zoneNext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_next"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp" />

    <TextView
        android:id="@+id/zoneCommandPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_command_panel"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF" />

    <TextView
        android:id="@+id/zoneDelete"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_delete"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp" />

    <TextView
        android:id="@+id/zoneSlideshow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:gravity="center"
        android:text="@string/touch_zone_queue"
        android:textColor="#D0FFFFFF"
        android:textSize="@dimen/empty_state_text_size"
        android:textStyle="bold"
        android:background="#50FFFFFF" />
</GridLayout>
