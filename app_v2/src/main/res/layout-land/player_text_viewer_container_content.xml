<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/textViewerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:background="?android:attr/colorBackground">

    <ImageButton
        android:id="@+id/btnCloseTextViewer"
        android:layout_width="@dimen/player_close_button_size"
        android:layout_height="@dimen/player_close_button_size"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/player_close_button_margin"
        android:background="@drawable/bg_circle_light"
        android:src="@drawable/ic_cancel"
        app:tint="#424242"
        android:scaleType="fitCenter"
        android:padding="@dimen/player_close_button_padding"
        android:contentDescription="@string/close"
        android:elevation="@dimen/elevation_player_overlay" />

    <ScrollView
        android:id="@+id/textScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/player_text_viewer_padding"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="@dimen/player_audio_info_text_size"
            android:fontFamily="monospace"
            android:scrollHorizontally="false"
            android:hyphenationFrequency="none"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Page navigation bar (shown for multi-page text files) -->
    <LinearLayout
        android:id="@+id/textPageNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="#B0000000"
        android:elevation="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnTextPagePrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTextPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnTextPageNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            app:tint="@color/white" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="4dp"
            android:background="#40FFFFFF" />

        <TextView
            android:id="@+id/tvTextEncodingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0FFFFFF"
            android:textSize="11sp"
            android:paddingHorizontal="4dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Find & Replace panel -->
    <LinearLayout
        android:id="@+id/textFindReplacePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#E0303030"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:elevation="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etFindQuery"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_input"
                android:hint="@string/find_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFindCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp"
                android:minWidth="32dp"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnFindNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnFindClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_cancel"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replaceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etReplaceQuery"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_input"
                android:hint="@string/replace_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplace"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/replace"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceAll"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/replace_all"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/textEditContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- S0189: unified editor toolbar - undo/redo/find on the left, cursor pos in the middle,
             Save/Save&Close/Save&Send/SendKeep/Cancel on the right (moved up from the former bottom
             red action panel so they stay reachable when the soft keyboard is open). -->
        <LinearLayout
            android:id="@+id/editorToolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:background="#CC000000">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/undo"
                android:src="@drawable/ic_undo"
                app:tint="@color/white"
                android:alpha="0.3" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/redo"
                android:src="@drawable/ic_redo"
                app:tint="@color/white"
                android:alpha="0.3" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="4dp"
                android:background="#40FFFFFF" />

            <ImageButton
                android:id="@+id/btnEditorFind"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnEditorFindReplace"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/find_and_replace"
                android:src="@drawable/ic_find_replace"
                app:tint="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvEditorCursorPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp"
                android:paddingHorizontal="8dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="4dp"
                android:background="#40FFFFFF" />

            <ImageButton
                android:id="@+id/btnEditorSave"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/text_editor_action_save"
                android:src="@drawable/ic_text_save"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnEditorSaveClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/text_editor_action_save_close"
                android:src="@drawable/ic_text_save_close"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnEditorSaveSend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/text_editor_action_save_send"
                android:src="@drawable/ic_text_save_send"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnEditorSendKeep"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone"
                android:contentDescription="@string/text_editor_action_send_keep"
                android:src="@drawable/ic_text_send_keep"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnEditorMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone"
                android:contentDescription="@string/more_actions"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnEditorCancel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/text_editor_action_cancel"
                android:src="@drawable/ic_text_cancel"
                app:tint="@color/white" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/textEditScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/player_text_viewer_padding">

            <EditText
                android:id="@+id/etTextContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:hint="@string/text_content_hint"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="@dimen/player_audio_info_text_size"
                android:fontFamily="monospace"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="10" />
        </ScrollView>

    </LinearLayout>
</FrameLayout>
