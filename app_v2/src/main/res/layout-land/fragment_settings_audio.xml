<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_padding">

    <!-- Support audio - help payload folded into the row -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/rowSupportAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_item_margin_bottom"
        app:str_title="@string/support_audio_description"
        app:str_subtitle="@string/setting_support_audio_desc"
        app:str_showHelp="true"
        app:str_helpTitle="@string/support_audio_description"
        app:str_helpMessage="@string/supported_audio_formats"
        app:str_checked="true" />

    <!-- Search audio covers online -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/rowSearchAudioCoversOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fragment_settings_audio_etAudioSizeMax_layout_marginStart"
        android:layout_marginBottom="@dimen/settings_item_margin_bottom"
        app:str_title="@string/search_audio_covers_online"
        app:str_subtitle="@string/setting_search_audio_covers_online_desc" />

    <!-- Cover-download sub-options (WiFi-only + local cache) on one row in landscape; each row's visibility is still toggled individually in fragment. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_nested_margin_start"
        android:layout_marginBottom="@dimen/settings_item_margin_bottom"
        android:orientation="horizontal">

        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowSearchCoversOnlyWifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/settings_margin_standard"
            android:visibility="gone"
            app:str_title="@string/search_covers_only_on_wifi"
            app:str_subtitle="@string/setting_search_covers_only_wifi_desc"
            app:str_checked="true" />

        <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
            android:id="@+id/rowSaveAudioMetadataLocally"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            app:str_title="@string/save_audio_metadata_locally"
            app:str_subtitle="@string/save_audio_metadata_locally_desc"
            app:str_checked="true" />
    </LinearLayout>

    <!-- Audio size limit -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_other_layoutOcrFontFamily_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center_vertical" android:orientation="horizontal">

        <TextView android:id="@+id/tvAudioSizeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/audio_size_limit" android:textSize="@dimen/toggler_title_text_size" />

        <ImageButton android:id="@+id/iconHelpAudioSizeLimits" android:layout_width="@dimen/settings_help_icon_size" android:layout_height="@dimen/settings_help_icon_size" android:layout_marginStart="@dimen/settings_help_icon_margin" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tooltip_audio_size_limits_title" android:src="@drawable/ic_help_outline_24" app:tint="@color/text_color_secondary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/layoutAudioSizeInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/settings_margin_indent_level_2" android:layout_marginEnd="@dimen/settings_margin_standard" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="start" android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAudioSizeMin" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="@dimen/settings_text_input_width" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/settings_margin_standard" android:hint="@string/fragment_settings_audio_tilAudioSizeMin_hint" app:hintTextColor="@color/settings_textinput_hint">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAudioSizeMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="@integer/input_max_length_filesize" android:textColor="@color/text_color_primary" android:textColorHint="@color/text_color_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAudioSizeMax" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="@dimen/settings_text_input_width" android:layout_height="wrap_content" android:hint="@string/fragment_settings_audio_tilAudioSizeMax_hint" app:hintTextColor="@color/settings_textinput_hint">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAudioSizeMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="@integer/input_max_length_filesize" android:textColor="@color/text_color_primary" android:textColorHint="@color/text_color_secondary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Enable photos during audio playback - help payload folded into the row -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/rowEnablePhotosDuringAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fragment_settings_audio_etAudioSizeMax_layout_marginStart"
        android:layout_marginBottom="@dimen/settings_item_margin_bottom"
        app:str_title="@string/enable_photos_during_audio_description"
        app:str_subtitle="@string/setting_photos_during_audio_desc"
        app:str_showHelp="true"
        app:str_helpTitle="@string/tooltip_photos_during_audio_title"
        app:str_helpMessage="@string/tooltip_photos_during_audio_message" />

    <!-- Background photos source selector -->
    <LinearLayout android:id="@+id/layoutPhotosSourceSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/settings_nested_margin_start" android:layout_marginBottom="@dimen/settings_margin_standard" android:orientation="vertical" android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:text="@string/audio_background_photos_source_label" android:textColor="@color/text_color_primary" android:textSize="@dimen/toggler_title_text_size" />

        <TextView android:id="@+id/tvSelectedPhotosSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:gravity="center" android:text="@string/no_photos_source_selected" android:textColor="@color/text_color_secondary" android:textSize="@dimen/toggler_title_text_size" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectPhotosSource" style="@style/Widget.FastMediaSorter.SettingsButton.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/select_photos_source" android:textAllCaps="false" />
    </LinearLayout>

    <!-- Audio empty state animation mode -->
    <LinearLayout android:id="@+id/layoutAudioEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fragment_settings_audio_etAudioSizeMax_layout_marginStart" android:layout_marginBottom="@dimen/settings_margin_standard" android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_margin_standard" android:text="@string/audio_empty_state_label" android:textSize="@dimen/toggler_title_text_size" />

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAudioEmptyStateMode" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="280dp" android:layout_height="wrap_content" app:hintTextColor="@color/settings_textinput_hint">

            <AutoCompleteTextView android:id="@+id/actvAudioEmptyStateMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textColor="@color/text_color_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSetDefaultAudioPlayer" style="@style/Widget.FastMediaSorter.SettingsButton.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="@dimen/settings_margin_standard" android:text="@string/settings_set_default_audio_player" android:textAllCaps="false" />

<!-- S0367: microphone-recording and camera-photos settings moved to Playback → "Camera, microphone and Other features". -->

</LinearLayout>
