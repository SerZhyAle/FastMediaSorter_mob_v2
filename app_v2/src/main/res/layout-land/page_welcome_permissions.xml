<?xml version="1.0" encoding="utf-8"?>
<!-- S0402 permissions onboarding page (landscape). Same compact structure and ids as the portrait
     variant (layout/page_welcome_permissions.xml): header (title + subtitle, no launcher icon), a single
     action row (grant-all + open-settings side by side), and the bounded scrollable card holding the
     adaptive permission list. The card takes the remaining height so the rows never clip on short
     landscape screens. All ids must stay in sync with the portrait variant. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/welcome_page_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_max="@dimen/welcome_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Header: title (compact, no icon) -->
        <TextView
            android:id="@+id/tvPermissionsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:gravity="center"
            android:text="@string/welcome_permissions_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/welcome_permissions_title_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header: subtitle -->
        <TextView
            android:id="@+id/tvPermissionsSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/welcome_permissions_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/welcome_description_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermissionsTitle" />

        <!-- Action row: grant-all (hidden by the manager when nothing is left to grant) + open-settings -->
        <LinearLayout
            android:id="@+id/layoutPermActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermissionsSubtitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantAll"
                style="@style/Widget.FastMediaSorter.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/perm_btn_grant_all"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/Widget.FastMediaSorter.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/welcome_perm_actions_gap"
                android:text="@string/perm_btn_open_system_settings"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Bounded, scrollable list panel: the filled surface + outline signals "this scrolls" -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermissions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/welcome_description_margin_top"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/welcome_perm_list_corner"
            app:cardElevation="0dp"
            app:contentPadding="@dimen/welcome_perm_list_content_padding"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPermActions">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPermissions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
