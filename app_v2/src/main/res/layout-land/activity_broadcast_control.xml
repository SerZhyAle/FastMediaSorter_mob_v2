<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/padding_normal">

    <!-- S4418: while a live camera picture is on air this container is the fullscreen video rectangle and a
         tap on it brings the panel back; BroadcastLandscapeVideoManager sets clickable and focusable by code,
         so the idle lens preview is not a dead button. -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:background="@android:color/black"
        android:foreground="?attr/selectableItemBackground"
        android:nextFocusRight="@id/btnToggleCamera"
        android:layout_marginEnd="@dimen/margin_normal" />

    <ScrollView
        android:id="@+id/controlsScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvControlTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/broadcast_control_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvListenerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_normal"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="0 listeners" />

            <TextView
                android:id="@+id/tvFeedbackWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_normal"
                android:text="@string/broadcast_control_feedback_warning"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- MODE & CAMERA SELECTION: S4336 the owner moved both choices to a list - one dropdown row
                 each, the option list lives in code (mode) or in the lens enumeration (camera). -->
            <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
                android:id="@+id/rowBroadcastMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:sdr_title="@string/broadcast_entry_mode_label"
                app:sdr_valueAsText="true" />

            <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
                android:id="@+id/rowLensSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:visibility="gone"
                app:sdr_title="@string/broadcast_entry_lens_label"
                app:sdr_valueAsText="true" />

            <!-- BROADCAST SETTINGS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBroadcastSettings"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_normal">

                <include
                    android:id="@+id/layoutBroadcastSettings"
                    layout="@layout/fragment_settings_broadcast" />
            </com.google.android.material.card.MaterialCardView>

            <!-- START BROADCAST ACTION (IDLE STATE) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartBroadcast"
                style="@style/Widget.FastMediaSorter.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/margin_small"
                android:minHeight="@dimen/touch_target_min_height"
                android:focusable="true"
                android:clickable="true"
                android:text="@string/broadcast_entry_start"
                app:icon="@drawable/ic_live_broadcast" />

            <!-- S4234: BROADCAST A STORED FILE (IDLE STATE) - the picker hands the uri to the controller -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBroadcastFile"
                style="@style/Widget.FastMediaSorter.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/margin_small"
                android:minHeight="@dimen/touch_target_min_height"
                android:focusable="true"
                android:clickable="true"
                android:text="@string/broadcast_control_file_action"
                android:visibility="gone" />

            <!-- S4233: BROADCAST THE PHONE SCREEN (IDLE STATE) - the platform consent result goes to the controller -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBroadcastScreen"
                style="@style/Widget.FastMediaSorter.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/margin_normal"
                android:minHeight="@dimen/touch_target_min_height"
                android:focusable="true"
                android:clickable="true"
                android:text="@string/broadcast_control_screen_action"
                android:visibility="gone" />

            <!-- S4273: SITE-STRUCTURE 0.2 item E - the page of going on air, visible before the broadcast starts. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBroadcastPortalStart"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/margin_small"
                android:minHeight="@dimen/touch_target_min_height"
                android:focusable="true"
                android:clickable="true"
                android:text="@string/exchange_portal_link_broadcast_start"
                app:icon="@drawable/ic_live_broadcast" />

            <!-- LIVE STREAM CONTROLS CONTAINER -->
            <LinearLayout
                android:id="@+id/layoutLiveControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_normal"
                android:visibility="gone">

                <!-- S4336: the live commands are covered by a collapsible group; the stop button stays
                     outside it so stopping never hides behind an expansion. -->
                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerLiveCommands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:csh_title="@string/broadcast_control_group_commands" />

                <LinearLayout
                    android:id="@+id/containerLiveCommands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- S4344: equal halves - wrap_content let the wider label squeeze the loser into a
                         mid-word-wrapping sliver at large font scales (S3168 recipe, share row). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_small">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleCamera"
                        style="@style/Widget.FastMediaSorter.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_control_live_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_control_live_button_text_size_max"
                        android:nextFocusRight="@+id/btnToggleMic"
                        android:nextFocusDown="@+id/btnSwitchCamera"
                        android:text="@string/broadcast_control_camera_on"
                        app:icon="@drawable/ic_camera_capture" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleMic"
                        style="@style/Widget.FastMediaSorter.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_control_live_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_control_live_button_text_size_max"
                        android:nextFocusLeft="@+id/btnToggleCamera"
                        android:nextFocusDown="@+id/btnScreenOff"
                        android:text="@string/broadcast_control_mic_on"
                        app:icon="@drawable/ic_microphone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_small">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSwitchCamera"
                        style="@style/Widget.FastMediaSorter.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_control_live_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_control_live_button_text_size_max"
                        android:nextFocusUp="@+id/btnToggleCamera"
                        android:nextFocusRight="@+id/btnScreenOff"
                        android:nextFocusDown="@+id/btnToggleTorch"
                        android:text="@string/broadcast_control_switch_camera"
                        app:icon="@drawable/ic_camera_switch" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScreenOff"
                        style="@style/Widget.FastMediaSorter.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_control_live_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_control_live_button_text_size_max"
                        android:contentDescription="@string/broadcast_control_screen_off_cd"
                        android:nextFocusUp="@+id/btnToggleMic"
                        android:nextFocusLeft="@+id/btnSwitchCamera"
                        android:nextFocusDown="@+id/btnLightFrame"
                        android:text="@string/broadcast_control_screen_off"
                        app:icon="@drawable/ic_black_screen" />
                </LinearLayout>

                <!-- S4281: low-light aids for a camera session. The row and the flashlight are shown by code: the
                     flashlight only when the lens on air has a flash, the whole row never in a file or screen session. -->
                <LinearLayout
                    android:id="@+id/rowLightControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleTorch"
                        style="@style/Widget.FastMediaSorter.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_control_live_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_control_live_button_text_size_max"
                        android:contentDescription="@string/broadcast_control_torch_cd"
                        android:nextFocusUp="@+id/btnSwitchCamera"
                        android:nextFocusRight="@+id/btnLightFrame"
                        android:nextFocusDown="@+id/btnSendToWatch"
                        android:text="@string/broadcast_control_torch_off"
                        app:icon="@drawable/ic_camera_flash_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLightFrame"
                        style="@style/Widget.FastMediaSorter.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_control_live_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_control_live_button_text_size_max"
                        android:contentDescription="@string/broadcast_control_light_frame_cd"
                        android:nextFocusUp="@+id/btnScreenOff"
                        android:nextFocusLeft="@+id/btnToggleTorch"
                        android:nextFocusDown="@+id/btnSendToWatch"
                        android:text="@string/broadcast_control_light_frame_off"
                        app:icon="@drawable/ic_front_flashlight" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendToWatch"
                    style="@style/Widget.FastMediaSorter.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:visibility="gone"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/btnLightFrame"
                    android:nextFocusDown="@+id/btnStopBroadcast"
                    android:text="@string/stream_action_send_to_watch"
                    app:icon="@drawable/ic_watch" />

                <!-- S4116: cast this broadcast to other devices of the account; shown while an exchange server carries it. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCastToDevices"
                    style="@style/Widget.FastMediaSorter.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:visibility="gone"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/btnLightFrame"
                    android:nextFocusDown="@+id/btnStopBroadcast"
                        android:text="@string/exchange_cast_send"
                        app:icon="@drawable/ic_cast" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopBroadcast"
                    style="@style/Widget.FastMediaSorter.Button.Destructive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/btnSendToWatch"
                    android:text="@string/broadcast_control_stop"
                    app:icon="@drawable/ic_stop" />

            </LinearLayout>

            <!-- SHARE & QR PANEL CONTAINER (LIVE STATE) -->
            <LinearLayout
                android:id="@+id/layoutSharePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_small">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerSharePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:csh_title="@string/broadcast_control_group_share" />

                <LinearLayout
                    android:id="@+id/containerSharePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/ivShareQr"
                    android:layout_width="@dimen/broadcast_control_qr_size"
                    android:layout_height="@dimen/broadcast_control_qr_size"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="@string/broadcast_share_qr_cd"
                    android:layout_marginBottom="@dimen/margin_small" />

                <TextView
                    android:id="@+id/tvShareUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:layout_marginBottom="@dimen/margin_small" />

                <!-- Shown only for a protected broadcast: the password goes to the person apart from the link and the QR code. -->
                <TextView
                    android:id="@+id/tvSharePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/margin_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareNewPassword"
                    style="@style/Widget.FastMediaSorter.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone"
                    android:contentDescription="@string/broadcast_share_new_password_cd"
                    android:text="@string/broadcast_share_new_password"
                    android:layout_marginBottom="@dimen/margin_small" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Equal thirds: wrap_content let a long localized label squeeze the last button to a sliver (S3168). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyUrl"
                        style="@style/Widget.FastMediaSorter.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:focusable="true"
                        android:clickable="true"
                        android:gravity="center"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_share_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_share_button_text_size_max"
                        android:nextFocusRight="@id/btnExportFile"
                        android:text="@string/broadcast_share_copy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportFile"
                        style="@style/Widget.FastMediaSorter.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:focusable="true"
                        android:clickable="true"
                        android:gravity="center"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_share_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_share_button_text_size_max"
                        android:nextFocusLeft="@id/btnCopyUrl"
                        android:nextFocusRight="@id/btnShareSend"
                        android:text="@string/broadcast_share_export_file" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareSend"
                        style="@style/Widget.FastMediaSorter.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:clickable="true"
                        android:gravity="center"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_share_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_share_button_text_size_max"
                        android:nextFocusLeft="@id/btnExportFile"
                        android:nextFocusRight="@+id/btnShareGuests"
                        android:text="@string/broadcast_share_send_link" />

                    <!-- Shown only while the broadcast is announced through an exchange server (DEVICE-EXCHANGE item BD). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareGuests"
                        style="@style/Widget.FastMediaSorter.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:minHeight="@dimen/touch_target_min_height"
                        android:focusable="true"
                        android:clickable="true"
                        android:visibility="gone"
                        android:gravity="center"
                        android:maxLines="2"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:paddingStart="@dimen/padding_tiny"
                        android:paddingEnd="@dimen/padding_tiny"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/broadcast_share_button_text_size_min"
                        app:autoSizeMaxTextSize="@dimen/broadcast_share_button_text_size_max"
                        android:nextFocusLeft="@id/btnShareSend"
                        android:contentDescription="@string/broadcast_guests_title"
                        android:text="@string/broadcast_guests_button" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBroadcastHelp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@id/btnCopyUrl"
                    android:text="@string/broadcast_share_help"
                    app:icon="@drawable/ic_info" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBroadcastPortal"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@id/btnBroadcastHelp"
                    android:text="@string/broadcast_portal_help"
                    app:icon="@drawable/ic_live_broadcast" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
