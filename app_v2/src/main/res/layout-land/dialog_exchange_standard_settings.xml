<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding_large">

        <TextView
            android:id="@+id/textStandardSettingsPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exchange_standard_settings_summary"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="@dimen/margin_normal" />

        <TextView
            android:id="@+id/textStandardSettingsGroupsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exchange_standard_settings_groups_header"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:layout_marginBottom="@dimen/margin_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
                    android:id="@+id/cbGroupGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fcr_checked="true"
                    app:fcr_title="@string/exchange_standard_settings_group_general" />

                <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
                    android:id="@+id/cbGroupAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fcr_checked="true"
                    app:fcr_title="@string/exchange_standard_settings_group_appearance" />

                <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
                    android:id="@+id/cbGroupPlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fcr_checked="true"
                    app:fcr_title="@string/exchange_standard_settings_group_playback" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
                    android:id="@+id/cbGroupShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fcr_checked="true"
                    app:fcr_title="@string/exchange_standard_settings_group_shortcuts" />

                <com.sza.fastmediasorter.ui.common.widget.FormCheckboxRow
                    android:id="@+id/cbGroupBehavior"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fcr_checked="true"
                    app:fcr_title="@string/exchange_standard_settings_group_behavior" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textStandardSettingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            android:layout_marginTop="@dimen/margin_small" />

        <ProgressBar
            android:id="@+id/progressStandardSettings"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_small"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
