<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorControlNormal"
        app:title="@string/calculator_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/settings_margin_standard">

        <LinearLayout
            android:id="@+id/calculatorContentGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="@dimen/margin_small">

                <ScrollView
                    android:id="@+id/calculatorHistoryScroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="insideInset"
                    android:fadeScrollbars="false">

                    <TextView
                        android:id="@+id/calculatorHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom|start"
                        android:text=""
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="@dimen/calculator_history_text_size" />
                </ScrollView>

                <TextView
                    android:id="@+id/calculatorDisplay"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:gravity="top|end"
                    android:maxLines="1"
                    android:text="0"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/text_color_primary"
                    app:autoSizeMaxTextSize="@dimen/calculator_display_text_size"
                    app:autoSizeMinTextSize="@dimen/calculator_display_text_size_min"
                    app:autoSizeStepGranularity="@dimen/calculator_display_text_size_step"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/calculatorMemoryIndicator"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/calculator_plus_button_text"
                        android:textSize="@dimen/calculator_memory_indicator_text_size"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalculatorMemoryToggle"
                        style="@style/Widget.FastMediaSorter.Calculator.MemoryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:contentDescription="@string/calculator_action_memory_toggle"
                        android:focusable="true"
                        android:minWidth="48dp"
                        android:text="M" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calculatorMemoryRow"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/calculator_memory_row_height"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorMemoryAdd" style="@style/Widget.FastMediaSorter.Calculator.MemoryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@string/calculator_action_memory_add" android:text="M+" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorMemorySubtract" style="@style/Widget.FastMediaSorter.Calculator.MemoryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@string/calculator_action_memory_subtract" android:text="M−" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorMemoryRecall" style="@style/Widget.FastMediaSorter.Calculator.MemoryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@string/calculator_action_memory_recall" android:text="MR" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorMemoryClear" style="@style/Widget.FastMediaSorter.Calculator.MemoryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@string/calculator_action_memory_clear" android:text="MC" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/calculatorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:columnCount="4"
                    android:rowCount="6"
                    android:useDefaultMargins="false">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorClear" style="@style/Widget.FastMediaSorter.Calculator.ClearButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_clear" android:text="C" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorClearEntry" style="@style/Widget.FastMediaSorter.Calculator.ClearButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_clear_entry" android:text="CE" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorBackspace" style="@style/Widget.FastMediaSorter.Calculator.Button" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_backspace" android:text="⌫" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorPercent" style="@style/Widget.FastMediaSorter.Calculator.OperatorButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_percent" android:text="%" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorSeven" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="7" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorEight" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="8" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorNine" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="9" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorDivide" style="@style/Widget.FastMediaSorter.Calculator.OperatorButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_divide" android:text="÷" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorFour" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="4" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorFive" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="5" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorSix" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="6" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorMultiply" style="@style/Widget.FastMediaSorter.Calculator.OperatorButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_multiply" android:text="×" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorOne" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorTwo" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="2" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorThree" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="3" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorSubtract" style="@style/Widget.FastMediaSorter.Calculator.OperatorButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_subtract" android:text="-" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorToggleSign" style="@style/Widget.FastMediaSorter.Calculator.Button" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_toggle_sign" android:text="+/-" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorZero" style="@style/Widget.FastMediaSorter.Calculator.DigitButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="0" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorDecimal" style="@style/Widget.FastMediaSorter.Calculator.Button" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_decimal" android:text="." />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorAdd" style="@style/Widget.FastMediaSorter.Calculator.PlusButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/calculator_action_add" android:text="+" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorMenu" style="@style/Widget.FastMediaSorter.Calculator.Button" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:contentDescription="@string/more_actions" android:text="≡" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCalculatorEquals" style="@style/Widget.FastMediaSorter.Calculator.EqualsButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnSpan="3" android:layout_columnWeight="3" android:layout_rowWeight="1" android:layout_gravity="fill" android:contentDescription="@string/calculator_action_equals" android:text="=" />
                </GridLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/calculatorFallbackGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/margin_large"
            android:visibility="gone">

            <TextView
                android:id="@+id/calculatorFallbackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/calculator_enable_prompt_title"
                android:textColor="@color/text_color_primary"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calculatorFallbackMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center"
                android:text="@string/calculator_enable_prompt_message"
                android:textColor="@color/text_color_secondary"
                android:textSize="@dimen/text_size_normal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculatorOpenSettings"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/calculator_open_settings"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
