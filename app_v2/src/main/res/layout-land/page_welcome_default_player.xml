<?xml version="1.0" encoding="utf-8"?>
<!-- Default Player page — landscape variant.
     Left column: app icon + title + description (scrollable).
     Right column: 4 action buttons, vertically centred. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/welcome_page_padding">

    <!-- Left column: header + scrollable description -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="@dimen/margin_large">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/welcome_icon_size"
                android:layout_height="@dimen/welcome_icon_size"
                android:layout_marginTop="@dimen/welcome_icon_margin_top"
                android:contentDescription="@string/welcome_default_player_title"
                android:src="@drawable/ic_audio"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/welcome_title_margin_top"
                android:text="@string/welcome_default_player_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/welcome_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/welcome_description_margin_top"
                android:text="@string/welcome_default_player_description"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/welcome_description_text_size"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

    </ScrollView>

    <!-- Right column: action buttons, vertically centred -->
    <LinearLayout
        android:id="@+id/layoutTypeButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_large">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/welcome_default_player_btn_audio"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/welcome_default_player_btn_video"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/welcome_default_player_btn_images"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultDocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_default_player_btn_docs"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
