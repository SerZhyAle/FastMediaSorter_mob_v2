<?xml version="1.0" encoding="utf-8"?>
<!-- Default Player page — landscape variant.
     Keep two-column UX: instructions on the left, action buttons on the right.
     Left side is scrollable so text remains readable on short screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/welcome_page_padding">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="@dimen/margin_large">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_default_player_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/welcome_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/welcome_description_margin_top"
                android:text="@string/welcome_default_player_description"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/welcome_description_text_size"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/welcome_default_player_hint"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/margin_large"
                android:contentDescription="@string/welcome_default_player_title"
                android:src="@drawable/ic_audio"
                app:tint="?attr/colorPrimary" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutTypeButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_large">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/welcome_default_player_btn_audio"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/welcome_default_player_btn_video"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/welcome_default_player_btn_images"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultDocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_default_player_btn_docs"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
