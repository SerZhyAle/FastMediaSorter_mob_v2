<?xml version="1.0" encoding="utf-8"?>
<!-- S2817: landscape variant of the Media-tab container. Same ordered section set and ids as the
     portrait layout so FragmentSettingsMediaContainerBinding resolves in both orientations. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:descendantFocusability="afterDescendants">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/settings_fragment_padding" android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" android:layout_marginTop="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_image"
                    app:csh_title="@string/settings_category_images" />

                <FrameLayout android:id="@+id/containerImages" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_video"
                    app:csh_title="@string/settings_category_video" />

                <FrameLayout android:id="@+id/containerVideo" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerVr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_vr_headset"
                    app:csh_helpMessage="@string/settings_3d_vr_help_message"
                    app:csh_helpTitle="@string/settings_3d_vr_help_title"
                    app:csh_showHelp="true"
                    app:csh_title="@string/vr_settings_block_title" />

                <FrameLayout android:id="@+id/containerVr" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_audio"
                    app:csh_title="@string/settings_category_audio" />

                <FrameLayout android:id="@+id/containerAudio" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_book"
                    app:csh_title="@string/settings_category_documents" />

                <FrameLayout android:id="@+id/containerDocuments" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_translate"
                    app:csh_title="@string/settings_category_other" />

                <FrameLayout android:id="@+id/containerOther" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_small" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="@dimen/card_elevation" app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerStreams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_stream"
                    app:csh_title="@string/settings_streams_section" />

                <FrameLayout android:id="@+id/containerStreams" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBroadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:contentPadding="@dimen/padding_none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <com.sza.fastmediasorter.ui.common.widget.CollapsibleSectionHeader
                    android:id="@+id/headerBroadcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:csh_icon="@drawable/ic_microphone"
                    app:csh_title="@string/settings_broadcast_section" />

                <FrameLayout android:id="@+id/containerBroadcast" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnResetMediaSection" style="@style/Widget.FastMediaSorter.SettingsButton.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="@dimen/margin_small" android:layout_marginEnd="@dimen/margin_small" android:text="@string/reset_media_section" />

    </LinearLayout>

</ScrollView>
