<?xml version="1.0" encoding="utf-8"?>
<!--
    S0191/S0192 - Draw overlay toolbar (landscape).

    Vertical strip keeps tool + colour controls at the top, primary save/share/cancel
    actions at the bottom, and the overflow for secondary commands.

    The tool + colour group is wrapped in a vertical ScrollView (mirror of the
    portrait S0389/S0390 fix): on short landscape screens the full strip exceeds
    the available height, which previously collapsed the spacer and clipped the
    trailing Cancel button off the bottom edge. The bottom action group is pinned
    outside the scroll so Save / Cancel stay fully visible at any height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawOverlayToolbar"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/draw_overlay_toolbar_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp"
    android:visibility="gone">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton style="@style/Widget.FastMediaSorter.Button.Icon.Overlay" android:id="@+id/btn_draw_tool_selector"
                android:layout_width="@dimen/player_cmd_button_size"
                android:layout_height="@dimen/player_cmd_button_size"
                android:contentDescription="@string/draw_tool_selector_cd"
                android:padding="8dp"
                android:src="@drawable/ic_draw_overlay" />

            <View
                android:id="@+id/color_black"
                android:foreground="@drawable/focus_button_background"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="@color/draw_swatch_black"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true" />

            <View
                android:id="@+id/color_white"
                android:foreground="@drawable/focus_button_background"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="@color/draw_swatch_white"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true" />

            <View
                android:id="@+id/color_red"
                android:foreground="@drawable/focus_button_background"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="@color/draw_swatch_red"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true" />

            <View
                android:id="@+id/color_custom"
                android:foreground="@drawable/focus_button_background"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/draw_color_swatch_selected"
                android:backgroundTint="@color/draw_swatch_red"
                android:clickable="true"
                android:contentDescription="@string/draw_color_custom_cd"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

    <ImageButton style="@style/Widget.FastMediaSorter.Button.Icon.Overlay" android:id="@+id/btn_draw_save"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/text_editor_action_save"
        android:padding="8dp"
        android:src="@drawable/ic_text_save" />

    <ImageButton style="@style/Widget.FastMediaSorter.Button.Icon.Overlay" android:id="@+id/btn_draw_save_close"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/text_editor_action_save_close"
        android:padding="8dp"
        android:src="@drawable/ic_text_save_close" />

    <ImageButton style="@style/Widget.FastMediaSorter.Button.Icon.Overlay" android:id="@+id/btn_draw_overflow"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/draw_overflow_settings"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_more" />

    <ImageButton style="@style/Widget.FastMediaSorter.Button.Icon.Overlay" android:id="@+id/btn_draw_close"
        android:layout_width="@dimen/player_cmd_button_size"
        android:layout_height="@dimen/player_cmd_button_size"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/text_editor_action_cancel"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</LinearLayout>
