<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: maxHeight added to ScrollView; title+buttons row is first item so always visible -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/dialog_landscape_max_height">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <!-- Title and Buttons at top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_small">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/player_settings_title"
            android:textSize="@dimen/text_size_title_dialog"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.FastMediaSorter.Button.DialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_action_button_gap"
            android:text="@string/apply" />

    </LinearLayout>

    <!-- Playback Speed Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_speed"
        android:textSize="@dimen/resource_card_title_text_size"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        app:singleSelection="true"
        app:selectionRequired="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed025"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed025_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed05"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed05_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed1"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed1_text"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed125"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed125_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed15"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed15_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed175"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed175_text" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSpeed2"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_player_settings_chipSpeed2_text" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Repeat Video -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/cbRepeatVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_tiny"
        app:str_title="@string/player_repeat_video"
        app:str_subtitle="@string/cb_repeat_video_desc" />

    <!-- Subtitles Section -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
        android:id="@+id/cbShowSubtitles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_tiny"
        app:str_title="@string/player_show_subtitles"
        app:str_subtitle="@string/cb_show_subtitles_desc" />

    <!-- Subtitle language (S0567: raw Spinner -> SettingsDropdownRow; the row owns its title.
         Enable/disable is driven by the subtitles toggle via the controller's isEnabled). -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
        android:id="@+id/spinnerSubtitleLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_xxlarge"
        android:layout_marginBottom="@dimen/margin_small"
        app:sdr_inline="true"
        app:sdr_fieldWidth="@dimen/settings_dropdown_compact_width"
        app:sdr_title="@string/player_subtitle_language" />

    <!-- Audio track (S0567: raw Spinner -> SettingsDropdownRow; the row owns its title). -->
    <com.sza.fastmediasorter.ui.common.widget.SettingsDropdownRow
        android:id="@+id/spinnerAudioLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        app:sdr_inline="true"
        app:sdr_fieldWidth="@dimen/settings_dropdown_compact_width"
        app:sdr_title="@string/player_audio_track" />

    <!-- 3D Video Section - mirrors portrait layout; must stay in sync with layout/dialog_player_settings.xml -->
    <TextView
        android:id="@+id/tv3DVideoLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/playback_settings_3d_tab"
        android:textSize="@dimen/resource_card_title_text_size"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_tiny" />

    <RadioGroup
        android:id="@+id/radioGroup3D"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_tiny">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio3DAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_settings_3d_auto"
            android:checked="true" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio3DSbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_settings_3d_sbs" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio3DOU"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_settings_3d_ou"
            android:enabled="false" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio3DMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_settings_3d_mono" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/playback_settings_3d_hint"
        android:textSize="@dimen/toggler_desc_text_size"
        android:textColor="@color/text_color_secondary"
        android:layout_marginBottom="@dimen/margin_small" />

</LinearLayout>
</ScrollView>
