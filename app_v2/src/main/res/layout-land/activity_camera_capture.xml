<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_capture_surface"
    android:keepScreenOn="true"
    tools:context=".ui.cameracapture.CameraCaptureActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <com.sza.fastmediasorter.ui.cameracapture.FocusRingOverlayView
        android:id="@+id/focusRingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="@id/previewViewCamera"
        app:layout_constraintEnd_toEndOf="@id/previewViewCamera"
        app:layout_constraintStart_toStartOf="@id/previewViewCamera"
        app:layout_constraintTop_toTopOf="@id/previewViewCamera" />

    <LinearLayout
        android:id="@+id/cameraTopBar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCamera"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/close"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_cancel"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleCameraMicrophone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/camera_capture_microphone"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_capture_microphone"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_microphone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraFlash"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/camera_control_flash"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_flash"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_camera_flash_off"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraMore"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/camera_control_more"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_more"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:icon="@drawable/ic_more_vert"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cameraZoomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cameraModeSwitchGroup"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cameraZoomPresetGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/camera_control_zoom"
            app:singleLine="true"
            app:singleSelection="true" />

        <com.google.android.material.slider.Slider
            android:id="@+id/cameraZoomSlider"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/camera_control_zoom"
            android:stepSize="0"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="1" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/cameraModeSwitchGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cameraActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModePhoto"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/camera_mode_photo"
            android:focusable="true"
            android:text="@string/camera_mode_photo"
            android:tooltipText="@string/camera_mode_photo"
            app:strokeColor="@color/camera_capture_control_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeVideo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/camera_mode_video"
            android:focusable="true"
            android:text="@string/camera_mode_video"
            android:tooltipText="@string/camera_mode_video"
            app:strokeColor="@color/camera_capture_control_stroke" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:id="@+id/cameraActionBar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapturePhoto"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cmd_camera_capture"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:tooltipText="@string/cmd_camera_capture"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_camera_capture"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="@color/camera_capture_shutter_icon" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraLensSwitch"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal|bottom"
            android:contentDescription="@string/camera_control_switch_lens"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tooltipText="@string/camera_control_switch_lens"
            android:visibility="gone"
            app:backgroundTint="@color/camera_capture_control_bg"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_camera_switch"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@color/camera_capture_control_stroke"
            tools:visibility="visible" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
