<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: buttons + title at top; rvColorPalette in NestedScrollView to prevent clipping -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_large">

    <!-- Title and buttons always visible at top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_color"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.FastMediaSorter.Button.DialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOk"
            style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:layout_marginStart="@dimen/dialog_action_button_gap" />

    </LinearLayout>

    <!-- Color preview row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/current_color"
            android:textSize="@dimen/resource_card_desc_text_size" />

        <View
            android:id="@+id/colorPreview"
            android:layout_width="@dimen/dialog_color_item_size"
            android:layout_height="@dimen/dialog_color_item_size"
            android:background="@color/success_color" />

        <TextView
            android:id="@+id/tvColorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_field_spacing"
            android:text="@string/dialog_color_picker_tvColorName_text"
            android:textSize="@dimen/resource_card_desc_text_size" />

    </LinearLayout>

    <!-- Color grid capped to avoid clipping in landscape -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/dialog_landscape_list_max_height">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColorPalette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
