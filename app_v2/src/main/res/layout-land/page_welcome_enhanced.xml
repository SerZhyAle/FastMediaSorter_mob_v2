<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced welcome page, landscape: hero icon on the left; the right column scrolls and holds
     title, short summary, the optional language picker, the adaptive feature-block grid
     (column count from @integer/welcome_feature_grid_columns), and the details block.
     All ids must stay in sync with the portrait variant (layout/page_welcome_enhanced.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/welcome_page_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_max="@dimen/welcome_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Hero icon on the left, vertically centred -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/welcome_icon_size"
            android:layout_height="@dimen/welcome_icon_size"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Right column: scrollable (title + summary + language picker + feature grid + details) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/margin_large"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivIcon"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_title_text_size"
                    android:textStyle="bold"
                    tools:text="Powerful Extras" />

                <!-- Short summary -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:gravity="start"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_description_text_size"
                    android:lineSpacingMultiplier="1.3"
                    android:alpha="0.85"
                    tools:text="Go beyond simple media viewing." />

                <!-- Language: visible only on the first Welcome page. S1190 replaced the three-position
                     switch - the interface language set is data now and no longer fits a fixed strip, so
                     this control shows the current language and opens the searchable picker. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWelcomeLanguage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone"
                    android:contentDescription="@string/welcome_language_picker_hint"
                    tools:text="English" />

                <!-- Theme picker: visible only on the first Welcome page. Mirrors the language picker
                     (styling, focusability) and recreates the activity immediately after a selection
                     so the current welcome page redraws in the chosen app theme. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/layoutThemePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:visibility="gone"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeAuto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/welcome_theme_auto"
                        android:contentDescription="@string/welcome_theme_picker_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLight"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/welcome_theme_light"
                        android:contentDescription="@string/welcome_theme_picker_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeDark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/welcome_theme_dark"
                        android:contentDescription="@string/welcome_theme_picker_hint" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Caption: selection applies immediately to the current welcome flow. -->
                <TextView
                    android:id="@+id/tvThemeAppliesHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:visibility="gone"
                    android:text="@string/welcome_theme_applies_after_setup" />

                <!-- S0404 / S1104: launcher-mode toggle - gone by default; shown only on the first page in
                     builds that ship the launcher surface (WelcomePage.showLauncherModeToggle). Canonical
                     SettingsToggleRow (switch-left "Trigger Row") so it matches every other app toggle, incl.
                     the capability rows on the functionality page. -->
                <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                    android:id="@+id/rowWelcomeLauncherMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:visibility="gone"
                    app:str_icon="@drawable/ic_launcher_mode"
                    app:str_title="@string/launcher_welcome_toggle_title" />

                <!-- Adaptive feature-block grid (populated programmatically; columnCount set at runtime) -->
                <GridLayout
                    android:id="@+id/gridFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:columnCount="2"
                    android:useDefaultMargins="false" />

                <!-- Multi-paragraph details -->
                <TextView
                    android:id="@+id/tvDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:gravity="start|top"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_description_text_size"
                    android:lineSpacingMultiplier="1.3"
                    tools:text="A longer, multi-paragraph explanation of the extra capabilities." />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
