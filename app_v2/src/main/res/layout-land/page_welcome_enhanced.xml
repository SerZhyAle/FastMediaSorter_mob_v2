<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced welcome page, landscape: hero icon on the left; the right column scrolls and holds
     title, short summary, the optional language picker, the adaptive feature-block grid
     (column count from @integer/welcome_feature_grid_columns), and the details block.
     All ids must stay in sync with the portrait variant (layout/page_welcome_enhanced.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/welcome_page_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_max="@dimen/welcome_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Hero icon on the left, vertically centred -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/welcome_icon_size"
            android:layout_height="@dimen/welcome_icon_size"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Right column: scrollable (title + summary + language picker + feature grid + details) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/margin_large"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivIcon"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_title_text_size"
                    android:textStyle="bold"
                    tools:text="Powerful Extras" />

                <!-- Short summary -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:gravity="start"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_description_text_size"
                    android:lineSpacingMultiplier="1.3"
                    android:alpha="0.85"
                    tools:text="Go beyond simple media viewing." />

                <!-- Language picker: visible only on the first Welcome page -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/layoutLanguagePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:visibility="gone"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangEn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="English"
                        android:contentDescription="@string/welcome_language_picker_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangRu"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Русский"
                        android:contentDescription="@string/welcome_language_picker_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangUk"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Українська"
                        android:contentDescription="@string/welcome_language_picker_hint" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Profile selector: visible only on the first Welcome page -->
                <LinearLayout
                    android:id="@+id/layoutProfileSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvProfileSelectorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="@string/welcome_profile_selector_title" />

                    <!-- Pressable card showing the current/recommended profile; opens the shared
                         tile picker (DeviceProfilePickerDialogFragment) on click. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSelectedProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:rippleColor="?attr/colorControlHighlight"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:id="@+id/ivSelectedProfileIcon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorPrimary"
                                tools:src="@drawable/ic_profile_home_tablet" />

                            <TextView
                                android:id="@+id/tvSelectedProfileTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                tools:text="Tablet &amp; desktop mode (Recommended)" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvProfileDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:alpha="0.8"
                        android:maxWidth="360dp"
                        tools:text="Best for personal smartphones. Touch-first UI, standard security settings." />

                </LinearLayout>

                <!-- Adaptive feature-block grid (populated programmatically; columnCount set at runtime) -->
                <GridLayout
                    android:id="@+id/gridFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:columnCount="2"
                    android:useDefaultMargins="false" />

                <!-- Multi-paragraph details -->
                <TextView
                    android:id="@+id/tvDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/welcome_description_margin_top"
                    android:gravity="start|top"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/welcome_description_text_size"
                    android:lineSpacingMultiplier="1.3"
                    tools:text="A longer, multi-paragraph explanation of the extra capabilities." />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
