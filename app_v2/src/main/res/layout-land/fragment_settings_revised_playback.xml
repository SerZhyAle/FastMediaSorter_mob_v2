<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mirror the same hosted playback group order in landscape so search/focus routing does
         not drift between orientations before Browse starts exposing the revised host. -->
    <FrameLayout
        android:id="@+id/revisedPlaybackContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>