<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape variant: horizontal section strip on top + content below (master-detail pivot,
     S0638). The strip scrolls horizontally when sections overflow the width; the content sits in a
     height-bounded MaxHeightLinearLayout so it scrolls instead of pushing the dialog off-screen.
     All IDs match the portrait layout so ViewBinding (generated from layout/) works without changes.
     VerticalSeekBar auto-detects landscape and renders as a standard horizontal SeekBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Title row with inline Done button - same as portrait -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvPlaybackControlTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/control"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePlaybackControl"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:text="@string/playback_control_done" />
    </LinearLayout>

    <!-- Section strip: horizontal toggle group, scrolls horizontally when sections overflow -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupPlaybackSections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionVolume"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_control_tab_volume"
                android:textAllCaps="false"
                app:icon="@drawable/ic_volume_up"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionAudio"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_control_tab_audio"
                android:textAllCaps="false"
                app:icon="@drawable/ic_audio_track"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionSubtitles"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_control_tab_subtitles"
                android:textAllCaps="false"
                app:icon="@drawable/ic_closed_caption"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionStereo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_settings_3d_tab"
                android:textAllCaps="false"
                app:icon="@drawable/ic_stereo_3d"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionHue"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_control_tab_hue"
                android:textAllCaps="false"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionBrightness"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_control_tab_brightness"
                android:textAllCaps="false"
                app:icon="@drawable/ic_night_mode"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionSpeed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/playback_control_tab_speed"
                android:textAllCaps="false"
                app:icon="@drawable/ic_speed"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Content area - VerticalSeekBar renders horizontally in landscape -->
    <com.sza.fastmediasorter.ui.common.widget.MaxHeightLinearLayout
        android:id="@+id/playbackResizableArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Volume section -->
                <LinearLayout
                    android:id="@+id/sectionVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVolumeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <!-- VerticalSeekBar behaves as standard horizontal SeekBar in landscape -->
                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekVolume"
                        style="@style/Widget.FMS.PlaybackSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMuteToggle"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:minHeight="56dp"
                            android:text="@string/playback_control_mute"
                            app:strokeColor="@color/btn_mute_toggle_state"
                            app:strokeWidth="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVolumeHalf"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/volume_50_percent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVolumeMax"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/volume_max" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Audio tracks section -->
                <LinearLayout
                    android:id="@+id/sectionAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAudioEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/playback_control_no_audio_tracks"
                        android:visibility="gone" />

                    <RadioGroup
                        android:id="@+id/groupAudioTracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Subtitles section -->
                <LinearLayout
                    android:id="@+id/sectionSubtitles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSubtitleEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/playback_control_no_subtitles"
                        android:visibility="gone" />

                    <RadioGroup
                        android:id="@+id/groupSubtitleTracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 3D / Stereo section - landscape: two-column layout (Flat | Spherical) for compact height -->
                <LinearLayout
                    android:id="@+id/sectionStereo3d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Detected mode label - compact, shown only when not AUTO -->
                    <TextView
                        android:id="@+id/tvStereoDetected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- B2: canonical toggle row (S0536) - the override switch as a SettingsToggleRow. -->
                    <com.sza.fastmediasorter.ui.common.widget.SettingsToggleRow
                        android:id="@+id/switchVrOverrideFormatType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        app:str_title="@string/playback_settings_3d_override_format_type" />

                    <!-- Two columns: Flat (left) | Spherical (right) - halves the vertical footprint -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Flat format column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/tvStereoFlatLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/playback_settings_3d_flat_format"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <RadioGroup
                                android:id="@+id/radioGroup3D"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DAuto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_auto" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DSbs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_sbs" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DOU"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_ou" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio3DMono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_mono" />
                            </RadioGroup>
                        </LinearLayout>

                        <!-- Thin vertical divider between columns -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Spherical format column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:id="@+id/tvStereoSphericalLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/playback_settings_3d_spherical_format"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <RadioGroup
                                android:id="@+id/radioGroupSpherical3D"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Auto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_auto" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Mono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_360_mono" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Sbs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_360_sbs" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radio360Ou"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_360_ou" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radioVr180"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_vr180" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/radioCylinder180"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="true"
                                    android:focusableInTouchMode="false"
                                    android:minHeight="36dp"
                                    android:text="@string/playback_settings_3d_cylinder_180" />
                            </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Compact hint below both columns -->
                    <TextView
                        android:id="@+id/tvStereoHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="11sp"
                        android:text="@string/playback_settings_3d_hint"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- HUE section -->
                <LinearLayout
                    android:id="@+id/sectionHue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHueValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekHue"
                        style="@style/Widget.FMS.PlaybackSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="360" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetHue"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="@string/reset" />
                </LinearLayout>

                <!-- Brightness / Light section -->
                <LinearLayout
                    android:id="@+id/sectionBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvBrightnessValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekBrightness"
                        style="@style/Widget.FMS.PlaybackSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="100" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetBrightness"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="@string/reset" />
                </LinearLayout>

                <!-- Speed section -->
                <LinearLayout
                    android:id="@+id/sectionSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textStyle="bold" />

                    <com.sza.fastmediasorter.ui.player.VerticalSeekBar
                        android:id="@+id/seekSpeed"
                        style="@style/Widget.FMS.PlaybackSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:max="7" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeed05"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/playback_control_speed_0_5x" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeed15"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/playback_control_speed_1_5x" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeed20"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="@string/playback_control_speed_2x" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetSpeed"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="@string/reset" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.sza.fastmediasorter.ui.common.widget.MaxHeightLinearLayout>

</LinearLayout>
