<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape variant of the panel internal-route picker (S0663). Same card structure as portrait
     with tighter vertical padding for short landscape screens. The list (<=9 items) scrolls in-card. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoutePickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvRoutePickerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="@string/app_launch_panel_picker_feature_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRouteItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_app_picker_row"
            tools:itemCount="6" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
