<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.browse.BrowseActivity">

    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/control_bar_padding"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size"
            android:text="@string/back"
            android:textColor="?attr/colorControlNormal"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="?attr/colorControlNormal" />

        <!-- Breadcrumb path (visible during subfolder navigation) -->
        <com.sza.fastmediasorter.ui.common.BreadcrumbView
            android:id="@+id/breadcrumbView"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_button_size"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Small space after Back (only visible when breadcrumb is hidden) -->
        <Space
            android:id="@+id/spaceAfterBack"
            android:layout_width="@dimen/control_button_spacing_small"
            android:layout_height="1dp" />

        <!-- Sort Button (shows current mode, popup menu on click) -->
        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size"
            android:minWidth="80dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textSize="12sp"
            android:textColor="?attr/colorControlNormal"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawableTint="?attr/colorControlNormal"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Date ↓" />

        <!-- Filter (with badge) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/search"
                android:textColor="?attr/colorControlNormal"
                app:icon="@android:drawable/ic_menu_search"
                app:iconTint="?attr/colorControlNormal" />
            
            <TextView
                android:id="@+id/tvFilterBadge"
                android:layout_width="@dimen/browse_filter_badge_size"
                android:layout_height="@dimen/browse_filter_badge_size"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/margin_tiny"
                android:layout_marginEnd="@dimen/margin_tiny"
                android:background="@drawable/badge_filter_background"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/browse_filter_badge_text_size"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Refresh -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size"
            android:text="@string/refresh"
            android:textColor="?attr/colorControlNormal"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconTint="?attr/colorControlNormal" />

        <!-- Grid/List toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleView"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size"
            android:text="@string/toggle_view_short"
            android:textColor="?attr/colorControlNormal"
            app:icon="@android:drawable/ic_menu_view"
            app:iconTint="?attr/colorControlNormal" />

        <!-- Small space -->
        <Space
            android:layout_width="@dimen/control_button_spacing_small"
            android:layout_height="1dp" />

        <!-- Select All -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size"
            android:text="@string/select_all_short"
            android:textColor="?attr/colorControlNormal"
            app:icon="@drawable/ic_select_all"
            app:iconTint="?attr/colorControlNormal" />

        <!-- Deselect All (No text requested, keeping as icon but MaterialButton for consistency) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeselectAll"
            style="?attr/materialIconButtonStyle"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:contentDescription="@string/deselect_all"
            app:icon="@drawable/ic_deselect_all"
            app:iconTint="?attr/colorControlNormal" />

        <!-- Small space -->
        <Space
            android:layout_width="@dimen/control_button_spacing_small"
            android:layout_height="1dp" />

        <!-- Play/Slideshow -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlay"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_button_size"
            android:text="@string/slideshow"
            android:textColor="?attr/colorControlNormal"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="?attr/colorControlNormal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutResourceInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/padding_small"
        android:paddingEnd="@dimen/padding_small"
        app:layout_constraintTop_toBottomOf="@id/layoutControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnResourceAction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="@string/edit"
            android:src="@drawable/ic_edit_20"
            app:tint="?attr/colorControlNormal"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvResourceInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            android:textSize="@dimen/text_size_small"
            android:textColor="?android:textColorSecondary"
            android:gravity="center_vertical"
            tools:text="Downloads • /storage/emulated/0/Download • 0 selected" />

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutResourceInfo"
        app:layout_constraintBottom_toTopOf="@id/layoutOperations"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMediaFiles"
            android:scrollbars="vertical"
            android:scrollbarFadeDuration="0"
            android:fadeScrollbars="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_media_file" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Scroll to Top button -->
    <ImageButton
        android:id="@+id/fabScrollToTop"
        android:layout_width="@dimen/browse_scroll_button_size"
        android:layout_height="@dimen/browse_scroll_button_size"
        android:layout_marginEnd="@dimen/browse_scroll_button_margin"
        android:layout_marginTop="@dimen/margin_small"
        android:background="@drawable/bg_scroll_button"
        android:contentDescription="@string/scroll_to_top"
        android:padding="@dimen/browse_scroll_button_padding"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:src="@drawable/ic_arrow_upward"
        android:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll to Bottom button -->
    <ImageButton
        android:id="@+id/fabScrollToBottom"
        android:layout_width="@dimen/browse_scroll_button_size"
        android:layout_height="@dimen/browse_scroll_button_size"
        android:layout_marginEnd="@dimen/browse_scroll_button_margin"
        android:layout_marginBottom="@dimen/margin_small"
        android:background="@drawable/bg_scroll_button"
        android:contentDescription="@string/scroll_to_bottom"
        android:padding="@dimen/browse_scroll_button_padding"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:src="@drawable/ic_arrow_downward"
        android:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Operations bar at bottom -->
    <LinearLayout
        android:id="@+id/layoutOperations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/control_bar_padding"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elevation_operations_bar"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/tvFilterWarning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Copy -->
        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy"
            android:src="@android:drawable/ic_menu_save"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

        <!-- Move -->
        <ImageButton
            android:id="@+id/btnMove"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/move"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

        <!-- Rename -->
        <ImageButton
            android:id="@+id/btnRename"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rename"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

        <!-- Delete -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

        <!-- Undo -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/undo"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

        <!-- Share -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvFilterWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/filter_warning_bg"
        android:padding="@dimen/padding_small"
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/filter_warning_text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="⚠ Filter active: name contains 'photo', created after 01.01.2024"
        tools:visibility="visible" />

    <!-- Empty state (no files found) -->
    <LinearLayout
        android:id="@+id/emptyStateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/empty_state_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/empty_state_icon_size"
            android:layout_height="@dimen/empty_state_icon_size"
            android:src="@drawable/ic_folder_open_24"
            android:contentDescription="@string/empty_folder"
            android:tint="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvEmptyStateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_state_text_margin_top"
            android:text="@string/no_files_found"
            android:textSize="@dimen/empty_state_text_size"
            android:textAlignment="center"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvEmptyStateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/empty_folder_hint"
            android:textSize="14sp"
            android:textAlignment="center"
            android:gravity="center"
            android:textColor="?android:attr/textColorTertiary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Error state view for network errors -->
    <LinearLayout
        android:id="@+id/errorStateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/empty_state_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/empty_state_icon_size"
            android:layout_height="@dimen/empty_state_icon_size"
            android:src="@android:drawable/stat_notify_error"
            android:contentDescription="@string/error"
            android:tint="@android:color/holo_red_dark" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_state_text_margin_top"
            android:text="@string/connection_failed"
            android:textSize="@dimen/empty_state_text_size"
            android:textAlignment="center"
            android:gravity="center"
            android:textColor="@android:color/holo_red_dark" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_margin_top_normal"
            android:text="@string/retry"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

    <!-- Progress layout with STOP button -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="@dimen/browse_progress_bar_size"
            android:layout_height="@dimen/browse_progress_bar_size"
            android:contentDescription="@string/loading_indicator" />

        <TextView
            android:id="@+id/tvProgressMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/browse_progress_text_margin_start"
            android:textSize="@dimen/empty_state_text_size"
            android:textColor="?android:textColorPrimary"
            android:maxLines="1"
            android:maxWidth="@dimen/browse_progress_max_width"
            tools:text="Loading (12345)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/browse_stop_button_margin_start"
            android:text="@string/stop"
            android:visibility="gone"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
