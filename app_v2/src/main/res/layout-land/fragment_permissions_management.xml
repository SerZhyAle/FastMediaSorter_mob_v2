<?xml version="1.0" encoding="utf-8"?>
<!-- Permissions management screen, landscape (Rule 11 counterpart of layout/fragment_permissions_management.xml).
     Same ids and view types as the portrait variant; the two action buttons sit side by side (split by a
     centre guideline so the layout stays correct when btn_grant_all is GONE), a divider marks where the
     pinned area ends, and the list fills the remaining area.
     All ids must stay in sync with the portrait variant. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnPrimary" />

    <!-- S2178: declared before the buttons so it draws behind them. Makes the pinned zone a visibly
         different plane from the list; a 1dp divider alone was invisible on the dark theme and the
         clipped first row still read as damage. -->
    <View
        android:id="@+id/bg_permissions_actions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@id/divider_permissions_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Centre split so the action buttons share the width; robust when btn_grant_all is GONE. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_actions_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_grant_all"
        style="@style/Widget.FastMediaSorter.Button.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/perm_btn_grant_all"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/guideline_actions_center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_system_settings"
        style="@style/Widget.FastMediaSorter.Button.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:text="@string/perm_btn_open_system_settings"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_actions_center"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- S2178: the list's top edge used to sit flush against the action buttons on the same background,
         so a half-scrolled row read as erased rather than as scrolled under the pinned area.
         Anchored to btn_open_system_settings for the reason the list used to be: both buttons share the
         toolbar baseline, and that one is always visible. -->
    <View
        android:id="@+id/divider_permissions_actions"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_divider_height"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_open_system_settings" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_permissions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_permissions_actions" />

</androidx.constraintlayout.widget.ConstraintLayout>
