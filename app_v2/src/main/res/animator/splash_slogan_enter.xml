<?xml version="1.0" encoding="utf-8"?>
<!--
    S1706: the slogan lands last, rising to its resting position. Offset plus duration is
    500 ms, inside the 700 ms declared by windowSplashScreenAnimationDuration.
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="translateY"
    android:valueFrom="9.0"
    android:valueTo="0.0"
    android:valueType="floatType"
    android:startOffset="140"
    android:duration="360"
    android:interpolator="@android:interpolator/decelerate_quint" />
