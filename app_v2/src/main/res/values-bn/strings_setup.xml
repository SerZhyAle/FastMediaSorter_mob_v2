    <string name="welcome_default_player_description">FastMediaSorter-কে ডিফল্ট মিডিয়া প্লেয়ার করুন</string>
    <string name="welcome_default_player_hint">নিচের কোনো বোতামে ট্যাপ করুন - একটি ডায়ালগ আসবে। FastMediaSorter বেছে নিয়ে <b>সবসময়</b>-এ ট্যাপ করুন।</string>
    <string name="welcome_default_player_title">ডিফল্ট প্লেয়ার</string>
    <string name="welcome_description_1">আপনার সবকিছু এক জায়গায় রাখা মিডিয়া ব্যবস্থাপক।\nলোকাল, নেটওয়ার্ক ও ক্লাউড স্টোরেজের ফাইল ব্রাউজ করুন, সাজান ও পরিচালনা করুন - সবই সহজ স্পর্শ অঙ্গভঙ্গিতে।</string>
    <string name="welcome_description_1_details">FastMediaSorter সব ধরনের মিডিয়া এক জায়গায় নিয়ে আসে। আপনার ডিভাইস থেকে, নেটওয়ার্ক শেয়ার থেকে বা ক্লাউড স্টোরেজ থেকে ছবি, ভিডিও, GIF ও গান খুলুন - এবং দীর্ঘক্ষণ চেপে ধরা মেনুর বদলে দ্রুত ট্যাপে সেগুলো সাজান।\n\nএখানে যা কিছু ঠিক করবেন তা পরে সেটিংসে বদলানো যাবে, তাই এই পর্দায় ভুল পছন্দ বলে কিছু নেই - এগোতে শুধু পরবর্তী চাপুন।</string>
    <string name="welcome_description_3" formatted="false">প্লেয়ার দ্রুত অ্যাকশনের জন্য 9টি টাচ জোন (3×3 গ্রিড) ব্যবহার করে। নেভিগেট করতে, ফাইল কপি/মুভ/ডিলিট করতে, বা কমান্ড প্যানেল অ্যাক্সেস করতে জোনে ট্যাপ করুন। বিস্তারিত জানতে উপরের স্কিমটি দেখুন।</string>
    <string name="welcome_language_picker_hint">অ্যাপের ভাষা বেছে নিন</string>
    <string name="welcome_profile_audio_player_desc">শুধু অডিও ডিভাইস বা MP3 প্লেয়ারের জন্য সবচেয়ে উপযুক্ত। ছবি ও ভিডিও লুকায়; পটভূমির অডিও ও এখন বাজছে পর্দা উন্নত করে।</string>
    <string name="welcome_profile_audio_player_title">অডিও প্লেয়ার</string>
    <string name="welcome_profile_car_head_unit_desc">Android গাড়ির স্টিরিওর জন্য সবচেয়ে উপযুক্ত। অতিরিক্ত বড় বোতাম ব্যবহার করে, পর্দা চালু রাখে এবং ফাইলের কাজের চেয়ে মিডিয়া চালানোকে অগ্রাধিকার দেয়।</string>
    <string name="welcome_profile_car_head_unit_title">গাড়ির হেড ইউনিট</string>
    <string name="welcome_profile_ebook_reader_desc">ই-রিডার বা নথি ট্যাবলেটের জন্য সবচেয়ে উপযুক্ত। ভিডিও ও গান লুকায়; PDF, EPUB ও লেখা পড়ার সেটিংস উন্নত করে।</string>
    <string name="welcome_profile_ebook_reader_title">ই-বুক রিডার</string>
    <string name="welcome_profile_home_tablet_desc">ট্যাবলেট, Chromebook ও Samsung DeX-এর জন্য সবচেয়ে উপযুক্ত। গ্রিড বিন্যাস উন্নত করে, বড় থাম্বনেইল চালু করে এবং একাধিক উইন্ডোতে ব্রাউজ করতে দেয়।</string>
    <string name="welcome_profile_home_tablet_title">ট্যাবলেট ও ডেস্কটপ মোড</string>
    <string name="welcome_profile_media_player_desc">নিবেদিত মিডিয়া বক্সের জন্য সবচেয়ে উপযুক্ত। স্বয়ংক্রিয় স্লাইডশো ও আবার শুরু করার সুবিধা নিয়ে পুরোপুরি ছবি, ভিডিও ও গানে মনোযোগ দেয়।</string>
    <string name="welcome_profile_media_player_title">মিডিয়া প্লেয়ার</string>
    <string name="welcome_profile_other_desc">সিস্টেমের ডিফল্ট সেটিংস অপরিবর্তিত রাখে। কোনো প্রিসেট নিজে থেকে প্রয়োগ হবে না।</string>
    <string name="welcome_profile_other_title">অন্যান্য / নিজস্ব</string>
    <string name="welcome_profile_personal_smartphone_desc">ব্যক্তিগত ফোনের জন্য সবচেয়ে উপযুক্ত। স্পর্শ বিন্যাস উন্নত করে, পটভূমিতে সিঙ্ক চালু করে এবং ডিফল্ট নিরাপত্তা নিশ্চিতকরণ বজায় রাখে।</string>
    <string name="welcome_profile_personal_smartphone_title">ব্যক্তিগত স্মার্টফোন</string>
    <string name="welcome_profile_photo_frame_desc">ডিভাইসটিকে ডিজিটাল ফটো ফ্রেমে পরিণত করে। ভিডিও, অডিও ও ফাইলের কাজ বন্ধ করে; চালু হওয়ামাত্র স্লাইডশো খোলে।</string>
    <string name="welcome_profile_photo_frame_title">ফটো ফ্রেম</string>
    <string name="welcome_profile_selector_title">ডিভাইস ব্যবহারের ধরন</string>
    <string name="welcome_profile_tv_media_box_desc">টিভি ও মিডিয়া সেন্টারের জন্য সবচেয়ে উপযুক্ত। ডি-প্যাড/রিমোট চলাচল উন্নত করে, বড় বোতাম ব্যবহার করে এবং ছোট স্পর্শ নিয়ন্ত্রণ লুকায়।</string>
    <string name="welcome_profile_tv_media_box_title">টিভি / মিডিয়া বক্স</string>
    <string name="welcome_profile_video_player_desc">শুধু ভিডিও ডিভাইসের জন্য সবচেয়ে উপযুক্ত। ছবি, গান ও নথি দর্শক লুকায়; দ্রুত ভিডিও চালানো ও থাম্বনেইলকে অগ্রাধিকার দেয়।</string>
    <string name="welcome_profile_video_player_title">ভিডিও প্লেয়ার</string>
    <string name="welcome_profile_vr_headset_desc">ভার্চুয়াল রিয়েলিটি ডিভাইসের জন্য সেরা। সমর্থিত হার্ডওয়্যার ফ্লেভারে 3D/360° লেআউট এবং ইমার্সিভ কন্ট্রোল আগে থেকেই সক্রিয় করে।</string>
