<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FastMediaSorter" parent="Theme.FastMediaSorter.Base">
        <item name="android:windowSplashScreenBackground">#F5F5F5</item>
        <!-- S0997: center = app logo + wordmark fading in; author logo moved to the branding slot. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_splash_branding</item>
    </style>

    <!-- S0134: Material You widget theme - adapts to launcher dynamic colors on Android 12+. -->
    <style name="Widget.FastMediaSorter" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_50</item>
    </style>
</resources>
