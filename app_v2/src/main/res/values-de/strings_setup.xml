    <string name="welcome_default_player_description">FastMediaSorter als Standard-Medienplayer festlegen</string>
    <string name="welcome_default_player_hint">Tippen Sie unten auf eine Schaltfläche - ein Dialog erscheint. Wählen Sie FastMediaSorter und tippen Sie auf <b>Immer</b>.</string>
    <string name="welcome_default_player_title">Standard-Player</string>
    <string name="welcome_description_1">Ihr Medienmanager für alles.\nDurchsuchen, sortieren und verwalten Sie Dateien auf lokalem, Netzwerk- und Cloud-Speicher - alles mit intuitiven Touch-Gesten.</string>
    <string name="welcome_description_1_details">FastMediaSorter bringt jede Art von Medien an einen Ort. Öffnen Sie Fotos, Videos, GIFs und Musik von Ihrem Gerät, von einer Netzwerkfreigabe oder aus dem Cloud-Speicher - und sortieren Sie sie mit kurzen Tipps statt mit Menüs beim langen Drücken.\n\nAlles, was Sie hier einrichten, lässt sich später in den Einstellungen ändern. Auf diesem Bildschirm gibt es also keine falsche Wahl - tippen Sie einfach auf Weiter.</string>
    <string name="welcome_description_3" formatted="false">Der Player nutzt 9 Berührungszonen (3×3-Raster) für schnelle Aktionen. Tippen Sie auf Zonen, um zu navigieren, Dateien zu kopieren, zu verschieben, zu löschen oder das Befehlsfeld zu öffnen. Details zeigt das Schema oben.</string>
    <string name="welcome_language_picker_hint">App-Sprache wählen</string>
    <string name="welcome_profile_audio_player_desc">Ideal für reine Audiogeräte oder MP3-Player. Blendet Fotos und Videos aus, optimiert Hintergrundwiedergabe und Wiedergabeanzeige.</string>
    <string name="welcome_profile_audio_player_title">Audioplayer</string>
    <string name="welcome_profile_car_head_unit_desc">Ideal für Android-Autoradios. Nutzt besonders große Schaltflächen, hält den Bildschirm an und stellt die Medienwiedergabe über Dateioperationen.</string>
    <string name="welcome_profile_car_head_unit_title">Autoradio</string>
    <string name="welcome_profile_ebook_reader_desc">Ideal für E-Reader oder Dokumenten-Tablets. Blendet Videos und Musik aus, optimiert die Einstellungen für PDF, EPUB und Text.</string>
    <string name="welcome_profile_ebook_reader_title">E-Book-Reader</string>
    <string name="welcome_profile_home_tablet_desc">Ideal für Tablets, Chromebooks und Samsung DeX. Optimiert das Raster, aktiviert große Vorschaubilder und erlaubt das Blättern im Mehrfenstermodus.</string>
    <string name="welcome_profile_home_tablet_title">Tablet- &amp; Desktop-Modus</string>
    <string name="welcome_profile_media_player_desc">Ideal für dedizierte Medienboxen. Konzentriert sich ganz auf Fotos, Videos und Musik, mit automatischer Diashow und Fortsetzen-Funktion.</string>
    <string name="welcome_profile_media_player_title">Medienplayer</string>
    <string name="welcome_profile_other_desc">Behält die Standardeinstellungen des Systems bei. Es werden keine Voreinstellungen automatisch angewendet.</string>
    <string name="welcome_profile_other_title">Sonstiges / Benutzerdefiniert</string>
    <string name="welcome_profile_personal_smartphone_desc">Ideal für private Telefone. Optimiert die Touch-Anordnung, aktiviert die Synchronisierung im Hintergrund und behält die Sicherheitsabfragen bei.</string>
    <string name="welcome_profile_personal_smartphone_title">Privates Smartphone</string>
    <string name="welcome_profile_photo_frame_desc">Macht aus dem Gerät einen digitalen Bilderrahmen. Deaktiviert Video, Audio und Dateioperationen und startet die Diashow sofort.</string>
    <string name="welcome_profile_photo_frame_title">Bilderrahmen</string>
    <string name="welcome_profile_selector_title">Nutzungsprofil des Geräts</string>
    <string name="welcome_profile_tv_media_box_desc">Ideal für Fernseher und Media-Center. Optimiert die Navigation per Steuerkreuz und Fernbedienung, nutzt große Schaltflächen und blendet winzige Touch-Elemente aus.</string>
    <string name="welcome_profile_tv_media_box_title">TV / Media-Box</string>
    <string name="welcome_profile_video_player_desc">Ideal für reine Videogeräte. Blendet Fotos, Musik und Dokumentenansicht aus, bevorzugt schnelle Wiedergabe und Vorschaubilder.</string>
    <string name="welcome_profile_video_player_title">Videoplayer</string>
    <string name="welcome_profile_vr_headset_desc">Ideal für Virtual-Reality-Geräte. Aktiviert vorab 3D-/360°-Ansichten und immersive Steuerung auf unterstützter Hardware.</string>
    <string name="welcome_profile_vr_headset_title">VR-Headset</string>
    <string name="welcome_recommended_badge">(Empfohlen)</string>
    <string name="welcome_title_1">Willkommen bei FastMediaSorter!</string>
