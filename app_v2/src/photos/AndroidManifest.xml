<?xml version="1.0" encoding="utf-8"?>
<!--
    Photos flavor manifest overlay.
    Removes the RandomMusicWidget which requires SUPPORT_AUDIO (not available in photos flavor).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      S0423 release scope: S0418 screencapture (overlay + MediaProjection FGS) stays noLegal-only for
      now; its SPECIAL_USE / SYSTEM_ALERT_WINDOW declarations are a Google Play review risk and are
      not declared in this store flavor (the src/screenCapture* source sets are not mounted here).
    -->

    <!-- S1442: photos reaches no microphone path at all - SUPPORT_MIC_RECORDING=false removes the
         voice-note surfaces and SUPPORT_VIDEO=false closes the camera video mode, the one place that
         would still request the mic. Dropped rather than left declared, per canon invariant 13.
         NOT mirrored into src/lite: SUPPORT_VIDEO is true there, so camera video legitimately records
         with audio and the permission is in use. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />

    <!-- S1454: same closure as the lite overlay. The only seam onto ContactsContract is
         ContactSnapshotDataSource, reached solely from src/launcherEnabled, which photos does not
         mount - so the permission was declared and could never be used here. Dropped rather than
         left declared, per canon invariant 13. -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        tools:node="remove" />

    <!-- S1442: the microphone opt-out in src/main exists only to cancel the implicit hardware
         requirement RECORD_AUDIO adds on Google Play. With the permission gone that requirement is
         gone too, so the opt-out is dead weight here (Rule 20). Removing a required="false" feature
         cannot narrow device reach - such a declaration never filtered anything. -->
    <uses-feature
        android:name="android.hardware.microphone"
        tools:node="remove" />

    <application>

        <!-- Remove Random Music Widget from photos flavor (no audio support) -->
        <receiver
            android:name=".widget.RandomMusicWidgetProvider"
            tools:node="remove" />

        <!-- Remove Camera OCR Translate Widget from photos flavor (no translation: ENABLE_TRANSLATION=false) -->
        <receiver
            android:name=".widget.CameraOcrTranslateWidgetProvider"
            tools:node="remove" />

        <!-- Remove Capture & OCR panel from photos flavor (no translation: ENABLE_TRANSLATION=false) -->
        <receiver
            android:name=".widget.CaptureOcrPanelWidgetProvider"
            tools:node="remove" />

        <!-- Remove Audio Now Playing widget from photos flavor (no audio support) -->
        <receiver
            android:name=".widget.AudioNowPlayingWidgetProvider"
            tools:node="remove" />

        <!-- Remove Stream launch widget from photos flavor (SUPPORT_STREAMS=false, S1916) -->
        <receiver
            android:name=".widget.StreamLaunchWidgetProvider"
            tools:node="remove" />
        <activity
            android:name=".widget.StreamLaunchWidgetConfigActivity"
            tools:node="remove" />

        <!-- Remove Quick Audio Recorder from photos flavor (SUPPORT_MIC_RECORDING=false, S0349) -->
        <receiver
            android:name=".widget.QuickAudioRecorderWidgetProvider"
            tools:node="remove" />
        <activity
            android:name=".widget.QuickAudioRecorderActivity"
            tools:node="remove" />
        <service
            android:name=".widget.QuickAudioRecorderService"
            tools:node="remove" />

        <!-- Remove Audio Quick Settings Tile from photos flavor (no audio support) -->
        <service
            android:name=".core.AudioToggleTileService"
            tools:node="remove" />

        <!-- Remove Dropbox Auth Activity: photos has no cloud support.
             Prevents multiple apps registering for db-<appKey>:// which triggers
             the Dropbox SDK security alert when two flavors are installed. -->
        <activity
            android:name="com.dropbox.core.android.AuthActivity"
            tools:node="remove" />

    </application>

</manifest>
