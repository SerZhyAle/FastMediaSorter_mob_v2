<?xml version="1.0" encoding="utf-8"?>
<!--
    S3431: the product mark on this edition's colour (ICON-RENDER 0.9 section 3 rule 9 - an edition may
    differ by colour or badge, never by dropping the mark). Qualified -v33 for the same reason as
    the main copy (S1507): below API 33 the v26 file stays free of the <monochrome> tag.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_edition_background" />
    <foreground android:drawable="@drawable/ic_launcher_edition_fore" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
