<?xml version="1.0" encoding="utf-8"?>
<!--
  noLegal flavor manifest overlay.

  History:
    S0174 originally set extractNativeLibs="true" here for Chaquopy 16.x. That entry was
    silently ignored because productFlavors.noLegal had manifest.srcFile("src/vr/...")
    set, which REPLACES the auto-detected flavor manifest. Chaquopy 17.x runs fine
    without the explicit flag - useLegacyPackaging=false in packaging.jniLibs is the
    modern default and Chaquopy adapts.

    S0183 added REQUEST_INSTALL_PACKAGES here. To make this file actually contribute to
    the merged manifest the build.gradle.kts androidComponents.onVariants block injects
    it via variant.sources.manifests.addStaticManifestFile().

  S0183: APK install from Browse - noLegal only; forbidden in market builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      S1614: the steps gadget's permission lives here, not in src/launcherEnabled, because Play
      classifies ACTIVITY_RECOGNITION as a health feature and blocks the release commit until the
      Health declaration is answered - a review surface the sideload flavor does not have. The
      gadget code stays shared; DeviceSensorAvailabilityRepositoryImpl reads the merged manifest
      and reports the capability absent wherever this permission is not declared.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
      S0559: the MediaProjection consent activity, the mediaProjection capture service, and the
      FOREGROUND_SERVICE_MEDIA_PROJECTION permission moved to src/screenCapture/AndroidManifest.xml
      (shared with the standard store flavor). This overlay file keeps only the noLegal-only
      overlay-strip host and the accessibility silent-capture service.
    -->
    <application>
        <service
            android:name="com.sza.fastmediasorter.screencapture.OverlayHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent edge overlay strip host for screenshot gesture trigger" />
        </service>

        <!--
          S0405: dialog-free capture path (API 30+). The accessibility service hosts the edge
          gesture strip (TYPE_ACCESSIBILITY_OVERLAY, no SYSTEM_ALERT_WINDOW) and takes silent
          screenshots. On API 26..29 the MediaProjection services above remain the fallback.
        -->
        <service
            android:name="com.sza.fastmediasorter.screencapture.ScreenshotAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screenshot_accessibility_service_config" />
        </service>

        <!-- S1881: Quick Settings Tile for noLegal -->
        <service
            android:name="com.sza.fastmediasorter.screencapture.NoLegalAccessibilityTileService"
            android:exported="true"
            android:icon="@drawable/ic_accessibility"
            android:label="@string/qs_tile_accessibility"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- S1881: Homescreen AppWidget for noLegal -->
        <receiver
            android:name="com.sza.fastmediasorter.widget.NoLegalAccessibilityWidgetProvider"
            android:exported="true"
            android:label="@string/qs_tile_accessibility">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sza.fastmediasorter.action.TOGGLE_ACCESSIBILITY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_accessibility_toggle_info" />
        </receiver>
    </application>

</manifest>
