<?xml version="1.0" encoding="utf-8"?>
<!--
    S3431: the skull badge as a single-alpha shape for the themed-icon layer. ic_skull_badge cannot be
    reused there: the launcher reads a monochrome layer as an alpha mask, and that badge draws its eyes,
    nose and teeth as opaque dark paint on an 80%-alpha backdrop, so as a mask it collapses into a plain
    disc. Here the features are holes (evenOdd), which survive the mask. Geometry follows ic_skull_badge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/white"
        android:fillType="evenOdd"
        android:pathData="M67,78 A18,18 0 1,0 103,78 A18,18 0 1,0 67,78 Z
                          M72,78 A5,6 0 1,0 82,78 A5,6 0 1,0 72,78 Z
                          M88,78 A5,6 0 1,0 98,78 A5,6 0 1,0 88,78 Z
                          M83,88 L85,93 L87,88 Z" />

    <path
        android:fillColor="@color/white"
        android:fillType="evenOdd"
        android:pathData="M70,97 L70,106 L100,106 L100,97 Z
                          M77,97 L77,106 L79,106 L79,97 Z
                          M84,97 L84,106 L86,106 L86,97 Z
                          M91,97 L91,106 L93,106 L93,97 Z" />

</vector>
