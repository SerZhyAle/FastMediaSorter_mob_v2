<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- S0404: launcher taskbar. Taller than the in-app panels' 48dp row because this bar is the
         permanent bottom chrome of the home screen and hosts 40dp app icons plus a tray. -->
    <dimen name="launcher_taskbar_height">56dp</dimen>
    <dimen name="launcher_taskbar_icon_size">40dp</dimen>
    <dimen name="launcher_taskbar_item_spacing">6dp</dimen>
    <dimen name="launcher_tray_icon_size">18dp</dimen>

    <!-- S1421: the freed system status band. Constant by owner ruling - the strip neither collapses nor
         resizes when its content changes, so its height cannot come from the content. Matched to the
         status bar it replaces (24dp) plus room for a chip's touch feedback. -->
    <dimen name="launcher_status_strip_height">28dp</dimen>

    <!-- S1421: one signal chip in that band. Below the 48dp touch-target minimum knowingly, for the same
         reason the gadget action buttons are: the band is 28dp tall by the ruling above, and a 48dp control
         cannot live inside it at all. The chip is the largest square the band holds with breathing room. -->
    <dimen name="launcher_signal_chip_size">24dp</dimen>
    <dimen name="launcher_signal_chip_padding">3dp</dimen>
    <dimen name="launcher_signal_chip_spacing">4dp</dimen>

    <!-- S0404: folder-preview thumbnail decode size. Glide decodes at display size, not source size -
         four full-resolution photos on the home screen would be a needless multi-MB decode. -->
    <dimen name="launcher_gadget_thumb_size">72dp</dimen>

    <!-- S0404: the play/random buttons in a list gadget's header. Below the 48dp touch-target minimum
         on purpose and knowingly: the whole gadget is one grid cell tall in its header row, and a 48dp
         control would leave the resource name ~45dp at density factor 1.5. 40dp with an 8dp inset is
         the largest that keeps the header readable. -->
    <dimen name="launcher_gadget_action_size">40dp</dimen>

    <!-- S0404: the remove badge on a cell in edit mode. Small on purpose - it overlays the cell's own
         content, and the cell can be as little as ~63dp across at the highest density factor. -->
    <dimen name="launcher_edit_badge_size">24dp</dimen>

    <!-- S0427: floor width of the quick-actions popup. A desktop cell can be ~63dp across, and a popup
         that narrow would ellipsize every action label to two words. -->
    <dimen name="launcher_shortcut_popup_width">220dp</dimen>

    <!-- S1401: smallest comfortable all-apps cell. The screen divides its measured width by this, so
         one layout serves both orientations and a wide screen simply gets more columns. -->
    <dimen name="launcher_all_apps_cell_min_width">88dp</dimen>

    <!-- S1173: contour width for a shortcut cell's icon and caption, overriding the shared 2dp default.
         That default is sized for large camera overlay labels; on a 12sp caption it thickens the glyph
         into a blob. -->
    <dimen name="launcher_cell_outline_width">1dp</dimen>

    <!-- S1173: lift restored on a shortcut cell while the desktop is being edited. Matches the gadget
         card's own elevation, so both kinds read as the same surface while arranging. -->
    <dimen name="launcher_cell_edit_elevation">2dp</dimen>

    <!-- S1209: band at the top and bottom of the scroll viewport inside which a drag auto-scrolls the
         desktop. One finger wide, the platform's minimum touch target, and deliberately under the
         smallest cell (~63dp at the highest density factor) so the band never swallows a whole row -
         a drag hovering over the last visible row must still be able to sit still. -->
    <dimen name="launcher_drag_autoscroll_band">48dp</dimen>

    <!-- S1414: shortcut caption size. The smallest the app uses for a cell caption (the stream grid
         cell already runs at this size); a cell can be ~63dp across, so every point of size costs
         characters before the ellipsis - and the caption is the only thing telling two cells with the
         same icon apart. -->
    <dimen name="launcher_cell_label_text_size">10sp</dimen>
</resources>
