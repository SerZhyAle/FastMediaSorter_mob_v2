<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- S0404: one tile of the folder-preview gadget's 2x2 grid. Half the grid each way (weight in
         both directions), so four tiles fill it exactly regardless of cell size or density factor. -->
    <style name="Widget.FastMediaSorter.LauncherPreviewThumb">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- foreground, not background: the focus ring draws OVER the thumbnail, and a background
             would sit behind an opaque image where nobody could ever see it. -->
        <item name="android:foreground">@drawable/focus_button_background</item>
    </style>

    <!-- S1401: the all-apps list opens over the whole desktop, taskbar included, so it is a dialog
         theme rather than a floating one - a floating dialog would leave the bar it replaces on screen. -->
    <style name="Theme.FastMediaSorter.Launcher.AllApps" parent="Theme.FastMediaSorter.FullScreen">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- S1643: the Start panel travels from the top taskbar's own edge, the direction the owner ruled
         for the top placement (strategic §6 item 3). The bottom placement keeps the Material bottom
         sheet and never resolves this style. -->
    <style name="Animation.FastMediaSorter.Launcher.TopPanel" parent="">
        <item name="android:windowEnterAnimation">@anim/launcher_top_panel_enter</item>
        <item name="android:windowExitAnimation">@anim/launcher_top_panel_exit</item>
    </style>

    <!-- S1643: host window for the Start panel under the top taskbar placement. Floating so the panel
         wraps its rows and can be pushed below the bar by y offset. The background is opaque because
         fragment_launcher_start_menu declares none of its own and borrows the bottom sheet's today - a
         transparent window would show the desktop through the rows. -->
    <style name="Theme.FastMediaSorter.Launcher.TopPanel" parent="Theme.FastMediaSorter">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowAnimationStyle">@style/Animation.FastMediaSorter.Launcher.TopPanel</item>
    </style>

    <style name="Widget.FastMediaSorter.Launcher.TaskbarDone" parent="Widget.FastMediaSorter.Button.Filled">
        <item name="backgroundTint">@color/confirm_button_bg</item>
        <item name="android:textColor">@color/confirm_button_on</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

</resources>
