<?xml version="1.0" encoding="utf-8"?>
<!-- S1743: the thin plate a section caption sits inside. It replaces the one-pixel rule that used to run
     under the caption on a second tier: the rule cost a whole tier to say "this is a header", and the plate
     says it inside the tier the caption already occupies. Shape and fill carry that distinction, never
     colour alone (S1428 strategic §3.2). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceVariant" />

    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />

    <corners android:radius="@dimen/launcher_cell_label_plate_radius" />

</shape>
