<?xml version="1.0" encoding="utf-8"?>
<!-- S0404: the outline of a free square in edit mode. Dashed so it reads as an invitation rather than
     as a real, empty item - a solid outline is what an occupied cell wears. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="16dp" />

    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline"
        android:dashGap="4dp"
        android:dashWidth="4dp" />

</shape>
