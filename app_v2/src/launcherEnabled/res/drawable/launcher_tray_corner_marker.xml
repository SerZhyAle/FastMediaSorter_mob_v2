<?xml version="1.0" encoding="utf-8"?>
<!-- S2023: the roaming mark on a SIM icon (ADR-8). A ring rather than a filled dot so it stays legible
     against both a light and a dark glyph at the 5dp it is drawn at. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorSurface" />
    <stroke
        android:width="1dp"
        android:color="@color/warning_color" />
</shape>
