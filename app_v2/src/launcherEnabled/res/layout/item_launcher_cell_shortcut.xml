<?xml version="1.0" encoding="utf-8"?>
<!-- S0404/S1173: one shortcut cell on the launcher desktop - icon over a label, with an optional badge
     marking which view mode a resource shortcut opens in. The cell is transparent at rest so the
     desktop wallpaper shows through it; contrast lives in the icon's and the caption's own contour, not
     in a card behind them. The whole cell stays the touch target. Edit mode restores the card look from
     the binder, because that is what makes cell boundaries and drop targets visible while arranging.
     Orientation-neutral: the cell is square in both layouts, so there is deliberately no layout-land
     counterpart. -->
<com.sza.fastmediasorter.ui.common.widget.FocusMaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLauncherCell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorControlHighlight"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <!-- No minHeight: LauncherDesktopLayout measures the cell EXACTLY at cellSize, so the grid is
         authoritative and a floor here would only fight it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- The padding is what gives the contour room: OutlinedImageView draws it inside its own
                 bounds, so without the inset the outermost pass is clipped at the icon's edge. -->
            <com.sza.fastmediasorter.ui.common.widget.OutlinedImageView
                android:id="@+id/cellIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:padding="@dimen/launcher_cell_outline_width"
                app:oiv_outlineWidth="@dimen/launcher_cell_outline_width"
                tools:src="@drawable/ic_folder" />

            <!-- S1176: a contact cell shows the person's initials where every other cell shows a glyph.
                 It occupies the icon's own 44dp box rather than sitting beside it - the two are
                 alternatives, never both, so the cell keeps its exact geometry either way. -->
            <TextView
                android:id="@+id/cellMonogram"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_contact_monogram"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="IP"
                tools:visibility="visible" />

            <!-- No focus background here: the badge is not focusable, clickable or hoverable, so the
                 selector could never leave its transparent default state - it drew nothing (Rule 20). -->
            <ImageView
                android:id="@+id/cellModeBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface"
                tools:src="@drawable/ic_slideshow"
                tools:visibility="visible" />

        </FrameLayout>

        <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
            android:id="@+id/cellLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
            tools:text="Photos" />

    </LinearLayout>

</com.sza.fastmediasorter.ui.common.widget.FocusMaterialCardView>
