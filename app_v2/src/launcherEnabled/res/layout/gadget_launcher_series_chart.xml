<?xml version="1.0" encoding="utf-8"?>
<!-- S1179: one layout for both chart tiles - the speed chart hides the secondary line, the altitude
     chart shows distance on it. Sized by the desktop grid like every gadget, so nothing here sets a
     fixed height. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/margin_small">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gadgetChartValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="96sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:ignore="UnusedAttribute"
                tools:text="64 km/h" />

            <TextView
                android:id="@+id/gadgetChartSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="12.4 km"
                tools:visibility="visible" />

            <com.sza.fastmediasorter.ui.common.chart.SensorSeriesChartView
                android:id="@+id/gadgetChartSeries"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/gadgetChartEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:text="@string/launcher_gadget_chart_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gadgetChartReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/launcher_gadget_chart_reset_description"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:text="@string/launcher_gadget_chart_reset"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</merge>
