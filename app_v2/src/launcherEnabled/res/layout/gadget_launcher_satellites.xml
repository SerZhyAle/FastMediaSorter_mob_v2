<?xml version="1.0" encoding="utf-8"?>
<!-- S1560: the satellite-count gadget, built on the speed tile's shape. Nothing here sets a fixed
     height - the desktop grid measures the cell and the value autosizes into it. A missing fix is
     shown as a zero in the value line rather than as an empty tile, because zero is the answer the
     owner asked for. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/margin_small">

        <!-- S1587: the tile's own name. A seeded desktop shows a bare "0 / 0" with nothing saying which
             reading it is, and the spoken description already carries the name, so this line is visual
             only. -->
        <TextView
            android:id="@+id/gadgetSatellitesCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/launcher_gadget_satellites"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/gadgetSatellitesValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute"
            tools:text="7 / 14" />

        <TextView
            android:id="@+id/gadgetSatellitesMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Location is off. Allow it in app permissions."
            tools:visibility="visible" />

    </LinearLayout>

</merge>
