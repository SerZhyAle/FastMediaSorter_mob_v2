<?xml version="1.0" encoding="utf-8"?>
<!-- S1170: the now-playing cell - title and artist over a transport row. Its own layout rather than the
     shared list shell, because this gadget shows one item with controls, not a list.

     Transparent, outlined text, ?attr colours: a desktop cell sits on the wallpaper, so contrast comes
     from each element's contour - the same choice every other launcher cell layout makes.

     Orientation-neutral, so no layout-land counterpart: the launcher stores spans per orientation and
     measures the cell exactly, so this layout never sees an orientation. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_small"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/margin_small"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/nowPlayingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
                android:id="@+id/nowPlayingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold"
                app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
                tools:text="Blue Monday" />

            <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
                android:id="@+id/nowPlayingArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone"
                app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
                tools:text="New Order"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nowPlayingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- focus_button_background goes in FOREGROUND, never background: as background it replaces
                 ImageButton's ripple with a selector that has no state_pressed, so taps stop giving
                 feedback. Same reason gadget_launcher_list.xml states. -->
            <ImageButton
                android:id="@+id/nowPlayingPrevious"
                android:layout_width="@dimen/launcher_gadget_action_size"
                android:layout_height="@dimen/launcher_gadget_action_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous"
                android:focusable="true"
                android:foreground="@drawable/focus_button_background"
                android:padding="6dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="?attr/colorControlNormal"
                tools:ignore="MissingPrefix" />

            <ImageButton
                android:id="@+id/nowPlayingPlayPause"
                android:layout_width="@dimen/launcher_gadget_action_size"
                android:layout_height="@dimen/launcher_gadget_action_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/play_pause"
                android:focusable="true"
                android:foreground="@drawable/focus_button_background"
                android:padding="6dp"
                android:src="@drawable/ic_play"
                app:tint="?attr/colorControlNormal"
                tools:ignore="MissingPrefix" />

            <ImageButton
                android:id="@+id/nowPlayingNext"
                android:layout_width="@dimen/launcher_gadget_action_size"
                android:layout_height="@dimen/launcher_gadget_action_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next"
                android:focusable="true"
                android:foreground="@drawable/focus_button_background"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                app:tint="?attr/colorControlNormal"
                tools:ignore="MissingPrefix" />

        </LinearLayout>

        <!-- S0429: takes the row the transport controls leave empty in the gadget's degraded state, so the
             offer sits exactly where the missing capability shows. Gone by default and shown only while
             notification access is off - the two are never visible at once. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nowPlayingGrantAccess"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/launcher_gadget_action_size"
            android:ellipsize="end"
            android:focusable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/launcher_now_playing_other_apps"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</merge>
