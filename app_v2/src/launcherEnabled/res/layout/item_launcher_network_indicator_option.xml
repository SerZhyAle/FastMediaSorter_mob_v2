<?xml version="1.0" encoding="utf-8"?>
<!-- The indicator glyph alone is ambiguous, so this launcher-only picker keeps its label
     visible rather than inheriting the generic searchable row's optional leading content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkIndicatorOptionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_focus_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_height"
    android:orientation="horizontal"
    android:paddingTop="@dimen/padding_small"
    android:paddingStart="@dimen/padding_normal"
    android:paddingEnd="@dimen/padding_normal"
    android:paddingBottom="@dimen/padding_small">

    <ImageView
        android:id="@+id/ivNetworkIndicatorOptionIcon"
        android:layout_width="@dimen/settings_width_icon"
        android:layout_height="@dimen/settings_width_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvNetworkIndicatorOptionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dialog_field_spacing"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
