<?xml version="1.0" encoding="utf-8"?>
<!-- S2032: name a channel for the YouTube window cell. The found channel is confirmed through the
     canonical searchable picker, so this layout only has to collect the query. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <TextView
        android:id="@+id/tvYouTubeChannelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:text="@string/launcher_youtube_channel_title"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutYouTubeChannelQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/launcher_youtube_channel_hint"
        app:boxBackgroundMode="outline"
        app:endIconMode="clear_text">

        <com.sza.fastmediasorter.ui.common.widget.SafeSelectionTextInputEditText
            android:id="@+id/editYouTubeChannelQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="textUri"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvYouTubeChannelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYouTubeChannelCancel"
            style="@style/Widget.FastMediaSorter.Button.DialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYouTubeChannelSearch"
            style="@style/Widget.FastMediaSorter.Button.DialogConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_action_button_gap"
            android:text="@string/launcher_weather_location_search" />

    </LinearLayout>

</LinearLayout>
