<?xml version="1.0" encoding="utf-8"?>
<!-- A letter group occupies one normal grid cell, so the alphabet keeps the same density as apps.
     S4626: the state triangle leads the caption plate; the tile is a recorded structural variant of the
     group header (collapsed headers packed in a grid). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/groupHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_tiny"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/focus_button_background"
    android:gravity="center"
    android:minHeight="@dimen/launcher_all_apps_group_tile_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_small"
    android:paddingTop="@dimen/margin_normal"
    android:paddingEnd="@dimen/margin_small"
    android:paddingBottom="@dimen/margin_normal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/groupIndicator"
            android:layout_width="@dimen/icon_size_button"
            android:layout_height="@dimen/icon_size_button"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_arrow_drop_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/groupTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_tiny"
            android:layout_marginEnd="@dimen/margin_tiny"
            android:layout_weight="1"
            android:background="@drawable/bg_launcher_app_group_vowel"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/launcher_all_apps_group_tile_letter_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/groupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/toggler_desc_text_size" />

</LinearLayout>
