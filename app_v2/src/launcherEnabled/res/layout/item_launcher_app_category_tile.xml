<?xml version="1.0" encoding="utf-8"?>
<!-- S4626: the state triangle leads the caption row; the tile grid is a recorded structural variant of the
     group header (collapsed headers packed in a grid). Mirrored in layout-land/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/groupHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_tiny"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/focus_button_background"
    android:gravity="center"
    android:minHeight="@dimen/launcher_all_apps_group_tile_min_height"
    android:orientation="vertical"
    android:padding="@dimen/margin_small">

    <GridLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:columnCount="2"
        android:importantForAccessibility="noHideDescendants"
        android:rowCount="2">

        <ImageView android:id="@+id/icon1" android:layout_width="24dp" android:layout_height="24dp" />
        <ImageView android:id="@+id/icon2" android:layout_width="24dp" android:layout_height="24dp" />
        <ImageView android:id="@+id/icon3" android:layout_width="24dp" android:layout_height="24dp" />
        <ImageView android:id="@+id/icon4" android:layout_width="24dp" android:layout_height="24dp" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/groupIndicator"
            android:layout_width="@dimen/icon_size_button"
            android:layout_height="@dimen/icon_size_button"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_arrow_drop_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/groupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/groupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
