<?xml version="1.0" encoding="utf-8"?>
<!-- S0404: the clock gadget. TextClock registers its own time/timezone receivers on attach and drops
     them on detach, and follows the 12/24h system setting by itself - so this gadget has no lifecycle
     wiring and no receiver to keep symmetric. Same correction the taskbar tray took in Phase 05.
     No weather here: S0426 extends this gadget through the gadget contract (strategic §6.7). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/margin_small">

        <!-- Autosized, not a fixed 32sp: the cell is `gridWidth / columns` tall, and at density factor
             1.5 on a narrow phone that is ~54dp of content - less than a 32sp time plus a 13sp date
             need, so a fixed size clips BOTH (gravity=center pushes the overflow off each end). The
             platform attr, not the AppCompat one: TextClock is not auto-inflated to an AppCompat view,
             and this source set is minSdk 26 so the native autosize is always there.
             tools:ignore - autosize needs layout_height to be free, which is exactly what 0dp+weight
             gives it here; the lint check does not model the weighted parent. -->
        <!-- S1610: time and date each own a fixed share of the card height instead of the date
             measuring first at its full size and leaving time the remainder. Four fifths to time,
             one fifth to the date, and each autosizes inside its own share - so shrinking the card
             to its 2x1 minimum scales both continuously instead of squeezing the time into what the
             date did not take. The date's fifth is sized so its 9sp..16sp range always fits: at the
             seeded 4x2 it reaches the 16sp cap, at the minimum it settles near 9sp. No new signal is
             needed - a gadget only ever learns the pixel bounds the grid measured for it. -->
        <TextClock
            android:id="@+id/gadgetClockTime"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:format12Hour="h:mm:ss"
            android:format24Hour="H:mm:ss"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute"
            tools:text="12:45" />

        <TextClock
            android:id="@+id/gadgetClockDate"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="UnusedAttribute"
            tools:text="Fri, 17 Jul" />

    </LinearLayout>

</merge>
