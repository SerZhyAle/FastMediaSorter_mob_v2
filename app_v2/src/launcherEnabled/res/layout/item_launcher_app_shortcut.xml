<?xml version="1.0" encoding="utf-8"?>
<!-- S0427: one published quick action of an installed app, shown in the long-press popup - icon
     beside a single-line label. Lives inside a floating window, so it is orientation-neutral and has
     no layout-land counterpart. The row must stay non-clickable and non-focusable: it is a ListView
     item, and a row that consumes the touch itself leaves AdapterView.OnItemClickListener unfired -
     the ripple plays and the menu does nothing (S1466). D-pad and mouse walk the list through the
     ListView's own selection, which ListPopupWindow.isModal already routes focus into. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shortcutRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/shortcutIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_launcher_mode" />

    <TextView
        android:id="@+id/shortcutLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        tools:text="New incognito tab" />

</LinearLayout>
