<?xml version="1.0" encoding="utf-8"?>
<!-- S1179: the steps gadget. Sized by the desktop grid like every gadget, so nothing here sets a
     fixed height. The caption is not decoration - the system counter reports steps since the last
     reboot, and a bare number with no denominator is one the user cannot interpret. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:id="@+id/gadgetStepsBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/focus_button_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/margin_small">

        <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
            android:id="@+id/gadgetStepsValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:otv_outlineScale="@dimen/outline_text_stroke_scale"
            app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
            tools:ignore="UnusedAttribute"
            tools:text="8,412" />

        <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
            android:id="@+id/gadgetStepsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/launcher_gadget_steps_since_boot"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
            android:textSize="10sp"
        />

        <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
            android:id="@+id/gadgetStepsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:visibility="gone"
            app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
            tools:text="Physical activity is off"
            tools:visibility="visible" />

    </LinearLayout>

</merge>
