<?xml version="1.0" encoding="utf-8"?>
<!-- S1415: the five device indicators in the order the owner fixed (strategic §3.3) - Bluetooth, SIM1,
     SIM2, network type, battery. Bluetooth and the two SIM slots start GONE: each appears only once its
     own source reports a value, so an unreadable indicator is absent rather than empty (ADR-1).
     S1431: defined once and inflated by both placements, so the set and the order cannot drift apart.

     S1767: every indicator is a control, not a label - a tap opens the Android settings section it
     reports on. Focusable as well as clickable, because this row is read by a D-pad as often as by a
     finger, and the ring goes in the FOREGROUND: the battery view's background is already its outline,
     and on the ImageViews a background ring would replace the ripple instead of sitting over it.

     S2023: the four glyph slots are LauncherTrayIconView, which carries the click, focus and foreground
     itself and adds room for an overlay badge and a corner mark inside the same 18dp square. The battery
     stays a TextView - it already carried text before any of this. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trayIndicators"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.sza.fastmediasorter.ui.launcher.tray.LauncherTrayIconView
        android:id="@+id/trayBluetooth"
        android:layout_width="@dimen/launcher_tray_icon_size"
        android:layout_height="@dimen/launcher_tray_icon_size"
        android:layout_marginEnd="@dimen/launcher_taskbar_item_spacing"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.sza.fastmediasorter.ui.launcher.tray.LauncherTrayIconView
        android:id="@+id/traySim1"
        android:layout_width="@dimen/launcher_tray_icon_size"
        android:layout_height="@dimen/launcher_tray_icon_size"
        android:layout_marginEnd="@dimen/launcher_taskbar_item_spacing"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.sza.fastmediasorter.ui.launcher.tray.LauncherTrayIconView
        android:id="@+id/traySim2"
        android:layout_width="@dimen/launcher_tray_icon_size"
        android:layout_height="@dimen/launcher_tray_icon_size"
        android:layout_marginEnd="@dimen/launcher_taskbar_item_spacing"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.sza.fastmediasorter.ui.launcher.tray.LauncherTrayIconView
        android:id="@+id/trayNetwork"
        android:layout_width="@dimen/launcher_tray_icon_size"
        android:layout_height="@dimen/launcher_tray_icon_size"
        android:layout_marginEnd="@dimen/launcher_taskbar_item_spacing" />

    <TextView
        android:id="@+id/trayBatteryLevel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/focus_button_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/launcher_tray_battery_outline"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        tools:text="86" />

</LinearLayout>
