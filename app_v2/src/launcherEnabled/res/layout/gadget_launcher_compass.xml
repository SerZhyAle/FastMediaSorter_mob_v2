<?xml version="1.0" encoding="utf-8"?>
<!-- S1179: the compass gadget. Sized by the desktop grid like every gadget, so nothing here sets a
     fixed height. The heading is a TextView beside the needle, not the needle alone - strategic §3.2
     requires heading and altitude to be readable as words by a screen reader.
     S4183: the 1:1 weight split is deliberate - the owner asked for the tile divided evenly, so the
     text can never push the needle around; the needle's half is fixed and no measurement moves it.
     S4476: the heading's fixed 24sp could not hold "143°" in half of a two-column tile on a dense
     grid and collapsed to "1..". It autosizes again, but in 2sp steps: the old jitter came from a
     font that was recomputed to a new size on every tick, and a step only changes when the text
     crosses a width boundary (a digit count or a cardinal word), while in a small tile the size sits
     at the floor and does not move. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/margin_small">

        <ImageView
            android:id="@+id/gadgetCompassNeedle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_compass" />

        <!-- S4476: keeps the heading whole and leaves out the altitude line when a short tile has no
             room for it next to the heading. -->
        <com.sza.fastmediasorter.ui.launcher.gadget.GadgetValueColumn
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
                android:id="@+id/gadgetCompassHeading"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textColor="?attr/launcherDesktopText"
                android:textStyle="bold"
                app:otv_outlineScale="@dimen/outline_text_stroke_scale"
                app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
                tools:ignore="UnusedAttribute"
                tools:text="42° Northeast" />

            <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
                android:id="@+id/gadgetCompassAltitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/launcherDesktopTextSecondary"
                android:textSize="12sp"
                app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
                tools:text="184 m" />

            <com.sza.fastmediasorter.ui.common.widget.OutlinedTextView
                android:id="@+id/gadgetCompassCalibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/launcher_gadget_compass_calibrate"
                android:textColor="?attr/launcherDesktopTextSecondary"
                android:textSize="11sp"
                android:visibility="gone"
                app:otv_outlineWidth="@dimen/launcher_cell_outline_width"
                tools:visibility="visible" />

        </com.sza.fastmediasorter.ui.launcher.gadget.GadgetValueColumn>

    </LinearLayout>

</merge>
