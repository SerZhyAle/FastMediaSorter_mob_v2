<?xml version="1.0" encoding="utf-8"?>
<!-- S1421: the band the launcher frees when it replaces the system status area. One file for both
     orientations, like launcher_taskbar.xml - the orientation-dependent part is the cutout gap, which is
     measured from window insets at runtime rather than laid out here. No background: the strip draws over
     the wallpaper, and a colour of its own would cut a stripe across it. -->
<!-- The root carries no id on purpose: the <include> in activity_launcher_home.xml supplies
     launcherStatusStrip, and a second id here would name the same view twice in one ViewBinding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/launcher_status_strip_height"
    android:paddingStart="@dimen/launcher_status_strip_corner_inset"
    android:paddingEnd="@dimen/launcher_status_strip_corner_inset"
    android:visibility="gone">

    <!-- Owned exclusively by LauncherStatusStripManager (S1421 ADR-2). Nothing else may add a child. -->
    <FrameLayout
        android:id="@+id/launcherStatusStripContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.sza.fastmediasorter.ui.launcher.signal.LauncherSignalRowView
            android:id="@+id/launcherSignalRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</FrameLayout>
