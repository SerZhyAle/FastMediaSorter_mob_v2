<?xml version="1.0" encoding="utf-8"?>
<!-- S0404: the Start menu. Every row is static and declared here rather than adapter-driven.
     S1401: the "All apps" row and its expanding grid are gone - the app list is its own screen now. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/startMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/margin_medium"
    android:paddingBottom="@dimen/margin_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowOpenApp"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_menu_open_app"
            app:icon="@drawable/ic_app_logo"
            app:iconGravity="start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowResources"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_menu_resources"
            app:icon="@drawable/ic_resource_local"
            app:iconGravity="start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowCreateResource"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_create_resource_menu_row"
            app:icon="@drawable/ic_add"
            app:iconGravity="start" />

        <!-- S1401: the "All apps" row and the grid it expanded are gone (ADR-2). One app list, reached
             from the taskbar button beside Start or by swiping up on the desktop. -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowAndroidSettings"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_menu_android_settings"
            app:icon="@drawable/ic_android"
            app:iconGravity="start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowAppSettings"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_menu_app_settings"
            app:icon="@drawable/ic_settings"
            app:iconGravity="start" />

        <!-- S1088: the launcher's own settings dialog, in place next to Android/App settings. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowLauncherSettings"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_menu_launcher_settings"
            app:icon="@drawable/ic_launcher_mode"
            app:iconGravity="start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowEditDesktop"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_edit_enter"
            app:icon="@drawable/ic_tune"
            app:iconGravity="start" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rowExitMode"
            style="@style/Widget.FastMediaSorter.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:foreground="@drawable/focus_button_background"
            android:gravity="start|center_vertical"
            android:text="@string/launcher_menu_exit_mode"
            app:icon="@drawable/ic_exit_to_app"
            app:iconGravity="start" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
