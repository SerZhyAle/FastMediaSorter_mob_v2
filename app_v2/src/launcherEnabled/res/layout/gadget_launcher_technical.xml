<?xml version="1.0" encoding="utf-8"?>
<!-- S1178: the one layout behind all four technical gadgets (ADR-2). Sized by the desktop grid like
     every gadget, so nothing here sets a fixed height. The fill bar never carries a value on its own -
     the number above it stays visible in every state (strategic 3.2, accessibility). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/margin_small">

        <ImageView
            android:id="@+id/gadgetTechnicalIcon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="48dp"
            android:tint="?attr/colorOnSurface"
            tools:ignore="UseAppTint"
            tools:src="@drawable/ic_wifi" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gadgetTechnicalValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="96sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:ignore="UnusedAttribute"
                tools:text="78%" />

            <TextView
                android:id="@+id/gadgetTechnicalCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="About 4 h left" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/gadgetTechnicalFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:max="100"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp"
                tools:progress="60"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</merge>
