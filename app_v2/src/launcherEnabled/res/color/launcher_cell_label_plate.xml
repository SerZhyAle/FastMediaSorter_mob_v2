<?xml version="1.0" encoding="utf-8"?>
<!-- S1587: the caption plate's fill. A theme attribute carries the surface colour so the plate follows
     the light and dark palettes, and the alpha lives here rather than on the view, because alpha on the
     TextView would fade the caption itself along with its backing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.72"
        android:color="?attr/colorSurface" />
</selector>
