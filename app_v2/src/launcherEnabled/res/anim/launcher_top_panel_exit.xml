<?xml version="1.0" encoding="utf-8"?>
<!-- S1643: the Start panel retracts into the top taskbar's own edge, the reverse of
     launcher_top_panel_enter. Mirrors res/anim/slide_out_right on the vertical axis. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300">
    <translate
        android:fromYDelta="0"
        android:toYDelta="-100%p" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
