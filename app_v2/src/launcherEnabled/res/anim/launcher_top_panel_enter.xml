<?xml version="1.0" encoding="utf-8"?>
<!-- S1643: the Start panel drops down from the top taskbar's own edge (owner ruling, strategic §6 item 3).
     Mirrors res/anim/slide_in_right on the vertical axis, same duration and same fade. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300">
    <translate
        android:fromYDelta="-100%p"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>
