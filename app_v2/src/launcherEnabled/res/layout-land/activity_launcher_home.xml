<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- S1101: wallpaper layers, behind the grid. At most one is visible; both stay GONE for the "empty"
         mode, and neither allocates anything until it is sized, so the idle cost of the unused layer is a
         view object. Mirrors layout/activity_launcher_home.xml (one ViewBinding, Rule 11). -->
    <ImageView
        android:id="@+id/launcherWallpaperImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.sza.fastmediasorter.ui.player.helpers.AudioWaveParticleView
        android:id="@+id/launcherWallpaperWaves"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- S1421: the band the system status bar leaves behind. GONE unless the launcher replaces the status
         area, and a GONE include collapses onto its own anchor, so the grid below lands at the parent top
         exactly as it did before this strip existed. Ids must match layout/ (one ViewBinding, Rule 11). -->
    <include
        android:id="@+id/launcherStatusStrip"
        layout="@layout/launcher_status_strip"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_status_strip_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- One screen plus downward scroll, no desktop pages (strategic §3.3). fillViewport is what makes
         a desktop shorter than the screen still fill it, so the grid is not a floating strip on top. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/launcherGridScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:scrollbarThumbVertical="@color/scrollbar_thumb"
        android:scrollbars="vertical"
        android:paddingStart="@dimen/margin_medium"
        android:paddingEnd="@dimen/margin_medium"
        app:layout_constraintBottom_toTopOf="@+id/launcherTaskbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/launcherStatusStrip">

        <com.sza.fastmediasorter.ui.launcher.grid.LauncherDesktopLayout
            android:id="@+id/launcherDesktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/launcherTaskbar"
        layout="@layout/launcher_taskbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_taskbar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- S1412: the "done" button lives on the taskbar (launcher_taskbar.xml), not here - floating over
         the grid's top-right corner covered up to two cells that edit mode then could not reach. -->

</androidx.constraintlayout.widget.ConstraintLayout>
