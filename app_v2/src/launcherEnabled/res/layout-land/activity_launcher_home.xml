<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- One screen plus downward scroll, no desktop pages (strategic §3.3). fillViewport is what makes
         a desktop shorter than the screen still fill it, so the grid is not a floating strip on top. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/launcherGridScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/margin_medium"
        android:paddingEnd="@dimen/margin_medium"
        app:layout_constraintBottom_toTopOf="@+id/launcherTaskbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.sza.fastmediasorter.ui.launcher.grid.LauncherDesktopLayout
            android:id="@+id/launcherDesktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/launcherTaskbar"
        layout="@layout/launcher_taskbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_taskbar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Floats over the desktop only while editing; the Start-menu row is how edit mode is entered. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/launcherEditDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_small"
        android:text="@string/launcher_edit_done"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
