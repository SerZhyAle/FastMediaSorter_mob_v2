<?xml version="1.0" encoding="utf-8"?>
<!--
    S0404: launcher mode - the app as the device home screen. Injected into standard / noLegal via
    addStaticManifestFile (build.gradle.kts). The activity ships DISABLED: the system only offers
    FastMediaSorter as a home screen after the user turns the mode on, which enables this component
    and brings up the system "Always / Just once" chooser (strategic ADR-2). Disabling it again
    hands the device back to the previous launcher.

    No <queries> here - the MAIN/LAUNCHER visibility declaration the app registry needs already lives in
    the main manifest (S0623). S2576 confirmed no <queries> entry is needed for the uninstall row either:
    com.google.android.packageinstaller sits in the platform's forceQueryable set, so it is visible to
    every app with nothing declared (measured with `dumpsys package queries`, Android 15).

    S2576 added REQUEST_DELETE_PACKAGES below. The app-action menu's uninstall row hands ACTION_DELETE to
    the system uninstaller, and an app targeting API 28 or later must hold this permission for that screen
    to show its confirmation - without it the screen closes on its own, so the menu entry looks dead while
    startActivity reports success and nothing is logged. It lives here rather than in src/noLegal because
    it is a normal permission with no Play review surface, unlike the REQUEST_INSTALL_PACKAGES that S0183
    had to confine to the sideload flavor; this source set is mounted by exactly the flavors that ship the
    launcher, which is the only feature that offers the row.

    S1415 added READ_PHONE_STATE below. It is requested at run time, and only when the tray is about to
    show a SIM indicator; a refusal simply leaves both SIM slots absent (strategic §7). No <uses-feature>
    accompanies it: READ_PHONE_STATE is not in the implied feature requirements table, so no
    android.hardware.telephony is inferred and Play device reach is unchanged.

    S1179 added ACTIVITY_RECOGNITION on the same terms: requested at run time, and only when the user
    adds the steps gadget; a refusal leaves that tile on the desktop in an honest empty state. No
    <uses-feature> either - a step-counter feature entry as required="false" buys nothing, and a
    required="true" one would cut Play device reach for the whole app.

    S1614 moved that permission OUT of this source set into src/noLegal. Play treats
    ACTIVITY_RECOGNITION as a health feature and refuses to commit a release until the Health
    declaration is filled in; the sideload flavor faces no such review. The gadget's own code stays
    here - DeviceSensorAvailabilityRepositoryImpl reports STEP_COUNTER absent when the merged
    manifest carries no ACTIVITY_RECOGNITION, so a build without the permission never offers the
    tile. Returning it to the store flavors is its own decision, tracked by S1614.

    S0429: the notification-listener service below is declared, never requested. It is the key
    MediaSessionManager demands before it will name another app's active media session, and it is inert
    until the user turns notification access on in system settings - which the Now Playing gadget offers
    behind a disclosure dialog. No <uses-permission> accompanies it: BIND_NOTIFICATION_LISTENER_SERVICE
    is held by the service declaration, not asked for by the app.

    S1205: the pin-request host below ships ENABLED, unlike the HOME activity. The system delivers
    ACTION_CONFIRM_PIN_SHORTCUT only to the launcher currently holding the home role, so the component
    is inert until that role is ours and needs no enable/disable lever of its own.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application>
        <!--
            S2026: an affinity of its own, so the home task holds the home surface and nothing else.
            Without it this activity shares the app's default affinity, so every FLAG_ACTIVITY_NEW_TASK
            launch off the desktop matched the *home* task and landed the player inside it - and Android
            refuses enterPictureInPictureMode() for a home-type task ("Current activity does not support
            picture-in-picture"), which is the reported "PiP errors out on streams".
        -->
        <activity
            android:name="com.sza.fastmediasorter.ui.launcher.LauncherHomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity="${applicationId}.launcherhome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            S2811: the same desktop presentation as the app's own start window. No HOME intent-filter,
            so this component never makes the app a home-screen candidate; no taskAffinity override and
            no excludeFromRecents, so a user who never enabled home mode keeps the app in Recents.
        -->
        <activity
            android:name="com.sza.fastmediasorter.ui.launcher.LauncherStartWindowActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:enabled="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:stateNotNeeded="true" />

        <activity
            android:name="com.sza.fastmediasorter.ui.launcher.pin.LauncherPinRequestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FastMediaSorter.Transparent">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.sza.fastmediasorter.ui.launcher.share.LauncherPlaceShareActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.FastMediaSorter.Transparent" />

        <activity-alias
            android:name=".LauncherPlaceShare"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_pin"
            android:label="@string/launcher_share_place_label"
            android:targetActivity="com.sza.fastmediasorter.ui.launcher.share.LauncherPlaceShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.sza.fastmediasorter.ui.launcher.gadget.nowplaying.MediaSessionAccessService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
