<?xml version="1.0" encoding="utf-8"?>
<!--
    Release manifest overlay.
    Removes permissions that require Google Play policy justification
    for features not yet submitted for review (scheduled ops).
    FOREGROUND_SERVICE_DATA_SYNC is not handled here: src/storeReleaseNoDataSync strips it for store
    releases, and fms.dataSyncFgsStandard=on (S4271) lets standard keep it once its declaration is saved.

    NOTE: FOREGROUND_SERVICE_MEDIA_PLAYBACK and AudioPlaybackService foregroundServiceType
    must remain declared - Media3 (API 34+) unconditionally calls startForeground(mediaPlayback)
    on any playback start. Removing them causes IllegalArgumentException crash on Android 14+.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S4263: FOREGROUND_SERVICE_DATA_SYNC moved to storeReleaseNoDataSync so noLegal keeps it in release -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <!-- ScheduledOperationsBootReceiver: disabled in release (feature hidden) -->
    <application>
        <receiver android:name=".worker.ScheduledOperationsBootReceiver"
            android:enabled="false"
            tools:node="merge"
            tools:replace="android:enabled" />
    </application>

</manifest>
