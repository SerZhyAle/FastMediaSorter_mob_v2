<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared screen-capture engine manifest (S0559).

  Mounted into BOTH standard and noLegal via build.gradle.kts addStaticManifestFile. Declares only
  the Play-safe confirmable capture path: the MediaProjection consent activity and the capture
  foreground service. The overlay-strip launcher (SYSTEM_ALERT_WINDOW / specialUse FGS) and the
  accessibility silent-capture service stay in src/noLegal/AndroidManifest.xml only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- S0774: screen video recording records microphone audio and posts a foreground notification. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name="com.sza.fastmediasorter.screencapture.ScreenCaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FastMediaSorter.Transparent" />

        <service
            android:name="com.sza.fastmediasorter.screencapture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- S0774: continuous screen video recording. -->
        <activity
            android:name="com.sza.fastmediasorter.screencapture.ScreenVideoRecordingConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FastMediaSorter.Transparent" />

        <service
            android:name="com.sza.fastmediasorter.screencapture.ScreenVideoRecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
