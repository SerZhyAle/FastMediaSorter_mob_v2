<?xml version="1.0" encoding="utf-8"?>
<!-- S0249 Phase 04: VR controls block content rendered inside the Media settings screen.
     Children:
       - xrUnavailableAdvisory: shown only when XrDetectionFacade reports no XR runtime.
       - masterToggleRow: tap target for the "Включить 3D VR" switch (reused from S0245).
                          isEnabled = false on non-XR devices (toggle visible but inactive).
       - testImmersiveRow: visible only when master toggle = ON; tap routes through
                           XrEntryGateway.enterDiagnosticImage().
     All rows respect the project's existing Trigger Row dimensions
     (toggler_title_text_size + toggler_desc_text_size) per docs/ARCHITECTURE.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_padding_horizontal_large">

    <!-- Advisory shown only on non-XR devices (XrDetectionFacade.state == NONE). -->
    <TextView
        android:id="@+id/xrUnavailableAdvisory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/settings_padding_vertical"
        android:text="@string/vr_settings_xr_unavailable_advisory"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- Master toggle row (reused S0245 semantics). isEnabled is set in code. -->
    <LinearLayout
        android:id="@+id/masterToggleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/settings_padding_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/masterToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vr_settings_master_toggle_label"
                android:textSize="@dimen/toggler_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/masterToggleSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vr_settings_master_toggle_summary"
                android:textSize="@dimen/toggler_desc_text_size" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/masterToggleSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/vr_settings_master_toggle_label" />
    </LinearLayout>

    <!-- Test Immersive button row. visibility=gone unless master toggle = ON. -->
    <LinearLayout
        android:id="@+id/testImmersiveRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/vr_settings_test_immersive_content_description"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="@dimen/settings_padding_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/testImmersiveLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vr_settings_test_immersive_label"
            android:textSize="@dimen/toggler_title_text_size" />
    </LinearLayout>

</LinearLayout>
