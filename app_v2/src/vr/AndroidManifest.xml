<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Union Manifest for vr flavor — contains entries for both store channels.
      All XR uses-feature declared with required="false" so they don't block
      install on platforms where the feature is not declared (see ADR-3 in spec).
    -->

    <application>

        <!--
          Required on HorizonOS v67+: tells the Meta runtime broker this app is a
          fully authorised VR app. Without this, the broker returns null cursor and
          the runtime falls back to the ODM JSON path, which does not register
          xrGetOpenGLESGraphicsRequirementsKHR in its dispatch table — causing every
          OpenXR session creation to fail with XR_ERROR_FUNCTION_UNSUPPORTED (-7).
        -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest|quest2|quest3|questpro|quest3s" />

        <!--
          Android XR SDK (Google): declare 2D-panel ("home space") start mode so the XR Shell
          knows our 2D activities (Welcome, Main, Settings) should render as flat panels and
          populates xrDesktopMode in EmbeddingMixedHandler instead of leaving it 'undefined'.
          On Meta Quest the property is ignored by Horizon runtime — Quest reads
          com.oculus.intent.category.2D / VR from the activity intent-filter instead.
          See S0036 §6 Q1 for the resolution that established this property as the public API.
        -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_HOME_SPACE" />

        <!--
          VrPlayerActivity: Meta Hybrid App Model immersive Activity.
          Two co-requisites make the VR category safe:
            1. Dedicated taskAffinity below — the VR task runs separately from the 2D
               panel task, so the compositor does not have a 2D window competing for
               the foreground slot while the XR session is ramping up.
            2. com.oculus.intent.category.VR in the intent-filter — tells HorizonOS
               this Activity is an immersive peer, not a panel child.
          Without the task split, the category alone previously produced an immediate
          black screen (passthrough disabled before the XR session was ready). With the
          split, HorizonOS can transition the XR session to FOCUSED.
          VrTaskTransition in main/.../ui/player/entry/ performs the runtime handoff
          (FLAG_ACTIVITY_NEW_TASK + finishAndRemoveTask on entry, home-intent PendingIntent on exit).
        -->
        <activity
            android:name="com.sza.fastmediasorter.vr.VrPlayerActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:taskAffinity="${applicationId}.vr">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>

            <!--
              Required on HorizonOS v67+: grants the activity VR focus and enables
              full OpenXR runtime capabilities (including xrGetOpenGLESGraphicsRequirementsKHR).
            -->
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />

        </activity>

        <!--
          MainActivity is the Quest Library entry point for browsing (2D panel mode).
          com.oculus.intent.category.2D = explicit panel/2D-window app in HorizonOS —
          the OS renders the standard Android window as a flat Quad Layer in VR space.
          com.oculus.intent.category.VR would force exclusive/immersive mode and require
          OpenXR frame submission — causing an empty black screen since MainActivity has
          no OpenXR rendering. VR immersive mode is handled by VrPlayerActivity which
          carries com.oculus.vr.focusaware=true and is launched internally via startActivity().

          <layout> provides a large landscape default for the first-ever launch before
          MainActivity.onCreate() has a chance to apply the persisted size from SharedPrefs.
          HorizonOS applies <layout> only on initial window creation; subsequent launches
          use the runtime override in MainActivity.onCreate() + onConfigurationChanged().
        -->
        <activity
            android:name="com.sza.fastmediasorter.ui.main.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|navigation|uiMode|fontScale"
            android:resizeableActivity="true"
            tools:replace="android:configChanges">
            <layout
                android:defaultWidth="1920dp"
                android:defaultHeight="1080dp"
                android:gravity="center"
                android:minWidth="400dp"
                android:minHeight="300dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.2D" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Empty taskAffinity lets VrPhoneFallbackActivity join the caller's task on phones
          (no XR runtime). Without this, the VR-task affinity above would propagate via
          the same source set and isolate the fallback Activity in its own task.
        -->
        <activity
            android:name="com.sza.fastmediasorter.vr.VrPhoneFallbackActivity"
            android:exported="false"
            android:taskAffinity="" />

        <!--
          Browse: resizable so HorizonOS can host multiple BrowseActivity
          windows side-by-side. launchMode inherits "standard" from main
          manifest — each new-window intent creates a separate instance.
          FLAG_ACTIVITY_MULTIPLE_TASK at call site creates a distinct task.
        -->
        <activity
            android:name="com.sza.fastmediasorter.ui.browse.BrowseActivity"
            android:resizeableActivity="true" />

        <!--
          Panel player: resizable for the same reason as BrowseActivity.
          VrPlayerActivity (immersive) keeps singleTask and is NOT listed here.
        -->
        <activity
            android:name="com.sza.fastmediasorter.ui.player.PlayerActivity"
            android:resizeableActivity="true" />

        <!--
          Android XR Shell resizes the virtual window across screenSize / smallestScreenSize /
          screenLayout / density / uiMode dimensions; without overriding the narrow main-manifest
          configChanges set, every resize triggers activity recreation, leaving Settings as a
          blank panel. This overlay is gated to the vr flavor — main manifest stays untouched
          for standard / lite / photos / legacy.
        -->
        <activity
            android:name="com.sza.fastmediasorter.ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|navigation|uiMode|fontScale"
            android:resizeableActivity="true"
            tools:replace="android:configChanges" />

        <activity
            android:name="com.sza.fastmediasorter.ui.welcome.WelcomeActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|navigation|uiMode|fontScale"
            android:resizeableActivity="true"
            tools:replace="android:configChanges" />

    </application>

    <!-- Meta Horizon Store: head tracking (required=false — does not block Google Play install) -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="false"
        android:version="1" />

    <!-- Google Play / Android XR: immersive XR (required=false — does not block Quest install) -->
    <uses-feature
        android:name="android.hardware.xr.immersive"
        android:required="false" />

    <!-- Android XR SDK: marks this APK as Jetpack-XR-aware for Home-Space panel rendering -->
    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="false" />

    <!--
      Hand tracking (spec_vr-hand-tracking-tech §3).
      Permission is required on HorizonOS v62+ to open XrHandTrackerEXT — without it
      xrCreateHandTrackerEXT returns XR_ERROR_PERMISSION_INSUFFICIENT and hand tracking
      stays off while controllers keep working. The feature is optional so non-Quest
      devices still install.
    -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <!-- S0058: Meta passthrough camera — user-grantable dangerous permission (Horizon OS v74+) -->
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />

    <!-- Declare camera feature as optional so the app installs on non-Quest Android devices -->
    <uses-feature
        android:name="android.hardware.camera2"
        android:required="false" />

    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

</manifest>
