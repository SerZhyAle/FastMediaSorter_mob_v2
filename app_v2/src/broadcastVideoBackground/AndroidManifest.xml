<?xml version="1.0" encoding="utf-8"?>
<!--
  S3154/S4235: background declaration of the camera broadcast service. Both standard and noLegal keep
  the camera on air after the app leaves the screen, carrying the camera foreground-service type and its
  permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <application>
        <service
            android:name="com.sza.fastmediasorter.broadcast.VideoBroadcastService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
