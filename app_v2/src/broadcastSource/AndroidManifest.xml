<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- S2662 phase 01: throwaway transport spike, launched only via `adb shell am start`.
             No intent filter, never linked from the interface, deleted by phase 05. -->
        <activity
            android:name="com.sza.fastmediasorter.broadcast.spike.VideoBroadcastSpikeActivity"
            android:exported="false" />

        <!-- S2818: broadcast entry surfaces - Quick Settings tile + home-screen widget. Declared in
             this static manifest (injected by app_v2/build.gradle.kts for standard/noLegal/legacy
             only), so flavors without broadcast never see them. -->
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastTileService"
            android:exported="true"
            android:icon="@drawable/ic_display"
            android:label="@string/tile_broadcast_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" />
        <receiver
            android:name="com.sza.fastmediasorter.widget.BroadcastEntryWidgetProvider"
            android:exported="true"
            android:icon="@drawable/ic_display"
            android:label="@string/widget_broadcast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_broadcast_entry_info" />
        </receiver>
    </application>
</manifest>
