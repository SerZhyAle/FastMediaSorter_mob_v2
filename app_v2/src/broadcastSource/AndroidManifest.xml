<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- S3155: declaring CAMERA without this makes the platform imply a REQUIRED camera feature, and
         Play then hides the build from every device without one - a Chromebook, a tablet with no
         back camera, an emulator image. required="false" keeps the permission and the reach: the
         broadcast surfaces check for a camera at runtime and offer audio-only when there is none. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- S3154: VideoBroadcastService is declared per flavor in src/broadcastVideoForeground (store
         builds, no camera foreground-service type) and src/broadcastVideoBackground (noLegal). Two
         injected manifests share one merger priority, so the service cannot live here and be
         overridden there. -->
    <application>
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- S2818: broadcast entry surfaces - Quick Settings tile + home-screen widget. Declared in
             this static manifest (injected by app_v2/build.gradle.kts for standard/noLegal/legacy
             only), so flavors without broadcast never see them. -->
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastTileService"
            android:exported="true"
            android:icon="@drawable/ic_live_broadcast"
            android:label="@string/tile_broadcast_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" />
        <receiver
            android:name="com.sza.fastmediasorter.widget.BroadcastEntryWidgetProvider"
            android:exported="true"
            android:icon="@drawable/ic_live_broadcast"
            android:label="@string/widget_broadcast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_broadcast_entry_info" />
        </receiver>
    </application>
</manifest>
