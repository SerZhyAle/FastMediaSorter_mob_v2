<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- S3155: declaring CAMERA without this makes the platform imply a REQUIRED camera feature, and
         Play then hides the build from every device without one - a Chromebook, a tablet with no
         back camera, an emulator image. required="false" keeps the permission and the reach: the
         broadcast surfaces check for a camera at runtime and offer audio-only when there is none. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- S4233: BroadcastScreenService types its foreground start as mediaProjection, and Android 14 refuses
         that type without this permission. The shared src/screenCapture manifest also declares it, but
         that one is absent on legacy and when fms.screenCapture is off, so the broadcast source cannot
         lean on it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- S3154/S4235: VideoBroadcastService is declared per flavor in src/broadcastVideoForeground (legacy,
         no camera foreground-service type) and src/broadcastVideoBackground (standard and noLegal). Two
         injected manifests share one merger priority, so the service cannot live here and be
         overridden there. -->
    <application>
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- S4234: the file source serves a stored file; it opens neither camera nor microphone,
             so it claims mediaPlayback and needs no runtime permission. -->
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastFileAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastFileVideoService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- S4233: the phone's screen as a broadcast source. The projection consent is taken on the control
             screen per session; the service only keeps what that consent produced. -->
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- S2818: broadcast entry surfaces - Quick Settings tile + home-screen widget. Declared in
             this static manifest (injected by app_v2/build.gradle.kts for standard/noLegal/legacy
             only), so flavors without broadcast never see them. The tile is bound by the platform only
             from API 24, hence tools:targetApi for the legacy API 23 floor (S3897). -->
        <service
            android:name="com.sza.fastmediasorter.broadcast.BroadcastTileService"
            android:exported="true"
            android:icon="@drawable/ic_live_broadcast"
            android:label="@string/tile_broadcast_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="n" />
        <receiver
            android:name="com.sza.fastmediasorter.widget.BroadcastEntryWidgetProvider"
            android:exported="true"
            android:icon="@drawable/ic_live_broadcast"
            android:label="@string/widget_broadcast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_broadcast_entry_info" />
        </receiver>
    </application>
</manifest>
