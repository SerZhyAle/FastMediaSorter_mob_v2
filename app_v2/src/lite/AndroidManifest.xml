<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 7: Lite flavor manifest overlay.
    Removes all Default Player components (activity aliases, MediaButtonReceiver)
    that are not supported in the lite build.
    Merged on top of src/main/AndroidManifest.xml at build time.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!-- Remove MediaButtonRestartReceiver from lite -->
        <receiver
            android:name=".ui.player.MediaButtonRestartReceiver"
            tools:node="remove" />

        <!-- Remove Camera OCR Translate Widget from lite flavor (no translation: ENABLE_TRANSLATION=false) -->
        <receiver
            android:name=".widget.CameraOcrTranslateWidgetProvider"
            tools:node="remove" />

        <!-- Remove Capture & OCR panel from lite flavor (no translation: ENABLE_TRANSLATION=false) -->
        <receiver
            android:name=".widget.CaptureOcrPanelWidgetProvider"
            tools:node="remove" />

        <!-- Remove Audio Now Playing widget from lite flavor (no persistent audio playback) -->
        <receiver
            android:name=".widget.AudioNowPlayingWidgetProvider"
            tools:node="remove" />

        <!-- Remove Quick Audio Recorder from lite flavor (SUPPORT_MIC_RECORDING=false, S0349) -->
        <receiver
            android:name=".widget.QuickAudioRecorderWidgetProvider"
            tools:node="remove" />
        <activity
            android:name=".widget.QuickAudioRecorderActivity"
            tools:node="remove" />
        <service
            android:name=".widget.QuickAudioRecorderService"
            tools:node="remove" />

        <!-- Remove ACTION_VIEW aliases from lite -->
        <activity-alias
            android:name=".StandaloneAudioPlayer"
            tools:node="remove" />

        <activity-alias
            android:name=".StandaloneVideoPlayer"
            tools:node="remove" />

        <activity-alias
            android:name=".StandaloneImagePlayer"
            tools:node="remove" />

        <activity-alias
            android:name=".StandaloneDocsPlayer"
            tools:node="remove" />

        <!-- Remove ACTION_SEND aliases from lite -->
        <activity-alias
            android:name=".StandaloneAudioSender"
            tools:node="remove" />

        <activity-alias
            android:name=".StandaloneVideoSender"
            tools:node="remove" />

        <activity-alias
            android:name=".StandaloneImageSender"
            tools:node="remove" />

        <!-- Remove Dropbox Auth Activity: lite has no cloud support.
             Prevents multiple apps registering for db-<appKey>:// which triggers
             the Dropbox SDK security alert when two flavors are installed. -->
        <activity
            android:name="com.dropbox.core.android.AuthActivity"
            tools:node="remove" />

    </application>

</manifest>
