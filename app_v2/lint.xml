<?xml version="1.0" encoding="utf-8"?>
<lint>
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!--
        StandalonePlayerActivity is an "Open With" handler designed to receive intents from any app.
        The UnsafeIntentLaunch check fires on debug-only logging code that calls checkUriPermission()
        with a URI read from the incoming intent. No intent data is ever forwarded to startActivity/
        startService — it is passed only to ExoPlayer/Glide. This is a false positive.
    -->
    <issue id="UnsafeIntentLaunch">
        <ignore path="**/StandalonePlayerActivity.kt" />
    </issue>
</lint>
