<?xml version="1.0" encoding="utf-8"?>
<lint>
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!--
        StandalonePlayerActivity is an "Open With" handler designed to receive intents from any app.
        The UnsafeIntentLaunch check fires on debug-only logging code that calls checkUriPermission()
        with a URI from the incoming intent. No intent data is ever forwarded to startActivity/
        startService - it is passed only to ExoPlayer/Glide. This is a false positive.
    -->
    <issue id="UnsafeIntentLaunch">
        <ignore path="**/StandalonePlayerActivity.kt" />
    </issue>
    <!--
        gradle.properties uses forward-slash path (C:/...) which is valid on Windows but lint
        misidentifies it as an un-escaped backslash path. Suppress at the root file level.
    -->
    <issue id="PropertyEscape">
        <ignore path="../gradle.properties" />
    </issue>
    <!--
        S3900: these Network Monitor readers live in src/main, but BLUETOOTH_CONNECT is declared only in
        src/networkMonitor (standard, noLegal) and READ_PHONE_STATE only in src/launcherEnabled, removed
        again in src/legacy (S2726). Flavors that do not mount the program therefore merge a manifest
        without them, and lint reports the undeclared-permission form of this check, which no grant
        check or catch (SecurityException) can satisfy. Declaring them there would ship a permission
        with no feature behind it; in standard every call is already guarded and lint accepts it.
    -->
    <issue id="MissingPermission">
        <ignore path="src/main/java/com/sza/fastmediasorter/data/networkmonitor/BluetoothDeviceDataSource.kt" />
        <ignore path="src/main/java/com/sza/fastmediasorter/data/networkmonitor/BluetoothProfileConnectionReader.kt" />
        <ignore path="src/main/java/com/sza/fastmediasorter/data/networkmonitor/BluetoothRssiSampler.kt" />
        <ignore path="src/main/java/com/sza/fastmediasorter/data/networkmonitor/BluetoothSnapshotDataSource.kt" />
        <ignore path="src/main/java/com/sza/fastmediasorter/data/networkmonitor/CellularSignalSampler.kt" />
        <ignore path="src/main/java/com/sza/fastmediasorter/data/networkmonitor/TelephonySnapshotDataSource.kt" />
    </issue>
</lint>
