# ============================================================================
# FastMediaSorter v2 - Community Repository .gitignore
# ============================================================================
# This file excludes build artifacts, IDE configs, credentials, and large
# test files while keeping all source code and documentation.
# ============================================================================

# ============================================================================
# BUILD ARTIFACTS & OUTPUTS
# ============================================================================
*.class
*.apk
*.aab
*.aar
*.jar
!gradle-wrapper.jar
*.war
*.ear
*.zip
*.tar.gz

# Gradle build outputs
.gradle/
build/
*/build/
**/build/
bin/
gen/
out/
release/
build_output.txt
aab_contents/

# Gradle wrapper (KEEP - required for project build)
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ============================================================================
# IDE & EDITOR CONFIGURATIONS
# ============================================================================
# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# VS Code
.vscode/

# AI Agent configurations
.agent/

# Eclipse
.classpath
.project
.settings/

# Kotlin
.kotlin/

# ============================================================================
# LOCAL CONFIGURATION & SECRETS (NEVER COMMIT)
# ============================================================================
# Local SDK/NDK paths and machine-specific settings
local.properties

# Keystore files - CRITICAL: DO NOT COMMIT
*.jks
*.keystore
*.pem
keystore.properties
fastmediasorter.keystore
upload_certificate.pem

# OAuth credentials - NEVER COMMIT
# Release OAuth config contains production credentials
app_v2/src/release/res/values/google_oauth.xml

# Google Services (Firebase, etc.) - Configure per deployment
google-services.json

# ============================================================================
# NATIVE BUILD OUTPUTS
# ============================================================================
.externalNativeBuild
.cxx/
obj/
libs/

# ============================================================================
# ANDROID PROFILING & DEBUGGING
# ============================================================================
*.hprof
*.trace

# ============================================================================
# TESTING FRAMEWORKS
# ============================================================================
# Maestro E2E test artifacts
maestro/**/*.mp4
maestro/**/*.webm
maestro/test-results/
maestro/maestro-results/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/readme.md

# Lint reports (keep config, exclude outputs)
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# ============================================================================
# TEMPORARY & SCRATCH FILES
# ============================================================================
temp/
*.tmp
*.log
*.swp
*.swo
*~

# ============================================================================
# LARGE TEST MEDIA FILES
# ============================================================================
# Test media files for manual testing (too large for repo)
test_media/

# ============================================================================
# BUILD OUTPUTS & DOWNLOADS
# ============================================================================
# Distribution folder with compiled APKs/AABs
DOWNLOADS/
downloads/

# ============================================================================
# DEPRECATED & ARCHIVED CODE
# ============================================================================
# Legacy V1 app (reference only, not for active development)
V1/
v2_6/
spec_v2/
temp/

# ============================================================================
# EXTERNAL DEPENDENCIES
# ============================================================================
# External servers/tools not part of main project
servers/
bundletool.jar

# Helper scripts with personal API keys (template versions are tracked)
scripts/ask-smart-router.ps1

# Python virtual environments (for scripts)
.venv/
venv/
__pycache__/
*.pyc

# ============================================================================
# OS-SPECIFIC FILES
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ============================================================================
# CI/CD TEMPORARY FILES
# ============================================================================
# GitHub Actions artifacts (keep workflow configs)
.github/*
!.github/workflows/
!.github/copilot-instructions.md

# ============================================================================
# MISCELLANEOUS
# ============================================================================
# Freeline (deprecated build tool)
freeline.py
freeline/
freeline_project_description.json

# Proguard (keep rules, exclude generated)
proguard/

# Version control
vcs.xml

# Agents documentation (internal AI instructions)
AGENTS.md
GEMINI.md

# Google site verification
google*.html

# ============================================================================
# WHAT SHOULD BE COMMITTED (FOR REFERENCE)
# ============================================================================
# ✅ Source code: app_v2/src/, wear/src/
# ✅ Build configs: *.gradle.kts, gradle.properties, gradle-wrapper.*
# ✅ Documentation: docs/, README*.md, *.md files
# ✅ Scripts: scripts/, dev/ (excluding logs)
# ✅ Tests: maestro/ configs, test source code
# ✅ Store assets: store_assets/
# ✅ Policies: PRIVACY_POLICY.*, TERMS_OF_SERVICE.*
# ✅ ProGuard rules: proguard-rules.pro
# ============================================================================
servers/

archive/
ChoiceModelRules.md
app_v2\src\main\res\xml\sza_resources.xml

# RAM disk backup folders
app_v2/build.backup/

# Large binary artifacts (>50MB, removed from history 2026-02-18)
bundletool.jar
maestro/lib/

# Integration test credentials (NEVER COMMIT)
test_credentials.json
**/test_media/test_credentials.json
sza_resources.xml .gradle_temp/
.gradle_temp/
.playwright-mcp/

# Generated catalog files (regenerated by scan.ps1 / render.ps1 — not versioned)
dev/CATALOG/app_v2.jsonl
dev/CATALOG/app_v2.md
dev/CATALOG/wear.jsonl
dev/CATALOG/wear.md