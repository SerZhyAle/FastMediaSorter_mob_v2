  "stateAndScoreInputs": {
    "description": "Everything that decides the board, a turn's outcome or the score. A ranked run is comparable only when every item here is identical.",
    "items": [
      {
        "id": "cells",
        "source": "phone.models",
        "fact": "Cells are FLOOR, WALL, EXIT. Board is a width x height grid; moves are orthogonal only (UP, DOWN, LEFT, RIGHT)."
      },
      {
        "id": "actors",
        "source": "phone.models",
        "fact": "One player, exactly one KRYVAVITSA enemy (id 'kryvavitsa'), zero or more SHADOW enemies (ids 'shadow_1'..)."
      },
      {
        "id": "config",
        "source": "phone.models",
        "fact": "GameLevelConfig = levelNumber, difficulty (stored, not read by the generator), width, height, shadowCount, seed."
      },
      {
        "id": "generator-normalize",
        "source": "phone.generator",
        "fact": "width/height clamped to 8..100; shadowCount clamped to 1..max(1, floor(w*h*0.30))."
      },
      {
        "id": "generator-attempts",
        "source": "phone.generator",
        "fact": "Up to 1500 attempts, attempt k uses kotlin.random.Random(seed + k*7919); exhaustion throws."
      },
      {
        "id": "generator-placement",
        "source": "phone.generator",
        "fact": "Player random; exit at Manhattan > min(w,h)/4; L-shaped reserved corridors (random horizontal-first or vertical-first) player->exit and player->Kryvavitsa; Kryvavitsa at > min(w,h)/3 off the exit corridor; shadows at > min(w,h)/4 off reserved cells."
      },
      {
        "id": "generator-walls",
        "source": "phone.generator",
        "fact": "Wall count = ceil(cells*0.30) + nextInt(floor(cells*0.10)+1), drawn by shuffled(random) from the non-reserved, unoccupied cells; validated density 0.30..0.40, reachable exit and Kryvavitsa, a legal first move, distance minimums."
      },
      {
        "id": "rng-dependency",
        "source": "phone.generator",
        "fact": "Board identity depends on the exact kotlin.random.Random (XorWow) sequence and on the order of every nextInt/nextBoolean/shuffled call. A port in another language must reproduce that sequence bit for bit, or seeds stop being portable."
      },
      {
        "id": "turn-order",
        "source": "phone.rules",
        "fact": "Player acts, score ticks, capture by stepping into an enemy ends the game, stepping on EXIT wins before enemies move; then Kryvavitsa (captures without moving if already adjacent, else HUNT), then shadows in an order shuffled by Random(config.seed + stats.turns), each WANDER; orthogonal adjacency after an enemy's action captures."
      },
      {
        "id": "blocked-move",
        "source": "phone.rules",
        "fact": "A blocked move (edge, wall that cannot move) is ACCEPTED: the turn is counted and charged, enemies act. Only a non-orthogonal delta or a finished level is rejected."
      },
      {
        "id": "wall-push",
        "source": "phone.rules",
        "fact": "Pushing a wall onto floor moves it (+10 bonus); onto a shadow crushes the shadow (+50) and moves the wall; onto EXIT destroys the wall (no push bonus); onto a wall, Kryvavitsa or off-board is blocked."
      },
      {
        "id": "hunt",
        "source": "phone.rules",
        "fact": "Kryvavitsa candidate order: greedy toward player (horizontal before vertical), greedy toward the first exit, then all four directions shuffled; first floor cell not occupied wins, else she stays."
      },
      {
        "id": "skip-turn",
        "source": "phone.rules",
        "fact": "Skip = turn ticked with the normal penalty, enemies act."
      },
      {
        "id": "scoring",
        "source": "phone.scoring",
        "fact": "Turn -10, wall push +10, shadow crush +50, floor 0; level completed +1000 and streak+1; restart (lost or voluntary) -500 floor 0 and streak 0; highScore = running max."
      },
      {
        "id": "progression-phone",
        "source": "phone.viewmodel",
        "fact": "Phone level N: square board 8 + N/3 capped at 20, shadowCount = N, difficulty NORMAL, fresh seed = clock(nanoTime xor currentTimeMillis) + nonce*104729 + N on every new level and every restart."
      },
      {
        "id": "persistence-phone",
        "source": "phone.repository-impl",
        "fact": "One Gson-serialized GameStateSnapshot (schemaVersion 1) under DataStore key 'embedded_game_state'; mode under 'embedded_game_mode'. A won or lost snapshot is healed into a playable level on resume."
      }
    ]
  },
  "presentationChoices": {
    "description": "Things that change how the game looks or is driven, never the board or the score.",
    "items": [
      {
        "id": "modes",
        "source": "phone.models",
        "fact": "GameMode CLASSIC, KRYVAVITSA, CONTRAST: a skin over unchanged logic, persisted separately; switching never resets a game. Unknown stored name -> CLASSIC."
      },
      {
        "id": "phone-input",
        "source": "phone.input",
        "fact": "D-pad, WASD and numpad 8/2/4/6 keys; touch controls; skip turn; restart; gamepad through the app-wide translator."
      },
      {
        "id": "phone-render",
        "source": "phone.board-view",
        "fact": "Custom View drawing cells and actors from drawables bg_game_ball_*, ic_game_fig_*, ic_game_door, ic_game_triangle_*; per-turn actor move animation; defeat connection line; exit guide arrow."
      },
      {
        "id": "phone-surfaces",
        "source": "phone.activity",
        "fact": "GameActivity, GameHelpActivity, launcher widget GameLaunchWidgetProvider; 54 game strings in strings_game.xml, authored EN/RU/UK and fanned out to 13 locales."
      },
      {
        "id": "wear-input",
        "source": "wear.screen",
        "fact": "Swipe-to-move on the board, side controls, long-press menu; rotary swallowed; edge swipe left to the platform."
      },
      {
        "id": "wear-render",
        "source": "wear.canvas",
        "fact": "Compose canvas with a stats ring and a rules screen."
      }
    ]
  },
  "wearDifferences": [
    {
      "id": "WD-01",
      "kind": "rule-variation",
      "fmsAReference": "phone.models",
      "wear": "wear.models",
      "fact": "Wear adds a VOID cell kind: contains() is false on it, so it acts as off-board for player moves and wall pushes.",
      "scopeQuestion": "Q-PAR-02"
    },
    {
      "id": "WD-02",
      "kind": "configuration-difference",
      "fmsAReference": "phone.viewmodel",
      "wear": "wear.viewmodel",
      "fact": "Wear board is 12x11 round (VOID corners) or 10x9 round compact or 9x9 square, fixed for every level; phone is square 8..20 growing with the level.",
      "scopeQuestion": "Q-PAR-01"
    },
    {
      "id": "WD-03",
      "kind": "configuration-difference",
      "fmsAReference": "phone.viewmodel",
      "wear": "wear.viewmodel",
      "fact": "Wear shadowCount = min(5, 2 + (N-1)/3); phone shadowCount = N.",
      "scopeQuestion": "Q-PAR-01"
    },
    {
      "id": "WD-04",
      "kind": "configuration-difference",
      "fmsAReference": "phone.viewmodel",
      "wear": "wear.viewmodel",
      "fact": "Wear difficulty band EASY <4, NORMAL <10, HARD after; phone always NORMAL. Neither generator reads it.",
      "scopeQuestion": "Q-RNK-02"
    },
    {
      "id": "WD-05",
      "kind": "rule-variation",
      "fmsAReference": "phone.generator",
      "wear": "wear.generator",
      "fact": "Wear reserves corridors by randomized BFS over the playable template instead of the phone's L-shaped path, and draws positions through the template; the random sequence is consumed differently, so one config and one seed do NOT give one board on both devices despite the ADR-1 comment.",
      "scopeQuestion": "Q-PAR-03"
    },
    {
      "id": "WD-06",
      "kind": "rule-variation",
      "fmsAReference": "phone.generator",
      "wear": "wear.generator",
      "fact": "Wall density and shadow capacity are computed over playable (non-VOID) cells on Wear, over all cells on the phone.",
      "scopeQuestion": "Q-PAR-02"
    },
    {
      "id": "WD-07",
      "kind": "configuration-difference",
      "fmsAReference": "phone.generator",
      "wear": "wear.generator",
      "fact": "Exhausted generation returns null on Wear (board left unchanged), throws on the phone.",
      "scopeQuestion": "Q-DEV-03"
    },
    {
      "id": "WD-08",
      "kind": "configuration-difference",
      "fmsAReference": "phone.models",
      "wear": "wear.models",
      "fact": "Wear fromRows maps ' ', '-', '_' to VOID and degrades an unknown char to FLOOR with a warning; the phone throws.",
      "scopeQuestion": "Q-DEV-03"
    },
    {
      "id": "WD-09",
      "kind": "presentation-choice",
      "fmsAReference": "phone.models",
      "wear": "wear.models",
      "fact": "Wear has no GameMode skins.",
      "scopeQuestion": "Q-FUT-01"
    },
    {
      "id": "WD-10",
      "kind": "presentation-choice",
      "fmsAReference": "phone.repository-impl",
      "wear": "wear.snapshot",
      "fact": "Wear stores the snapshot as its own delimited string (schema 1) in the watch settings store; the phone stores Gson JSON. The two saves are not interchangeable.",
      "scopeQuestion": "Q-FST-04"
    },
    {
      "id": "WD-11",
      "kind": "presentation-choice",
      "fmsAReference": "phone.board-view",
      "wear": "wear.guide-arrow",
      "fact": "Wear guide arrow targets the nearest exit by Manhattan distance; it is a hint only.",
      "scopeQuestion": "Q-PAR-04"
    },
    {
      "id": "WD-12",
      "kind": "rule-variation",
      "fmsAReference": "phone.scoring",
      "wear": "wear.scoring",
      "fact": "Scoring constants and formula are identical (only the expression is split into locals).",
      "scopeQuestion": "none - parity holds"
    },
    {
      "id": "WD-13",
      "kind": "rule-variation",
      "fmsAReference": "phone.rules",
      "wear": "wear.rules",
      "fact": "Rules engine is line-identical except the VOID branch (move into VOID -> blocked OUT_OF_BOUNDS, counted as a turn).",
      "scopeQuestion": "Q-PAR-02"
    }
  ],
  "gapsForOptionsMatrix": [
    "Two hand-maintained copies of the domain already drift (WD-05, WD-06): any standalone layout must make one canonical rules source.",
    "Seed portability depends on kotlin.random.Random's exact sequence (rng-dependency): a non-Kotlin port (Web in JS, Windows in C#) needs a specified, versioned PRNG.",
    "Board geometry differs per device (WD-02): ranked play needs a per-game-type geometry independent of the screen, or separate leaderboards per geometry.",
    "Seeds are clock-derived on the client: a shared leaderboard needs server-issued or verifiable seeds and a replayable move log.",
    "Two incompatible save formats (WD-10) and no carry-over path to a standalone app.",
    "Visual modes exist only on the phone (WD-09)."
  ],
  "referenceCases": [
    {
      "id": "RC-GEN-01",
      "area": "generation",
      "evidence": "test.phone.generator#generatedBoardIsDeterministicForSameSeed",
      "input": {
        "config": {
          "width": 10,
          "height": 10,
          "shadowCount": 2,
          "seed": 123
        }
      },
      "action": "createInitialState twice",
      "expected": "identical board, player and enemies",
      "evidenceStatus": "sourced"
    },
    {
      "id": "RC-GEN-02",
      "area": "generation",
      "evidence": "test.phone.generator#generatedBoardPassesCustomValidation",
      "input": {
        "config": {
          "width": 10,
          "height": 10,
          "shadowCount": 3,
          "seed": 99
        }
      },
      "action": "createInitialState then validateCustomBoard",
      "expected": "valid, no errors",
      "evidenceStatus": "sourced"
    },
    {
      "id": "RC-GEN-03",
      "area": "generation",
      "evidence": "test.phone.generator#generatedBoardUsesLevelAsShadowCountAndReferenceWallDensity",
      "input": {
        "config": {
          "width": 10,
          "height": 10,
          "shadowCount": 4,
          "seed": 101
        }
      },
      "action": "createInitialState",
      "expected": "4 shadows, wall density in 0.30..0.40",
      "evidenceStatus": "sourced"
    },
    {
      "id": "RC-GEN-04",
      "area": "generation",
      "evidence": "test.phone.generator#generatedBoardKeepsKryvavitsaReachableFromPlayer",
      "input": {
        "config": {
          "width": 12,
          "height": 12,
          "shadowCount": 3,
          "seedRange": "0..24"
        }
