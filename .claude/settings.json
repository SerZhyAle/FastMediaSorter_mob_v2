{
  "permissions": {
    "allow": [
      "Bash(./gradlew.bat *)",
      "Bash(git *)",
      "Bash(powershell.exe *)",
      "Bash(.\\scripts\\* *)",
      "Edit(**)",
      "Read(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(wc -l \"p:/ANDROID/FastMediaSorter_mob_v2/PLAN/tasks/\"task-ML-*.md)",
      "Bash(powershell -Command \".\\\\scripts\\\\add_to_dev_log.ps1 'PLAN/tasks/README.md' 'memory-leak-tasks' 'Research complete: 11 tasks created \\(2 CRITICAL, 5 HIGH, 4 MEDIUM\\), 2 already implemented \\(ML-001 PDF-manager, ML-002 OneDrive-GlobalScope\\), remaining 9 pending'\")",
      "mcp__mobile-mcp__mobile_list_elements_on_screen",
      "mcp__mobile-mcp__mobile_take_screenshot",
      "mcp__mobile-mcp__mobile_save_screenshot",
      "Bash(pwsh *)",
      "PowerShell(pwsh *)",
      "PowerShell(.\\a.ps1 *)",
      "PowerShell(.\\gradlew.bat *)",
      "PowerShell(git *)",
      "mcp__mobile-mcp__mobile_click_on_screen_at_coordinates",
      "mcp__mobile-mcp__mobile_double_tap_on_screen",
      "mcp__mobile-mcp__mobile_long_press_on_screen_at_coordinates",
      "mcp__mobile-mcp__mobile_press_button",
      "mcp__mobile-mcp__mobile_swipe_on_screen",
      "mcp__mobile-mcp__mobile_type_keys",
      "mcp__mobile-mcp__mobile_set_orientation",
      "mcp__mobile-mcp__mobile_get_orientation",
      "mcp__mobile-mcp__mobile_get_screen_size",
      "mcp__mobile-mcp__mobile_list_available_devices",
      "mcp__mobile-mcp__mobile_list_apps",
      "mcp__mobile-mcp__mobile_launch_app",
      "mcp__mobile-mcp__mobile_terminate_app"
    ],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File .claude/statusline.ps1",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/reset-catalog-touch-marker.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/nudge-small-task-tier.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-catalog-before-kt-search.ps1\""
          }
        ]
      }
    ]
  },
  "agent": "android-rd-specialist",
  "enabledPlugins": {
    "telegram@claude-plugins-official": false
  }
}
