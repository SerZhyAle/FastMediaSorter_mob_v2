{
  "_comment": "S1344 phase 02 - recorded PreToolUse payloads for guard-catalog-before-kt-search.ps1. This hook adjudicates every Grep and Glob in the repository, so a false refusal degrades search for every future session until someone disables the gate. Each case names the marker state it runs under, because temp/catalog-touch.marker is the pass condition. Run with .claude/hooks/tests/run-guard-catalog-cases.ps1.",
  "cases": [
    {
      "name": "unnarrowed-kt-grep-without-marker",
      "marker": false,
      "expectedExit": 2,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "PlayerViewModel", "glob": "**/*.kt", "output_mode": "files_with_matches" } }
    },
    {
      "name": "unnarrowed-kt-grep-with-marker",
      "marker": true,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "PlayerViewModel", "glob": "**/*.kt", "output_mode": "files_with_matches" } }
    },
    {
      "name": "grep-narrowed-by-path",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "PlayerViewModel", "path": "app_v2/src/main/java/com/sza/fastmediasorter/ui/player" } }
    },
    {
      "name": "grep-narrowed-by-glob",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "PlayerViewModel", "glob": "app_v2/src/main/java/**/*.kt" } }
    },
    {
      "name": "grep-narrowed-by-package-segment-in-glob",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "collectOnLifecycle", "glob": "**/ui/player/*.kt" } }
    },
    {
      "name": "grep-over-xml-is-out-of-scope",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "android:layout_width", "glob": "**/*.xml" } }
    },
    {
      "name": "grep-over-strings-xml-is-out-of-scope",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "settings_title", "glob": "**/strings.xml" } }
    },
    {
      "name": "grep-type-kotlin-unnarrowed-without-marker",
      "marker": false,
      "expectedExit": 2,
      "payload": { "tool_name": "Grep", "tool_input": { "pattern": "class .*Repository", "type": "kotlin" } }
    },
    {
      "name": "glob-all-kt-without-marker",
      "marker": false,
      "expectedExit": 2,
      "payload": { "tool_name": "Glob", "tool_input": { "pattern": "**/*.kt" } }
    },
    {
      "name": "glob-scripts-subtree-is-out-of-scope",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Glob", "tool_input": { "pattern": "scripts/**" } }
    },
    {
      "name": "grep-without-pattern-is-malformed-not-ours",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Grep", "tool_input": { "glob": "**/*.kt" } }
    },
    {
      "name": "non-search-tool-passes",
      "marker": false,
      "expectedExit": 0,
      "payload": { "tool_name": "Read", "tool_input": { "file_path": "app_v2/src/main/java/com/sza/fastmediasorter/MainActivity.kt", "limit": 100 } }
    }
  ]
}
